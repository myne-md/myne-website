---
// Current terms for the source-only project. The closed-beta terms were
// retired on 2026-11-25; they remain in git history, not on this page.
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteOg } from "../lib/og";

const title = "Terms — Myne";
const description =
  "Terms for the free, source-only Myne project: AGPL-3.0-only software, no hosted service, no warranty, and the rules for the website and the Myne name.";
const canonical = new URL("/terms/", Astro.site!).toString();
const ogImage = absoluteOg("terms", Astro.site!);
const effective = "25 November 2026";

const eyebrow = "font-size:11px;color:var(--accent);margin-bottom:14px;";
const h2 =
  "font-size:clamp(19px,2.2vw,25px);font-weight:700;letter-spacing:-0.02em;line-height:1.15;margin-top:56px;";
const body =
  "margin-top:14px;max-width:68ch;font-size:15px;line-height:1.7;color:var(--ink-3);";
const cardStyle =
  "border:1px solid rgb(var(--line-rgb) / 0.1);border-radius:12px;padding:22px;background:var(--paper-2);margin-top:22px;";
const listStyle = body + "padding-left:20px;";
---

<LandingLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <div style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:var(--ink-1);background:var(--paper);min-height:100vh;">
    <GlassNav active="legal" />

    <section id="top" style="padding:var(--page-top) var(--gutter) 70px;">
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Legal</div>
        <h1 style="font-size:clamp(30px,5vw,50px);font-weight:800;letter-spacing:-0.03em;line-height:1.05;">
          Terms
        </h1>
        <p style={body}>
          Effective {effective}. These terms cover the Myne website and the Myne software. They do not
          cover a server run by someone else: if you use a self-hosted or third-party sync server, that
          operator's terms and privacy policy apply to it.
        </p>

        <div style={cardStyle}>
          <div class="mono up" style={eyebrow}>The short version</div>
          <p style="margin:0;max-width:64ch;font-size:15px;line-height:1.7;color:var(--ink-3);">
            Myne is free software under AGPL-3.0-only, published as source. We run no hosted sync,
            storage or account service. The software and this website come with no warranty and no
            service level. The Myne name and logo are not licensed with the code; see
            <a href="https://github.com/myne-md/myne/blob/develop/TRADEMARK.md" style="color:var(--accent);">TRADEMARK.md</a>.
          </p>
        </div>

        <h2 style={h2}>Who we are</h2>
        <p style={body}>
          Myne is a free, non-commercial open-source project maintained by <strong>Myne contributors</strong>.
          The project has no hosted service and no paid plan. You can reach us at
          <a href="mailto:hello@myne.md" style="color:var(--accent);">hello@myne.md</a>; security reports go to
          <a href="mailto:security@myne.md" style="color:var(--accent);">security@myne.md</a>.
        </p>

        <h2 style={h2}>The software</h2>
        <p style={body}>
          The Myne source is published at
          <a href="https://github.com/myne-md/myne" rel="noopener" style="color:var(--accent);">github.com/myne-md/myne</a>
          under the GNU Affero General Public License, version 3 only (AGPL-3.0-only). Your rights in
          the code are those of that licence, including the source-offer rules in section 6. Nothing on
          this page narrows them.
        </p>
        <p style={body}>
          We do not operate a hosted Myne service, do not hold your vault, and do not provide accounts,
          storage, sync, backups or recovery. If you run Myne yourself, or use a server run by someone
          else, you and that operator are responsible for the deployment, its data and its security.
        </p>
        <p style={body}>
          If you receive a Myne binary from us, its corresponding source is available under AGPL §6.
          Write to <a href="mailto:source@myne.md" style="color:var(--accent);">source@myne.md</a> with the
          version and platform; we will provide the source for that binary at no charge. This offer is
          valid for at least three years from the date of distribution. It does not cover a build made
          by a third party from modified source.
        </p>

        <h2 style={h2}>The website</h2>
        <p style={body}>
          The text and user-guide content on this site are licensed under
          <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener" style="color:var(--accent);">CC BY 4.0</a>.
          The Myne name, wordmark, icon and other brand assets are not licensed for reuse; see
          <a href="https://github.com/myne-md/myne-website/blob/develop/TRADEMARK.md" style="color:var(--accent);">TRADEMARK.md</a>
          and <a href="https://github.com/myne-md/myne-website/blob/develop/LICENSING.md" style="color:var(--accent);">LICENSING.md</a>.
          The source code of this website is MIT-licensed as stated in its repository.
        </p>

        <h2 style={h2}>Acceptable use</h2>
        <ul style={listStyle}>
          <li style="margin-top:8px;">Do not use the Myne name or logo as the name of your fork, product or service, or in a way that suggests we endorse it. A factual “built on Myne” or “Myne-compatible” reference is fine.</li>
          <li style="margin-top:8px;">Do not attack this website, attempt to overload it, or use it to break the law.</li>
          <li style="margin-top:8px;">Do not misrepresent the security properties of Myne. The threat model is the authority on what the software does and does not protect.</li>
        </ul>

        <h2 style={h2}>No warranty, no service level</h2>
        <p style={body}>
          The software and this website are provided “as is”, without warranty of any kind, to the
          extent permitted by law. There is no uptime, support or data-recovery commitment. Myne is
          encryption software: if you lose your password and recovery phrase, nobody can recover your
          vault. Keep your own backups and test that they restore.
        </p>

        <h2 style={h2}>Third-party links and services</h2>
        <p style={body}>
          This site links to GitHub, model providers and other third-party sites. We do not control
          them and are not responsible for their content, availability or data practices. A link is
          not an endorsement, and their terms apply when you use them.
        </p>

        <h2 style={h2}>Liability</h2>
        <p style={body}>
          We are liable without limitation for intent, gross negligence, and injury to life, body or
          health. For ordinary negligence we are liable only for breach of an obligation essential to
          the purpose of these terms, and then only for the damage typically foreseeable for a free
          project of this kind. This does not exclude liability that German law makes mandatory.
        </p>

        <h2 style={h2}>Governing law</h2>
        <p style={body}>
          German law applies, excluding its conflict-of-law rules. If you are a consumer, this does
          not deprive you of the protection of mandatory provisions of the law of your country of
          residence.
        </p>

        <h2 style={h2}>Changes</h2>
        <p style={body}>
          We may update these terms when the project changes. The effective date above changes with
          them. Because there is no account or service relationship, continued use of the website
          after an update means the new terms apply to that use. The AGPL licence on the code is not
          changed by this page.
        </p>

        <h2 style={h2}>Contact</h2>
        <p style={body}>
          Questions about these terms: <a href="mailto:hello@myne.md" style="color:var(--accent);">hello@myne.md</a>.
          Privacy: <a href="mailto:privacy@myne.md" style="color:var(--accent);">privacy@myne.md</a>.
          Security: <a href="mailto:security@myne.md" style="color:var(--accent);">security@myne.md</a>.
          Source requests: <a href="mailto:source@myne.md" style="color:var(--accent);">source@myne.md</a>.
        </p>

        <p style={body + "margin-top:44px;font-size:14px;"}>
          Deutsche Fassung: <a href="/nutzungsbedingungen/" style="color:var(--accent);">Nutzungsbedingungen</a>.
          Datenschutz: <a href="/privacy/" style="color:var(--accent);">Privacy Policy</a>.
        </p>
      </div>
    </section>
    <SiteFooter />
  </div>
</LandingLayout>
