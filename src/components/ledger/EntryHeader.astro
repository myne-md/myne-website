---
import type { CollectionEntry } from "astro:content";
import EntryMeta from "./EntryMeta.astro";
import TagChip from "./TagChip.astro";

interface Props {
  entry: CollectionEntry<"ledger">;
}
const { entry } = Astro.props;
---

<header class="entry-header">
  <EntryMeta entry={entry} authorAs="schemaName" />

  <h1 class="t-h1 title">{entry.data.title}</h1>

  <p class="summary">{entry.data.summary}</p>

  {entry.data.tags.length > 0 && (
    <div class="tags" aria-label="Tags">
      {entry.data.tags.map((t) => <TagChip label={t} />)}
    </div>
  )}
</header>

<style>
  .entry-header { display: flex; flex-direction: column; gap: 16px; }
  .title { margin: 0; }
  .summary { margin: 0; font-size: 18px; line-height: 1.65; color: var(--fg-2); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 8px; }
</style>
