---
interface Props {
  /** Current page pathname, used for cross-route active state. */
  pathname?: string;
}
const { pathname = "/" } = Astro.props;

const isHome = pathname === "/" || pathname === "";
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);

const homeLinks = [
  { label: "How it works", section: "how" },
  { label: "Identity",     section: "identity" },
  { label: "Specs",        section: "specs" },
  { label: "Roadmap",      section: "roadmap" },
];

const isLedger = pathname === "/ledger" || pathname.startsWith("/ledger/");
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">Myne</a>
    <div class="nav-links">
      {homeLinks.map((l) => (
        <a href={sectionHref(l.section)} data-section={isHome ? l.section : undefined}>
          {l.label}
        </a>
      ))}
      <a
        href="/ledger/"
        class:list={["ledger-link", { active: isLedger }]}
        aria-current={isLedger ? "page" : undefined}
      >
        Ledger
      </a>
    </div>
    <div class="nav-spacer"></div>
    <div class="nav-cta">
      <a href={sectionHref("cta")} class="btn btn-primary">
        Get notified
      </a>
    </div>
  </div>
</nav>

<script>
  // Scroll-spy is home-page-only — guard against pages without sections.
  // On /ledger/* there is no #how / #identity / etc. on the DOM, so skip.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      ".nav-links a[data-section]",
    ),
  );
  if (links.length > 0) {
    const map = new Map<string, HTMLAnchorElement>();
    for (const a of links) map.set(a.dataset.section!, a);

    const sections = Array.from(map.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (sections.length > 0) {
      const setActive = (id: string | null) => {
        for (const a of links) a.classList.toggle("active", a.dataset.section === id);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort(
              (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
            );
          if (visible.length > 0) setActive(visible[0].target.id);
        },
        {
          rootMargin: "-15% 0px -70% 0px",
          threshold: 0,
        },
      );

      for (const s of sections) observer.observe(s);
    }
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(251, 251, 250, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line-1);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 56px;
  }
  .brand {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--fg-display);
  }
  .nav-links {
    display: flex;
    gap: 24px;
    font-size: 14px;
    color: var(--fg-2);
    margin-left: 16px;
  }
  .nav-links a {
    position: relative;
    padding-bottom: 2px;
  }
  .nav-links a:hover { color: var(--fg-1); }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 220ms var(--ease-standard);
  }
  .nav-links a.active {
    color: var(--fg-1);
  }
  .nav-links a.active::after {
    transform: scaleX(1);
  }
  /* Cross-route Ledger link gets a subtle separator from anchor links. */
  .nav-links .ledger-link {
    margin-left: 4px;
  }
  .nav-spacer { flex: 1; }
  .nav-cta { display: flex; gap: 8px; align-items: center; }

  @media (max-width: 920px) {
    .nav-links { display: none; }
  }
</style>
