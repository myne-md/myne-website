---
const links = {
  product: [
    { label: "How it works", href: "/#how" },
    { label: "Specs", href: "/#specs" },
    { label: "Roadmap", href: "/#roadmap" },
  ],
  bydesign: [
    { label: "Things Myne does not do", href: "/#non" },
    { label: "Account number", href: "/#identity" },
    { label: "Recovery phrase", href: "/#recovery" },
  ],
};

const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="grid">
      <div class="col">
        <div class="brand">Myne</div>
        <p>
          Open-source, end-to-end encrypted markdown notes. Privacy is the
          default; the recovery model is honest.
        </p>
      </div>
      <div class="col">
        <h4>Product</h4>
        {links.product.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </div>
      <div class="col">
        <h4>By design</h4>
        {links.bydesign.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </div>
      <div class="col">
        <h4>Status</h4>
        <p class="status-note">
          Pre-alpha. The desktop client is in development. Source repositories
          will be made public when Phase 1 ships.
        </p>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} Myne contributors · CC0 (docs) · AGPL-3.0 (client, on Phase 1)</span>
      <span class="mono">myne-protocol-v0.1</span>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 64px 0 48px;
    border-top: 1px solid var(--line-1);
    background: var(--paper-2);
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .col h4 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0 0 12px;
  }
  .col a {
    display: block;
    padding: 6px 0;
    font-size: 14px;
    color: var(--fg-2);
  }
  .col a:hover { color: var(--fg-1); }
  .col p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg-3);
    margin: 0;
    max-width: 320px;
  }
  .status-note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg-3);
    margin: 0;
    max-width: 240px;
  }
  .brand {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--fg-display);
    margin-bottom: 16px;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    color: var(--fg-3);
    border-top: 1px solid var(--line-1);
    padding-top: 24px;
  }
  .bottom .mono {
    font-family: var(--font-mono);
    font-feature-settings: "ss02", "zero";
  }

  @media (max-width: 920px) {
    .grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
