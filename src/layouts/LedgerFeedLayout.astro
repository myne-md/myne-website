---
import LandingLayout from "./LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import StatusBadge from "../components/StatusBadge.astro";
import VersionBadge from "../components/VersionBadge.astro";
import SegmentedFilter from "../components/ledger/SegmentedFilter.astro";
import EntryCard from "../components/ledger/EntryCard.astro";
import PinnedBanner from "../components/ledger/PinnedBanner.astro";
import {
  applyFilter,
  FILTERS,
  getSortedLedgerEntries,
  type FilterKey,
} from "../lib/ledger";
import { absoluteOg } from "../lib/og";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/ledger.css";
import "../styles/ledger-dark.css";

interface Props {
  active: FilterKey;
  /** Optional pinned-banner text. Render the sparse-state pin if set. */
  pinned?: string;
  title?: string;
  description?: string;
}
const { active, pinned, title, description } = Astro.props;

const filter = FILTERS.find((f) => f.key === active)!;
const filtered = applyFilter(await getSortedLedgerEntries(), active);

// Every filter view (/ledger, /ledger/shipped, …) canonicalizes to the feed
// root so the duplicate slices collapse to one indexable URL. Derive it from
// `Astro.site` rather than hardcoding the prod host, so the preview deploy
// emits a preview-host canonical instead of pointing at prod.
const ledgerCanonical = new URL("/ledger/", Astro.site!).toString();

const SPARSE_THRESHOLD = 4;
const showSparseQuiet =
  active === "all" && filtered.length > 0 && filtered.length < SPARSE_THRESHOLD;
---

<LandingLayout
  title={title ?? filter.pageTitle}
  description={description ?? filter.description}
  canonical={ledgerCanonical}
  ogImage={absoluteOg("ledger", Astro.site!)}
>
  <div class="ledger-root">
    <GlassNav active="ledger" />
    <section>
      <div class="container">
      <p class="section-eyebrow">Ledger</p>
      <h1 class="section-title ledger-h1">Notes from building Myne.</h1>
      <p class="section-lede ledger-lede">
        An append-only record of threat-model, protocol, and spec changes —
        and the reasoning behind them. Not a blog. Not a roadmap. Updates
        land when there is something worth saying.
      </p>

      {pinned && (
        <div class="ledger-pinned">
          <PinnedBanner text={pinned} />
        </div>
      )}

      <div class="ledger-filter-row">
        <SegmentedFilter active={active} />
        <div class="ledger-filter-spacer"></div>
        <a class="ledger-rss link-accent" href="/ledger/rss.xml">
          RSS<span class="path">/ledger/rss.xml</span>
        </a>
      </div>

      {filtered.length > 0 ? (
        <div class="ledger-list">
          {filtered.map((entry) => <EntryCard entry={entry} />)}
        </div>
      ) : (
        <div class="ledger-quiet">
          <p class="title">No entries yet under this filter.</p>
          <p class="body">Try <a class="link-accent" href="/ledger/">All</a>, or check back later.</p>
        </div>
      )}

      {showSparseQuiet && (
        <div class="ledger-quiet">
          <p class="title">That's all so far.</p>
          <p class="body">
            We post when there is something to post. The next entry might be
            next week or next quarter — both are fine.
          </p>
        </div>
      )}
      </div>
    </section>
    <footer class="ledger-footer">
      <div class="mono up ledger-footer__inner">
        <span>© 2026 Myne · AGPL-3.0 · CC-BY-4.0 docs</span><StatusBadge /><VersionBadge />
      </div>
    </footer>
  </div>
</LandingLayout>
