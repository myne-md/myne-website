---
/*
 * The vault as it exists on disk, a listing, not a capture.
 *
 * ── Why this one is drawn ─────────────────────────────────────────────────
 *
 * Every other surface on the marketing pages is a screenshot of the app. This
 * one is not, and cannot be: no guide frame photographs the vault directory, and
 * the point of the panel is the shape of that directory rather than of a window
 *, a locked vault has no window on it at all.
 *
 * What it shows is the tree `docs/spec/protocol.md` §9.1 specifies, verbatim:
 * `vault.meta`, `vault.prefs` and the flat `notes/` of `<uuid>.myn` blobs, with
 * each entry's first four bytes being a format magic rather than a header a
 * reader could learn anything from. Two things in it are the whole argument:
 * every note is a UUID and an extension, so no title and no folder name is on
 * disk to leak (folders are virtual, and the tree lives inside the encrypted
 * frontmatter), and the sizes say nothing.
 *
 * ── The hover ─────────────────────────────────────────────────────────────
 *
 * Each row answers when pointed at: the line under the listing swaps to that
 * entry's own sentence, and the row's UUID characters churn for a beat. The
 * churn is reflow-free for the same reason the hero's wordmark is, the listing
 * is monospace, so a substituted glyph has the same advance as the one it
 * replaced. Only the hex body churns; the leading path and the extension hold,
 * so the row goes on saying which file it is.
 *
 * Used once, on the landing page's closing CTA.
 */
const rows: [string, string, string, string][] = [
  [
    "vault.meta",
    "NTV5",
    "318 B",
    "the wrapped items key, the Argon2id salt and a hash of the account number",
  ],
  [
    "vault.prefs",
    "MYP5",
    "264 B",
    "settings, the vault's name, and the folders you made on purpose",
  ],
  [
    "notes/0184a2b3-…",
    "NC05",
    "1.4 kB",
    "XChaCha20-Poly1305 · the title, the tags and the folder are inside it",
  ],
  [
    "notes/0184a2b4-…",
    "NC05",
    "962 B",
    "another note, indistinguishable from the one above to this listing",
  ],
  [
    "attachments/a71b4e…",
    "MYA5",
    "2.6 MB",
    "a file, sealed the same way; the catalogue beside it is vault.attachments",
  ],
];
---

<div class="mp vl" data-vault data-motion="scale">
  <div class="mp__head vl__head">
    <span class="vl__title">
      <svg class="vl__folder" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2.5h8.5A1.5 1.5 0 0 1 21 10v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18Z" />
      </svg>
      vault · on disk
    </span>
    <span class="mp__pill vl__state">
      <i class="mp__dot vl__dot" aria-hidden="true"></i>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </svg>
      sealed
    </span>
  </div>
  <ul class="mono vl__rows">
    {
      rows.map(([name, magic, size, note]) => (
        <li class="vl__row" data-vault-row data-vault-note={note}>
          <span class="vl__tick" aria-hidden="true" />
          <span class="vl__name" data-vault-name data-vault-label={name}>
            {name}
          </span>
          <span class="vl__magic">{magic}</span>
          <span class="vl__size">{size}</span>
        </li>
      ))
    }
  </ul>
  <p class="mp__foot vl__note" data-vault-note-out>
    notes/ is flat · no titles, no folder names, no text
  </p>
</div>

<style>
  /* The plate itself is `styles/panel.css`: transparent, one hairline border,
     no shadow, no gradient. This file only holds what is the vault listing's
     own, which is the tree.
     ── What changed and why ───────────────────────────────────────────────
     The first version was deliberately boxless: hairlines top and bottom, rows
     floating on the page, on the theory that a `tree` should not look like a
     widget. In place, beside a section that already carries a dashed outer
     border, it read as a stray table someone had pasted in: nothing said the
     panel was a PLATE holding the vault. So it became one, and the plate then
     overshot: a corner glow, a sheen, an inset highlight, a 60px shadow and a
     light travelling the top edge, which together made a file listing look like
     a lit screen. A screen is the one thing this panel must not look like. */
  .vl {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    font-size: 11.5px;
  }

  .vl__head {
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
  }
  .vl__title {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .vl__folder {
    color: var(--ink-4);
  }
  .vl__state {
    border-color: rgb(var(--accent-rgb) / 0.4);
    color: var(--accent);
  }

  .vl__rows {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 9px 0 9px 15px;
  }
  /* The tree rail. One line, drawn once by the list rather than by every row,
     so the connectors below cannot drift out of alignment with each other. */
  .vl__rows::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 12px;
    bottom: 12px;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      rgb(var(--line-rgb) / 0.18) 12%,
      rgb(var(--line-rgb) / 0.18) 88%,
      transparent
    );
  }
  .vl__row {
    position: relative;
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto 48px;
    gap: 10px;
    align-items: center;
    padding: 6px 8px 6px 2px;
    border-radius: 6px;
    cursor: default;
    transition:
      background var(--duration-fast) var(--ease-standard),
      transform var(--duration-base) var(--ease-out);
  }
  .vl__row:hover {
    background: rgb(var(--line-rgb) / 0.05);
  }
  /* The row's own stub off the rail. */
  .vl__tick::before {
    content: "";
    display: block;
    width: 8px;
    height: 1px;
    background: rgb(var(--line-rgb) / 0.22);
  }
  .vl__name {
    color: var(--ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .vl__row:hover .vl__name {
    color: var(--ink-0);
  }
  .vl__magic {
    padding: 1px 5px;
    border: 1px solid rgb(var(--line-rgb) / 0.13);
    border-radius: 4px;
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--ink-4);
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }
  .vl__row:hover .vl__magic {
    border-color: rgb(var(--accent-rgb) / 0.45);
    background: rgb(var(--accent-rgb) / 0.1);
    color: var(--accent);
  }
  .vl__size {
    color: var(--ink-4);
    text-align: right;
  }
  /* The answer line. Reserved height so a hover never moves the section. */
  .vl__note {
    min-height: 3.2em;
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--ink-4);
    transition: color var(--duration-base) var(--ease-standard);
  }
  .vl[data-hover] .vl__note {
    color: var(--ink-2);
  }

  /* The rows band needs its own breathing room now that the plate has none of
     its own. */
  .vl__rows {
    padding: 8px 14px 8px 28px;
  }
  .vl__rows::before {
    left: 17px;
  }
</style>

<script>
  // Every listing on the page, not just the first: the landing's closing CTA and
  // the encryption block on /features each render one, and a `querySelector`
  // here would have left the second one inert with nothing to say so.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-vault]").forEach((vault) => {
    const out = vault.querySelector<HTMLElement>("[data-vault-note-out]");
    const rows = Array.from(vault.querySelectorAll<HTMLElement>("[data-vault-row]"));
    const DEFAULT_NOTE = out ? out.textContent || "" : "";
    const CH = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789";
    // One handle per element. A single shared handle meant entering a second row
    // cancelled the first row's pending frame, so the first filename kept
    // whatever hex was last painted into it until it was hovered again.
    const handles = new Map<HTMLElement, number>();

    const scramble = (el: HTMLElement, label: string) => {
      let start = -1;
      const tick = (now: number) => {
        if (start < 0) start = now;
        const t = now - start;
        let done = true;
        let next = "";
        for (let i = 0; i < label.length; i++) {
          const ch = label[i];
          const churnable = i > 5 && i < label.length - 3 && /[0-9a-fA-F]/.test(ch);
          if (!churnable || t > 240 + i * 5) next += ch;
          else {
            done = false;
            next += CH[(Math.random() * CH.length) | 0];
          }
        }
        el.textContent = next;
        if (done) {
          el.textContent = label;
          handles.delete(el);
          return;
        }
        handles.set(el, requestAnimationFrame(tick));
      };
      const live = handles.get(el);
      if (live) cancelAnimationFrame(live);
      handles.set(el, requestAnimationFrame(tick));
    };

    rows.forEach((row) => {
      const name = row.querySelector<HTMLElement>("[data-vault-name]");
      const label = name?.dataset.vaultLabel ?? "";
      // The same reveal for a pointer and for the keyboard. The sentence each
      // row carries exists nowhere else, so a hover-only handler makes the
      // panel's whole argument unreachable without a mouse.
      const reveal = () => {
        vault.dataset.hover = "";
        if (out && row.dataset.vaultNote) out.textContent = row.dataset.vaultNote;
        if (name && !reduce) scramble(name, label);
      };
      row.addEventListener("pointerenter", reveal);
      row.addEventListener("focus", reveal);
    });
    vault.addEventListener("pointerleave", () => {
      delete vault.dataset.hover;
      if (out) out.textContent = DEFAULT_NOTE;
    });
  });
</script>
