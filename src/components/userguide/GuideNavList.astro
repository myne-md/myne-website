---
// The user-guide navigation (categories + articles), rendered for the mobile
// navbar drop-down's "guide" pane. The desktop left sidebar keeps its own
// richer markup (with search); this is the compact, tappable mobile version.
import { getManifest } from "../../lib/userGuide";

interface Props {
  currentCategory?: string;
  currentSlug?: string;
}
const { currentCategory, currentSlug } = Astro.props;
const manifest = getManifest();
---

<div class="gnl">
  {
    manifest.map((cat) => {
      const isActiveCat = cat.slug === currentCategory;
      return (
        <div class="gnl-cat">
          <a
            href={`/user-guide/${cat.slug}/`}
            class:list={["gnl-catlink", "mono", { active: isActiveCat }]}
          >
            {cat.label}
          </a>
          {cat.articles.length > 0 && (
            <ul class="gnl-articles">
              {cat.articles.map((slug) => {
                const isActive = isActiveCat && slug === currentSlug;
                return (
                  <li>
                    <a
                      href={`/user-guide/${cat.slug}/${slug}/`}
                      class:list={["gnl-article", { active: isActive }]}
                      aria-current={isActive ? "page" : undefined}
                    >
                      {slug.replace(/-/g, " ")}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      );
    })
  }
</div>

<style>
  .gnl {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .gnl-cat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .gnl-catlink {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    padding: 2px 0 6px;
  }
  .gnl-catlink.active {
    color: var(--accent);
  }
  .gnl-articles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .gnl-article {
    display: block;
    padding: 10px 0 10px 14px;
    font-size: 14px;
    line-height: 1.3;
    color: var(--ink-2);
    text-decoration: none;
    text-transform: capitalize;
    border-left: 1px solid rgb(var(--line-rgb) / 0.1);
  }
  .gnl-article.active {
    color: var(--ink-1);
    border-left-color: var(--accent);
  }
</style>
