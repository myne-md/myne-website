---
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteOg } from "../lib/og";

const title = "Myne — Your notes. Sealed.";
const description =
  "Myne is a privacy-first markdown notes app that encrypts every byte before it leaves your device, asks for no email, and stores only ciphertext at rest — quietly, by default.";
const ogImage = absoluteOg("home", Astro.site!);
---

<LandingLayout title={title} description={description} ogImage={ogImage}>
  <div
    data-root
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e6e6e4;background:#0a0a0a;overflow-x:clip;"
  >
    <!-- Cursor glow: a soft light that follows the pointer everywhere except
         the hero, whose own 01 field already carries the glow. -->
    <div
      data-cursorglow
      style="position:fixed;top:0;left:0;width:460px;height:460px;border-radius:50%;pointer-events:none;z-index:70;opacity:0;transform:translate3d(-9999px,-9999px,0) translate(-50%,-50%);background:radial-gradient(circle closest-side, rgba(236,235,231,0.06), rgba(236,235,231,0.022) 45%, transparent 70%);mix-blend-mode:screen;transition:opacity .35s ease;"
    ></div>
    <!-- TOP BAR -->
    <GlassNav active="home" spy />

    <!-- ===================== HERO ===================== -->
    <section
      id="top"
      style="position:relative;min-height:100vh;overflow:hidden;padding:0 28px;"
    >
      <canvas
        data-noise
        style="position:absolute;top:0;left:0;width:100%;height:100%;display:block;opacity:0.9;-webkit-mask-image:linear-gradient(to bottom,#000 52%,transparent 100%);mask-image:linear-gradient(to bottom,#000 52%,transparent 100%);"
      ></canvas>
      <div
        style="position:relative;z-index:2;max-width:1280px;margin:0 auto;height:100vh;min-height:680px;display:flex;flex-direction:column;justify-content:center;"
      >
        <div class="hero-copy" style="max-width:620px;position:relative;">
          <h1
            class="up"
            style="font-size:clamp(40px,5.6vw,82px);line-height:0.96;font-weight:800;letter-spacing:-0.01em;"
          >
            Your notes.<br /><span class="mono" data-sealed>Sealed</span>.
          </h1>
          <p
            class="mono"
            style="margin-top:22px;max-width:46ch;font-size:13px;line-height:1.7;color:#8a8a86;"
          >
            Myne is a privacy-first markdown notes app that encrypts every byte
            before it leaves your device, asks for no email, and stores only
            ciphertext at rest — quietly, by default.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:30px;">
            <a
              href="/spec/"
              class="up"
              style="background:#e6e6e4;color:#0a0a0a;text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;"
              >Read the spec</a
            >
            <a
              href="#work"
              class="up"
              style="background:transparent;color:#e6e6e4;text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;border:1px solid rgba(255,255,255,0.2);"
              >Learn how it works</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== MANIFESTO (pinned word reveal) ===================== -->
    <section data-manifesto style="position:relative;height:300vh;background:#0a0a0a;">
      <div
        style="position:sticky;top:0;height:100vh;display:flex;align-items:center;justify-content:center;padding:0 6vw;"
      >
        <h2
          class="mono"
          style="font-size:clamp(26px,4.6vw,62px);line-height:1.28;font-weight:500;letter-spacing:-0.01em;max-width:20ch;text-align:left;"
          data-words
        >
          We can't read your notes. The server can't. We didn't build a way to.
          That is the entire point.
        </h2>
      </div>
    </section>

    <!-- ===================== GLOBE + PROCESS ===================== -->
    <section id="work" style="padding:90px 28px 110px;">
      <div style="max-width:1280px;margin:0 auto;">
        <h2
          data-reveal
          class="up"
          style="font-size:clamp(22px,3vw,40px);font-weight:600;letter-spacing:0.01em;max-width:22ch;"
        >
          Sealed by math. Portable by design.
        </h2>
        <div
          class="work-grid"
          style="display:grid;grid-template-columns:1fr 1fr;gap:56px;margin-top:50px;align-items:center;"
        >
          <div
            data-globe
            style="position:relative;height:420px;display:flex;align-items:center;justify-content:center;"
          >
            <canvas
              data-globecv
              style="width:100%;height:100%;display:block;cursor:grab;touch-action:none;"
            ></canvas>
          </div>
          <div data-process>
            <div style="border-top:1px solid rgba(255,255,255,0.14);padding:22px 0;">
              <div class="mono" style="font-size:12px;color:#54544f;">01</div>
              <div
                class="mono up"
                style="margin-top:8px;font-size:13px;color:#e6e6e4;"
              >
                Key derivation
              </div>
              <p
                style="margin-top:8px;max-width:50ch;font-size:12px;line-height:1.7;color:#8a8a86;"
              >
                Your password is stretched with Argon2id (m=256 MiB, t=3, p=2)
                into a key that never leaves the device. Parameters are bound
                into the ciphertext to defeat downgrade attacks.
              </p>
            </div>
            <div style="border-top:1px solid rgba(255,255,255,0.14);padding:22px 0;">
              <div class="mono" style="font-size:12px;color:#54544f;">02</div>
              <div
                class="mono up"
                style="margin-top:8px;font-size:13px;color:#e6e6e4;"
              >
                Local encryption
              </div>
              <p
                style="margin-top:8px;max-width:50ch;font-size:12px;line-height:1.7;color:#8a8a86;"
              >
                Every note is sealed with XChaCha20-Poly1305 plus a key
                commitment before it touches disk. Content, titles, folders,
                timestamps — all of it.
              </p>
            </div>
            <div style="border-top:1px solid rgba(255,255,255,0.14);padding:22px 0;">
              <div class="mono" style="font-size:12px;color:#54544f;">03</div>
              <div
                class="mono up"
                style="margin-top:8px;font-size:13px;color:#e6e6e4;"
              >
                Ciphertext at rest
              </div>
              <p
                style="margin-top:8px;max-width:50ch;font-size:12px;line-height:1.7;color:#8a8a86;"
              >
                Your notes' contents are unreadable on disk without your
                password. There is no plaintext mode for your notes to forget
                to enable, and no opt-out toggle to misconfigure.
              </p>
            </div>
            <div
              style="border-top:1px solid rgba(255,255,255,0.14);border-bottom:1px solid rgba(255,255,255,0.14);padding:22px 0;"
            >
              <div class="mono" style="font-size:12px;color:#54544f;">04</div>
              <div
                class="mono up"
                style="margin-top:8px;font-size:13px;color:#e6e6e4;"
              >
                Sync or self-host
              </div>
              <p
                style="margin-top:8px;max-width:50ch;font-size:12px;line-height:1.7;color:#8a8a86;"
              >
                The same zero-knowledge server — self-hostable, or hosted by us —
                stores and routes ciphertext, never holding a key. (Sync is in
                pre-alpha hardening.)
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== COMPARISON ===================== -->
    <section id="capab" style="padding:100px 28px;">
      <div style="max-width:1280px;margin:0 auto;">
        <div data-reveal style="max-width:620px;margin-bottom:40px;">
          <span class="mono up" style="font-size:11px;color:#8a8a86;"
            >Why not the workarounds</span
          >
          <h2
            style="margin-top:14px;font-size:clamp(28px,3.8vw,50px);font-weight:600;letter-spacing:-0.03em;line-height:1.04;"
          >
            The stack you're duct-taping, in one app.
          </h2>
        </div>
        <div data-reveal class="cmp-scroll">
        <div
          class="cmp-card"
          style="border:1px solid rgba(255,255,255,0.12);border-radius:12px;overflow:hidden;background:#0c0c0c;"
        >
          <div
            style="display:grid;grid-template-columns:minmax(0,2fr) repeat(5,minmax(0,1fr));"
          >
            <div
              style="padding:16px 18px;border-bottom:1px solid rgba(255,255,255,0.1);"
            >
            </div>
            <div
              style="padding:16px 14px;border-bottom:1px solid rgba(255,255,255,0.1);border-left:1px solid rgba(255,255,255,0.1);background:rgba(138,164,208,0.14);text-align:center;font-weight:700;color:#8aa4d0;"
            >
              Myne
            </div>
            <div
              style="padding:16px 14px;border-bottom:1px solid rgba(255,255,255,0.1);border-left:1px solid rgba(255,255,255,0.1);text-align:center;font-size:13.5px;font-weight:600;color:#c4c4c0;"
            >
              Obsidian
            </div>
            <div
              style="padding:16px 14px;border-bottom:1px solid rgba(255,255,255,0.1);border-left:1px solid rgba(255,255,255,0.1);text-align:center;font-size:13.5px;font-weight:600;color:#c4c4c0;"
            >
              Standard Notes
            </div>
            <div
              style="padding:16px 14px;border-bottom:1px solid rgba(255,255,255,0.1);border-left:1px solid rgba(255,255,255,0.1);text-align:center;font-size:13.5px;font-weight:600;color:#c4c4c0;"
            >
              Joplin
            </div>
            <div
              style="padding:16px 14px;border-bottom:1px solid rgba(255,255,255,0.1);border-left:1px solid rgba(255,255,255,0.1);text-align:center;font-size:13.5px;font-weight:600;color:#c4c4c0;"
            >
              Notesnook
            </div>
          </div>
          <div data-cmp-rows></div>
        </div>
        </div>
        <p class="mono" style="margin-top:14px;font-size:11.5px;line-height:1.7;color:#54544f;max-width:90ch;">
          Comparison reflects each tool's default configuration. Myne is
          pre-alpha, with no published signed release yet — cells marked
          <span style="color:#c2a35e;">partial</span> on the Myne column
          (zero-knowledge sync, self-hostable sync) are implemented in code and
          ship in v1.0 (Phase 1); signed reproducible builds are a committed v1.0
          deliverable, not yet produced. Only the managed hosted-sync tier is
          Phase 2. Obsidian's own at-rest encryption and self-hosted sync need
          add-ons (e.g. Cryptomator, Syncthing) it doesn't ship.
        </p>
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    <section id="commit" style="padding:96px 28px;">
      <div
        class="faq-grid"
        style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1.4fr;gap:50px;align-items:start;"
      >
        <div data-reveal>
          <h2
            style="font-size:clamp(30px,4vw,56px);font-weight:700;letter-spacing:-0.03em;line-height:1.02;"
          >
            Frequently<br />asked<br /><span style="color:rgba(255,255,255,0.4);"
              >questions</span
            >
          </h2>
          <p
            style="margin-top:20px;max-width:34ch;font-size:13.5px;line-height:1.7;color:#8a8a86;"
          >
            No vault is worth much if you can't understand it. Straight answers,
            including the uncomfortable ones.
          </p>
          <p
            class="mono"
            style="margin-top:18px;font-size:12px;line-height:1.6;color:#54544f;"
          >
            Still have a question?<br />
            <a
              href="mailto:info@myne.md"
              style="color:#8aa4d0;text-decoration:none;"
              >info@myne.md</a
            >
          </p>
        </div>
        <div data-faq></div>
      </div>
    </section>

    <!-- ===================== CTA ===================== -->
    <section id="contact" style="padding:90px 28px 60px;">
      <div
        data-reveal
        class="cta-grid"
        style="max-width:1280px;margin:0 auto;border:1px dashed rgba(255,255,255,0.2);padding:56px 48px;display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center;"
      >
        <div>
          <h2
            class="up"
            style="font-size:clamp(26px,3.4vw,46px);line-height:1.02;font-weight:700;"
          >
            Write like no one's watching.<br />Because no one else can read a word.
          </h2>
          <p
            style="margin-top:16px;max-width:46ch;font-size:12.5px;line-height:1.7;color:#8a8a86;"
          >
            Your notes deserve more than a privacy policy. Step into a tool where
            encryption is effortless, invisible, and always on.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:28px;">
            <a
              href="/spec/"
              class="up"
              style="background:#e6e6e4;color:#0a0a0a;text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;"
              >Read the spec</a
            >
            <a
              href="https://github.com/myne-md"
              class="up"
              style="background:transparent;color:#e6e6e4;text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;border:1px solid rgba(255,255,255,0.2);"
              >View source</a
            >
          </div>
        </div>
        <div
          data-encpanel
          style="display:flex;flex-direction:column;justify-content:center;height:230px;width:100%;max-width:380px;margin:0 auto;"
        >
          <div
            class="mono"
            data-enclabel
            style="font-size:10.5px;letter-spacing:0.04em;color:#54544f;margin-bottom:12px;transition:color .45s ease;"
          >
            note.md · in memory
          </div>
          <div
            style="border:1px solid rgba(255,255,255,0.12);border-radius:8px;background:rgba(255,255,255,0.025);padding:16px 18px;overflow:hidden;"
          >
            <div
              data-enclines
              class="mono"
              style="font-size:12px;line-height:1.95;color:#c4c4c0;white-space:nowrap;"
            ></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FOOTER ===================== -->
    <SiteFooter />
  </div>

  <!-- Mobile layout overrides. Inline styles win over classes, so the grid
       collapses use !important — scoped to ≤760px, desktop is untouched. -->
  <style is:global>
    /* The "Sealed" wordmark renders in the mono face: its fixed-width glyphs
       keep the encrypt/decrypt scramble from reflowing the line. */
    [data-sealed] {
      letter-spacing: 0.01em;
    }

    /* A diffuse dark cloud behind the hero copy: it locally suppresses the 01
       field so the text stays legible, then dissolves smoothly back into the
       binary on every side — soft radial falloff, no box edge. Same colour as
       the page (#0a0a0a), so it never reads as a visible blob, only as the
       binary fading out behind the words. */
    .hero-copy::before {
      content: "";
      position: absolute;
      z-index: -1;
      pointer-events: none;
      inset: -48% -58% -46% -42%;
      /* Fully opaque core so the cursor-driven 01 glow can't light up behind
         the text; then a soft falloff that dissolves into the binary. */
      background: radial-gradient(
        62% 58% at 34% 50%,
        rgba(10, 10, 10, 1) 0%,
        rgba(10, 10, 10, 1) 28%,
        rgba(10, 10, 10, 0.55) 52%,
        rgba(10, 10, 10, 0) 74%
      );
    }
    @media (max-width: 760px) {
      .hero-copy::before {
        inset: -32% -30% -34% -26%;
        background: radial-gradient(
          78% 60% at 42% 46%,
          rgba(10, 10, 10, 1) 0%,
          rgba(10, 10, 10, 1) 34%,
          rgba(10, 10, 10, 0.5) 60%,
          rgba(10, 10, 10, 0) 82%
        );
      }
    }

    @media (max-width: 760px) {
      /* Globe + process steps stack into one column. */
      .work-grid {
        grid-template-columns: 1fr !important;
        gap: 36px !important;
      }
      .work-grid [data-globe] {
        height: 300px !important;
      }

      /* Wide comparison table scrolls horizontally instead of crushing
         its six columns. */
      .cmp-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .cmp-scroll .cmp-card {
        min-width: 640px;
      }

      /* FAQ + CTA two-column splits stack. */
      .faq-grid {
        grid-template-columns: 1fr !important;
        gap: 28px !important;
      }
      .cta-grid {
        grid-template-columns: 1fr !important;
        gap: 28px !important;
        padding: 32px 22px !important;
      }
    }
  </style>
</LandingLayout>

<script>
  // Ported from the Claude Design v13 prototype (DCLogic.componentDidMount).
  // Plain DOM + canvas — no framework. Module scope keeps locals off window.
  const accent = "#8aa4d0";
  const $ = (s: string) => document.querySelector(s);
  const $$ = (s: string) => Array.from(document.querySelectorAll(s));
  const reduce =
    window.matchMedia &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let manCheck: (() => void) | null = null;
  let nRaf = 0;
  let gRaf = 0;
  let aRaf = 0;

  // ---------- reveals ----------
  const reveals = $$("[data-reveal]") as HTMLElement[];
  reveals.forEach((el) => {
    el.style.opacity = "0";
    el.style.transform = "translateY(24px)";
    el.style.transition =
      "opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1)";
  });
  if (reduce)
    reveals.forEach((el) => {
      el.style.opacity = "1";
      el.style.transform = "none";
    });
  const revealCheck = reduce
    ? () => {}
    : () => {
        const h = window.innerHeight;
        for (let i = reveals.length - 1; i >= 0; i--) {
          if (reveals[i].getBoundingClientRect().top < h * 0.92) {
            reveals[i].style.opacity = "1";
            reveals[i].style.transform = "none";
            reveals.splice(i, 1);
          }
        }
        if (manCheck) manCheck();
      };
  window.addEventListener("scroll", revealCheck, { passive: true });
  window.addEventListener("resize", revealCheck, { passive: true });
  revealCheck();
  requestAnimationFrame(revealCheck);
  [0, 150, 500, 1000].forEach((d) => setTimeout(revealCheck, d));

  // ---------- manifesto word reveal ----------
  const mclamp = (v: number, a: number, b: number) =>
    Math.max(a, Math.min(b, v));
  const man = $("[data-manifesto]") as HTMLElement | null;
  const wordsEl = $("[data-words]") as HTMLElement | null;
  if (wordsEl && man) {
    const text = wordsEl.textContent!.trim();
    const parts = text.split(/\s+/);
    wordsEl.textContent = "";
    const spans = parts.map((w) => {
      const s = document.createElement("span");
      s.textContent = w + " ";
      s.style.opacity = "0.16";
      // The highlight is scroll-driven (user-controlled), not an autonomous
      // animation, so it stays under reduce-motion — but drop the easing so
      // opacity snaps instead of animating.
      s.style.transition = reduce ? "none" : "opacity .3s ease";
      wordsEl.appendChild(s);
      return s;
    });
    manCheck = () => {
      const total = man.offsetHeight - window.innerHeight;
      const r = man.getBoundingClientRect();
      const p = total > 0 ? mclamp(-r.top / total, 0, 1) : 0;
      const lit = mclamp((p - 0.06) / 0.82, 0, 1) * spans.length;
      spans.forEach((s, i) => {
        s.style.opacity = i < lit ? "1" : i < lit + 1.6 ? "0.5" : "0.16";
      });
    };
    // revealCheck is a no-op under reduce-motion, so drive manCheck from its
    // own listeners too — otherwise the highlight never updates on the many
    // phones that ship with Reduce Motion enabled.
    window.addEventListener("scroll", manCheck, { passive: true });
    window.addEventListener("resize", manCheck, { passive: true });
    manCheck();
  }

  // ---------- wireframe globe ----------
  const gcv = $("[data-globecv]") as HTMLCanvasElement | null;
  if (gcv) {
    const ctx = gcv.getContext("2d")!;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const gclamp = (v: number, a: number, b: number) =>
      Math.max(a, Math.min(b, v));
    let W = 0,
      H = 0,
      R = 0;
    const resize = () => {
      const b = gcv.parentElement!.getBoundingClientRect();
      W = b.width;
      H = b.height;
      gcv.width = W * dpr;
      gcv.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      R = Math.min(W, H) * 0.42;
    };
    resize();
    window.addEventListener("resize", resize);
    // Drag-to-rotate. The globe holds still until grabbed, then turns in the
    // direction of the drag; a flick leaves a little inertia that eases out.
    // No hover rotation, no idle auto-spin.
    const view = { ry: 0.5, rx: 0.35 };
    let vRy = 0,
      vRx = 0; // angular velocity (rad/frame) for post-release inertia
    let dragging = false;
    let last = { x: 0, y: 0 };
    const SENS = 0.006;
    const AUTO = 0.0018; // slow idle yaw; suspended while dragging
    const clampRx = (v: number) => Math.max(-1.3, Math.min(1.3, v));
    gcv.addEventListener("pointerdown", (e: PointerEvent) => {
      dragging = true;
      vRy = vRx = 0;
      last = { x: e.clientX, y: e.clientY };
      gcv.setPointerCapture(e.pointerId);
      gcv.style.cursor = "grabbing";
    });
    gcv.addEventListener("pointermove", (e: PointerEvent) => {
      if (!dragging) return;
      // Negated so the grabbed surface follows the cursor (drag right turns the
      // globe right) instead of moving against it.
      vRy = -(e.clientX - last.x) * SENS;
      vRx = -(e.clientY - last.y) * SENS;
      last = { x: e.clientX, y: e.clientY };
      view.ry += vRy;
      view.rx = clampRx(view.rx + vRx);
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      try {
        gcv.releasePointerCapture(e.pointerId);
      } catch {}
      gcv.style.cursor = "grab";
    };
    gcv.addEventListener("pointerup", endDrag);
    gcv.addEventListener("pointercancel", endDrag);
    const project = (lat: number, lon: number, ry: number, rx: number) => {
      const x = Math.cos(lat) * Math.cos(lon),
        y = Math.sin(lat),
        z = Math.cos(lat) * Math.sin(lon);
      const x1 = x * Math.cos(ry) - z * Math.sin(ry),
        z1 = x * Math.sin(ry) + z * Math.cos(ry);
      const y2 = y * Math.cos(rx) - z1 * Math.sin(rx),
        z2 = y * Math.sin(rx) + z1 * Math.cos(rx);
      return { x: x1, y: y2, z: z2 };
    };
    let time = 0;
    // Nodes sit on wireframe intersections so they ride the grid instead of
    // floating in the gaps: latitude ∈ {0, ±30, ±60} (the drawn parallels) and
    // longitude on a 30° meridian. Authored in degrees, converted to radians.
    const D2R = Math.PI / 180;
    // Kept off antipodal pairs on connected edges — a node exactly opposite a
    // neighbour makes the great-circle slerp divide by zero (lines to infinity).
    const nodes = (
      [
        [30, -120],
        [0, 30], // hub (node 1)
        [-30, 90],
        [60, 150],
        [-30, -30],
        [-30, -90],
      ] as [number, number][]
    ).map(([la, lo]) => [la * D2R, lo * D2R] as [number, number]);
    // Unit-sphere vector for each node (pre-rotation) — needed for the
    // great-circle arcs and the pulses that ride them.
    const nodeVec = nodes.map(([la, lo]) => ({
      x: Math.cos(la) * Math.cos(lo),
      y: Math.sin(la),
      z: Math.cos(la) * Math.sin(lo),
    }));
    // Node 1 is the hub; a couple of mesh edges keep it from reading as a star.
    const edges = [
      [1, 0],
      [1, 2],
      [1, 3],
      [1, 4],
      [1, 5],
      [0, 5],
      [2, 4],
    ];
    const ACCENT = "138,164,208";
    const rot = (x: number, y: number, z: number, ry: number, rx: number) => {
      const x1 = x * Math.cos(ry) - z * Math.sin(ry),
        z1 = x * Math.sin(ry) + z * Math.cos(ry);
      const y2 = y * Math.cos(rx) - z1 * Math.sin(rx),
        z2 = y * Math.sin(rx) + z1 * Math.cos(rx);
      return { x: x1, y: y2, z: z2 };
    };
    const slerp = (
      a: { x: number; y: number; z: number },
      b: { x: number; y: number; z: number },
      t: number,
    ) => {
      let d = a.x * b.x + a.y * b.y + a.z * b.z;
      d = Math.max(-1, Math.min(1, d));
      const om = Math.acos(d);
      if (om < 1e-4) return { x: a.x, y: a.y, z: a.z };
      const s = Math.sin(om),
        w1 = Math.sin((1 - t) * om) / s,
        w2 = Math.sin(t * om) / s;
      return {
        x: a.x * w1 + b.x * w2,
        y: a.y * w1 + b.y * w2,
        z: a.z * w1 + b.z * w2,
      };
    };
    const draw = () => {
      time += 1;
      // Integrate inertia + a slow idle auto-spin only when not actively
      // dragging — while dragging, the view is updated straight from pointer
      // deltas. After release the flick decays and the auto-spin resumes.
      if (!dragging) {
        view.ry += vRy + AUTO;
        view.rx = clampRx(view.rx + vRx);
      }
      vRy *= 0.95;
      vRx *= 0.95;
      if (Math.abs(vRy) < 1e-4) vRy = 0;
      if (Math.abs(vRx) < 1e-4) vRx = 0;
      const ry = view.ry,
        rx = view.rx;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2,
        cy = H / 2;
      // Sealed-orb body fill only — a faint inner shade that gives the
      // wireframe depth. The outer atmosphere halo was removed per design.
      const body = ctx.createRadialGradient(
        cx - R * 0.32,
        cy - R * 0.32,
        R * 0.05,
        cx,
        cy,
        R,
      );
      body.addColorStop(0, "rgba(" + ACCENT + ",0.06)");
      body.addColorStop(1, "rgba(" + ACCENT + ",0)");
      ctx.fillStyle = body;
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, 6.2832);
      ctx.fill();
      ctx.lineWidth = 1;
      for (let la = -60; la <= 60; la += 30) {
        ctx.beginPath();
        let started = false;
        for (let lo = 0; lo <= 360; lo += 6) {
          const p = project(
            (la * Math.PI) / 180,
            (lo * Math.PI) / 180,
            ry,
            rx,
          );
          const sx = cx + p.x * R,
            sy = cy + p.y * R;
          ctx.strokeStyle =
            "rgba(232,231,225," +
            (0.1 + gclamp((p.z + 1) / 2, 0, 1) * 0.35).toFixed(2) +
            ")";
          if (!started) {
            ctx.moveTo(sx, sy);
            started = true;
          } else ctx.lineTo(sx, sy);
        }
        ctx.stroke();
      }
      for (let lo = 0; lo < 360; lo += 30) {
        ctx.beginPath();
        let started = false;
        for (let la = -90; la <= 90; la += 6) {
          const p = project(
            (la * Math.PI) / 180,
            (lo * Math.PI) / 180,
            ry,
            rx,
          );
          const sx = cx + p.x * R,
            sy = cy + p.y * R;
          ctx.strokeStyle =
            "rgba(232,231,225," +
            (0.08 + gclamp((p.z + 1) / 2, 0, 1) * 0.28).toFixed(2) +
            ")";
          if (!started) {
            ctx.moveTo(sx, sy);
            started = true;
          } else ctx.lineTo(sx, sy);
        }
        ctx.stroke();
      }
      const pts = nodeVec.map((v) => rot(v.x, v.y, v.z, ry, rx));

      // Great-circle arcs between connected nodes, sampled and stroked per
      // segment so each line fades as it wraps to the back of the sphere.
      const SEG = 22;
      edges.forEach(([a, b]) => {
        const va = nodeVec[a],
          vb = nodeVec[b];
        let prev: { sx: number; sy: number; z: number } | null = null;
        for (let s = 0; s <= SEG; s++) {
          const m = slerp(va, vb, s / SEG);
          const p = rot(m.x, m.y, m.z, ry, rx);
          const sx = cx + p.x * R,
            sy = cy + p.y * R;
          if (prev) {
            const zf = gclamp(((p.z + prev.z) / 2) * 0.5 + 0.5, 0, 1);
            ctx.strokeStyle =
              "rgba(" + ACCENT + "," + (0.05 + zf * 0.33).toFixed(3) + ")";
            ctx.beginPath();
            ctx.moveTo(prev.sx, prev.sy);
            ctx.lineTo(sx, sy);
            ctx.stroke();
          }
          prev = { sx, sy, z: p.z };
        }
      });

      // Sync pulses riding each arc — ciphertext in transit. Accent glow,
      // hidden once they round the far side of the globe.
      ctx.globalCompositeOperation = "lighter";
      edges.forEach(([a, b], i) => {
        const va = nodeVec[a],
          vb = nodeVec[b];
        const t = (time * 0.0038 + i / edges.length) % 1;
        const m = slerp(va, vb, t);
        const p = rot(m.x, m.y, m.z, ry, rx);
        if (p.z <= -0.05) return;
        const sx = cx + p.x * R,
          sy = cy + p.y * R;
        const fade = gclamp((p.z + 0.05) / 0.6, 0, 1);
        const g = ctx.createRadialGradient(sx, sy, 0, sx, sy, 9);
        g.addColorStop(0, "rgba(" + ACCENT + "," + (0.85 * fade).toFixed(3) + ")");
        g.addColorStop(1, "rgba(" + ACCENT + ",0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(sx, sy, 9, 0, 6.2832);
        ctx.fill();
        ctx.fillStyle = "rgba(214,226,247," + (0.9 * fade).toFixed(3) + ")";
        ctx.beginPath();
        ctx.arc(sx, sy, 1.6, 0, 6.2832);
        ctx.fill();
      });

      // Node glows — soft accent halo with a gentle breathing pulse; the hub
      // (node 1) reads a touch larger. Drawn additively over the wireframe.
      pts.forEach((p, i) => {
        if (p.z <= -0.15) return;
        const sx = cx + p.x * R,
          sy = cy + p.y * R;
        const depth = (p.z + 1) / 2;
        const hubN = i === 1;
        const pulse = 0.5 + 0.5 * Math.sin(time * 0.045 + i * 1.7);
        const glowR = (hubN ? 13 : 8) + pulse * (hubN ? 4 : 2.5);
        const gg = ctx.createRadialGradient(sx, sy, 0, sx, sy, glowR);
        gg.addColorStop(
          0,
          "rgba(" + ACCENT + "," + (0.4 * (0.5 + depth * 0.5)).toFixed(3) + ")",
        );
        gg.addColorStop(1, "rgba(" + ACCENT + ",0)");
        ctx.fillStyle = gg;
        ctx.beginPath();
        ctx.arc(sx, sy, glowR, 0, 6.2832);
        ctx.fill();
      });
      ctx.globalCompositeOperation = "source-over";

      // Solid node cores on top.
      pts.forEach((p, i) => {
        if (p.z <= -0.1) return;
        const sx = cx + p.x * R,
          sy = cy + p.y * R;
        const depth = (p.z + 1) / 2;
        const hubN = i === 1;
        ctx.fillStyle = hubN
          ? "rgba(224,233,250," + (0.6 + depth * 0.4).toFixed(3) + ")"
          : "rgba(232,231,225," + (0.4 + depth * 0.6).toFixed(3) + ")";
        ctx.beginPath();
        ctx.arc(sx, sy, hubN ? 3.1 : 2.3, 0, 6.2832);
        ctx.fill();
      });

      gRaf = requestAnimationFrame(draw);
    };
    draw();
    if (reduce) cancelAnimationFrame(gRaf);
  }

  // ---------- comparison rows ----------
  const cmp = $("[data-cmp-rows]") as HTMLElement | null;
  if (cmp) {
    const Y = '<span style="color:#7fb89a;font-weight:600;">✓</span>';
    const N = '<span style="color:#54544f;">—</span>';
    const P = '<span style="color:#c2a35e;font-size:12px;">partial</span>';
    // Columns: label, Myne, Obsidian+Cryptomator+Syncthing, Standard Notes,
    // Joplin, Notesnook. Researched + adversarially verified against each
    // tool's default config (see /spec + the workarounds research).
    const rows = [
      ["Encrypted by default", Y, N, Y, N, Y],
      ["Encrypts titles & structure too", Y, N, P, P, Y],
      ["Plain markdown files", Y, Y, N, N, N],
      ["Backlinks & graph, built-in", Y, Y, P, P, P],
      ["No email at signup", Y, Y, P, Y, P],
      ["User-held recovery, no reset", Y, P, P, P, P],
      ["Zero-knowledge sync", P, P, Y, N, Y],
      ["Self-hostable sync", P, N, Y, Y, P],
      ["Open-source full stack", Y, N, Y, Y, Y],
      ["One integrated app", Y, Y, Y, Y, Y],
      ["No plaintext mode for notes", Y, N, Y, N, Y],
      ["Reproducible, signed builds", P, N, N, P, P],
      ["No feature paywall", Y, Y, P, Y, P],
    ];
    rows.forEach((r, ri) => {
      const row = document.createElement("div");
      row.style.cssText =
        "display:grid;grid-template-columns:minmax(0,2fr) repeat(5,minmax(0,1fr));" +
        (ri < rows.length - 1
          ? "border-bottom:1px solid rgba(255,255,255,0.1);"
          : "");
      const cells = [
        '<div style="padding:14px 18px;font-size:13.5px;color:#e6e6e4;">' +
          r[0] +
          "</div>",
        '<div style="padding:14px 14px;border-left:1px solid rgba(255,255,255,0.1);background:rgba(138,164,208,0.08);text-align:center;">' +
          r[1] +
          "</div>",
        '<div style="padding:14px 14px;border-left:1px solid rgba(255,255,255,0.1);text-align:center;">' +
          r[2] +
          "</div>",
        '<div style="padding:14px 14px;border-left:1px solid rgba(255,255,255,0.1);text-align:center;">' +
          r[3] +
          "</div>",
        '<div style="padding:14px 14px;border-left:1px solid rgba(255,255,255,0.1);text-align:center;">' +
          r[4] +
          "</div>",
        '<div style="padding:14px 14px;border-left:1px solid rgba(255,255,255,0.1);text-align:center;">' +
          r[5] +
          "</div>",
      ];
      row.innerHTML = cells.join("");
      cmp.appendChild(row);
    });
  }

  // ---------- hero noise canvas (char map) ----------
  const clamp = (v: number, a: number, b: number) =>
    Math.max(a, Math.min(b, v));
  const noise = $("[data-noise]") as HTMLCanvasElement | null;
  if (noise) {
    const ctx = noise.getContext("2d")!;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    // Touch devices never get the cursor glow that reveals the field on
    // desktop, so the faint base alpha reads as blank on a phone. Lift the
    // base contrast on no-hover (coarse-pointer) devices so the 01s show.
    const noHover =
      !!window.matchMedia && window.matchMedia("(hover: none)").matches;
    const fieldBoost = noHover ? 2.1 : 1;
    const GL = "01";
    let W = 0,
      H = 0,
      cols = 0,
      rows = 0,
      grid: { c: string; on: boolean }[] = [];
    const CELL = 15;
    const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999, active: false };
    const resize = () => {
      const b = noise.getBoundingClientRect();
      W = b.width;
      H = b.height;
      noise.width = W * dpr;
      noise.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(W / CELL);
      rows = Math.ceil(H / CELL);
      grid = new Array(cols * rows);
      for (let i = 0; i < grid.length; i++)
        grid[i] = { c: GL[(Math.random() * 2) | 0], on: Math.random() < 0.5 };
      ctx.font = "11px 'JetBrains Mono', monospace";
      ctx.textBaseline = "top";
    };
    resize();
    window.addEventListener("resize", resize);
    const moveTarget = noise.parentElement || noise;
    moveTarget.addEventListener("mousemove", (e) => {
      const b = noise.getBoundingClientRect();
      mouse.tx = (e as MouseEvent).clientX - b.left;
      mouse.ty = (e as MouseEvent).clientY - b.top;
      // Snap on first entry so the glow doesn't glide in from off-canvas.
      if (!mouse.active) {
        mouse.x = mouse.tx;
        mouse.y = mouse.ty;
        mouse.active = true;
      }
    });
    moveTarget.addEventListener("mouseleave", () => {
      mouse.active = false;
      mouse.x = mouse.y = mouse.tx = mouse.ty = -9999;
    });
    // Glyphs re-randomize on a calm ~70ms cadence; the cursor glow eases
    // toward the pointer and is redrawn every frame while hovering so it
    // visibly tracks the mouse instead of jumping in 70ms steps.
    const R = 200;
    let flickerLast = 0;
    const draw = (t: number) => {
      const flick = t - flickerLast > 70;
      if (flick) {
        flickerLast = t;
        for (let i = 0; i < grid.length; i++)
          if (Math.random() < 0.06) grid[i].c = GL[(Math.random() * 2) | 0];
      }
      if (mouse.active) {
        mouse.x += (mouse.tx - mouse.x) * 0.25;
        mouse.y += (mouse.ty - mouse.y) * 0.25;
      }
      // Full redraw every frame while hovering (smooth tracking); otherwise
      // only on the flicker tick to keep the idle cost low.
      if (mouse.active || flick) {
        ctx.clearRect(0, 0, W, H);
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const cell = grid[y * cols + x];
            const px = x * CELL,
              py = y * CELL;
            // Cover the whole hero and fade the field downward.
            const dens = clamp((1 - y / rows) * 0.8 + 0.2, 0, 1);
            const a =
              (cell.on ? 0.04 + dens * 0.18 : 0.02 + dens * 0.05) * fieldBoost;
            const d = Math.hypot(px - mouse.x, py - mouse.y);
            if (d < R) {
              const a2 = clamp(a + (1 - d / R) * 0.62, 0, 0.82);
              ctx.fillStyle = "rgba(236,235,231," + a2.toFixed(3) + ")";
            } else {
              ctx.fillStyle = "rgba(232,231,225," + a.toFixed(3) + ")";
            }
            ctx.fillText(cell.c, px, py);
          }
        }
      }
      nRaf = requestAnimationFrame(draw);
    };
    if (reduce) {
      // Force one full paint: draw() only renders on a flicker tick, and
      // t=0 with flickerLast=0 would skip it, leaving the field blank.
      flickerLast = -1000;
      draw(0);
      cancelAnimationFrame(nRaf);
    } else nRaf = requestAnimationFrame(draw);
  }

  // ---------- page-wide cursor glow ----------
  // A soft light that eases toward the pointer across the whole page. The
  // hero is excluded — its 01 field already carries the cursor glow — so the
  // binary characters stay hero-only while the glow follows everywhere else.
  const glow = $("[data-cursorglow]") as HTMLElement | null;
  if (glow && !reduce) {
    let gx = -9999,
      gy = -9999,
      tx = -9999,
      ty = -9999,
      started = false,
      inWindow = false;
    let heroBottom = 0;
    const measureHero = () => {
      const h = document.getElementById("top");
      heroBottom = h ? h.offsetHeight : window.innerHeight;
    };
    measureHero();
    window.addEventListener("resize", measureHero);
    window.addEventListener(
      "mousemove",
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
        if (!started) {
          gx = tx;
          gy = ty;
          started = true;
        }
        inWindow = true;
      },
      { passive: true },
    );
    window.addEventListener("mouseout", (e) => {
      if (!(e as MouseEvent).relatedTarget) inWindow = false;
    });
    const tick = () => {
      gx += (tx - gx) * 0.16;
      gy += (ty - gy) * 0.16;
      glow.style.transform =
        "translate3d(" + gx + "px," + gy + "px,0) translate(-50%,-50%)";
      // Hide over the hero (its 01 field already glows) and when the pointer
      // has left the window.
      const overHero = window.scrollY + ty < heroBottom;
      glow.style.opacity = inWindow && started && !overHero ? "1" : "0";
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // ---------- FAQ ----------
  const faq = $("[data-faq]") as HTMLElement | null;
  if (faq) {
    const items: [string, string][] = [
      [
        "What if I lose my password?",
        "With your 24-word recovery phrase you re-derive your key and you’re back in. Lose both and the data is gone — there is no reset link, because a reset link is a backdoor.",
      ],
      [
        "Can you read my notes?",
        "No. Encryption happens on your device with a key we never receive. The sync server stores and routes ciphertext only.",
      ],
      [
        "Is it actually open source?",
        "Client, server, and protocol spec are all open — AGPL-3.0 for code, CC-BY-4.0 for docs. No open core, no proprietary build.",
      ],
      [
        "What if Myne shuts down?",
        "Your notes are plain markdown after decryption, so they open in any editor. And the server is open source — keep syncing by self-hosting.",
      ],
      [
        "Is it ready to use?",
        "Not yet. It’s pre-alpha: the v0.1 spec and threat model are public (still in draft); the desktop client is in progress.",
      ],
    ];
    // Accordion: only one panel stays open at a time. Each entry registers a
    // close() that the others call when one is expanded.
    const panels: { open: boolean; expand: (v: boolean) => void }[] = [];
    items.forEach(([q, a], i) => {
      const row = document.createElement("div");
      row.style.cssText =
        "border-bottom:1px solid rgba(255,255,255,0.1);" +
        (i === 0 ? "border-top:1px solid rgba(255,255,255,0.1);" : "");
      const head = document.createElement("button");
      head.style.cssText =
        "width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 16px;background:rgba(255,255,255,0.02);border:0;cursor:pointer;text-align:left;font-family:inherit;margin:8px 0;border-radius:8px;";
      head.innerHTML =
        '<span style="font-size:15px;font-weight:500;color:#e6e6e4;">' +
        q +
        '</span><span class="mono" data-plus style="font-size:18px;color:' +
        accent +
        ';transition:transform .3s ease;">+</span>';
      const body = document.createElement("div");
      body.style.cssText =
        "overflow:hidden;max-height:0;transition:max-height .35s ease;";
      body.innerHTML =
        '<p style="padding:0 16px 18px;max-width:60ch;font-size:13.5px;line-height:1.65;color:#8a8a86;">' +
        a +
        "</p>";
      const plus = head.querySelector("[data-plus]") as HTMLElement;
      const panel = {
        open: false,
        expand(v: boolean) {
          this.open = v;
          body.style.maxHeight = v ? body.scrollHeight + 30 + "px" : "0px";
          plus.style.transform = v ? "rotate(45deg)" : "rotate(0deg)";
        },
      };
      panels.push(panel);
      head.addEventListener("click", () => {
        const next = !panel.open;
        panels.forEach((p) => p !== panel && p.open && p.expand(false));
        panel.expand(next);
      });
      row.appendChild(head);
      row.appendChild(body);
      faq.appendChild(row);
    });
  }

  // ---------- hero "Sealed" wordmark: decrypt reveal ----------
  // Plays once on load (scrambled -> resolved, left to right) and replays on
  // hover. Deliberately one-shot — no idle loop — so it never nags the reader.
  // Mono glyphs (set in CSS) keep the line from reflowing as chars churn.
  const sealed = $("[data-sealed]") as HTMLElement | null;
  if (sealed && !reduce) {
    const target = (sealed.textContent || "Sealed").trim();
    const cs = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%@&$/?";
    let running = false;
    const play = () => {
      if (running) return;
      running = true;
      const L = target.length;
      const per = 78; // ms before each successive char locks in
      const lead = 200; // initial all-scrambled beat
      let start = -1;
      const tick = (now: number) => {
        if (start < 0) start = now;
        const t = now - start;
        let out = "";
        let done = true;
        for (let i = 0; i < L; i++) {
          if (t >= lead + i * per) {
            out += target[i];
          } else {
            done = false;
            out += cs[(Math.random() * cs.length) | 0];
          }
        }
        sealed.textContent = out;
        if (done) {
          sealed.textContent = target;
          running = false;
          return;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    play();
    sealed.addEventListener("mouseenter", play);
  }

  // ---------- encryption morph (CTA): plaintext note -> ciphertext ----------
  // On theme with the heading ("no one else can read a word"): a private note
  // scrambles character-by-character into ciphertext and back, looping, while
  // the file label flips note.md (in memory) -> note.myn (ciphertext).
  const enclines = $("[data-enclines]") as HTMLElement | null;
  const enclabel = $("[data-enclabel]") as HTMLElement | null;
  if (enclines) {
    const plain = [
      "# Q3 launch - ship slow",
      "- call mom, buy milk",
      "- the idea i can't say",
      "todo: trust math, not us",
      "draft: things left unsaid",
    ];
    const charset =
      "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz0123456789+/$#%@&?";
    const rnd = () => charset[(Math.random() * charset.length) | 0];
    const rows = plain.map((txt) => {
      const d = document.createElement("div");
      d.textContent = txt;
      enclines.appendChild(d);
      return { el: d, txt };
    });
    const setLabel = (cipher: boolean) => {
      if (!enclabel) return;
      enclabel.textContent = cipher
        ? "note.myn · ciphertext"
        : "note.md · in memory";
      enclabel.style.color = cipher ? "#8aa4d0" : "#54544f";
    };
    if (reduce) {
      // Static ciphertext conveys the point without motion.
      rows.forEach((r) => {
        r.el.textContent = r.txt.replace(/[^ ]/g, () => rnd());
      });
      setLabel(true);
      cancelAnimationFrame(aRaf);
    } else {
      let p = 0,
        dir = 1,
        hold = 34,
        last = 0;
      const step = (now: number) => {
        if (now - last > 45) {
          last = now;
          if (hold > 0) {
            hold--;
          } else {
            p += dir * 0.02;
            if (p >= 1) {
              p = 1;
              hold = 46;
              dir = -1;
              setLabel(true);
            } else if (p <= 0) {
              p = 0;
              hold = 40;
              dir = 1;
              setLabel(false);
            }
          }
          rows.forEach((r) => {
            const L = r.txt.length;
            const cut = p * L; // characters encrypted from the left
            let out = "";
            for (let i = 0; i < L; i++) {
              const ch = r.txt[i];
              // Re-randomize ciphered chars each frame so they shimmer.
              out += ch === " " ? " " : i < cut ? rnd() : ch;
            }
            r.el.textContent = out;
          });
        }
        aRaf = requestAnimationFrame(step);
      };
      aRaf = requestAnimationFrame(step);
    }
  }
</script>
