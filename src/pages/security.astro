---
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { absoluteOg } from "../lib/og";

const title = "Security — Myne";
const description =
  "How to report a security issue in Myne. Acknowledgment-only: we credit researchers, there is no monetary bounty yet. Report privately via GitHub security advisories or security@myne.md.";
const canonical = new URL("/security/", Astro.site!).toString();
const ogImage = absoluteOg("security", Astro.site!);

const cardStyle =
  "border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px;background:#0c0c0c;";
const eyebrow = "font-size:11px;color:#8aa4d0;margin-bottom:14px;";
const h2 =
  "font-size:clamp(20px,2.4vw,28px);font-weight:700;letter-spacing:-0.02em;line-height:1.1;";
const lead =
  "margin-top:14px;max-width:64ch;font-size:15px;line-height:1.65;color:#8a8a86;";

const inScope = [
  "The desktop client (editor, vault, key handling)",
  "The protocol spec and the cryptographic implementation",
  "The sync server — self-hostable, open source (Phase 1, in production hardening)",
  "The web client at app.example.com and its bundle delivery channel (the weaker A15/TB11 served-bundle surface)",
  "The build & release pipeline, signed builds, the auto-updater",
  "This website and the /.well-known/security.txt it serves",
];
const outScope = [
  "Theoretical attacks already documented in the threat model (A7 active malware, A10 nation-state, A12 coercion)",
  "Lost-password / lost-recovery-phrase data loss — by design, there is no reset",
  "Best-practice nags without a concrete, reproducible impact",
];
---

<LandingLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <div
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e6e6e4;background:#0a0a0a;min-height:100vh;"
  >
    <GlassNav active="security" />

    <section id="top" style="padding:128px 28px 70px;">
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Security</div>
        <h1
          style="font-size:clamp(34px,5vw,58px);line-height:1.0;font-weight:700;letter-spacing:-0.035em;"
        >
          Found a hole? Tell us.
        </h1>
        <p
          style="margin-top:22px;max-width:66ch;font-size:16px;line-height:1.65;color:#8a8a86;"
        >
          Myne's whole pitch is that you can verify it rather than trust it — so
          we want to hear when something is wrong. This first iteration is
          <strong style="color:#e6e6e4;font-weight:600;"
            >acknowledgment-only</strong
          >: we credit researchers who report responsibly. There is no monetary
          bounty yet.
        </p>

        <!-- HOW TO REPORT -->
        <div class="sec-cols" style="margin-top:42px;display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <a
            href="https://github.com/myne-md/myne/security/advisories/new"
            rel="noopener"
            style={`${cardStyle}text-decoration:none;display:block;`}
          >
            <div class="mono up" style="font-size:10px;color:#54544f;">Preferred</div>
            <div style="margin-top:9px;font-size:17px;font-weight:600;color:#e6e6e4;">
              GitHub security advisory
            </div>
            <p style="margin-top:10px;font-size:12.5px;line-height:1.6;color:#8a8a86;">
              Report privately through GitHub's coordinated-disclosure flow — it
              stays confidential until a fix ships.
            </p>
            <div class="mono" style="margin-top:14px;font-size:12px;color:#8aa4d0;">
              github.com/myne-md/myne · Security → Report →
            </div>
          </a>
          <div style={cardStyle}>
            <div class="mono up" style="font-size:10px;color:#54544f;">Or email</div>
            <div class="mono" style="margin-top:9px;font-size:16px;font-weight:600;color:#e6e6e4;">
              security@myne.md
            </div>
            <p style="margin-top:10px;font-size:12.5px;line-height:1.6;color:#8a8a86;">
              For anything that doesn't fit a GitHub advisory. Encrypt if you can;
              include steps to reproduce and the affected version.
            </p>
            <div class="mono" style="margin-top:14px;font-size:11px;color:#54544f;">
              /.well-known/security.txt
            </div>
          </div>
        </div>

        <!-- SCOPE -->
        <div class="sec-cols" style="margin-top:48px;display:grid;grid-template-columns:1fr 1fr;gap:40px;">
          <div>
            <div class="mono up" style={eyebrow}>In scope</div>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;">
              {
                inScope.map((s) => (
                  <li style="position:relative;padding-left:20px;font-size:13.5px;line-height:1.6;color:#c4c4c0;">
                    <span style="position:absolute;left:2px;top:9px;width:5px;height:5px;border-radius:50%;background:#7fb89a;" />
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <div class="mono up" style={eyebrow}>Out of scope</div>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;">
              {
                outScope.map((s) => (
                  <li style="position:relative;padding-left:20px;font-size:13.5px;line-height:1.6;color:#8a8a86;">
                    <span style="position:absolute;left:2px;top:9px;width:5px;height:5px;border-radius:50%;background:#54544f;" />
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- WHAT TO EXPECT -->
        <div style="margin-top:48px;">
          <div class="mono up" style={eyebrow}>What to expect</div>
          <h2 style={h2}>Coordinated, credited, and honest about limits.</h2>
          <p style={lead}>
            We acknowledge reports as fast as a two-person team can, work a fix
            under coordinated disclosure, and credit you in the release notes
            unless you'd rather stay anonymous. Where the threat model already
            says we don't defend something — active malware, a nation-state
            adversary, coercion — we'll say so plainly rather than pretend
            otherwise. The
            <a href="/spec/" style="color:#8aa4d0;text-decoration:none;">protocol spec</a>
            and
            <a href="/spec/#threats" style="color:#8aa4d0;text-decoration:none;"
              >threat model</a
            > are the contract.
          </p>
        </div>
      </div>
    </section>

    <footer style="border-top:1px solid rgba(255,255,255,0.1);padding:36px 28px;">
      <div
        class="mono up"
        style="max-width:820px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:10px;color:#54544f;"
      >
        <span>© 2026 Myne · AGPL-3.0 · CC-BY-4.0 docs</span><StatusBadge /><span
          >acknowledgment-only · no bounty yet</span
        >
      </div>
    </footer>
  </div>

  <!-- Mobile: the two-up report cards + in/out-of-scope columns stack so they
       stop getting crushed on phones. Inline grids win, hence !important. -->
  <style is:global>
    @media (max-width: 640px) {
      .sec-cols {
        grid-template-columns: 1fr !important;
        gap: 24px !important;
      }
    }
  </style>
</LandingLayout>
