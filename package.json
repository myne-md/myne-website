{
  "name": "myne-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --test src/lib/*.test.mjs src/lib/themeBuilder/*.test.mjs scripts/*.test.mjs",
    "sync-themes": "node scripts/sync-themes.mjs",
    "sync-preview": "node scripts/sync-preview.mjs",
    "validate-sidebar": "node scripts/validate-sidebar.mjs",
    "build": "node scripts/validate-sidebar.mjs && node scripts/validate-release.mjs && astro build && node scripts/validate-draft-notice.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "^6.1.9",
    "markdown-it": "^14.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/markdown-it": "^14.1.2",
    "satori": "^0.26.0",
    "sharp": "0.34.5",
    "typescript": "~5.8.3"
  }
}
