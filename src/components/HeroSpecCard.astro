---
---

<aside class="card" aria-label="Protocol summary">
  <div class="titlebar">
    <span class="title">myne-protocol-v0.1 — summary</span>
  </div>
  <pre class="body">
<span class="k">protocol         </span>= myne-protocol-v0.1
<span class="k">kdf              </span>= Argon2id (m=256 MiB, t=3, p=2, v=1.3)
<span class="k">aead             </span>= XChaCha20-Poly1305 + CTX commitment
<span class="k">subkey-derivation</span>= HKDF-SHA-256 (libsodium)
<span class="k">recovery         </span>= BIP-39 24-word &rarr; Argon2id
<span class="k">account-number   </span>= <span id="hero-acct" class="acct-live" aria-label="Live demo account number — click to regenerate">MY‑XXXX‑XXXX‑XXXX‑XXXX‑XXXX</span> <span class="hint">click to reroll</span>
<span class="k">aad-prefix       </span>= "myne.v0.1|"
<span class="k">on-disk-magic    </span>= MY01 (note blob), MYV1 (vault.meta)
<span class="k">library          </span>= libsodium (RustCrypto fallback)
<span class="k">audit-status     </span>= unaudited (pre-alpha)</pre>
  <div class="foot">
    <a href="#specs" class="link">
      See the full specs
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  </div>
</aside>

<script>
  import { mountAccountNumber } from "../scripts/account-number";
  const el = document.getElementById("hero-acct");
  if (el) mountAccountNumber(el);
</script>

<style>
  .card {
    background: var(--paper-2);
    border: 1px solid var(--line-1);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(11, 11, 9, 0.04),
      0 8px 24px rgba(11, 11, 9, 0.06);
  }
  .titlebar {
    padding: 10px 16px;
    border-bottom: 1px solid var(--line-1);
    background: var(--paper-3);
  }
  .title {
    font-size: 12px;
    color: var(--fg-3);
    font-family: var(--font-mono);
    font-feature-settings: "ss02", "zero";
  }
  .body {
    margin: 0;
    padding: 28px 32px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.85;
    color: var(--fg-1);
    font-feature-settings: "ss02", "zero", "calt";
    background: var(--bg-1);
    overflow-x: auto;
  }
  .body .k {
    color: var(--fg-3);
  }
  .body .acct-live {
    color: var(--accent);
    user-select: all;
    transition: color 120ms var(--ease-standard);
    border-bottom: 1px dashed transparent;
  }
  .body .acct-live:hover {
    border-bottom-color: var(--accent);
  }
  .body .hint {
    color: var(--fg-3);
    font-size: 11px;
    margin-left: 6px;
    opacity: 0;
    transition: opacity 180ms var(--ease-standard);
  }
  .body:hover .hint { opacity: 1; }
  .foot {
    padding: 14px 16px;
    border-top: 1px solid var(--line-1);
    background: var(--paper-3);
    display: flex;
    justify-content: flex-end;
  }
  .link {
    color: var(--accent);
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .link:hover { text-decoration: underline; }

  @media (max-width: 920px) {
    .body { font-size: 12px; padding: 20px; }
  }
</style>
