---
/*
 * Shared glassy top bar so the landing and the user guide carry an identical
 * navbar. Anchors are absolute (/#…) so the section links also work from the
 * user-guide routes (they navigate to the landing and scroll). Relies on the
 * .up / .mono helper classes provided by LandingLayout, which wraps both.
 */
interface Props {
  /** Highlighted nav entry. */
  active?:
    | "home"
    | "work"
    | "method"
    | "commit"
    | "guide"
    | "roadmap"
    | "ledger"
    | "download"
    | "spec"
    | "security"
    | "releases";
}
const { active = "home" } = Astro.props;

const links = [
  { key: "home", label: "Home", href: "/#top" },
  { key: "work", label: "How it works", href: "/#work" },
  { key: "method", label: "Compare", href: "/#capab" },
  { key: "commit", label: "FAQ", href: "/#commit" },
  { key: "guide", label: "Guide", href: "/user-guide/" },
  { key: "roadmap", label: "Roadmap", href: "/roadmap/" },
  { key: "ledger", label: "Ledger", href: "/ledger/" },
] as const;
---

<header
  style="position:fixed;top:0;left:0;right:0;z-index:80;display:flex;align-items:center;justify-content:space-between;padding:18px 28px;background:rgba(10,10,10,0.18);backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);"
>
  <a
    href="/#top"
    style="display:flex;align-items:center;gap:9px;text-decoration:none;color:#e6e6e4;"
  >
    <svg width="18" height="18" viewBox="0 0 32 32" fill="none"
      ><path
        d="M8 22 V10 L16 18 L24 10 V22"
        stroke="#e6e6e4"
        stroke-width="2.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
    <span style="font-size:15px;font-weight:600;letter-spacing:-0.01em;">Myne</span>
  </a>
  <nav class="up" style="display:flex;gap:22px;font-size:10.5px;color:#8a8a86;">
    {
      links.map((l) => (
        <a
          href={l.href}
          style={`color:${active === l.key ? "#e6e6e4" : "inherit"};text-decoration:none;`}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
  <div
    class="mono"
    style="display:flex;align-items:center;gap:18px;font-size:10.5px;color:#8a8a86;"
  >
    <a
      href="/download/"
      class="up"
      style="color:#e6e6e4;text-decoration:none;border:1px solid rgba(255,255,255,0.2);border-radius:5px;padding:7px 13px;font-size:10px;"
      >Download</a
    >
  </div>
</header>
