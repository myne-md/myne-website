---
// PRD Open Q2 (resolved): code-side uses canonical Lucide v0.x icons via
// `<Icon>`; Penpot library substitutes (arrow-right / file-text / download
// / code) are accepted as a design-side abstraction.

import type { CategoryEntry } from "../../lib/userGuide";
import Icon from "../Icon.astro";

interface Props {
  category: CategoryEntry;
}
const { category } = Astro.props;

const ICONS = {
  "getting-started": "play",
  "daily-use": "book-open",
  recovery: "key-round",
  "backup-restore": "archive",
  "settings-privacy": "settings",
  "self-host": "server",
} as const;

const isSelfHost = category.slug === "self-host";
const articleCount = category.articles.length;
const countLabel = isSelfHost
  ? "Phase 2 — coming later"
  : `${articleCount} ${articleCount === 1 ? "article" : "articles"}`;
const iconName = ICONS[category.slug as keyof typeof ICONS];
---

<a class="ug-card" href={`/user-guide/${category.slug}/`}>
  <div class="ug-card__header">
    <span
      class:list={["ug-card__icon", { "ug-card__icon--faded": isSelfHost }]}
      aria-hidden="true"
    >
      {iconName && <Icon name={iconName} />}
    </span>
    <span class="ug-card__title">{category.label}</span>
  </div>
  <p class="ug-card__description">{category.description}</p>
  <p class="ug-card__count">{countLabel}</p>
</a>
