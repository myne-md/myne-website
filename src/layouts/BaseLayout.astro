---
import "../styles/tokens.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SubscribeDialog from "../components/SubscribeDialog.astro";

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL for this page. */
  canonical?: string;
  /** og:type — defaults to website; permalink pages pass "article". */
  ogType?: "website" | "article";
  /** Absolute og:image URL — falls back to nothing if absent. */
  ogImage?: string;
  /** Robots directive (e.g. "noindex,nofollow"). Omit to leave the header unset. */
  robots?: string;
  /** Render the site footer. Defaults to true; the user guide opts out. */
  showFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = "website",
  ogImage,
  robots,
  showFooter = true,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site!).toString();
---

<!--
                    o      o
   888b     d888  o    o    o
   8888b   d8888    o    o
   88888b.d88888  o    o    o
   888 888P 888                     myne-protocol-v0.1
   888  Y8P  888                    encrypted markdown notes
   888   "   888                    no email at signup
   888       888                    your account is a number
                                    you keep, not an email we keep

   Hi. If you're reading this, you're our kind of person.
   Specs, threat model, and source go public when Phase 1 ships.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {robots && <meta name="robots" content={robots} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Myne ledger"
      href="/ledger/rss.xml"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <Nav pathname={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <SubscribeDialog />
  </body>
</html>
