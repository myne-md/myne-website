---
import type { MarkdownHeading } from "astro";
import UserGuideShellLayout from "./UserGuideShellLayout.astro";
import TodoBanner from "../components/userguide/TodoBanner.astro";
import TocRail from "../components/userguide/TocRail.astro";
import PrevNextBlock from "../components/userguide/PrevNextBlock.astro";
import RecommendedBlock from "../components/userguide/RecommendedBlock.astro";
import {
  getCategoryLabel,
  type PrevNextResult,
  type RecommendedItem,
} from "../lib/userGuide";
import "../styles/ledger.css";

interface Props {
  title: string;
  summary: string;
  category: string;
  slug: string;
  updated: Date;
  canonical?: string;
  headings: MarkdownHeading[];
  prevNext: PrevNextResult | null;
  recommended: readonly RecommendedItem[];
}

const {
  title,
  summary,
  category,
  slug,
  updated,
  canonical,
  headings,
  prevNext,
  recommended,
} = Astro.props;

const updatedLabel = updated.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const categoryLabel = getCategoryLabel(category) ?? category;
---

<UserGuideShellLayout
  title={`${title} — ${categoryLabel} — Myne user guide`}
  description={summary}
  canonical={canonical}
  currentCategory={category}
  currentSlug={slug}
  currentArticleTitle={title}
>
  <TocRail slot="rightRail" headings={headings} variant="desktop" />

  <TodoBanner />

  <header class="ug-article-header">
    <a class="ug-article-back" href="/user-guide/">
      <span class="arrow" aria-hidden="true">←</span>
      Back to user guide
    </a>
    <h1 class="ug-h1">{title}</h1>
    <p class="ug-article-updated">Updated {updatedLabel}</p>
  </header>

  <TocRail headings={headings} variant="mobile" />

  <article class="ledger-prose">
    <slot />
  </article>

  <RecommendedBlock items={recommended} />

  <PrevNextBlock result={prevNext} />
</UserGuideShellLayout>
