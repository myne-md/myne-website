<script>
  // Mobile Edit/Preview toggle (builder-shell-entry task 5). Height-locked: it
  // swaps which pane is visible; the page never scrolls. On desktop the .tb-seg
  // control is display:none, so this listener simply never fires above 920px.
  const seg = document.querySelector(".tb-seg");
  const panes = document.querySelector(".tb-panes");
  if (seg && panes) {
    seg.addEventListener("click", (e) => {
      const target = e.target;
      const btn = target instanceof Element ? target.closest("[data-tb-pane]") : null;
      const pane = btn?.getAttribute("data-tb-pane");
      if (!pane) return;
      panes.setAttribute("data-mobile-pane", pane);
      seg.querySelectorAll("[data-tb-pane]").forEach((b) => {
        const on = b === btn;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
    });
  }
</script>

<script>
  // Controls (builder-controls): wire native color pickers ↔ the shared singleton
  // state, and the "Start from" preset picker + reset. Every edit and preset load
  // flows through appState so preview (slice 3) and export (slice 4) see it live.
  import { appState } from "../../scripts/themeBuilderApp";
  import { LIGHT_DEFAULTS, DARK_DEFAULTS } from "../../lib/themeBuilder/tokens.mjs";
  import { helpersForBase } from "../../lib/themeBuilder/derive.mjs";
  import { createColorPicker } from "../../lib/themeBuilder/colorPicker.mjs";
  import themesFull from "../../data/themes-full.json";

  const palettes = themesFull as Record<string, Record<string, string>>;
  const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>(".tb-ctl"));
  const darkNote = document.getElementById("tb-dark-note");

  // Editing a base color also auto-fills its helper shades (overridable — a manual
  // fine-tune edit sticks until the base changes again).
  function applyColor(token: string, hex: string): void {
    const helpers = helpersForBase(token, hex, appState.isDark());
    if (Object.keys(helpers).length) appState.patch({ [token]: hex, ...helpers });
    else appState.set(token, hex);
  }

  // Custom on-register color picker (replaces the native OS dialog). Clicking a
  // swatch opens it anchored to that swatch; every drag/type flows into state live.
  let activeToken: string | null = null;
  const picker = createColorPicker({
    onChange: (hex) => {
      if (activeToken) applyColor(activeToken, hex);
    },
  });
  for (const sw of swatches) {
    sw.addEventListener("click", () => {
      const token = sw.dataset.token;
      if (!token) return;
      activeToken = token;
      picker.open(sw, appState.get(token) ?? "#000000");
    });
  }

  // state → swatch backgrounds (preset loads, live edits) + dark-note visibility.
  // Cache each swatch dot once so repaints don't re-query the DOM per change.
  const swatchDots = swatches.map((sw) => ({
    token: sw.dataset.token,
    dot: sw.querySelector<HTMLElement>(".tb-ctl-swatch"),
  }));
  function paintSwatches(palette: Record<string, string>): void {
    for (const { token, dot } of swatchDots) {
      if (token && dot && palette[token]) dot.style.background = palette[token];
    }
  }
  appState.subscribe((snap) => {
    paintSwatches(snap.palette);
    if (darkNote) darkNote.hidden = !snap.isDark;
  });
  paintSwatches(appState.getPalette());

  // presets
  const select = document.getElementById("tb-preset-select") as HTMLSelectElement | null;
  const resetBtn = document.getElementById("tb-reset");

  const isDarkFor = (value: string): boolean =>
    value === "dark" ||
    (select?.selectedOptions[0]?.dataset.dark === "true");

  function loadPreset(value: string): void {
    picker.close();
    const dark = isDarkFor(value);
    if (value === "light") appState.replace({ ...LIGHT_DEFAULTS }, false);
    else if (value === "dark") appState.replace({ ...DARK_DEFAULTS }, true);
    else if (value.startsWith("theme:")) {
      const palette = palettes[value.slice("theme:".length)];
      if (palette) {
        // Merge over the appearance-correct base (LIGHT/DARK_DEFAULTS each carry all
        // 44 tokens) so every token — including optionals — is set; a dark theme's
        // optionals come from the dark canon, never a LIGHT fallback (SYNC-6).
        const base = dark ? DARK_DEFAULTS : LIGHT_DEFAULTS;
        appState.replace({ ...base, ...palette }, dark);
      }
    }
  }

  select?.addEventListener("change", () => loadPreset(select.value));
  resetBtn?.addEventListener("click", () => loadPreset(select?.value ?? "light"));
</script>

<script>
  // Live preview (builder-preview): apply the shared palette to the scoped
  // preview wrapper via gated CSSOM setProperty (SYNC-4 — the ONLY browser
  // injection gate; the site has no CSP). Never string-concat into a <style>.
  import { appState } from "../../scripts/themeBuilderApp";
  import { applyTheme } from "../../lib/themeBuilder/applyPreview.mjs";
  import { contrastReport } from "../../lib/themeBuilder/validator.mjs";
  import { isDarkBackground } from "../../lib/themeBuilder/syntaxTheme.mjs";

  const pvRoot = document.getElementById("tb-pv-root");
  const readability = document.getElementById("tb-readability");

  // Plain-word names for the 5 canonical CONTRAST_RULES pairs.
  const REGION_NAMES: Record<string, string> = {
    "--ink-0|--paper": "Headings",
    "--ink-1|--paper": "Body text",
    "--ink-1|--paper-2": "Text on panels",
    "--ink-2|--paper": "Secondary text",
    "--accent|--paper": "Accent",
  };

  function updateReadability(palette: Record<string, string>): void {
    if (!readability) return;
    const report = contrastReport(palette);
    readability.replaceChildren();
    if (report.failures.length === 0) {
      readability.hidden = true;
      return;
    }
    readability.hidden = false;
    const label = document.createElement("span");
    label.className = "tb-readability-label";
    label.textContent = "Low contrast:";
    readability.append(label);
    for (const f of report.failures) {
      const chip = document.createElement("span");
      chip.className = "tb-readability-chip";
      chip.textContent = REGION_NAMES[`${f.fg}|${f.bg}`] ?? f.label;
      readability.append(chip);
    }
  }

  if (pvRoot) {
    const apply = (snap: { palette: Record<string, string> }) => {
      applyTheme(pvRoot.style, snap.palette);
      updateReadability(snap.palette);
      // Expose the preview's effective appearance (SYNC-8 — export reads it).
      pvRoot.dataset.appearance = isDarkBackground(snap.palette["--paper"]) ? "dark" : "light";
    };
    apply(appState.snapshot());
    appState.subscribe(apply);
  }
</script>

<script>
  // Export (builder-export): the submit modal. Single primary action (Download) +
  // one supporting affordance (Share) — fits the 2026-05-03 website modal carve-out.
  import { appState } from "../../scripts/themeBuilderApp";
  import { canExport, buildThemeJson, buildMetaJson } from "../../lib/themeBuilder/serialize.mjs";
  import { contrastReport } from "../../lib/themeBuilder/validator.mjs";
  import { downloadFile } from "../../lib/themeBuilder/download.mjs";
  import { slugify, slugCollides, isShareableSlug } from "../../lib/themeBuilder/slug.mjs";
  import { buildShareUrl } from "../../lib/themeBuilder/shareUrl.mjs";
  import themesIndex from "../../data/themes-index.json";

  const existingSlugs = (themesIndex.themes ?? []).map((t) => t.slug);

  const modal = document.getElementById("tb-export-modal") as HTMLDialogElement | null;
  const openBtn = document.getElementById("tb-export-btn");
  const downloadBtn = document.getElementById("tb-download") as HTMLButtonElement | null;
  const shareLink = document.getElementById("tb-share");
  const statusEl = document.getElementById("tb-export-status");
  const nameInput = document.getElementById("tb-meta-name") as HTMLInputElement | null;
  const authorInput = document.getElementById("tb-meta-author") as HTMLInputElement | null;
  const descInput = document.getElementById("tb-meta-desc") as HTMLTextAreaElement | null;
  const pvRoot = document.getElementById("tb-pv-root");

  const readMeta = () => ({
    name: nameInput?.value ?? "",
    author: authorInput?.value ?? "",
    description: descInput?.value ?? "",
  });
  const currentAppearance = (): "light" | "dark" =>
    pvRoot?.dataset.appearance === "dark" ? "dark" : "light";

  function refreshExportState(): boolean {
    const palette = appState.getPalette();
    const meta = readMeta();
    const gate = canExport(palette);
    const named = meta.name.trim() !== "";
    const slug = slugify(meta.name);
    const contrast = contrastReport(palette);
    const ready = gate.ok && named;
    // Sharing needs an ascii slug; a non-Latin/emoji name folds to "" (which would
    // yield a `themes//` folder and slip past the collision guard). Download is not
    // gated on the slug — theme.json is palette-only and its filename is fixed.
    const shareReady = ready && isShareableSlug(slug);

    if (statusEl) {
      if (!gate.ok) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-error";
        statusEl.textContent = `Set every color first — ${gate.missing.length} still unset.`;
      } else if (!named) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent = "Give your theme a name to download or share it.";
      } else if (!isShareableSlug(slug)) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent = "Add Latin letters or numbers to the name to share to the gallery — you can still download.";
      } else if (slugCollides(slug, existingSlugs)) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent = "A gallery theme with this name already exists — rename it before sharing.";
      } else if (!contrast.ok) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent = `Heads up: ${contrast.failures.length} low-contrast pair(s). You can still export.`;
      } else {
        statusEl.hidden = true;
      }
    }

    if (downloadBtn) downloadBtn.disabled = !ready;
    if (shareLink) {
      shareLink.setAttribute("aria-disabled", shareReady ? "false" : "true");
      if (shareReady) {
        const appearance = currentAppearance();
        (shareLink as HTMLAnchorElement).href = buildShareUrl({
          slug,
          name: meta.name.trim(),
          author: meta.author.trim(),
          description: meta.description.trim(),
          appearance,
          themeJson: JSON.stringify(buildThemeJson(palette), null, 2),
          metaJson: JSON.stringify(buildMetaJson(meta, appearance), null, 2),
        });
      } else {
        (shareLink as HTMLAnchorElement).href = "#";
      }
    }
    return ready;
  }

  openBtn?.addEventListener("click", () => {
    refreshExportState();
    modal?.showModal();
  });

  // dismiss — × button, backdrop click (Esc is native to <dialog>).
  modal?.querySelector("[data-tb-close]")?.addEventListener("click", () => modal.close());
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });

  // Re-gate as the user types the metadata. No palette subscription: the color
  // controls sit behind the modal's backdrop while it's open, so the palette
  // can't change here — the open-click + these input handlers cover every case.
  for (const el of [nameInput, authorInput, descInput]) {
    el?.addEventListener("input", refreshExportState);
  }

  // Download: two import-ready files (theme.json + meta.json), no zip.
  downloadBtn?.addEventListener("click", () => {
    if (!refreshExportState()) return;
    const palette = appState.getPalette();
    const appearance = currentAppearance();
    downloadFile("theme.json", JSON.stringify(buildThemeJson(palette), null, 2));
    downloadFile("meta.json", JSON.stringify(buildMetaJson(readMeta(), appearance), null, 2));
  });
</script>
