---
/*
 * /press — facts, boilerplate, stills, brand assets and a contact, for anyone
 * writing about Myne.
 *
 * ── Why this page exists, and why it is a page rather than a folder ────────
 *
 * A writer who has to ask for a description, a logo and a current version will
 * get the description wrong or use a screenshot of an old build, and both of
 * those outlive the release they came from. So the same three things are here,
 * ready to take: copy that can be pasted, stills that are the real product, and
 * marks with the terms attached.
 *
 * ── The one rule this page is built under ─────────────────────────────────
 *
 * Nothing on it may claim more than `docs/threat-model.md` (myne-website's
 * AGENTS.md, "Marketing copy discipline"). That is why there is no user count,
 * no growth curve and no "military-grade": the facts here are the licence, the
 * date of the first release, the platforms a build exists for, and the versions
 * the archive already lists. Everything else is a link to the artefact.
 *
 * ── The brand assets are a deliberate copy ────────────────────────────────
 *
 * `myne-branding` is private, so a press page that linked to it would hand a
 * journalist a 404. The four files under `public/brand/` are therefore copied
 * from `myne-branding@{logo,app-icon,social-press}` and are the published copy:
 * when the marks change there, they change here in the same commit. The usage
 * terms are the summary of that repository's `TRADEMARK.md`, written out because
 * the source document is not readable by the people this page is for.
 */
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteOg } from "../lib/og";

const title = "Press — Myne";
const description =
  "Descriptions of Myne ready to copy, the facts at a glance, milestones, stills of the real product, brand assets with their usage terms, and press@myne.md.";
const canonical = new URL("/press/", Astro.site!).toString();
const ogImage = absoluteOg("press", Astro.site!);

/* Copyable boilerplate. Three lengths, because three is what a writer asks for:
   a line for a caption, a paragraph for a summary box, and the full one for the
   body of an article. */
const BOILERPLATE = [
  {
    id: "oneline",
    label: "One line",
    text: "Myne is a local-first, end-to-end encrypted notes app: your notes are sealed on your device, and sync moves ciphertext the server cannot read.",
  },
  {
    id: "short",
    label: "Short",
    text: "Myne is a local-first, end-to-end encrypted notes app for macOS, Windows, Linux, iOS and the browser. Notes, attachments and their search index are encrypted on your device with a key only your password or recovery phrase carries; the sync server stores and relays ciphertext it has no key for. It is open source, and the sync server is available to run on a machine you control.",
  },
  {
    id: "long",
    label: "Long",
    text: "Myne is a local-first, end-to-end encrypted notes app for macOS, Windows, Linux, iOS and the browser. A vault is a folder of ordinary files whose contents are sealed one note at a time, so the app can search, edit and sync without any of it being readable to anyone who does not hold the key. That key comes from a password or a recovery phrase and never leaves the device; the sync server stores blobs it cannot open and passes them between your devices. Shared vaults extend the same design: a member's access is a key wrapped to their own person key, so removing someone is a key change rather than a promise. The app is open source under AGPL-3.0-only-only, the specifications are published under CC-BY-4.0 so an independent client can be written from them, and the sync server can be self-hosted. Myne is in alpha.",
  },
];

/* The stills the site already ships for its own pages. `-light` twins are the
   same capture in the light theme; both are offered because a writer picking
   artwork needs the one that matches their layout, not the one we liked. */
const STILLS = [
  { name: "desktop", label: "Desktop · editor and sidebar", note: "1440×900 · dark and light" },
  { name: "phone", label: "Phone · notes list and editor", note: "390×844 · dark and light" },
  { name: "p-encryption", label: "Encryption", note: "detail · dark and light" },
  { name: "p-markdown", label: "Markdown editing", note: "detail · dark and light" },
  { name: "p-search", label: "Search", note: "detail · dark and light" },
  { name: "p-graph", label: "Link graph", note: "detail · dark and light" },
  { name: "p-agents", label: "Local AI", note: "detail · dark and light" },
  { name: "p-collaboration", label: "Shared vault", note: "detail · dark and light" },
  { name: "p-portable", label: "Portable vault", note: "detail · dark and light" },
];

const BRAND = [
  { href: "/brand/myne-mark.svg", label: "The mark", note: "SVG · the “M” on its dark card" },
  { href: "/brand/myne-wordmark.svg", label: "The wordmark", note: "SVG · mark and “Myne”" },
  { href: "/brand/myne-app-icon-1024.png", label: "App icon", note: "PNG · 1024×1024" },
  { href: "/brand/myne-field.webp", label: "Banner", note: "WebP · the app on a laptop" },
];

/* Dated facts a reader can check against the tagged source. The first two are
   history and are written down; the third is the current source version. */
const MILESTONES = [
  { date: "1 August 2026", what: "v0.1.0, the first public release." },
  {
    date: "3 October 2026",
    what:
      "From v0.9.0 every release ships a minisign-signed SHA256SUMS, and this site publishes the same hashes from a separate machine and a separate deploy chain, so the two can be compared.",
  },
  { date: "3 November 2026", what: "v0.12.0, the first release cut on the beta channel." },
];

const cardStyle =
  "border:1px solid rgb(var(--line-rgb) / 0.12);border-radius:12px;padding:20px;background:var(--paper-2);";
const eyebrow = "font-size:11px;color:var(--accent);margin-bottom:12px;";
const h2 =
  "font-size:clamp(20px,2.4vw,28px);font-weight:700;letter-spacing:-0.02em;line-height:1.1;";
const body =
  "margin-top:12px;font-size:14px;line-height:1.7;color:var(--ink-3);";
const sectionStyle = "padding:44px var(--gutter);border-top:1px solid rgb(var(--line-rgb) / 0.12);";
const mono = "font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;";
---

<LandingLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <div
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:var(--ink-1);background:var(--paper);min-height:100vh;"
  >
    <GlassNav active="press" />

    <!-- ===================== HERO ===================== -->
    <section id="top" style="padding:var(--page-top) var(--gutter) 40px;">
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Press</div>
        <h1
          style="font-size:clamp(34px,5vw,58px);line-height:1.0;font-weight:700;letter-spacing:-0.035em;"
        >
          What to call it, and what to
          <br />put next to your words.
        </h1>
        <p style="margin-top:22px;max-width:66ch;font-size:16px;line-height:1.65;color:var(--ink-3);">
          Descriptions you can copy, the facts at a glance, stills of the real
          product, and the marks with their terms. Everything here is either
          dated or checkable against the tagged source in the repository.
        </p>
        <p style="margin-top:14px;font-size:13px;line-height:1.7;color:var(--ink-4);">
          Writing about it and want to check a claim first? Mail
          <a href="mailto:press@myne.md" style="color:var(--accent);text-decoration:none;">press@myne.md</a>.
        </p>
      </div>
    </section>

    <!-- ===================== BOILERPLATE ===================== -->
    <section id="boilerplate" style={sectionStyle}>
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Boilerplate</div>
        <h2 style={h2}>Three lengths.</h2>
        <p style={body}>
          Copy the one that fits. The long version states what the product does
          and what it does not claim; if you shorten it yourself, keep the
          distinction between "encrypted on your device" and "the server cannot
          read it", because the second is a consequence of the first and not a
          separate feature.
        </p>

        <div style="margin-top:22px;display:flex;flex-direction:column;gap:12px;">
          {
            BOILERPLATE.map((entry) => (
              <div style={cardStyle} data-boilerplate={entry.id}>
                <div style="display:flex;align-items:center;gap:12px;">
                  <span class="mono up" style={`${mono}color:var(--ink-4);`}>{entry.label}</span>
                  <button
                    type="button"
                    class="press-copy mono up"
                    data-copy={entry.text}
                    aria-describedby={`copy-note-${entry.id}`}
                    style="margin-inline-start:auto;background:transparent;border:1px solid rgb(var(--line-rgb) / 0.25);border-radius:999px;padding:5px 12px;color:var(--accent);cursor:pointer;"
                  >
                    Copy
                  </button>
                </div>
                <p style="margin-top:10px;font-size:14px;line-height:1.7;color:var(--ink-2);">
                  {entry.text}
                </p>
                <span id={`copy-note-${entry.id}`} class="press-copy-status" aria-live="polite"></span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===================== AT A GLANCE ===================== -->
    <section id="facts" style={sectionStyle}>
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>At a glance</div>
        <h2 style={h2}>The facts, with nothing behind them.</h2>
        <dl class="press-facts" style="margin-top:22px;display:grid;grid-template-columns:10ch 1fr;gap:10px 18px;font-size:14px;line-height:1.6;">
          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>Product</dt>
          <dd style="margin:0;color:var(--ink-2);">A local-first, end-to-end encrypted notes app.</dd>

          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>Platforms</dt>
          <dd style="margin:0;color:var(--ink-2);">
            macOS 11 or later (Apple Silicon), Windows 10 or later (x86_64), Linux
            (x86_64 and arm64), iOS, Android, and a browser client.
          </dd>

          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>Licence</dt>
          <dd style="margin:0;color:var(--ink-2);">
            AGPL-3.0-only-only for the application, CC-BY-4.0 for the specifications, so an
            independent client can be built from them.
          </dd>

          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>Status</dt>
          <dd style="margin:0;color:var(--ink-2);">Alpha. Expect rough edges.</dd>

          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>First release</dt>
          <dd style="margin:0;color:var(--ink-2);">1 August 2026 (v0.1.0).</dd>

          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>Current</dt>
          <dd style="margin:0;color:var(--ink-2);">
            v0.19.0, tagged in the source repository.
          </dd>

          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>Self-hosting</dt>
          <dd style="margin:0;color:var(--ink-2);">
            The sync server is open source and runs on a machine you control; the
            vault is a folder of files, so leaving with your notes is copying it.
          </dd>

          <dt class="mono up" style={`${mono}color:var(--ink-4);`}>Contact</dt>
          <dd style="margin:0;color:var(--ink-2);">
            <a href="mailto:press@myne.md" style="color:var(--accent);text-decoration:none;">press@myne.md</a>
            for press, <a href="/security/" style="color:var(--accent);text-decoration:none;">security@myne.md</a> for vulnerabilities.
          </dd>
        </dl>
      </div>
    </section>

    <!-- ===================== MILESTONES ===================== -->
    <section id="milestones" style={sectionStyle}>
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Milestones</div>
        <h2 style={h2}>Three dates worth knowing.</h2>
        <ul style="margin-top:22px;list-style:none;padding:0;display:flex;flex-direction:column;gap:14px;">
          {MILESTONES.map((m) => (
            <li style="display:grid;grid-template-columns:16ch 1fr;gap:18px;font-size:14px;line-height:1.65;">
              <span class="mono" style="color:var(--ink-4);font-size:11px;">{m.date}</span>
              <span style="color:var(--ink-2);">{m.what}</span>
            </li>
          ))}
          <li style="display:grid;grid-template-columns:16ch 1fr;gap:18px;font-size:14px;line-height:1.65;">
            <span class="mono" style="color:var(--ink-4);font-size:11px;">source-only</span>
            <span style="color:var(--ink-2);">
              v0.19.0 is the current source release. Build it from the tagged
              tree; no installers are published.
            </span>
          </li>
        </ul>
      </div>
    </section>

    <!-- ===================== MEDIA ===================== -->
    <section id="media" style={sectionStyle}>
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Media</div>
        <h2 style={h2}>Stills of the real product.</h2>
        <p style={body}>
          Captured from the running app, not mocked up. Every still is available
          in the dark and the light theme, so pick the one your layout needs.
          Nothing here is licensed separately: use them to write about Myne.
        </p>
        <div class="press-media" style="margin-top:22px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;">
          {STILLS.map((still) => (
            <div style={cardStyle}>
              <img
                src={`/app/${still.name}.webp`}
                alt={still.label}
                loading="lazy"
                style="width:100%;height:auto;border-radius:8px;border:1px solid rgb(var(--line-rgb) / 0.12);"
              />
              <div style="margin-top:12px;font-size:13px;font-weight:600;color:var(--ink-1);">{still.label}</div>
              <div class="mono" style="margin-top:4px;font-size:10px;color:var(--ink-4);">{still.note}</div>
              <div style="margin-top:10px;display:flex;gap:14px;">
                <a class="mono up" href={`/app/${still.name}.webp`} style="font-size:9.5px;color:var(--accent);text-decoration:none;">dark ↓</a>
                <a class="mono up" href={`/app/${still.name}-light.webp`} style="font-size:9.5px;color:var(--accent);text-decoration:none;">light ↓</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== BRAND ===================== -->
    <section id="brand" style={sectionStyle}>
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Brand</div>
        <h2 style={h2}>The marks, and how to use them.</h2>
        <p style={body}>
          The name, the “M” mark, the wordmark and the app icon identify the
          project. The code is open source and the specifications are open, but
          the marks are not covered by either licence: they are asserted as
          trademarks through use, and the terms below are what keeps them meaning
          one thing.
        </p>

        <div class="press-brand" style="margin-top:22px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;">
          {BRAND.map((asset) => (
            <a href={asset.href} style={`${cardStyle}display:block;text-decoration:none;`}>
              <div style="font-size:14px;font-weight:600;color:var(--ink-1);">{asset.label}</div>
              <div class="mono" style="margin-top:6px;font-size:10px;color:var(--ink-4);">{asset.note}</div>
              <div class="mono up" style="margin-top:12px;font-size:9.5px;color:var(--accent);">download ↓</div>
            </a>
          ))}
        </div>

        <div style="margin-top:26px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;">
          <div style={cardStyle}>
            <div class="mono up" style={`${mono}color:var(--ink-4);`}>You may, without asking</div>
            <ul style="margin:12px 0 0;padding-inline-start:18px;font-size:13.5px;line-height:1.7;color:var(--ink-2);">
              <li>Use the marks to refer to Myne, in articles, reviews, tutorials and talks.</li>
              <li>Reproduce a mark unmodified to link to or illustrate the project.</li>
              <li>Show the interface in screenshots of the product.</li>
            </ul>
          </div>
          <div style={cardStyle}>
            <div class="mono up" style={`${mono}color:var(--ink-4);`}>Ask first</div>
            <ul style="margin:12px 0 0;padding-inline-start:18px;font-size:13.5px;line-height:1.7;color:var(--ink-2);">
              <li>Using a mark, or a similar name, for another product, service or domain.</li>
              <li>Implying endorsement or official status that does not exist.</li>
              <li>Presenting a fork as Myne. Redistribute it under its own name and mark.</li>
              <li>Altering a mark, or recolouring it into a different treatment.</li>
            </ul>
          </div>
        </div>
        <p style="margin-top:16px;font-size:12px;line-height:1.7;color:var(--ink-4);">
          These are common-law marks asserted through use; Myne holds no
          registered trademark. Unsure about a use? Ask
          <a href="mailto:press@myne.md" style="color:var(--accent);text-decoration:none;">press@myne.md</a>
          and it is answered before your piece runs, not after.
        </p>
      </div>
    </section>

    <!-- ===================== CONTACT ===================== -->
    <section id="contact" style={sectionStyle}>
      <div style="max-width:820px;margin:0 auto;">
        <div class="mono up" style={eyebrow}>Contact</div>
        <h2 style={h2}>One address.</h2>
        <p style={body}>
          <a href="mailto:press@myne.md" style="color:var(--accent);text-decoration:none;font-size:16px;">press@myne.md</a>
          — for interviews, a claim you want checked, a build you cannot install,
          or a screenshot you would like from a surface that is not here yet.
        </p>
        <p style="margin-top:10px;font-size:13px;line-height:1.7;color:var(--ink-4);">
          Vulnerabilities do not go to that address: report them through
          <a href="/security/" style="color:var(--accent);text-decoration:none;">/security</a>,
          which reaches the same people with the right urgency.
        </p>
      </div>
    </section>

    <SiteFooter />
  </div>
</LandingLayout>

<script>
  // Copy feedback on the control that was pressed: the label swaps and the
  // status line below the text says it out loud for a screen reader. A toast
  // would be a second place to look for a result the button already owns.
  const buttons = document.querySelectorAll<HTMLButtonElement>(".press-copy");

  buttons.forEach((button) => {
    button.addEventListener("click", async () => {
      const text = button.dataset.copy ?? "";
      const status = button
        .closest("[data-boilerplate]")
        ?.querySelector<HTMLElement>(".press-copy-status");
      const original = button.textContent ?? "Copy";
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
        if (status) status.textContent = "Copied to the clipboard.";
      } catch {
        // A refused clipboard (an insecure context, or a denied permission) is
        // the one case where the reader needs to know the copy did not happen:
        // the text is still on the page and selectable.
        button.textContent = "Select it instead";
        if (status) status.textContent = "The clipboard refused the copy. Select the text above.";
      }
      setTimeout(() => {
        button.textContent = original;
        if (status) status.textContent = "";
      }, 2000);
    });
  });
</script>

<style>
  .press-copy-status {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    color: var(--ink-4);
  }
  .press-copy:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 760px) {
    .press-media,
    .press-brand {
      grid-template-columns: minmax(0, 1fr) !important;
    }
    .press-facts {
      grid-template-columns: minmax(0, 1fr) !important;
    }
  }
</style>
