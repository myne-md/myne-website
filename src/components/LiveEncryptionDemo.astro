---
const initialNote = `# Today's note

Met [[Argon2id]] for the first time. The chamber is cool and quiet — 256 MiB of memory, three rounds, two lanes. Nothing leaves until the door closes.`;
---

<aside class="card" aria-label="Live encryption demo">
  <header class="bar">
    <div class="dots">
      <span></span><span></span><span></span>
    </div>
    <span class="title">live encryption · AES-256-GCM</span>
    <span class="status" id="enc-status" aria-live="polite">
      <span class="status-dot"></span>
      <span class="status-label">encrypting</span>
    </span>
  </header>

  <div class="panes">
    <div class="pane plaintext">
      <div class="pane-eyebrow">your note · plaintext</div>
      <textarea id="enc-input" spellcheck="false" autocorrect="off" autocapitalize="off">{initialNote}</textarea>
    </div>
    <div class="pane ciphertext">
      <div class="pane-eyebrow">on disk · ciphertext (hex)</div>
      <div class="cipher" id="enc-cipher" aria-label="Live ciphertext output"></div>
    </div>
  </div>

  <footer class="meta">
    <div class="meta-row">
      <span class="k">iv</span>
      <span class="v" id="enc-iv">—</span>
      <span class="size">12B</span>
    </div>
    <div class="meta-row">
      <span class="k">tag</span>
      <span class="v" id="enc-tag">—</span>
      <span class="size">16B</span>
    </div>
    <div class="meta-row">
      <span class="k">ciphertext</span>
      <span class="v size-only">opaque to the server</span>
      <span class="size" id="enc-size">0B</span>
    </div>
  </footer>

  <p class="caveat">
    Real Web Crypto, ephemeral session key. AES-256-GCM stands in for the
    production XChaCha20-Poly1305 + CTX construction — same authenticated
    encryption principle, slightly different bytes.
  </p>
</aside>

<style>
  .card {
    background: var(--paper-2);
    border: 1px solid var(--line-1);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(11, 11, 9, 0.04),
      0 8px 24px rgba(11, 11, 9, 0.06);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line-1);
    background: var(--paper-3);
  }
  .dots { display: flex; gap: 6px; }
  .dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .title {
    flex: 1;
    text-align: left;
    font-size: 12px;
    color: var(--fg-3);
    font-family: var(--font-mono);
    font-feature-settings: "ss02", "zero";
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-3);
    font-feature-settings: "ss02", "zero";
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-2);
    transition: background 240ms var(--ease-standard);
  }
  .status.active .status-dot { background: var(--accent); }
  .status.active .status-label { color: var(--accent); }

  .panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 320px;
  }
  .pane {
    display: flex;
    flex-direction: column;
    background: var(--bg-1);
  }
  .pane + .pane {
    border-left: 1px solid var(--line-1);
  }
  .pane-eyebrow {
    padding: 12px 16px 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .plaintext textarea {
    flex: 1;
    min-height: 280px;
    padding: 12px 16px;
    margin: 8px 0 0;
    border: 0;
    outline: none;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
    color: var(--fg-1);
    resize: none;
    font-feature-settings: "ss02", "zero";
  }
  .plaintext textarea:focus {
    background: rgba(232, 237, 245, 0.25);
  }

  .cipher {
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--fg-2);
    font-feature-settings: "ss02", "zero";
    overflow-y: auto;
    max-height: 320px;
    word-wrap: break-word;
    word-break: break-all;
  }
  .cipher :global(.byte) {
    display: inline-block;
    margin-right: 4px;
    padding: 0 1px;
    color: var(--fg-2);
    transition: color 320ms var(--ease-standard);
  }
  .cipher :global(.byte.changed) {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    padding: 12px 16px;
    background: var(--paper-3);
    border-top: 1px solid var(--line-1);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-3);
    font-feature-settings: "ss02", "zero";
  }
  .meta-row {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 0 16px 0 0;
    border-right: 1px solid var(--line-1);
    margin-right: 16px;
  }
  .meta-row:last-child {
    border-right: 0;
    margin-right: 0;
  }
  .meta-row .k { color: var(--fg-3); }
  .meta-row .v {
    color: var(--fg-1);
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta-row .size {
    color: var(--fg-3);
    font-size: 10px;
  }
  .meta-row .size-only { color: var(--fg-3); font-style: italic; }

  .caveat {
    margin: 0;
    padding: 12px 16px;
    background: var(--paper-2);
    border-top: 1px solid var(--line-1);
    font-size: 12px;
    line-height: 1.5;
    color: var(--fg-3);
    max-width: none;
  }

  @media (max-width: 920px) {
    .panes { grid-template-columns: 1fr; }
    .pane + .pane {
      border-left: 0;
      border-top: 1px solid var(--line-1);
    }
    .meta-row {
      flex: 1 1 auto;
      border-right: 0;
      margin-right: 0;
    }
  }
</style>

<script>
  import { mountEncryptionDemo } from "../scripts/encryption-demo";
  const els = {
    textarea: document.getElementById("enc-input") as HTMLTextAreaElement,
    cipher: document.getElementById("enc-cipher") as HTMLElement,
    iv: document.getElementById("enc-iv") as HTMLElement,
    tag: document.getElementById("enc-tag") as HTMLElement,
    size: document.getElementById("enc-size") as HTMLElement,
    status: document.getElementById("enc-status") as HTMLElement,
  };
  if (els.textarea && els.cipher) {
    mountEncryptionDemo(els, {
      autoDemoText:
        "# A note nobody else can read\n\nThe key never leaves this device.\nThe server only sees what's on the right.",
      autoDemoIdleMs: 6000,
    });
  }
</script>
