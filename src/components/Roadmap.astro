---
const phases = [
  {
    label: "PHASE 1 — NOW",
    title: "Desktop client",
    body: "Tauri 2 app with single-vault editor, wikilinks, backlinks, and a minimal graph view. Local-only until Phase 2 lands.",
    active: true,
  },
  {
    label: "PHASE 2",
    title: "Sync server + hosted sync",
    body: "Same protocol, same trust boundary for self-hosted and hosted. Hosted sync is the only paid tier; the local app stays free.",
    active: false,
  },
  {
    label: "PHASE 3",
    title: "Mobile",
    body: "iOS and Android clients sharing the protocol library. Same crypto, same account number, same vault format.",
    active: false,
  },
  {
    label: "PHASE 4",
    title: "Real-time collaboration",
    body: "Multi-cursor co-editing via CRDT (Yjs). Lands only after the rest of the product is solid — earliest, not soonest.",
    active: false,
  },
];
---

<section id="roadmap">
  <div class="container">
    <div class="section-eyebrow">Roadmap</div>
    <h2 class="section-title">Phased, in public.</h2>

    <div class="grid">
      {phases.map((p) => (
        <article class={`card ${p.active ? "active" : ""}`}>
          <div class="num">{p.label}</div>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Roadmap-specific overrides: title gets a wider bottom margin
     (sections list, no lede paragraph), and the active phase card
     drops to bg-1 with the accent border. */
  .section-title { margin-bottom: var(--space-8); }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .card.active {
    background: var(--bg-1);
    border-color: var(--accent);
  }
  .card.active .num { color: var(--accent); }
  .card h3 {
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--fg-1);
  }
  .card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
    margin: 0;
  }

  @media (max-width: 920px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
