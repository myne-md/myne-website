---
/*
 * Theme Builder — the no-code custom-theme authoring tool (MYND-346).
 *
 * Slice 1 (builder-shell-entry): the page frame only — dark LandingLayout+GlassNav
 * chrome, a builder toolbar with the Export affordance, and a full-page no-scroll
 * two-pane layout with empty named slots the sibling slices fill:
 *   - #tb-config-slot  ← builder-controls (left)
 *   - #tb-preview-slot ← builder-preview (right)
 *   - #tb-export-btn   ← builder-export (opens the submit modal; no-op for now)
 *
 * No new nav entry — reached only from the /themes gallery "Build your own" CTA.
 * The page-scoped overflow lock keeps other dark pages (min-height:100vh) intact.
 */
import LandingLayout from "../../layouts/LandingLayout.astro";
import GlassNav from "../../components/GlassNav.astro";
import TokenControl from "../../components/themeBuilder/TokenControl.astro";
import MeasureControl from "../../components/themeBuilder/MeasureControl.astro";
import { GROUPS } from "../../lib/themeBuilder/manifest.mjs";
import {
  PRESETS,
  ROLES,
  TINT_CEILING,
  ornamentToken,
  primitivesForRole,
} from "../../lib/themeBuilder/ornament.mjs";
import { MEASURE_GROUPS } from "../../lib/themeBuilder/measure.mjs";
import { LIGHT_DEFAULTS } from "../../lib/themeBuilder/tokens.mjs";
import themesIndex from "../../data/themes-index.json";
import themesFull from "../../data/themes-full.json";

const val = (token: string): string => LIGHT_DEFAULTS[token] ?? "#000000";

// Gallery themes that have a full vendored palette → "start from" presets.
const galleryThemes = (themesIndex.themes ?? [])
  .filter((t) => t.slug in themesFull)
  .map((t) => ({ slug: t.slug, name: t.name, dark: t.appearance === "dark" }));
---

<LandingLayout
  title="Theme Builder — Myne"
  description="Build your own Myne theme with live preview — pick colors, see them applied, download or share."
  notice="none"
>
  <div class="tb-page">
    <GlassNav />

    <main class="tb">
      <div class="tb-inner">
    {/* Builder toolbar — sits under GlassNav (which we keep verbatim). Holds the
        tool title and the Export affordance. Task 5 adds the mobile Edit/Preview
        toggle into the .tb-bar-mid slot. */}
    <div class="tb-bar">
      <div class="tb-bar-title mono up">Theme Builder</div>
      <div class="tb-bar-mid">
        {/* Mobile-only Edit/Preview toggle (task 5). Hidden on desktop. */}
        <div class="tb-seg" role="tablist" aria-label="Edit or preview">
          <button
            type="button"
            class="tb-seg-btn is-active"
            data-tb-pane="config"
            role="tab"
            aria-selected="true">Edit</button
          >
          <button
            type="button"
            class="tb-seg-btn"
            data-tb-pane="preview"
            role="tab"
            aria-selected="false">Preview</button
          >
        </div>
      </div>
      <div class="tb-bar-actions">
        <button type="button" id="tb-export-btn" class="tb-export mono up">Export</button>
      </div>
    </div>

    <div class="tb-panes" data-mobile-pane="config">
      <section class="tb-pane tb-pane--config" aria-label="Theme controls">
        <div id="tb-config-slot" class="tb-slot tb-controls">
          <div class="tb-preset">
            <label class="tb-preset-label mono up" for="tb-preset-select">Start from</label>
            <div class="tb-preset-row">
              <select id="tb-preset-select" class="tb-preset-select">
                <option value="light">Blank — light</option>
                <option value="dark">Blank — dark</option>
                {galleryThemes.length > 0 && (
                  <optgroup label="Gallery themes">
                    {galleryThemes.map((t) => (
                      <option value={`theme:${t.slug}`} data-dark={t.dark ? "true" : "false"}>
                        {t.name}
                      </option>
                    ))}
                  </optgroup>
                )}
              </select>
              <button type="button" id="tb-reset" class="tb-reset mono up">Reset</button>
            </div>
            <p id="tb-dark-note" class="tb-dark-note" hidden>
              Dark theme — the optional colors are pre-filled from Myne's dark palette. Adjust them
              under Code highlighting, Color labels and Text highlights.
            </p>
          </div>
          {
            GROUPS.map((g) =>
              g.disclosure ? (
                <details class="tb-group tb-group--collapsible">
                  <summary class="tb-group-head mono up">{g.label}</summary>
                  <div class="tb-group-body">
                    {g.tokens.map((t) => (
                      <TokenControl token={t.token} label={t.label} value={val(t.token)} />
                    ))}
                  </div>
                </details>
              ) : (
                <section class="tb-group">
                  <div class="tb-group-head mono up">{g.label}</div>
                  {g.hint && <p class="tb-group-hint">{g.hint}</p>}
                  <div class="tb-group-body">
                    {g.tokens
                      .filter((t) => !t.helper)
                      .map((t) => (
                        <TokenControl token={t.token} label={t.label} value={val(t.token)} />
                      ))}
                    {g.tokens.some((t) => t.helper) && (
                      <details class="tb-finetune">
                        <summary class="tb-finetune-head mono up">Fine-tune</summary>
                        {g.tokens
                          .filter((t) => t.helper)
                          .map((t) => (
                            <TokenControl token={t.token} label={t.label} value={val(t.token)} />
                          ))}
                      </details>
                    )}
                  </div>
                </section>
              ),
            )
          }

          {/* Ornament (myne#394). Chosen per ROLE rather than per element, which
              is what keeps a complete theme ~30 settings instead of several
              hundred. Every control is optional: a colour-only theme is still a
              complete theme, and the presets below only fill these same selects. */}
          <details class="tb-group tb-group--collapsible" id="tb-ornament">
            <summary class="tb-group-head mono up">Ornament</summary>
            <div class="tb-group-body">
              <p class="tb-group-hint">
                Decoration Myne draws for you — pick the parts, not a finished look. Ornament never
                moves anything, and anything drawn behind text is capped so the words stay readable.
              </p>

              <div class="tb-presets" role="group" aria-label="Ornament starting points">
                {PRESETS.map((preset) => (
                  <button
                    type="button"
                    class="tb-preset"
                    data-preset={preset.id}
                    data-preset-role={preset.role}
                    data-preset-set={JSON.stringify(preset.set)}
                  >
                    {preset.label}
                  </button>
                ))}
              </div>

              {ROLES.map((role) => (
                <section class="tb-orn-role">
                  <div class="tb-orn-role-head mono up">{role.label}</div>
                  <p class="tb-group-hint">{role.hint}</p>
                  {primitivesForRole(role.id).map((primitive) => (
                    <label class="tb-orn-ctl">
                      <span class="tb-orn-label">
                        {primitive.label}
                        <span class="tb-orn-hint">{primitive.hint}</span>
                      </span>
                      <select
                        class="tb-orn-select"
                        data-ornament-token={ornamentToken(role.id, primitive.id)}
                        data-ornament-role={role.id}
                        data-ornament-primitive={primitive.id}
                      >
                        {primitive.values.map((v) => (
                          <option value={v.value}>{v.label}</option>
                        ))}
                      </select>
                    </label>
                  ))}
                </section>
              ))}

              {/* The tint wash: one colour and one strength for the whole
                  interface, not per role — that is what the ornament layer
                  composes, and offering it per role would store keys nothing
                  ever draws. The strength stops at the app's own ceiling; a
                  slider that ran past it would show the user a wash the app
                  clamps back down. */}
              <section class="tb-orn-role">
                <div class="tb-orn-role-head mono up">Tint wash</div>
                <p class="tb-group-hint">
                  A colour laid over everything. Capped so it can never bury the text.
                </p>
                <button type="button" class="tb-ctl" data-token="--tint" aria-label="Tint colour">
                  <span class="tb-ctl-swatch" style="background:transparent;border:1px solid #3a3a36"
                  ></span>
                  <span class="tb-ctl-label">Tint colour</span>
                </button>
                <label class="tb-mc" data-tint-strength>
                  <span class="tb-mc-head">
                    <span class="tb-mc-label">Strength</span>
                    <output class="tb-mc-value mono"></output>
                  </span>
                  <input
                    type="range"
                    class="tb-mc-range"
                    min="0"
                    max={TINT_CEILING}
                    step="0.01"
                    value="0"
                  />
                </label>
              </section>
            </div>
          </details>

          {/* Measure tokens (myne#394). Density, corners, type scale, weight and
              letter spacing — every one bounded to 0.5×–2× of its built-in
              default, which is the same envelope the app clamps to. The bounds
              are established on hydration from the preview's own token sheet,
              never from a table in this repo. */}
          <details class="tb-group tb-group--collapsible" id="tb-measure">
            <summary class="tb-group-head mono up">Shape &amp; size</summary>
            <div class="tb-group-body">
              <p class="tb-group-hint">
                How dense, how round and how large the interface is. Each control moves within half
                to double Myne's own value — enough to reshape it, not enough to make it unusable.
              </p>
              {MEASURE_GROUPS.map((g) => (
                <section class="tb-orn-role">
                  <div class="tb-orn-role-head mono up">{g.label}</div>
                  <p class="tb-group-hint">{g.hint}</p>
                  {g.tokens.map((t) => (
                    <MeasureControl token={t.token} label={t.label} unit={g.unit} step={g.step} />
                  ))}
                </section>
              ))}
            </div>
          </details>
        </div>
      </section>
      <section class="tb-pane tb-pane--preview" aria-label="Live preview">
        <div id="tb-preview-slot" class="tb-slot tb-preview-slot">
          {/* Readability hints — populated from the 5 shared CONTRAST_RULES. */}
          <div id="tb-readability" class="tb-readability" hidden></div>
          {/* The REAL Myne interface (myne#394): the editor's own DOM and its own
              stylesheet, captured from the running desktop app and served by
              `preview-frame.html.ts`. It is an iframe rather than inlined markup
              because its CSS is written against `:root` / `:root[data-o-*]`
              selectors and therefore has to BE a document root — and because
              this page's own stylesheet must not leak into it, which is the
              drift the snapshot exists to end. Same-origin, so the apply engine
              below reaches `contentDocument` and drives the palette through
              per-property `setProperty`, exactly as the app drives `:root`. */}
          {/* The stage clips and scales; the frame keeps the capture's own
              1280×800 geometry. Letting the iframe take the pane's width would
              REFLOW the app into a narrow layout — previewing a responsive
              screen the theme author is not dressing. */}
          {/* No `allow-scripts` on the frame below: the captured document
              carries no script of its own (the capture strips them), and the
              builder reaches in from the parent rather than posting messages.
              The comment sits ABOVE the tag rather than between its attributes
              — Astro parses an attribute list as markup, not as JSX, so a
              `{/* … */}` in that position is a syntax error. */}
          <div id="tb-pv-stage" class="tb-pv-stage">
            <iframe
              id="tb-pv-frame"
              class="tb-pv-frame"
              src="/themes/preview-frame.html"
              title="Live preview of the Myne interface with your theme applied"
              loading="eager"
              sandbox="allow-same-origin"></iframe>
          </div>
        </div>
      </section>
    </div>
      </div>
    </main>

    {/* Export modal — single primary action (Download) + one supporting affordance
        (Share), per the myne-website modal carve-out (decisions.md 2026-05-03).
        Sits OUTSIDE .tb so its top-layer centering isn't affected by the fixed pane. */}
    <dialog id="tb-export-modal" class="tb-modal" aria-labelledby="tb-modal-title">
      <div class="tb-modal-card">
        <div class="tb-modal-head">
          <h2 id="tb-modal-title" class="tb-modal-title">Export your theme</h2>
          <button type="button" class="tb-modal-x" data-tb-close aria-label="Close">×</button>
        </div>
        <div class="tb-modal-body">
          <label class="tb-field">
            <span class="tb-field-label">Theme name</span>
            <input type="text" id="tb-meta-name" class="tb-field-input" maxlength="60" placeholder="e.g. Nord Dusk" />
          </label>
          <label class="tb-field">
            <span class="tb-field-label">Your name</span>
            <input type="text" id="tb-meta-author" class="tb-field-input" maxlength="80" placeholder="e.g. Ada Lovelace" />
          </label>
          <label class="tb-field">
            <span class="tb-field-label">Description</span>
            <textarea id="tb-meta-desc" class="tb-field-input tb-field-area" maxlength="280" rows="2" placeholder="A short line about the vibe."></textarea>
          </label>
          <div id="tb-export-status" class="tb-export-status" hidden></div>
        </div>
        <div class="tb-modal-foot">
          <button type="button" id="tb-download" class="tb-modal-primary mono up">Download theme</button>
          <a id="tb-share" class="tb-modal-secondary" href="#" target="_blank" rel="noopener">Share to the gallery →</a>
        </div>
      </div>
    </dialog>
  </div>
</LandingLayout>

{/* Page-scoped no-scroll lock. `is:global` on THIS page only — it ships in the
    builder route's bundle, so other LandingLayout pages (which scroll via
    min-height:100vh) never see it. */}
<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  /* Custom color picker — appended to <body>, so styled globally (scoped styles
     wouldn't reach a JS-created element). Dark, on-register, Inter. */
  .tb-cp {
    position: fixed;
    z-index: 200;
    width: 224px;
    padding: 10px;
    background: #0c0c0c;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    user-select: none;
    touch-action: none;
  }
  .tb-cp[hidden] {
    display: none;
  }
  .tb-cp-sv {
    position: relative;
    width: 204px;
    height: 132px;
    border-radius: 7px;
    cursor: crosshair;
  }
  .tb-cp-sv-thumb,
  .tb-cp-hue-thumb {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .tb-cp-hue {
    position: relative;
    width: 204px;
    height: 12px;
    margin-top: 12px;
    border-radius: 999px;
    cursor: pointer;
    background: linear-gradient(
      to right,
      #f00 0%,
      #ff0 17%,
      #0f0 33%,
      #0ff 50%,
      #00f 67%,
      #f0f 83%,
      #f00 100%
    );
  }
  .tb-cp-hue-thumb {
    top: 50%;
  }
  .tb-cp-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }
  .tb-cp-swatch {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .tb-cp-hex {
    flex: 1 1 auto;
    min-width: 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 12px;
    color: #e6e6e4;
    background: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 7px 9px;
    text-transform: lowercase;
  }
  .tb-cp-hex:focus-visible {
    outline: 2px solid #8aa4d0;
    outline-offset: 1px;
  }
</style>

<style>
  /* Pane region fixed below the ~56px GlassNav → the no-scroll math needs no
     margin bookkeeping and the panes always fill exactly the space beneath the
     bar. */
  /* Inter font context for the whole page (incl. GlassNav) — matches the gallery.
     Without this the un-wrapped nav falls back to the serif default. */
  .tb-page {
    --tb-nav-h: 56px; /* GlassNav height — single source for the pane's top offset */
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    color: #e6e6e4;
  }
  .tb {
    position: fixed;
    inset: var(--tb-nav-h) 0 0 0;
    padding: 0 28px; /* match the GlassNav gutter */
    display: flex;
    justify-content: center; /* centre the content column */
  }
  /* The content column — same max-width + centring as the navbar's inner box. */
  .tb-inner {
    width: 100%;
    max-width: 1280px;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .tb-bar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 52px;
    padding: 0; /* flush to the column edge → aligns with the navbar brand/CTA */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: #0a0a0a;
  }
  .tb-bar-title {
    font-size: 11px;
    color: #8a8a86;
  }
  .tb-bar-mid {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
  }
  .tb-bar-actions {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tb-export {
    font-size: 10.5px;
    color: #0a0a0a;
    background: #e6e6e4;
    border: 0;
    border-radius: 7px;
    padding: 9px 16px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .tb-export:hover {
    background: #ffffff;
  }
  .tb-export:focus-visible {
    outline: 2px solid #8aa4d0;
    outline-offset: 2px;
  }

  /* Two panes fill the remaining height; each scrolls INTERNALLY so the page
     frame itself never scrolls. */
  .tb-panes {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(320px, 400px) 1fr;
  }
  .tb-pane {
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    background: #0a0a0a; /* same as the page bg — no contrast step (user) */
  }
  .tb-pane--config {
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }
  .tb-slot {
    min-height: 100%;
    padding: 20px;
  }

  /* ── Controls (builder-controls) ──────────────────────────────────────── */
  .tb-controls {
    padding: 6px 0 48px;
  }
  .tb-preset {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .tb-preset-label {
    display: block;
    font-size: 10px;
    color: #6a6a66;
    margin-bottom: 8px;
  }
  .tb-preset-row {
    display: flex;
    gap: 8px;
  }
  .tb-preset-select {
    flex: 1 1 auto;
    min-width: 0;
    font-family: inherit;
    font-size: 13px;
    color: #e6e6e4;
    background: #0c0c0c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 7px;
    padding: 8px 10px;
    cursor: pointer;
  }
  .tb-preset-select:focus-visible {
    outline: 2px solid #8aa4d0;
    outline-offset: 1px;
  }
  .tb-reset {
    flex: 0 0 auto;
    font-size: 10px;
    color: #8a8a86;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 7px;
    padding: 8px 12px;
    cursor: pointer;
  }
  .tb-reset:hover {
    color: #e6e6e4;
    border-color: rgba(255, 255, 255, 0.3);
  }
  .tb-dark-note {
    margin: 10px 0 0;
    font-size: 11px;
    line-height: 1.5;
    color: #6a6a66;
  }
  .tb-dark-note[hidden] {
    display: none;
  }

  /* ── Live preview (builder-preview) — descendants read raw var(--token), set
     on .tb-pv via CSSOM by the apply engine. ─────────────────────────────── */
  .tb-preview-slot {
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .tb-readability {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px 24px 0;
  }
  .tb-readability[hidden] {
    display: none;
  }
  .tb-readability-label {
    font-size: 11px;
    color: #d8b76a;
  }
  .tb-readability-chip {
    font-size: 11px;
    color: #d8b76a;
    border: 1px solid rgba(216, 183, 106, 0.4);
    border-radius: 999px;
    padding: 3px 10px;
  }
  /* The captured-interface frame. It owns its own document, so nothing here
     styles its CONTENTS — this is the window, not the room. The ~200 lines of
     `.tb-pv-*` rules that used to live here styled a hand-written imitation of
     Myne; the imitation and its stylesheet went together (myne#394). */
  .tb-pv-stage {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border-radius: 10px;
    /* Sized by the script from the measured pane width — the frame is scaled,
       so the stage has to be the scaled height or it leaves a gap below. */
  }
  .tb-pv-frame {
    /* The capture's own geometry, held fixed. The scale that fits it into the
       pane is a transform, applied by the script, so the app inside never
       reflows — a theme author is dressing the desktop window, and a preview
       that silently switched to the phone layout would be showing them a screen
       they are not authoring. */
    width: 1280px;
    height: 800px;
    border: 0;
    background: #fbfbfa;
    display: block;
    transform-origin: top left;
  }
    border-radius: 50%;
  }

  /* ── Export modal (builder-export) ────────────────────────────────────── */
  .tb-modal {
    /* Explicit viewport centring (the fixed pane was throwing off the UA default). */
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    width: calc(100% - 40px);
    max-width: 440px;
    max-height: calc(100vh - 40px);
    overflow: auto;
    border: none;
    padding: 0;
    background: transparent;
    color: #e6e6e4;
  }
  .tb-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  /* Open animation — card lifts + fades, backdrop fades. Global reduced-motion
     rule in LandingLayout disables it. */
  .tb-modal[open] .tb-modal-card {
    animation: tb-modal-in 200ms cubic-bezier(0.2, 0, 0, 1) both;
  }
  .tb-modal[open]::backdrop {
    animation: tb-backdrop-in 200ms ease both;
  }
  @keyframes tb-modal-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes tb-backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .tb-modal-card {
    background: #0c0c0c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 22px;
    font-family:
      "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .tb-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .tb-modal-title {
    font-size: 16px;
    font-weight: 600;
  }
  .tb-modal-x {
    background: transparent;
    border: 0;
    color: #8a8a86;
    font-size: 22px;
