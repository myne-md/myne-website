  /* Folding is a grid-row transition rather than `display: none`, so the panel
     opens and closes instead of jumping. The inner wrapper is what clips: a
     1fr row is as tall as its content, a 0fr row is zero, and the rows inside
     stay in the DOM either way. */
  .tb-group-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .tb-group-body[data-folded="true"] {
    grid-template-rows: 0fr;
  }
  .tb-group-inner {
    overflow: hidden;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* `[hidden]` is a UA rule and loses to any author `display:`: which is how a
     "hidden" modal button kept showing. */
  .tb-modal-primary[hidden],
  .tb-modal-secondary[hidden] {
    display: none;
  }
  /* .tb-ctl / .tb-ctl-swatch / .tb-ctl-label live in TokenControl.astro. */
  /* ── Ornament controls (myne#394) ─────────────────────────────────── */
  .tb-orn-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 16px;
  }
  .tb-orn-preset {
    font: inherit;
    font-size: 12px;
    padding: 4px 10px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--fg-1);
    cursor: pointer;
  }
  .tb-orn-preset:hover {
    background: var(--paper-3);
  }
  .tb-orn-role {
    margin-top: 18px;
  }
  .tb-orn-role-head {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--fg-3);
    margin-bottom: 2px;
  }
  .tb-orn-ctl {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
  }
  .tb-orn-label {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--fg-1);
  }
  .tb-orn-hint {
    font-size: 11px;
    color: var(--fg-3);
    max-width: 34ch;
  }
  .tb-orn-select {
    font: inherit;
    font-size: 12px;
    padding: 3px 6px;
    border: 1px solid var(--line-2);
    border-radius: 4px;
    background: var(--paper);
    color: var(--fg-1);
    flex-shrink: 0;
  }


  /* No scrollbar chrome in the panes. The controls column is a long list and the
     bar competed with the fold markers for the same right gutter; wheel,
     trackpad and keyboard scrolling all still work, and the preview pane does
     not scroll at all (its stage is sized to fit). */
  .tb-pane {
    scrollbar-width: none;
  }
  .tb-pane::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  /* Segmented Edit/Preview toggle: desktop-hidden, shown on mobile. */
  .tb-seg {
    display: none;
    align-items: center;
    gap: 2px;
    padding: 2px;
    background: #0c0c0c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
  }
  .tb-seg-btn {
    font-family: inherit;
    font-size: 11px;
    color: #8a8a86;
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 6px 16px;
    cursor: pointer;
  }
  .tb-seg-btn.is-active {
    color: #e6e6e4;
    background: rgba(255, 255, 255, 0.08);
  }
  .tb-seg-btn:focus-visible {
    outline: 2px solid #8aa4d0;
    outline-offset: 1px;
  }

  /* Mobile: height-locked single pane switched by the toggle: the page never
     scrolls; the visible pane scrolls internally. */
  @media (max-width: 920px) {
    .tb {
      --tb-nav-h: 71px; /* taller mobile nav (63px) + an 8px breathing gap */
      /* A gutter, NOT full-bleed. Full-bleed was here first and it put the
         start-from row hard against both screen edges: the reset button lost its
         right border to the viewport, which reads as a control that is cut off.
         The bar above already insets by 20px, so this also makes the two agree. */
      padding: 0 20px;
    }
    .tb-bar-title {
      display: none;
    }
    /* Explicit toggle-left / Export-right so neither is clipped on a phone. */
    .tb-bar {
      padding: 0 20px;
      justify-content: space-between;
    }
    .tb-bar-mid {
      flex: 0 1 auto;
      justify-content: flex-start;
    }
    .tb-seg {
      display: inline-flex;
    }
    /* Below the breakpoint the two shortcuts keep their icons and drop their
       words: Export is the primary exit from the builder and it is the one
       control that must stay on screen at 375px. */
    .tb-bar-actions .tb-bar-btn span {
      display: none;
    }
    .tb-bar-actions .tb-bar-btn {
      padding: 8px 10px;
    }
    .tb-panes {
      grid-template-columns: 1fr;
      overflow: hidden;
    }
    .tb-pane--config {
      border-right: 0;
    }
    .tb-panes[data-mobile-pane="config"] .tb-pane--preview {
      display: none;
    }
    .tb-panes[data-mobile-pane="preview"] .tb-pane--config {
      display: none;
    }
  }

  /* Narrow phones: tighten the toolbar so the toggle + Export both fit. */
  @media (max-width: 460px) {
    .tb-bar {
      padding: 0 14px;
      gap: 8px;
    }
    .tb-seg-btn {
      padding: 6px 12px;
    }
    .tb-export {
      padding: 8px 13px;
    }
  }

</style>

<script>
  // Mobile Edit/Preview toggle (builder-shell-entry task 5). Height-locked: it
  // swaps which pane is visible; the page never scrolls. On desktop the .tb-seg
  // control is display:none, so this listener simply never fires above 920px.
  const seg = document.querySelector(".tb-seg");
  const panes = document.querySelector(".tb-panes");
  if (seg && panes) {
    seg.addEventListener("click", (e) => {
      const target = e.target;
      const btn = target instanceof Element ? target.closest("[data-tb-pane]") : null;
      const pane = btn?.getAttribute("data-tb-pane");
      if (!pane) return;
      panes.setAttribute("data-mobile-pane", pane);
      seg.querySelectorAll("[data-tb-pane]").forEach((b) => {
        const on = b === btn;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
    });
  }
</script>

<script>
  // Controls (builder-controls): the colour panel.
  //
  // Four things share this block because they are four views of one state: the
  // picker writes a colour, the link control decides whether a derived shade
  // follows its anchor, the dice roll a new value, and the filter decides which
  // rows are on screen. Grouping colours into tone families (`manifest.mjs`) is
  // what makes the anchor/link pair mean anything; before it, a derived shade
  // sat under a "Fine-tune" disclosure and could not be unlinked at all.
  import { appState } from "../../scripts/themeBuilderApp";
  import { LIGHT_DEFAULTS, DARK_DEFAULTS } from "../../lib/themeBuilder/tokens.mjs";
  import { helpersForBase } from "../../lib/themeBuilder/derive.mjs";
  import { createColorPicker } from "../../lib/themeBuilder/colorPicker.mjs";
  import { randomValueFor, randomizePalette } from "../../lib/themeBuilder/randomize.mjs";
  import { clearHighlight, highlightToken } from "../../lib/themeBuilder/highlight.mjs";
  import { anchorFor } from "../../lib/themeBuilder/manifest.mjs";
  import { computeVisibility, normaliseQuery } from "../../lib/themeBuilder/filters.mjs";
  import themesFull from "../../data/themes-full.json";

  const palettes = themesFull as Record<string, Record<string, string>>;
  const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>(".tb-ctl"));
  const darkNote = document.getElementById("tb-dark-note");

  // ── Editing ────────────────────────────────────────────────────────────────
  // Editing an anchor re-derives the shades that follow it, except the ones the
  // author has unlinked. Editing a SHADE is itself an override, so it pins: the
  // alternative is a shade that silently snaps back the next time its anchor
  // moves, which is the behaviour this whole model exists to remove.
  function applyColor(token: string, hex: string): void {
    if (anchorFor(token)) {
      appState.pin(token);
      appState.set(token, hex);
      return;
    }
    const helpers = helpersForBase(token, hex, appState.isDark(), appState.getPalette());
    const usable = Object.entries(helpers).filter(([t]) => !appState.isPinned(t));
    if (usable.length) appState.patch({ [token]: hex, ...Object.fromEntries(usable) });
    else appState.set(token, hex);
  }

  // ── "What does this colour drive?" ─────────────────────────────────────────
  // The capture carries the real stylesheet, so the answer is read from the
  // frame's own CSSOM (`highlight.mjs`) rather than from a second, hand-kept map,
  // and it is answered by OUTLINING the regions in the preview: no caption
  // counting them, which was a sentence repeating what the eye can already see.
  const frameEl = document.getElementById("tb-pv-frame") as HTMLIFrameElement | null;
  function previewDoc(): Document | null {
    try {
      return frameEl?.contentDocument ?? null;
    } catch {
      return null;
    }
  }
  function showHighlight(token: string | null): void {
    const doc = previewDoc();
    if (!doc) return;
    if (!token) clearHighlight(doc);
    else highlightToken(doc, token);
  }

  // ── The picker ─────────────────────────────────────────────────────────────
  let activeToken: string | null = null;
  const picker = createColorPicker({
    onChange: (hex) => {
      if (activeToken) applyColor(activeToken, hex);
    },
    onClose: () => {
      activeToken = null;
      showHighlight(null);
    },
  });

  for (const sw of swatches) {
    const token = sw.dataset.token;
    if (!token) continue;
    sw.addEventListener("click", () => {
      // Pressing the same row again closes it: the picker is a toggle, not a mode.
      if (activeToken === token && picker.isOpen()) {
        picker.close();
        return;
      }
      activeToken = token;
      picker.open(sw, appState.get(token) ?? "#000000");
      showHighlight(token);
    });
    // Deliberately NOT on hover: a highlight that follows the pointer turns the
    // preview into a light show while you are reading the panel. It answers a
    // question you asked by pressing a row, and clears when you dismiss it.
  }

  // ── Unlink / re-link a derived shade ───────────────────────────────────────
  const linkButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".tb-link"));
  function paintLinks(): void {
    for (const b of linkButtons) {
      b.setAttribute("aria-pressed", appState.isPinned(b.dataset.link ?? "") ? "true" : "false");
    }
  }
  for (const b of linkButtons) {
    b.addEventListener("click", () => {
      const token = b.dataset.link ?? "";
      const anchor = b.dataset.anchor ?? "";
      if (appState.isPinned(token)) {
        // Re-link is a real undo: unpin AND snap to what the anchor says now,
        // rather than a flag that only takes effect at the next anchor edit.
        appState.unpin(token);
        const base = appState.get(anchor);
        if (base) {
          const derived = helpersForBase(anchor, base, appState.isDark(), appState.getPalette())[token];
          if (derived) appState.set(token, derived);
        }
      } else {
        appState.pin(token);
      }
      paintLinks();
    });
  }

  // ── Dice ───────────────────────────────────────────────────────────────────
  for (const b of Array.from(document.querySelectorAll<HTMLButtonElement>("[data-dice]"))) {
    b.addEventListener("click", () => {
      const token = b.dataset.dice ?? "";
      if (!token) return;
      const value = randomValueFor(token, {
        isDark: appState.isDark(),
        palette: appState.getPalette(),
      });
      if (anchorFor(token)) {
        appState.pin(token);
        appState.set(token, value);
      } else {
        applyColor(token, value);
      }
    });
  }

  // ── Swatch painting + the state-driven UI ──────────────────────────────────
  // Cache each swatch dot once so repaints don't re-query the DOM per change.
  const swatchDots = swatches.map((sw) => ({
    token: sw.dataset.token,
    dot: sw.querySelector<HTMLElement>(".tb-ctl-swatch"),
  }));
  function paintSwatches(palette: Record<string, string>): void {
    for (const { token, dot } of swatchDots) {
      if (token && dot && palette[token]) dot.style.background = palette[token];
    }
  }

  // "Modified" compares against the palette this session STARTED from: the
  // preset that was loaded: not against LIGHT_DEFAULTS, or loading a gallery
  // theme would open with every row already marked as changed.
  let basePalette: Record<string, string> = appState.getPalette();

  const filterInput = document.getElementById("tb-filter") as HTMLInputElement | null;
  const modifiedBtn = document.getElementById("tb-modified-toggle");

  function applyFilters(): void {
    const query = filterInput?.value ?? "";
    const modifiedOnly = modifiedBtn?.getAttribute("aria-pressed") === "true";
    const palette = appState.getPalette();
    const searching = normaliseQuery(query) !== "";
    for (const group of Array.from(document.querySelectorAll<HTMLElement>(".tb-group[data-group]"))) {
      const rowEls = Array.from(group.querySelectorAll<HTMLElement>(".tb-row"));
      // The DECISION lives in `filters.mjs` so it can be tested; this loop only
      // writes what it returns.
      const verdict = computeVisibility({
        filterKind: group.dataset.filter === "group" ? "group" : "rows",
        label: group.dataset.label ?? "",
        query,
        modifiedOnly,
        palette,
        basePalette,
        rows: rowEls.map((el) => ({
          token: el.dataset.row ?? "",
          hay: el.dataset.search ?? "",
        })),
      });
      group.hidden = verdict.hidden;
      rowEls.forEach((el, i) => {
        el.hidden = verdict.rows[i]?.show !== true;
      });
      // Searching OPENS a folded group: a match behind a closed disclosure reads
      // as no match at all.
      if (searching && !verdict.hidden) {
        setFolded(group.querySelector<HTMLElement>(".tb-group-body"), false);
        group.querySelector<HTMLElement>("[data-fold]")?.setAttribute("aria-expanded", "true");
      }
    }
  }

  filterInput?.addEventListener("input", applyFilters);
  modifiedBtn?.addEventListener("click", () => {
    const on = modifiedBtn.getAttribute("aria-pressed") === "true";
    modifiedBtn.setAttribute("aria-pressed", on ? "false" : "true");
    applyFilters();
  });

  // Folded groups. The animation is a grid-row transition (see the CSS), and the
  // inner wrapper goes `inert` while folded so its sliders and selects leave the
  // tab order instead of being focusable at zero height.
  function setFolded(body: HTMLElement | null, folded: boolean): void {
    if (!body) return;
    body.dataset.folded = folded ? "true" : "false";
    const inner = body.querySelector<HTMLElement>(".tb-group-inner");
    if (inner) inner.inert = folded;
  }
  for (const b of Array.from(document.querySelectorAll<HTMLElement>("[data-fold]"))) {
    const body = document.getElementById(b.dataset.fold ?? "");
    setFolded(body, b.getAttribute("aria-expanded") !== "true");
    b.addEventListener("click", () => {
      const open = b.getAttribute("aria-expanded") === "true";
      b.setAttribute("aria-expanded", open ? "false" : "true");
      setFolded(body, open);
    });
  }

  appState.subscribe((snap) => {
    paintSwatches(snap.palette);
    paintLinks();
    if (darkNote) darkNote.hidden = !snap.isDark;
    applyFilters();
  });

  paintSwatches(appState.getPalette());
  paintLinks();
  applyFilters();

  // ── Start-from dropdown + reset ────────────────────────────────────────────
  // The dropdown keeps listbox semantics (arrow keys, Home/End, Escape, focus
  // returns to the trigger) and only the SKIN is ours; the native <select> it
  // replaces drew an OS caret a couple of pixels off the border and could not be
  // styled at all.
  const presetTrigger = document.getElementById("tb-preset-trigger") as HTMLButtonElement | null;
  const presetMenu = document.getElementById("tb-preset-menu");
  const presetValueEl = document.getElementById("tb-preset-value");
  const resetBtn = document.getElementById("tb-reset");
  const presetOptions = Array.from(document.querySelectorAll<HTMLButtonElement>(".tb-dd-option"));
  let presetValue = "light";

  function setPresetLabel(value: string): void {
    presetValue = value;
    for (const opt of presetOptions) {
      const selected = opt.dataset.value === value;
      opt.setAttribute("aria-selected", selected ? "true" : "false");
      if (selected && presetValueEl) presetValueEl.textContent = (opt.textContent ?? "").trim();
    }
  }

  function setPresetMenuOpen(open: boolean, focusOption = false): void {
    if (!presetMenu || !presetTrigger) return;
    presetMenu.hidden = !open;
    presetTrigger.setAttribute("aria-expanded", open ? "true" : "false");
    if (!open || !focusOption) return;
    const current = presetOptions.find((o) => o.getAttribute("aria-selected") === "true");
    (current ?? presetOptions[0])?.focus();
  }

  presetTrigger?.addEventListener("click", () => setPresetMenuOpen(presetMenu?.hidden !== false));
  presetTrigger?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      setPresetMenuOpen(true, true);
    }
  });

  for (const opt of presetOptions) {
    opt.addEventListener("click", () => {
      const value = opt.dataset.value ?? "light";
      setPresetLabel(value);
      setPresetMenuOpen(false);
      presetTrigger?.focus();
      loadPreset(value);
    });
    opt.addEventListener("keydown", (e) => {
      const i = presetOptions.indexOf(opt);
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        const step = e.key === "ArrowDown" ? 1 : presetOptions.length - 1;
        presetOptions[(i + step) % presetOptions.length]?.focus();
      } else if (e.key === "Home" || e.key === "End") {
        e.preventDefault();
        (e.key === "Home" ? presetOptions[0] : presetOptions[presetOptions.length - 1])?.focus();
      } else if (e.key === "Escape") {
        e.preventDefault();
        setPresetMenuOpen(false);
        presetTrigger?.focus();
      }
    });
  }

  // Clicking anywhere else closes the menu, the same way the colour picker does.
  document.addEventListener("pointerdown", (e) => {
    if (presetMenu?.hidden !== false) return;
    const target = e.target;
    if (!(target instanceof Element) || target.closest(".tb-dd")) return;
    setPresetMenuOpen(false);
  });

  function loadPreset(value: string): void {
    picker.close();
    const dark = value === "dark" || presetOptions.find((o) => o.dataset.value === value)?.dataset.dark === "true";
    if (value === "light") appState.replace({ ...LIGHT_DEFAULTS }, false);
    else if (value === "dark") appState.replace({ ...DARK_DEFAULTS }, true);
    else if (value.startsWith("theme:")) {
      const palette = palettes[value.slice("theme:".length)];
      if (!palette) return;
      // Merge over the appearance-correct base (LIGHT/DARK_DEFAULTS each carry all
      // 44 tokens) so every token: including optionals: is set; a dark theme's
      // optionals come from the dark canon, never a LIGHT fallback (SYNC-6).
      const base = dark ? DARK_DEFAULTS : LIGHT_DEFAULTS;
      appState.replace({ ...base, ...palette }, dark);
    }
    basePalette = appState.getPalette();
    if (darkNote) darkNote.hidden = !appState.isDark();
    applyFilters();
  }

  resetBtn?.addEventListener("click", () => loadPreset(presetValue));
  // The markup already renders "Blank (light)" selected; this makes the
  // aria-selected state agree with it without a second source of truth.
  setPresetLabel(presetValue);

  // ── Surprise me ────────────────────────────────────────────────────────────
  document.getElementById("tb-randomize-all")?.addEventListener("click", () => {
    picker.close();
    appState.replace(randomizePalette({ isDark: appState.isDark() }), appState.isDark());
    basePalette = appState.getPalette();
    applyFilters();
  });
</script>

<script>
  // Ornament controls (myne#394). Each select writes its `--<role>-<primitive>`
  // straight into the shared state, so preview and export both see it live —
  // the same path the colour swatches use.
  //
  // The preview applies ornament by REFLECTING each selection onto the preview
  // wrapper as `data-o-<role>-<primitive>`, exactly as the app reflects it onto
  // `:root`. CSS cannot branch on a custom property's value, so this attribute
  // bridge is what makes the rules selectable: and mirroring it here is what
  // makes "what you see is what installs" true rather than approximately true.
  import { appState } from "../../scripts/themeBuilderApp";

  const ornSelects = Array.from(
    document.querySelectorAll<HTMLSelectElement>(".tb-orn-select"),
  );

  // Selecting an ornament is a state write, and nothing more: the preview's own
  // subscriber reflects the whole palette onto the frame whenever state changes.
  // The reflect used to happen HERE, per control, which is how the `data-o-on`
  // flag: the attribute every ornament rule is scoped under: ended up written
  // by nobody, and how a tint-only theme had no way to turn the layer on at all.
  for (const select of ornSelects) {
    const token = select.dataset.ornamentToken;
    if (!token) continue;
    // Hydrate from whatever the state already holds (a loaded starting theme).
    const current = appState.get(token);
    if (typeof current === "string" && current !== "") select.value = current;
    select.addEventListener("change", () => {
      appState.set(token, select.value);
    });
  }

  // Tint strength. Its ceiling is the app's own (`--_o-ceiling`), declared once
  // in `ornament.mjs` and rendered as the slider's `max`, so the control cannot
  // promise a wash the app would clamp back down.
  //
  // **Zero is WRITTEN, and the previous version's reasoning for clearing it was
  // false.** "An absent key and a zero key mean the same thing" is exactly what
  // the stylesheet does not do: it composes
  // `min(var(--tint-strength, 0.08), var(--_o-ceiling))`, so an absent key means
  // **8%**, not off. Combined with `serialize.mjs` dropping empty values, a user
  // who set a tint colour and slid the strength to a control labelled "off"
  // shipped an 8% wash: in the preview and in the app: with no affordance
  // anywhere to turn it off.
  const tintStrength = document.querySelector<HTMLInputElement>("[data-tint-strength] input");
  const tintOut = document.querySelector<HTMLOutputElement>("[data-tint-strength] output");
  if (tintStrength && tintOut) {
    const paint = () => {
      const v = Number(tintStrength.value);
      tintOut.textContent = v === 0 ? "off" : v.toFixed(2);
      appState.set("--tint-strength", v === 0 ? "0" : String(v));
    };
    const current = appState.get("--tint-strength");
    if (typeof current === "string" && current !== "") tintStrength.value = current;
    paint();
    tintStrength.addEventListener("input", paint);
  }

  // Presets fill the selects above and nothing else: they expand to ordinary
  // settings, so no preset name is ever stored in the theme (decisions.md
  // 2026-08-06). Anything the preset does not mention is reset to its no-op, so
  // clicking two presets in a row does not leave the first one's leftovers.
  for (const button of Array.from(document.querySelectorAll<HTMLButtonElement>(".tb-orn-preset"))) {
    button.addEventListener("click", () => {
      const role = button.dataset.presetRole;
      const set = JSON.parse(button.dataset.presetSet ?? "{}") as Record<string, string>;
      if (!role) return;
      for (const select of ornSelects) {
        if (select.dataset.ornamentRole !== role) continue;
        const primitive = select.dataset.ornamentPrimitive ?? "";
        const token = select.dataset.ornamentToken ?? "";
        const value = set[primitive] ?? select.options[0]?.value ?? "none";
        select.value = value;
        appState.set(token, value);
      }
    });
  }
</script>

<script>
  // Live preview (builder-preview): apply the shared palette to the CAPTURED
  // interface: the real app's DOM and stylesheet, in a same-origin iframe
  // (myne#394): via gated CSSOM setProperty (SYNC-4: the ONLY browser
  // injection gate; the site has no CSP). Never string-concat into a <style>.
  //
  // Applying to the frame's `documentElement` rather than to a wrapper div is
  // what makes the snapshot's own rules resolve: they are written against
  // `:root` and `:root[data-o-*]`, because they came from an app that applies
  // themes to the document root. Same target, same precedence, same result.
  import { appState } from "../../scripts/themeBuilderApp";
  import { applyTheme } from "../../lib/themeBuilder/applyPreview.mjs";
  import { contrastReport } from "../../lib/themeBuilder/validator.mjs";
  import { isDarkBackground } from "../../lib/themeBuilder/syntaxTheme.mjs";
  import {
    drawableOrnaments,
    reflectOrnament,
    withPreviewRoot,
  } from "../../lib/themeBuilder/previewFrame.mjs";
  import { bandFor } from "../../lib/themeBuilder/measure.mjs";

  const readability = document.getElementById("tb-readability");

  // Plain-word names for the 5 canonical CONTRAST_RULES pairs, and for the
  // surface each one is read against. A finding has to be able to say WHAT is
  // wrong ("Secondary text is too faint against the page background, 3.42:1,
  // needs 4.5:1"), which a chip holding two words cannot.
  const REGION_NAMES: Record<string, string> = {
    "--ink-0|--paper": "Headings",
    "--ink-1|--paper": "Body text",
    "--ink-1|--paper-2": "Text on panels",
    "--ink-2|--paper": "Secondary text",
    "--accent|--paper": "Accent",
  };
  const SURFACE_NAMES: Record<string, string> = {
    "--paper": "the page background",
    "--paper-2": "panel backgrounds",
    "--paper-3": "hover surfaces",
  };
  /** Past this many findings the tail is summarised, so the banner stays readable. */
  const MAX_LISTED_FINDINGS = 4;

  function updateReadability(palette: Record<string, string>): void {
    const text = document.getElementById("tb-readability-text");
    if (!readability || !text) return;
    const report = contrastReport(palette);
    if (report.failures.length === 0) {
      readability.hidden = true;
      return;
    }
    readability.hidden = false;
    const sentences = report.failures.map((f) => {
      const who = REGION_NAMES[`${f.fg}|${f.bg}`] ?? f.label;
      const where = SURFACE_NAMES[f.bg] ?? "its background";
      return `${who} is too faint against ${where} (${f.ratio.toFixed(2)}:1, needs ${f.min}:1)`;
    });
    // One running paragraph, not one line per finding: and `textContent`, so a
    // palette value can never inject anything here.
    const shown = sentences.slice(0, MAX_LISTED_FINDINGS);
    const rest = sentences.length - shown.length;
    text.textContent = `${shown.join("; ")}${rest > 0 ? `; and ${rest} more` : ""}.`;
  }

  // Fit the captured 1280×800 window into whatever width the pane has, by
  // scaling rather than reflowing. `ResizeObserver` rather than a `resize`
  // listener because the pane also changes width when the mobile Edit/Preview
  // toggle switches panes, which fires no window resize at all.
  const stage = document.getElementById("tb-pv-stage");
  const frame = document.getElementById("tb-pv-frame");
  const CAPTURE_W = 1280;
  const CAPTURE_H = 800;

  // Hand the captured interface to the frame as `srcdoc` instead of a `src`.
  // The snapshot has to be a document of its own (its rules are written against
  // `:root`, and this page's stylesheet must not leak into it), but a framed
  // HTTP response inherits the origin's `X-Frame-Options`: and myne.md ships
  // `DENY` site-wide, which blocks even a same-origin frame. The production
  // builder therefore showed Firefox's "will not allow ... to display the page
  // if another site has embedded it" where the preview belongs, while the same
  // page on localhost worked, because the dev server sends no such header.
  // `about:srcdoc` is not a response, so there is no header to refuse it, and
  // `sandbox="allow-same-origin"` keeps the frame on this origin so the apply
  // engine can still reach into it.
  if (frame instanceof HTMLIFrameElement) {
    // Versioned by the snapshot's own hash: the endpoint caches for an hour (it
    // is ~190 KB), so without this a browser that had already loaded the
    // PREVIOUS capture kept serving it after a re-capture, which reads as "the
    // preview is still the old app".
    const version = frame.dataset.previewVersion ?? "0";
    void fetch(`/themes/preview-frame.html?v=${encodeURIComponent(version)}`, {
      credentials: "same-origin",
    })
      .then((res) => (res.ok ? res.text() : Promise.reject(new Error(String(res.status)))))
      .then((html) => {
        frame.srcdoc = html;
      })
      .catch(() => {
        // A missing snapshot degrades to an empty stage: the same posture the
        // measure controls take below, rather than a spinner nobody can clear.
      });
  }
  if (stage && frame) {
    const fit = () => {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      if (width <= 0 || height <= 0) return;
      // Fit BOTH axes and never scale UP: past 1:1 the preview is showing a
      // magnified screenshot, and every hairline in the theme reads a pixel
      // thicker than it ships. The frame's layout box is fixed, so the stage's
      // flex height is stable and this cannot feed back into itself.
      const scale = Math.min(width / CAPTURE_W, height / CAPTURE_H, 1);
      const dx = Math.max(0, Math.round((width - CAPTURE_W * scale) / 2));
      const dy = Math.max(0, Math.round((height - CAPTURE_H * scale) / 2));
      frame.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
      // The frame's corner radius is divided by this (see the CSS): the transform
      // scales the corner along with everything else.
      stage.style.setProperty("--pv-scale", String(scale));
    };
    fit();
    new ResizeObserver(fit).observe(stage);
  }

  withPreviewRoot((pvRoot: HTMLElement) => {
    // What the loaded stylesheet can actually draw, read off its own rules. A
    // selection absent from this set is never written, so the preview cannot
    // hold an attribute nothing matches: the shape that made every ornament
    // control here a no-op before the snapshot arrived.
    const drawable = drawableOrnaments(pvRoot);

    // ── Measure controls ─────────────────────────────────────────────────────
    // Bands come from the preview's OWN token sheet: the real `tokens.css`,
    // captured with the snapshot: read here, before any palette is applied, so
    // what is measured is the built-in default rather than a previous theme's.
    // A token whose band cannot be established (a zero default, an unreadable
    // value) has its control REMOVED: `--space-0` and `--tracking-normal` both
    // default to 0, and half-to-double of zero is zero, so a slider for them
    // could only ever lie. (Field Notes ships `--tracking-normal: 0.01em` today
    // and it has never had any effect.)
    const measured = getComputedStyle(pvRoot);
    for (const ctl of Array.from(document.querySelectorAll<HTMLElement>("[data-measure-token]"))) {
      const token = ctl.dataset.measureToken ?? "";
      const range = ctl.querySelector<HTMLInputElement>("input");
      const out = ctl.querySelector<HTMLOutputElement>("output");
      const band = bandFor(measured.getPropertyValue(token));
      if (!band || !range || !out) {
        ctl.remove();
        continue;
      }
      range.min = String(band.min);
      range.max = String(band.max);
      range.value = String(band.base);
      ctl.hidden = false;

      const paint = () => {
        const n = Number(range.value);
        out.textContent = `${n}${band.unit}`;
        // At the default, write nothing: an absent key and a key holding the
        // built-in value mean the same thing to the app, and only one of them
        // puts a line in every exported theme.
        appState.set(token, n === band.base ? "" : `${n}${band.unit}`);
      };
      const current = appState.get(token);
      if (typeof current === "string" && current !== "") {
        const parsed = Number.parseFloat(current);
        if (Number.isFinite(parsed)) range.value = String(parsed);
      }
      paint();
      range.addEventListener("input", paint);
    }

    const apply = (snap: { palette: Record<string, string> }) => {
      // A custom palette replaces the built-in wholesale, exactly as the app
      // does: otherwise the captured `data-theme` keeps supplying values the
      // theme meant to override.
      pvRoot.removeAttribute("data-theme");
      applyTheme(pvRoot.style, snap.palette);
      reflectOrnament(pvRoot, snap.palette, drawable);
      updateReadability(snap.palette);
      // Expose the preview's effective appearance (SYNC-8: export reads it).
      // On the builder page's own element, not the frame's: the export block
      // reads it from this document.
      document.body.dataset.previewAppearance = isDarkBackground(snap.palette["--paper"])
        ? "dark"
        : "light";
    };
    apply(appState.snapshot());
    appState.subscribe(apply);
  });
</script>

<script>
  // Export / Share (builder-export): ONE dialog, two modes.
  //
  // Both need the same three fields and the same completeness gate, so a second
  // dialog would be the same markup twice with two sets of ids. What actually
  // differs is the sentence and the destination: Export writes two files to
  // Downloads; Share opens a PULL REQUEST on the gallery with the palette
  // already written into `themes/<slug>/theme.json` (GitHub's new-file page,
  // which forks for anyone without write access), and keeps the issue form as
  // the fallback when the encoded URL would be too long.
  import { appState } from "../../scripts/themeBuilderApp";
  import { canExport, buildThemeJson, buildMetaJson } from "../../lib/themeBuilder/serialize.mjs";
  import { contrastReport } from "../../lib/themeBuilder/validator.mjs";
  import { downloadFile } from "../../lib/themeBuilder/download.mjs";
  import { slugify, slugCollides, isShareableSlug } from "../../lib/themeBuilder/slug.mjs";
  import { buildSubmission } from "../../lib/themeBuilder/shareUrl.mjs";
  import { buildThemeInstallUrl } from "../../lib/themeInstallLink.mjs";
  import themesIndex from "../../data/themes-index.json";

  const existingSlugs = (themesIndex.themes ?? []).map((t) => t.slug);

  const modal = document.getElementById("tb-export-modal") as HTMLDialogElement | null;
  const titleEl = document.getElementById("tb-modal-title");
  const blurbEl = document.getElementById("tb-modal-blurb");
  const noteEl = document.getElementById("tb-modal-note");
  const openBtn = document.getElementById("tb-export-btn");
  const downloadBtn = document.getElementById("tb-download") as HTMLButtonElement | null;
  const openPrLink = document.getElementById("tb-open-pr") as HTMLAnchorElement | null;
  const modeShareBtn = document.getElementById("tb-mode-share");
  const modeExportBtn = document.getElementById("tb-mode-export");
  const statusEl = document.getElementById("tb-export-status");
  const nameInput = document.getElementById("tb-meta-name") as HTMLInputElement | null;
  const authorInput = document.getElementById("tb-meta-author") as HTMLInputElement | null;
  const descInput = document.getElementById("tb-meta-desc") as HTMLTextAreaElement | null;

  const readMeta = () => ({
    name: nameInput?.value ?? "",
    author: authorInput?.value ?? "",
    description: descInput?.value ?? "",
  });

  // The preview block publishes the effective appearance here (SYNC-8).
  const currentAppearance = (): "light" | "dark" =>
    document.body.dataset.previewAppearance === "dark" ? "dark" : "light";

  /** Everything both destinations need, built once per refresh. */
  function outputs() {
    const palette = appState.getPalette();
    const meta = readMeta();
    const appearance = currentAppearance();
    const slug = slugify(meta.name);
    return {
      palette,
      meta,
      appearance,
      slug,
      themeJson: JSON.stringify(buildThemeJson(palette), null, 2),
      metaJson: JSON.stringify(buildMetaJson(meta, appearance), null, 2),
    };
  }

  function refreshExportState(): boolean {
    const out = outputs();
    const gate = canExport(out.palette);
    const named = out.meta.name.trim() !== "";
    const contrast = contrastReport(out.palette);
    const ready = gate.ok && named;
    // Sharing needs an ascii slug; a non-Latin/emoji name folds to "" (which would
    // yield a `themes//` folder and slip past the collision guard). Download is not
    // gated on the slug: theme.json is palette-only and its filename is fixed.
    const shareReady = ready && isShareableSlug(out.slug);

    if (statusEl) {
      if (!gate.ok) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-error";
        statusEl.textContent = `Set every color first — ${gate.missing.length} still unset.`;
      } else if (!named) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent = "Give your theme a name to download or share it.";
      } else if (!isShareableSlug(out.slug)) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent =
          "Add Latin letters or numbers to the name to share to the gallery. You can still download.";
      } else if (slugCollides(out.slug, existingSlugs)) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent = "A gallery theme with this name already exists — rename it before sharing.";
      } else if (!contrast.ok) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent = `Heads up: ${contrast.failures.length} low-contrast pair(s). You can still export.`;
      } else {
        statusEl.hidden = true;
      }
    }

    if (downloadBtn) downloadBtn.disabled = !ready;

    if (openPrLink) {
      openPrLink.setAttribute("aria-disabled", shareReady ? "false" : "true");
      if (shareReady) {
        const submission = buildSubmission({
          slug: out.slug,
          name: out.meta.name.trim(),
          author: out.meta.author.trim(),
          description: out.meta.description.trim(),
          appearance: out.appearance,
          themeJson: out.themeJson,
          metaJson: out.metaJson,
        });
        openPrLink.href = submission.url;
        // A palette too large to encode falls back to the issue form; say so
        // rather than promising a diff the link cannot carry.
        openPrLink.textContent =
          submission.kind === "pr" ? "Open a pull request" : "Open a submission issue";
      } else {
        openPrLink.href = "#";
      }
    }

    return ready;
  }

  const COPY = {
    export: {
      title: "Export your theme",
      blurb:
        "Two files go into your Downloads folder. theme.json is what you import from Settings → Appearance; meta.json carries your name, a description and the appearance so a gallery submission can be filed without asking again. Nothing leaves this page.",
      note: "The palette is validated on your device when you import it.",
    },
    share: {
      title: "Share your theme",
      blurb:
        "Opens a pull request on the myne-themes gallery with your palette already written into themes/<slug>/theme.json. Nothing is uploaded from this page: GitHub shows you the diff first, and a maintainer reviews it with the same validator the app runs.",
      note: "No GitHub account? Use Export instead and attach the files to an issue.",
    },
  };

  type Mode = "export" | "share";

  function setMode(next: Mode): void {
    modal?.setAttribute("data-mode", next);
    const copy = COPY[next];
    if (titleEl) titleEl.textContent = copy.title;
    if (blurbEl) blurbEl.textContent = copy.blurb;
    if (noteEl) noteEl.textContent = copy.note;
    const sharing = next === "share";
    if (downloadBtn) downloadBtn.hidden = sharing;
    if (openPrLink) openPrLink.hidden = !sharing;
    if (modeShareBtn) modeShareBtn.hidden = sharing;
    if (modeExportBtn) modeExportBtn.hidden = !sharing;
    refreshExportState();
  }

  function openModal(next: Mode): void {
    setMode(next);
    modal?.showModal();
    if (next === "share" && (nameInput?.value ?? "").trim() === "") nameInput?.focus();
  }

  openBtn?.addEventListener("click", () => openModal("export"));

  modeShareBtn?.addEventListener("click", () => setMode("share"));
  modeExportBtn?.addEventListener("click", () => setMode("export"));

  // ── Toolbar shortcuts ─────────────────────────────────────────────────────
  const shareBtn = document.getElementById("tb-share-btn");
  const openInMyneBtn = document.getElementById("tb-open-in-myne");

  shareBtn?.addEventListener("click", () => openModal("share"));

  // Open in Myne hands the LIVE palette to the desktop app through the same
  // `myne://theme/install` link the gallery cards use: no file, no round trip
  // through the export modal. That is the iteration loop a theme author
  // actually wants: press it, the app asks to apply, look at the real window.
  const refreshOpenInMyne = () => {
    if (!openInMyneBtn) return;
    const url = buildThemeInstallUrl({
      name: (nameInput?.value ?? "").trim() || "Untitled theme",
      palette: appState.getPalette(),
      author: (authorInput?.value ?? "").trim(),
      source: "https://myne.md/themes/builder",
    });
    // `null` means the link cannot be built: an incomplete palette, or one
    // whose encoded form exceeds the OS command-line budget the app documents.
    // Either way the honest answer is "use Export", so the button says that
    // rather than emitting a link that fails in the app's dialog.
    openInMyneBtn.setAttribute("aria-disabled", url ? "false" : "true");
    openInMyneBtn.title = url
      ? "Hand this theme to the desktop app without downloading anything"
      : "This theme is too large to hand off in a link. Use Export.";
  };

  openInMyneBtn?.addEventListener("click", () => {
    if (openInMyneBtn.getAttribute("aria-disabled") === "true") {
      openModal("export");
      if (statusEl) {
        statusEl.hidden = false;
        statusEl.className = "tb-export-status is-warn";
        statusEl.textContent =
          "Too large to hand off in a link. Use Download, then import it from Settings → Appearance.";
      }
      return;
    }
    const url = buildThemeInstallUrl({
      name: (nameInput?.value ?? "").trim() || "Untitled theme",
      palette: appState.getPalette(),
      author: (authorInput?.value ?? "").trim(),
      source: "https://myne.md/themes/builder",
    });
    if (url) window.location.href = url;
  });

  appState.subscribe(refreshOpenInMyne);
  refreshOpenInMyne();

  // dismiss: × button, backdrop click (Esc is native to <dialog>).
  modal?.querySelector("[data-tb-close]")?.addEventListener("click", () => modal.close());
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });

  // Re-gate as the user types the metadata. No palette subscription: the color
  // controls sit behind the modal's backdrop while it's open, so the palette
  // can't change here: the open-click + these input handlers cover every case.
  for (const el of [nameInput, authorInput, descInput]) {
    el?.addEventListener("input", refreshExportState);
  }

  // Download: two import-ready files (theme.json + meta.json), no zip.
  downloadBtn?.addEventListener("click", () => {
    if (!refreshExportState()) return;
    const out = outputs();
    downloadFile("theme.json", out.themeJson);
    downloadFile("meta.json", out.metaJson);
  });
</script>
