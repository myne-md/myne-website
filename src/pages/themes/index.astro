---
import LandingLayout from "../../layouts/LandingLayout.astro";
import GlassNav from "../../components/GlassNav.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import themesData from "../../data/themes-index.json";
import themePalettes from "../../data/themes-full.json";
import { buildThemeInstallUrl } from "../../lib/themeInstallLink.mjs";

const title = "Themes — Myne";
const description =
  "Community themes for Myne. Browse and open one straight in the app — validated on your device, never sandboxed.";
const canonical = new URL("/themes/", Astro.site!).toString();

const themes = (themesData.themes ?? []) as Array<{
  slug: string;
  name: string;
  author: string;
  description: string;
  license: string;
  appearance?: "light" | "dark";
  github: string;
  download: string;
  preview: string | null;
  swatches: {
    background: string;
    surface: string;
    foreground: string;
    accent: string;
    line: string;
  };
}>;

const REPO = "https://github.com/myne-md/myne-themes";

// MYND-568: the one-click hand-off. Each card's primary action is a
// `myne://theme/install` link carrying the whole palette, so clicking it opens
// the theme IN Myne (with a confirm dialog) instead of dropping a JSON file the
// user then has to find and import by hand.
//
// The palette rides inside the URL because the app has no network egress path
// and so cannot fetch a `src` — see `src/lib/themeInstallLink.mjs`. Built once
// here at BUILD time: no runtime fetch, no client JS, no tracker.
//
// `installUrl` is null when a theme has no palette in `themes-full.json` or
// would exceed the URL budget. That is a graceful degrade, not an error — the
// card then shows the plain `.json` download as the only path.
const palettes = themePalettes as Record<string, Record<string, string>>;
const cards = themes.map((t) => ({
  ...t,
  installUrl: buildThemeInstallUrl({
    name: t.name,
    palette: palettes[t.slug],
    author: t.author,
    source: t.github,
  }),
}));
---

<LandingLayout title={title} description={description} canonical={canonical}>
  <div
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e6e6e4;background:#0a0a0a;min-height:100vh;"
  >
    <GlassNav />

    <section style="padding:128px 28px 40px;">
      <div style="max-width:1280px;margin:0 auto;">
        <div class="mono up" style="font-size:11px;color:#8aa4d0;margin-bottom:18px;">
          Themes
        </div>
        <h1
          style="font-size:clamp(34px,5vw,60px);line-height:1.0;font-weight:700;letter-spacing:-0.035em;"
        >
          Make it yours.
        </h1>
        <p style="margin-top:22px;max-width:64ch;font-size:16px;line-height:1.65;color:#8a8a86;">
          Community themes for Myne. Pick one and it
          <span style="color:#cfcfca;">opens in the app</span>, which shows you what
          it is and asks before applying it — or download the
          <span style="color:#cfcfca;">.json</span> and import it yourself from
          Settings → Appearance. A theme is a small, validated palette — not code —
          and Myne <span style="color:#cfcfca;">validates it on your device</span>.
          We don't sandbox themes and we don't call this "safe"; the theme travels
          inside the link, so the app never phones this page, and there are no
          trackers or download counters here. Themes you keep are stored as
          encrypted vault content, so they sync to your other devices and travel
          in your backups.
        </p>
        <a
          href="/themes/builder"
          class="tbuild-cta"
          style="display:inline-flex;align-items:center;gap:8px;margin-top:30px;background:#e6e6e4;color:#0a0a0a;text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;transition:background 0.15s ease;"
          >Build your own →</a
        >
      </div>
    </section>

    <section style="padding:8px 28px 100px;">
      <div style="max-width:1280px;margin:0 auto;">
        {
          themes.length === 0 ? (
            <p class="mono" style="color:#6a6a66;font-size:13px;">
              No themes published yet.{" "}
              <a href={`${REPO}/blob/main/CONTRIBUTING.md`} style="color:#8aa4d0;text-decoration:none;">
                Contribute the first one →
              </a>
            </p>
          ) : (
            <>
            {cards.some((c) => c.installUrl) && (
              <p class="tgrid-hint">
                <strong>Open in Myne</strong> hands the theme to the desktop app, which
                shows you what it is and asks before applying it — nothing lands in your
                Downloads folder. No Myne yet? <a href="/download">Get the app</a>, or use
                <strong>Download .json</strong> and import it from Settings → Appearance.
                On a phone, use the download — the hand-off is desktop-only.
              </p>
            )}
            <div class="tgrid">
              {cards.map((t) => (
                <article class="tcard">
                  <div class="tcard-preview" style={`background:${t.swatches.background};`}>
                    {t.preview ? (
                      <img src={t.preview} alt={`${t.name} preview`} loading="lazy" width="1200" height="760" />
                    ) : (
                      <div class="tcard-swatchfill">
                        {Object.values(t.swatches).map((c) => (
                          <span style={`background:${c};`} />
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="tcard-body">
                    <div class="tcard-titlerow">
                      <h2 class="tcard-name">{t.name}</h2>
                      {t.appearance && (
                        <span class="tcard-chip mono up">{t.appearance}</span>
                      )}
                    </div>
                    <div class="tcard-author mono">by {t.author}</div>
                    <p class="tcard-desc">{t.description}</p>
                    <div class="tcard-swatches" aria-hidden="true">
                      {Object.values(t.swatches).map((c) => (
                        <span style={`background:${c};`} />
                      ))}
                    </div>
                    <div class="tcard-actions mono up">
                      {
                        t.installUrl && (
                          <a
                            class="tbtn tbtn-primary tbtn-open"
                            href={t.installUrl}
                            aria-label={`Open ${t.name} in Myne`}
                          >
                            Open in Myne
                          </a>
                        )
                      }
                      <a
                        class:list={["tbtn", t.installUrl ? "tbtn-ghost tbtn-file" : "tbtn-primary"]}
                        href={t.download}
                        download={`${t.slug}.json`}
                        aria-label={`Download ${t.name} as JSON`}
                      >
                        Download .json
                      </a>
                      <a
                        class="tbtn tbtn-ghost"
                        href={t.github}
                        target="_blank"
                        rel="noopener"
                        aria-label={`${t.name} on GitHub`}
                      >
                        GitHub
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
            </>
          )
        }

        <div
          class="mono"
          style="margin-top:44px;border-top:1px solid rgba(255,255,255,0.1);padding:30px 0 0;font-size:12.5px;line-height:1.8;color:#6a6a66;max-width:70ch;"
        >
          Want to share your own? Themes live in the{" "}
          <a href={REPO} style="color:#8aa4d0;text-decoration:none;">myne-themes</a>{" "}
          repository — one folder, one pull request. Every submission is checked by
          the <em>same validator the app runs</em> plus a contrast check, then reviewed
          by a maintainer. Contributed themes are{" "}
          <a href={`${REPO}/blob/main/LICENSING.md`} style="color:#8aa4d0;text-decoration:none;">CC-BY-4.0</a>.
        </div>
      </div>
    </section>

    <footer style="border-top:1px solid rgba(255,255,255,0.1);padding:36px 28px;">
      <div
        class="mono up"
        style="max-width:1280px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:10px;color:#54544f;"
      >
        <span>© 2026 Myne · AGPL-3.0 · CC-BY-4.0 docs</span><StatusBadge /><span>v0.1 · pre-alpha</span>
      </div>
    </footer>
  </div>

  <style>
    .tbuild-cta:hover {
      background: #ffffff;
    }
    .tgrid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 22px;
    }
    .tcard {
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      overflow: hidden;
      background: #0c0c0c;
      display: flex;
      flex-direction: column;
      transition: border-color 0.18s ease, transform 0.18s ease;
    }
    .tcard:hover {
      border-color: rgba(255, 255, 255, 0.22);
      transform: translateY(-2px);
    }
    .tcard-preview {
      aspect-ratio: 1200 / 760;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }
    .tcard-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .tcard-swatchfill {
      display: flex;
      width: 100%;
      height: 100%;
    }
    .tcard-swatchfill span {
      flex: 1;
    }
    .tcard-body {
      padding: 20px 20px 22px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .tcard-titlerow {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .tcard-name {
      margin: 0;
      font-size: 19px;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: #e6e6e4;
    }
    .tcard-chip {
      margin-left: auto;
      font-size: 9px;
      color: #8aa4d0;
      border: 1px solid rgba(138, 164, 208, 0.35);
      border-radius: 999px;
      padding: 3px 9px;
    }
    .tcard-author {
      margin-top: 5px;
      font-size: 11px;
      color: #6a6a66;
    }
    .tcard-desc {
      margin: 13px 0 0;
      font-size: 14px;
      line-height: 1.55;
      color: #a7a7a2;
      flex: 1;
    }
    .tcard-swatches {
      display: flex;
      gap: 6px;
      margin-top: 18px;
    }
    .tcard-swatches span {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .tcard-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
    }
    /* MYND-568: the two-path explainer under the actions. A browser cannot
       reliably report whether a `myne://` link resolved, so the fallback is a
       PERMANENTLY VISIBLE second path rather than a timeout guess or UA
       sniffing — the user is told what each button does and picks. */
    /* One explainer above the grid, not one per card: the per-card affordance
       is the Download .json button itself, and repeating the prose would put N
       identical sentences in the screen-reader flow and N duplicate "Get the
       app" links in the tab order. */
    .tgrid-hint {
      margin: 0 0 26px;
      max-width: 78ch;
      font-size: 13px;
      line-height: 1.7;
      color: #8a8a86;
    }
    .tgrid-hint strong {
      color: #cfcfca;
      font-weight: 600;
    }
    .tgrid-hint a {
      color: #8aa4d0;
      text-decoration: none;
    }
    .tgrid-hint a:hover {
      text-decoration: underline;
    }
    .tbtn {
      font-size: 10px;
      text-decoration: none;
      border-radius: 7px;
      padding: 9px 16px;
      border: 1px solid transparent;
    }
    .tbtn-primary {
      background: #e6e6e4;
      color: #0a0a0a;
      font-weight: 600;
    }
    .tbtn-primary:hover {
      background: #fff;
    }
    .tbtn-ghost {
      color: #cfcfca;
      border-color: rgba(255, 255, 255, 0.2);
    }
    .tbtn-ghost:hover {
      border-color: rgba(255, 255, 255, 0.4);
    }
    @media (max-width: 600px) {
      .tgrid {
        grid-template-columns: 1fr;
      }
    }
    /* Mobile degrade (MYND-568): "Open in Myne" is a DESKTOP hand-off. On a
       phone the tap either does nothing or — since the mobile client registers
       the same `myne://` scheme for its widgets — launches the mobile app,
       which ignores the `theme` action. Either way the file download is the
       useful path there, so on coarse-pointer devices the two swap visual
       weight.

       Weight only, deliberately NOT `order`: reordering with flex `order` would
       leave the third button (GitHub, unstyled by this block) at the default
       `order: 0` and hoist it to the front, and would desync visual order from
       DOM/tab order (WCAG 2.4.3 Focus Order, 1.3.2 Meaningful Sequence). Both
       links stay present and functional either way — a touchscreen laptop
       classed as "coarse" loses only button prominence, never a path. A media
       feature, not UA sniffing. */
    @media (pointer: coarse) {
      .tcard-actions .tbtn-open {
        background: transparent;
        color: #cfcfca;
        font-weight: 400;
        border-color: rgba(255, 255, 255, 0.2);
      }
      .tcard-actions .tbtn-file {
        background: #e6e6e4;
        color: #0a0a0a;
        font-weight: 600;
        border-color: transparent;
      }
    }
  </style>
</LandingLayout>
