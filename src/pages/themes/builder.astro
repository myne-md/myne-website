---
/*
 * Theme Builder: the no-code custom-theme authoring tool (MYND-346).
 *
 * Slice 1 (builder-shell-entry): the page frame only: dark LandingLayout+GlassNav
 * chrome, a builder toolbar with the Export affordance, and a full-page no-scroll
 * two-pane layout with empty named slots the sibling slices fill:
 *   - #tb-config-slot  ← builder-controls (left)
 *   - #tb-preview-slot ← builder-preview (right)
 *   - #tb-export-btn   ← builder-export (opens the submit modal; no-op for now)
 *
 * No new nav entry: reached only from the /themes gallery "Build your own" CTA.
 * The page-scoped overflow lock keeps other dark pages (min-height:100vh) intact.
 */
import LandingLayout from "../../layouts/LandingLayout.astro";
import GlassNav from "../../components/GlassNav.astro";
import TokenControl from "../../components/themeBuilder/TokenControl.astro";
import MeasureControl from "../../components/themeBuilder/MeasureControl.astro";
import { GROUPS, labelFor } from "../../lib/themeBuilder/manifest.mjs";
import {
  PRESETS,
  ROLES,
  TINT_CEILING,
  ornamentToken,
  primitivesForRole,
} from "../../lib/themeBuilder/ornament.mjs";
import { MEASURE_GROUPS } from "../../lib/themeBuilder/measure.mjs";
import { LIGHT_DEFAULTS } from "../../lib/themeBuilder/tokens.mjs";
import themesIndex from "../../data/themes-index.json";
import themesFull from "../../data/themes-full.json";
import previewMeta from "../../data/preview/meta.json";

// The captured snapshot's identity, used to version its URL. The endpoint caches
// (it is ~190 KB, and a deploy is what changes it), so without this a browser
// that had already loaded the PREVIOUS capture kept serving it from cache after
// a re-capture: which is what a "the preview is still the old app" report was.
const previewVersion =
  (previewMeta as { surfaceHash?: string }).surfaceHash?.slice(0, 12) ?? "0";

const val = (token: string): string => LIGHT_DEFAULTS[token] ?? "#000000";

// Gallery themes that have a full vendored palette → "start from" presets.
const galleryThemes = (themesIndex.themes ?? [])
  .filter((t) => t.slug in themesFull)
  .map((t) => ({ slug: t.slug, name: t.name, dark: t.appearance === "dark" }));
---

<LandingLayout
  title="Theme Builder — Myne"
  description="Build your own Myne theme with live preview — pick colors, see them applied, download or share."
  notice="none"
  themeLock
>
  <div class="tb-page">
    <GlassNav />

    <main class="tb">
      <div class="tb-inner">
    {/* Builder toolbar — sits under GlassNav (which we keep verbatim). Holds the
        tool title and the Export affordance. Task 5 adds the mobile Edit/Preview
        toggle into the .tb-bar-mid slot. */}
    <div class="tb-bar">
      <div class="tb-bar-title mono up">Theme Builder</div>
      <div class="tb-bar-mid">
        {/* Mobile-only Edit/Preview toggle (task 5). Hidden on desktop. */}
        <div class="tb-seg" role="tablist" aria-label="Edit or preview">
          <button
            type="button"
            class="tb-seg-btn is-active"
            data-tb-pane="config"
            role="tab"
            aria-selected="true">Edit</button
          >
          <button
            type="button"
            class="tb-seg-btn"
            data-tb-pane="preview"
            role="tab"
            aria-selected="false">Preview</button
          >
        </div>
      </div>
      <div class="tb-bar-actions">
        {/* Two shortcuts beside Export, in the order a theme author uses them:
            try it in the real app, then share it. Both are wired in the export
            block below, which already owns the metadata fields the share link
            needs; neither is a second code path to the app or to GitHub. */}
        <button
          type="button"
          id="tb-open-in-myne"
          class="tb-bar-btn mono up"
          title="Hand this theme to the desktop app without downloading anything"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14 4h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M20 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Open in Myne</span>
        </button>
        <button
          type="button"
          id="tb-share-btn"
          class="tb-bar-btn mono up"
          title="Open a prefilled gallery submission. A maintainer turns it into a pull request."
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="6" cy="6" r="2.5" stroke="currentColor" stroke-width="1.7" />
            <circle cx="6" cy="18" r="2.5" stroke="currentColor" stroke-width="1.7" />
            <circle cx="18" cy="12" r="2.5" stroke="currentColor" stroke-width="1.7" />
            <path d="M8.4 7.3L15.7 10.8M8.4 16.7L15.7 13.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          </svg>
          <span>Share</span>
        </button>
        <button type="button" id="tb-export-btn" class="tb-export mono up">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <path d="M7.5 10.5L12 15l4.5-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <span>Export</span>
        </button>
      </div>
    </div>

    <div class="tb-panes" data-mobile-pane="config">
      <section class="tb-pane tb-pane--config" aria-label="Theme controls">
        <div id="tb-config-slot" class="tb-slot tb-controls">
          {/* Quick actions. Forty-four colours need a way to FIND one, and a
              panel that only scrolls is a panel people stop reading. Search
              filters the rows; "Modified" narrows to what changed since the
              starting point; "Surprise me" rolls a complete palette. */}
          <div class="tb-quick">
            <input
              type="search"
              id="tb-filter"
              class="tb-search"
              placeholder="Search colours and settings"
              aria-label="Search the theme controls"
              autocomplete="off"
            />
            <button
              type="button"
              id="tb-randomize-all"
              class="tb-qbtn tb-qbtn--icon"
              aria-label="Surprise me: roll a complete palette"
              title="Surprise me. Roll a complete palette from one random hue."
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width="1.7" />
                <circle cx="8.7" cy="8.7" r="1.5" fill="currentColor" />
                <circle cx="15.3" cy="15.3" r="1.5" fill="currentColor" />
                <circle cx="12" cy="12" r="1.5" fill="currentColor" />
              </svg>
            </button>
            <button
              type="button"
              id="tb-modified-toggle"
              class="tb-qbtn tb-qbtn--icon"
              aria-pressed="false"
              aria-label="Show only the colours you have changed"
              title="Show only the colours you have changed"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3 5h18l-7 8.5V20l-4-2v-4.5L3 5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>

          <div class="tb-preset">
            <span id="tb-preset-label" class="tb-preset-label mono up">Start from</span>
            <div class="tb-preset-row">
              {/* A real dropdown rather than a <select>. The native control's
                  caret is drawn by the OS a couple of pixels from the border and
                  its popup cannot be styled at all, so it was the one place in
                  the panel that did not look like Myne. This keeps the native
                  listbox semantics (aria-haspopup, arrow keys, Escape) and
                  replaces only the skin. */}
              <div class="tb-dd">
                <button
                  type="button"
                  id="tb-preset-trigger"
                  class="tb-dd-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="tb-preset-label tb-preset-value"
                >
                  <span id="tb-preset-value" class="tb-dd-value">Blank (light)</span>
                  <svg class="tb-dd-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div
                  id="tb-preset-menu"
                  class="tb-dd-menu"
                  role="listbox"
                  aria-labelledby="tb-preset-label"
                  hidden
                >
                  <button type="button" class="tb-dd-option" role="option" data-value="light" aria-selected="true">
                    Blank: light
                  </button>
                  <button type="button" class="tb-dd-option" role="option" data-value="dark" data-dark="true" aria-selected="false">
                    Blank: dark
                  </button>
                  {galleryThemes.length > 0 && (
                    <>
                      <div class="tb-dd-group mono up" role="presentation">Gallery themes</div>
                      {galleryThemes.map((t) => (
                        <button
                          type="button"
                          class="tb-dd-option"
                          role="option"
                          data-value={`theme:${t.slug}`}
                          data-dark={t.dark ? "true" : "false"}
                          aria-selected="false"
                        >
                          {t.name}
                        </button>
                      ))}
                    </>
                  )}
                </div>
              </div>
              <button
                type="button"
                id="tb-reset"
                class="tb-reset tb-qbtn--icon"
                aria-label="Reset to this starting point"
                title="Reset to this starting point"
              >
                {/* Lucide `refresh-cw`, AS DRAWN. Two things were wrong before
                    this: the button was 58px wide because `.tb-reset`'s
                    horizontal padding outranked the square variant, and the
                    glyph was a hand-rolled near-circle with its arrow corner at
                    the top-left, so the INK sat left of centre inside a centred
                    SVG box and read as crooked. This one is symmetric under
                    180 degrees, so it cannot read as off-centre. */}
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M3 3v5h5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M16 16h5v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <p id="tb-dark-note" class="tb-dark-note" hidden>
              Dark theme — the optional colors are pre-filled from Myne's dark palette. Adjust them
              under Code highlighting, Color labels and Text highlights.
            </p>
          </div>

          {/* One group per TONE FAMILY: the anchor colour, then the shades that
              follow from it. The relationship is the control: the link button
              on a derived row is what lets an author break it: so the panel no
              longer explains derivation in a paragraph under each heading. The
              paragraph is now the `?` tooltip, where it can be asked for. */}
          {
            GROUPS.map((g) => (
              <section class="tb-group" data-group={g.id} data-filter="rows" data-label={g.label.toLowerCase()}>
                <div class="tb-group-head">
                  {g.disclosure ? (
                    <button
                      type="button"
                      class="tb-group-title tb-fold mono up"
                      data-fold={`tb-fold-${g.id}`}
                      aria-expanded="false"
                      aria-controls={`tb-fold-${g.id}`}
                    >
                      {g.label}
                    </button>
                  ) : (
                    <h3 class="tb-group-title mono up">{g.label}</h3>
                  )}
                </div>
                {g.hint && <p class="tb-group-hint">{g.hint}</p>}
                <div
                  class="tb-group-body"
                  id={`tb-fold-${g.id}`}
                  data-folded={g.disclosure ? "true" : "false"}
                >
                  <div class="tb-group-inner">
                    {g.tokens.map((t) => (
                      <TokenControl
                        token={t.token}
                        label={t.label}
                        value={val(t.token)}
                        derivesFrom={t.derivesFrom}
                        anchorLabel={t.derivesFrom ? labelFor(t.derivesFrom) : undefined}
                      />
                    ))}
                  </div>
                </div>
              </section>
            ))
          }

          {/* Ornament (myne#394). Chosen per ROLE rather than per element, which
              is what keeps a complete theme ~30 settings instead of several
              hundred. Every control is optional: a colour-only theme is still a
              complete theme, and the presets below only fill these same selects.

              A section, not a <details>: two shapes of the same idea meant the
              hint lived in two places and only one of them animated. Every
              group folds the same way now. */}
          <section
            class="tb-group"
            data-group="ornament"
            data-filter="group"
            data-label="ornament decoration frames shadows textures folds tint wash"
          >
            <div class="tb-group-head">
              <button
                type="button"
                class="tb-group-title tb-fold mono up"
                data-fold="tb-fold-ornament"
                aria-expanded="false"
                aria-controls="tb-fold-ornament">Ornament</button
              >
            </div>
            <p class="tb-group-hint">
              Decoration Myne draws for you: pick the parts, not a finished look. Ornament never
              moves anything, and anything drawn behind text is capped so the words stay readable.
            </p>
            <div class="tb-group-body" id="tb-fold-ornament" data-folded="true">
              <div class="tb-group-inner">
                <div class="tb-orn-presets" role="group" aria-label="Ornament starting points">
                  {PRESETS.map((preset) => (
                    <button
                      type="button"
                      class="tb-orn-preset"
                      data-preset={preset.id}
                      data-preset-role={preset.role}
                      data-preset-set={JSON.stringify(preset.set)}
                    >
                      {preset.label}
                    </button>
                  ))}
                </div>

                {ROLES.map((role) => (
                  <section class="tb-orn-role">
                    <div class="tb-orn-role-head mono up">{role.label}</div>
                    <p class="tb-group-hint">{role.hint}</p>
                    {primitivesForRole(role.id).map((primitive) => (
                      <label class="tb-orn-ctl">
                        <span class="tb-orn-label">
                          {primitive.label}
                          <span class="tb-orn-hint">{primitive.hint}</span>
                        </span>
                        <select
                          class="tb-orn-select"
                          data-ornament-token={ornamentToken(role.id, primitive.id)}
                          data-ornament-role={role.id}
                          data-ornament-primitive={primitive.id}
                        >
                          {primitive.values.map((v) => (
                            <option value={v.value}>{v.label}</option>
                          ))}
                        </select>
                      </label>
                    ))}
                  </section>
                ))}

                {/* The tint wash: one colour and one strength for the whole
                    interface, not per role: that is what the ornament layer
                    composes, and offering it per role would store keys nothing
                    ever draws. The strength stops at the app's own ceiling; a
                    slider that ran past it would show the user a wash the app
                    clamps back down. */}
                <section class="tb-orn-role">
                  <div class="tb-orn-role-head mono up">Tint wash</div>
                  <p class="tb-group-hint">
                    A colour laid over everything. Capped so it can never bury the text.
                  </p>
                  {/* Rendered through the SAME component as every other colour
                      row. The hand-written copy here is what left this one
                      control unstyled: `.tb-ctl` lives in TokenControl's scoped
                      stylesheet, which cannot reach markup the page writes. */}
                  <TokenControl token="--tint" label="Tint colour" value="transparent" />
                  <label class="tb-mc" data-tint-strength>
                    <span class="tb-mc-head">
                      <span class="tb-mc-label">Strength</span>
                      <output class="tb-mc-value mono"></output>
                    </span>
                    <input
                      type="range"
                      class="tb-mc-range"
                      min="0"
                      max={TINT_CEILING}
                      step="0.01"
                      value="0"
                    />
                  </label>
                </section>
              </div>
            </div>
          </section>

          {/* Measure tokens (myne#394). Density, corners, type scale, weight and
              letter spacing — every one bounded to 0.5×–2× of its built-in
              default, which is the same envelope the app clamps to. The bounds
              are established on hydration from the preview's own token sheet,
              never from a table in this repo. */}
          <section
            class="tb-group"
            data-group="measure"
            data-filter="group"
            data-label="shape size density corners type scale spacing letter spacing weight"
          >
            <div class="tb-group-head">
              <button
                type="button"
                class="tb-group-title tb-fold mono up"
                data-fold="tb-fold-measure"
                aria-expanded="false"
                aria-controls="tb-fold-measure">Shape &amp; size</button
              >
            </div>
            <p class="tb-group-hint">
              How dense, how round and how large the interface is. Each control moves within half to
              double Myne's own value: enough to reshape it, not enough to make it unusable.
            </p>
            <div class="tb-group-body" id="tb-fold-measure" data-folded="true">
              <div class="tb-group-inner">
                {MEASURE_GROUPS.map((g) => (
                  <section class="tb-orn-role">
                    <div class="tb-orn-role-head mono up">{g.label}</div>
                    <p class="tb-group-hint">{g.hint}</p>
                    {g.tokens.map((t) => (
                      <MeasureControl token={t.token} label={t.label} unit={g.unit} step={g.step} />
                    ))}
                  </section>
                ))}
              </div>
            </div>
          </section>
        </div>
      </section>
      <section class="tb-pane tb-pane--preview" aria-label="Live preview">
        <div id="tb-preview-slot" class="tb-slot tb-preview-slot">
          {/* Contrast findings, from the 5 shared CONTRAST_RULES. One banner,
              one paragraph: a chip per finding read as a row of unrelated
              labels, and loose chips cannot say WHY a pair fails. */}
          <div id="tb-readability" class="tb-banner" hidden>
            <svg class="tb-banner-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3.5l9 16H3l9-16z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
              <path d="M12 10v4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              <circle cx="12" cy="17.2" r="1" fill="currentColor" />
            </svg>
            <div class="tb-banner-body">
              <div class="tb-banner-title mono up">Issues found</div>
              <p class="tb-banner-text" id="tb-readability-text"></p>
            </div>
          </div>
          {/* The REAL Myne interface (myne#394): the editor's own DOM and its own
              stylesheet, captured from the running desktop app and served by
              `preview-frame.html.ts`. It is an iframe rather than inlined markup
              because its CSS is written against `:root` / `:root[data-o-*]`
              selectors and therefore has to BE a document root — and because
              this page's own stylesheet must not leak into it, which is the
              drift the snapshot exists to end. Same-origin, so the apply engine
              below reaches `contentDocument` and drives the palette through
              per-property `setProperty`, exactly as the app drives `:root`. */}
          {/* The stage clips and scales; the frame keeps the capture's own
              1280×800 geometry. Letting the iframe take the pane's width would
              REFLOW the app into a narrow layout — previewing a responsive
              screen the theme author is not dressing. */}
          {/* No `allow-scripts` on the frame below: the captured document
              carries no script of its own (the capture strips them), and the
              builder reaches in from the parent rather than posting messages.
              The comment sits ABOVE the tag rather than between its attributes
              Astro parses an attribute list as markup, not as JSX, so a JSX
              comment block in that position is a syntax error. (Written out
              rather than as the literal brace-star form: that form closing
              here would terminate THIS comment early and leak the rest of the
              sentence into the page as text.) */}
          <div id="tb-pv-stage" class="tb-pv-stage">
            {/* No `src`: the snapshot is fetched and written into `srcdoc` by
                the preview block below. A framed HTTP RESPONSE is subject to
                the origin's own `X-Frame-Options`, and myne.md sends DENY
                (clickjacking cover for the whole site): which blocks a
                SAME-ORIGIN frame just as flatly as a third-party one, so the
                built site showed a browser error where the preview belongs
                while localhost, which sends no such header, worked. An
                `about:srcdoc` document has no response and therefore no
                header to honour; same-origin is inherited, so the apply engine
                still reaches `contentDocument`. */}
            <iframe
              id="tb-pv-frame"
              class="tb-pv-frame"
              data-preview-version={previewVersion}
              title="Live preview of the Myne interface with your theme applied"
              loading="eager"
              sandbox="allow-same-origin"></iframe>
          </div>
        </div>
      </section>
    </div>
      </div>
    </main>

    {/* Export modal — single primary action (Download) + one supporting affordance
        (Share), per the myne-website modal carve-out (decisions.md 2026-05-03).
        Sits OUTSIDE .tb so its top-layer centering isn't affected by the fixed pane. */}
    <dialog id="tb-export-modal" class="tb-modal" data-mode="export" aria-labelledby="tb-modal-title">
      <div class="tb-modal-card">
        <div class="tb-modal-head">
          <div class="tb-modal-headtext">
            <h2 id="tb-modal-title" class="tb-modal-title">Export your theme</h2>
            <p id="tb-modal-blurb" class="tb-modal-blurb"></p>
          </div>
          <button type="button" class="tb-modal-x" data-tb-close aria-label="Close">×</button>
        </div>
        <div class="tb-modal-body">
          <label class="tb-field">
            <span class="tb-field-label">Theme name</span>
            <input type="text" id="tb-meta-name" class="tb-field-input" maxlength="60" placeholder="e.g. Nord Dusk" />
          </label>
          <label class="tb-field">
            <span class="tb-field-label">Your name</span>
            <input type="text" id="tb-meta-author" class="tb-field-input" maxlength="80" placeholder="e.g. Ada Lovelace" />
          </label>
          <label class="tb-field">
            <span class="tb-field-label">Description</span>
            <textarea id="tb-meta-desc" class="tb-field-input tb-field-area" maxlength="280" rows="2" placeholder="A short line about the vibe."></textarea>
          </label>
          <div id="tb-export-status" class="tb-export-status" hidden></div>
        </div>
        <div class="tb-modal-foot">
          <div class="tb-modal-primary-slot">
            <button type="button" id="tb-download" class="tb-modal-primary mono up">Download both files</button>
            <a id="tb-open-pr" class="tb-modal-primary mono up" href="#" target="_blank" rel="noopener" hidden>Open a pull request</a>
          </div>
          <div class="tb-modal-alt">
            <button type="button" id="tb-mode-share" class="tb-modal-secondary">
              Also submit it to the gallery →
            </button>
            <button type="button" id="tb-mode-export" class="tb-modal-secondary" hidden>
              Export only instead
            </button>
          </div>
        </div>
        <p id="tb-modal-note" class="tb-modal-note"></p>
      </div>
    </dialog>
  </div>
</LandingLayout>

{/* Page-scoped no-scroll lock. `is:global` on THIS page only — it ships in the
    builder route's bundle, so other LandingLayout pages (which scroll via
    min-height:100vh) never see it. */}
<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  /* Custom color picker: appended to <body>, so styled globally (scoped styles
     wouldn't reach a JS-created element). Dark, on-register, Inter. */
  .tb-cp {
    position: fixed;
    z-index: 200;
    width: 224px;
    padding: 10px;
    background: #0c0c0c;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
