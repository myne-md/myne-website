---
---

<section id="identity">
  <div class="container">
    <div class="feature">
      <div>
        <div class="section-eyebrow">Identity</div>
        <h3>Your account is a number you keep.</h3>
        <p>
          No email field, no phone field, no recovery question. Signup gives you
          an account number — yours to write down, store offline, or hand to a
          password manager.
        </p>
        <p>
          The server keeps only its hash. We can't reset it, sell it, or mail you
          about it. There is nothing to mail.
        </p>
        <ul>
          <li>95 bits of entropy across 19 Crockford-base32 characters</li>
          <li>1 Damm-32 check character — single-typo recovery</li>
          <li>Non-breaking hyphens — never wraps mid-group</li>
          <li>Single click selects the whole value</li>
          <li>Slashed-zero monospace — no <code>0/O</code> ambiguity</li>
        </ul>
      </div>
      <div class="visual">
        <div class="acct">
          <div class="big-row">
            <span id="big-acct" class="big" aria-label="Live demo account number — click to regenerate">MY‑XXXX‑XXXX‑XXXX‑XXXX‑XXXX</span>
            <button class="reroll" type="button" id="big-acct-reroll" aria-label="Generate a new account number">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 12a9 9 0 0 1 15.5-6.3L21 8" />
                <path d="M21 3v5h-5" />
                <path d="M21 12a9 9 0 0 1-15.5 6.3L3 16" />
                <path d="M3 21v-5h5" />
              </svg>
            </button>
          </div>
          <div class="anno">
            <code>MY</code>
            <span>Fixed prefix — distinguishes Myne account numbers from arbitrary base32.</span>
            <code>1–4</code>
            <span>First entropy group. Non-breaking hyphens (U+2011) — never wraps mid-group.</span>
            <code>20</code>
            <span>Damm-32 check character. Single-typo recovery, single-transposition recovery.</span>
            <code>·</code>
            <span class="demo-note">Demo — fresh CSPRNG draw on every click. Production includes the spec §4 Damm-32 check.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 0;
    border-bottom: 1px solid var(--line-1);
  }
  .section-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 16px;
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 48px 0;
  }
  .feature h3 {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 600;
    margin: 0 0 16px;
    color: var(--fg-display);
  }
  .feature p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg-2);
    margin: 0 0 16px;
  }
  .feature ul {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .feature li {
    padding: 8px 0 8px 24px;
    border-top: 1px solid var(--line-1);
    position: relative;
    font-size: 14px;
    color: var(--fg-1);
  }
  .feature li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 16px;
    width: 12px;
    height: 1px;
    background: var(--fg-3);
  }
  .feature code {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--paper-2);
    border: 1px solid var(--line-1);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .visual {
    background: var(--paper-2);
    border: 1px solid var(--line-1);
    border-radius: 8px;
    padding: 32px;
    min-height: 320px;
  }
  .acct {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .big-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .big {
    font-family: var(--font-mono);
    font-size: 28px;
    letter-spacing: 0.04em;
    font-weight: 500;
    font-feature-settings: "ss02", "zero", "calt";
    white-space: nowrap;
    user-select: all;
    color: var(--fg-1);
    cursor: pointer;
  }
  .reroll {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--line-1);
    background: var(--bg-1);
    color: var(--fg-3);
    cursor: pointer;
    transition:
      color 120ms var(--ease-standard),
      background 120ms var(--ease-standard),
      border-color 120ms var(--ease-standard);
  }
  .reroll:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .reroll :global(.ico) { width: 16px; height: 16px; }
  .demo-note {
    color: var(--fg-3) !important;
    font-style: italic;
  }
  .anno {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px 16px;
    font-size: 12.5px;
    align-items: baseline;
  }
  .anno code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    background: transparent;
    border: 0;
    padding: 0;
    font-feature-settings: "ss02", "zero";
  }
  .anno span {
    color: var(--fg-2);
    line-height: 1.5;
  }

  @media (max-width: 920px) {
    .feature {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 0;
    }
    .big { font-size: 22px; }
  }
</style>

<script>
  import { mountAccountNumber, generateAccountNumber, animateAccountNumber } from "../scripts/account-number";
  const big = document.getElementById("big-acct");
  const reroll = document.getElementById("big-acct-reroll");
  if (big) {
    mountAccountNumber(big);
    if (reroll) {
      reroll.addEventListener("click", (e) => {
        e.stopPropagation();
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const next = generateAccountNumber();
        if (reduce) big.textContent = next;
        else animateAccountNumber(big, next);
      });
    }
  }
</script>
