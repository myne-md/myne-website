---
/*
 * Shared glassy top bar so the landing and the user guide carry an identical
 * navbar. Anchors are absolute (/#…) so the section links also work from the
 * user-guide routes (they navigate to the landing and scroll). Relies on the
 * .up / .mono helper classes provided by LandingLayout, which wraps both.
 *
 * Responsive: on narrow viewports the centre links collapse behind a hamburger
 * that toggles a drop-down panel. The toggle is a pure-CSS checkbox hack — no
 * island, no JS runtime (CLAUDE.md: keep the bundle small).
 */
interface Props {
  /** Highlighted nav entry. */
  active?:
    | "home"
    | "work"
    | "method"
    | "commit"
    | "guide"
    | "roadmap"
    | "ledger"
    | "download"
    | "spec"
    | "security"
    | "releases";
  /** Enable scroll-spy: the landing page passes this so the in-page section
   *  links light up as their section scrolls into view. Other pages leave it
   *  off so the server-set `active` stays put. */
  spy?: boolean;
  /** User-guide pages pass this so the mobile drop-down carries the guide nav
   *  (provided via the `guide` slot) as its default pane, with a back button
   *  to the normal site nav. No separate sidebar drawer on mobile. */
  guide?: boolean;
}
const { active = "home", spy = false, guide = false } = Astro.props;

const links = [
  { key: "home", label: "Home", href: "/#top", spy: "top" },
  { key: "work", label: "How it works", href: "/#work", spy: "work" },
  { key: "method", label: "Compare", href: "/#capab", spy: "capab" },
  { key: "guide", label: "Guide", href: "/user-guide/getting-started/welcome/" },
  { key: "security", label: "Security", href: "/security/" },
  { key: "releases", label: "Releases", href: "/releases/" },
  { key: "roadmap", label: "Roadmap", href: "/roadmap/" },
  { key: "ledger", label: "Ledger", href: "/ledger/" },
] as const;
---

<header class="gnav" data-gnav-spy={spy ? "" : undefined}>
  <div class="gnav-inner">
    <a href="/#top" class="gnav-brand">
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none"
        ><path
          d="M8 22 V10 L16 18 L24 10 V22"
          stroke="#e6e6e4"
          stroke-width="2.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
      <span class="gnav-word">Myne</span>
    </a>

    {/* CSS-only toggle: the checkbox state drives the mobile panel. */}
    <input type="checkbox" id="gnav-toggle" class="gnav-toggle" aria-hidden="true" />

    <nav class="gnav-links up" data-gnav-panel data-pane={guide ? "guide" : "site"}>
      {/* Site pane — the links sit inline on desktop (wrapper is display:contents)
         and become the drop-down list on mobile. */}
      <div class="gnav-sitepane">
        {
          links.map((l) => (
            <a
              href={l.href}
              data-spy={"spy" in l ? l.spy : undefined}
              class:list={["gnav-link", { "is-active": active === l.key }]}
            >
              {l.label}
            </a>
          ))
        }
        {guide && (
          <button type="button" class="gnav-paneswitch" data-gnav-to-guide>
            Guide contents →
          </button>
        )}
        {/* Mobile-only CTA — the bar chip is hidden on narrow viewports. */}
        <a href="/download/" class="gnav-download gnav-download--panel up mono">
          Download
        </a>
      </div>

      {/* Guide pane — the full guide nav, the default pane on guide pages, with
         a back button to the site nav. Mobile-only. */}
      {guide && (
        <div class="gnav-guidepane">
          <div class="gnav-guidehead">
            <button type="button" class="gnav-paneback" data-gnav-to-site>
              ← Menu
            </button>
            <div class="gnav-guidesearch">
              <span class="gnav-guidesearch__slash mono">/</span>
              <input
                type="search"
                class="gnav-guidesearch__input mono"
                placeholder="Search"
                aria-label="Filter the guide"
                data-gnav-guide-search
              />
            </div>
          </div>
          <slot name="guide" />
        </div>
      )}
    </nav>

    <div class="gnav-actions mono">
      <a href="/download/" class="gnav-download up">Download</a>
    </div>

    <label for="gnav-toggle" class="gnav-burger" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </label>
  </div>
</header>

<style>
  .gnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    /* The 28px gutter lives on the full-width bar (not the inner box) so the
       inner column mirrors the page sections exactly: outer padding + a pure
       max-width:1280 centred inner. That lands the brand on the same edge as
       the hero/section content at every width. */
    padding: 0 28px;
    background: rgba(10, 10, 10, 0.18);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  .gnav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 18px 0;
  }

  .gnav-brand {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: #e6e6e4;
    flex-shrink: 0;
  }
  .gnav-word {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .gnav-links {
    display: flex;
    gap: 22px;
    font-size: 10.5px;
    color: #8a8a86;
  }
  .gnav-link {
    color: inherit;
    text-decoration: none;
  }
  .gnav-link.is-active {
    color: #e6e6e4;
  }

  /* Panes: on desktop the site links sit inline (the wrapper is transparent to
     layout via display:contents); the guide pane and the pane-switch controls
     are mobile-only. */
  .gnav-sitepane {
    display: contents;
  }
  .gnav-guidepane {
    display: none;
  }
  .gnav-paneswitch {
    display: none;
  }

  .gnav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 10.5px;
    color: #8a8a86;
    flex-shrink: 0;
  }
  .gnav-download {
    color: #e6e6e4;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    padding: 7px 13px;
    font-size: 10px;
  }
  /* Lives inside the drop-down panel; only surfaces on mobile. */
  .gnav-download--panel {
    display: none;
  }

  /* The checkbox + hamburger are desktop-hidden; the panel lives inside .gnav-links. */
  .gnav-toggle {
    display: none;
  }
  .gnav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 30px;
    height: 30px;
    padding: 4px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .gnav-burger span {
    display: block;
    height: 1.6px;
    width: 100%;
    background: #e6e6e4;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 920px) {
    /* The mobile bar is fully opaque — no see-through over the page beneath.
       Drop the bar's gutter so the drop-down panel spans edge to edge; the
       inner row carries the inset instead. */
    .gnav {
      padding: 0;
      background: #0a0a0a;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    /* 28px gutter matches the page sections so the brand/burger line up with
       the mobile content edges. */
    .gnav-inner {
      padding: 16px 28px;
    }

    /* Centre links become a full-height drop-down panel anchored under the bar. */
    .gnav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0 28px;
      background: #0a0a0a;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 12px;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .gnav-link {
      padding: 13px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .gnav-link:first-child {
      border-top: none;
    }

    /* Two panes (site links ↔ guide nav). Only one shows at a time, switched
       by the pane-switch buttons; on guide pages the panel opens on "guide". */
    .gnav-sitepane,
    .gnav-guidepane {
      flex-direction: column;
    }
    .gnav-links[data-pane="site"] .gnav-sitepane {
      display: flex;
    }
    .gnav-links[data-pane="site"] .gnav-guidepane {
      display: none;
    }
    .gnav-links[data-pane="guide"] .gnav-sitepane {
      display: none;
    }
    .gnav-links[data-pane="guide"] .gnav-guidepane {
      display: flex;
    }
    .gnav-paneswitch {
      display: block;
      width: 100%;
      text-align: left;
      background: transparent;
      border: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 14px 0;
      margin: 0;
      font: inherit;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #8aa4d0;
      cursor: pointer;
    }
    /* Guide pane head: "← Menu" sits inline next to the search box, no
       separator line. */
    .gnav-guidehead {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0 18px;
    }
    .gnav-paneback {
      flex: 0 0 auto;
      width: auto;
      background: transparent;
      border: 0;
      padding: 0;
      margin: 0;
      font: inherit;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #8a8a86;
      cursor: pointer;
      white-space: nowrap;
    }
    .gnav-guidesearch {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 8px;
      height: 38px;
      padding: 0 12px;
      background: #0c0c0c;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
    }
    .gnav-guidesearch:focus-within {
      border-color: rgba(138, 164, 208, 0.45);
    }
    .gnav-guidesearch__slash {
      flex: 0 0 auto;
      color: #54544f;
      font-size: 13px;
    }
    .gnav-guidesearch__input {
      flex: 1;
      min-width: 0;
      background: transparent;
      border: 0;
      outline: none;
      color: #e6e6e4;
      font-size: 13px;
      text-transform: none;
      letter-spacing: 0;
    }
    .gnav-guidesearch__input::placeholder {
      color: #54544f;
    }
    /* The wrapper's :focus-within border is the only focus indicator — kill the
       input's own outline so there's no double ring inside the rounded box. */
    .gnav-guidesearch__input:focus,
    .gnav-guidesearch__input:focus-visible {
      outline: none !important;
    }
    .gnav-guidepane {
      padding-bottom: 24px;
    }

    /* Download moves out of the bar and into the panel as a real CTA. */
    .gnav-actions {
      display: none;
    }
    .gnav-download--panel {
      display: block;
      margin: 14px 0 18px;
      padding: 12px 16px;
      text-align: center;
      font-size: 11px;
      border-color: rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.04);
    }

    /* Open state — a near-full-height sheet below the bar. */
    .gnav-toggle:checked ~ .gnav-links {
      max-height: calc(100vh - 56px);
      max-height: calc(100dvh - 56px);
      overflow-y: auto;
    }

    .gnav-burger {
      display: flex;
    }
    /* Animate the hamburger into an X when open. */
    .gnav-toggle:checked ~ .gnav-burger span:nth-child(1) {
      transform: translateY(5.6px) rotate(45deg);
    }
    .gnav-toggle:checked ~ .gnav-burger span:nth-child(2) {
      opacity: 0;
    }
    .gnav-toggle:checked ~ .gnav-burger span:nth-child(3) {
      transform: translateY(-5.6px) rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gnav-links,
    .gnav-burger span {
      transition: none;
    }
  }
</style>

<script>
  // Scroll-spy for the landing page — only runs where the bar opted in via
  // [data-gnav-spy] (the landing). Each in-page section link carries a
  // data-spy="<section-id>"; on scroll the link whose section the reader is
  // currently in gets .is-active. Pages without the opt-in keep their
  // server-set active entry untouched. Closing the mobile panel on a link tap
  // is handled here too so a same-page anchor jump doesn't leave it open.
  const bar = document.querySelector(".gnav[data-gnav-spy]");
  if (bar) {
    const spyLinks = Array.from(
      bar.querySelectorAll<HTMLAnchorElement>("[data-spy]"),
    );
    const targets = spyLinks
      .map((a) => ({ a, el: document.getElementById(a.dataset.spy!) }))
      .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => !!t.el);

    if (targets.length) {
      const header = bar as HTMLElement;
      let raf = 0;
      const update = () => {
        raf = 0;
        const y = window.scrollY + header.offsetHeight + 8;
        let active = targets[0];
        for (const t of targets) if (t.el.offsetTop <= y) active = t;
        // Pin the last section to the bottom-most link when the page is
        // scrolled to the very end (short final sections never cross the line).
        if (
          window.innerHeight + window.scrollY >=
          document.body.scrollHeight - 2
        )
          active = targets[targets.length - 1];
        spyLinks.forEach((a) => a.classList.toggle("is-active", a === active.a));
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }

  // Collapse the mobile drop-down after tapping any link inside it.
  const toggle = document.getElementById("gnav-toggle") as HTMLInputElement | null;
  if (toggle) {
    document.querySelectorAll(".gnav-links a").forEach((a) =>
      a.addEventListener("click", () => {
        toggle.checked = false;
      }),
    );
  }

  // Guide drop-down: switch between the guide nav and the site nav. The panel
  // re-opens on its default pane (guide, on guide pages) each time.
  const panel = document.querySelector<HTMLElement>("[data-gnav-panel]");
  if (panel) {
    const defaultPane = panel.dataset.pane || "site";
    const setPane = (p: string) => panel.setAttribute("data-pane", p);
    panel
      .querySelector("[data-gnav-to-guide]")
      ?.addEventListener("click", () => setPane("guide"));
    panel
      .querySelector("[data-gnav-to-site]")
      ?.addEventListener("click", () => setPane("site"));
    toggle?.addEventListener("change", () => {
      if (toggle.checked) setPane(defaultPane);
    });

    // Live-filter the guide nav from the search box in the guide pane head.
    const guideSearch = panel.querySelector<HTMLInputElement>(
      "[data-gnav-guide-search]",
    );
    if (guideSearch) {
      const cats = Array.from(panel.querySelectorAll<HTMLElement>(".gnl-cat"));
      guideSearch.addEventListener("input", () => {
        const q = guideSearch.value.trim().toLowerCase();
        cats.forEach((cat) => {
          let anyVisible = false;
          cat.querySelectorAll<HTMLElement>(".gnl-article").forEach((a) => {
            const match = !q || (a.textContent || "").toLowerCase().includes(q);
            const li = a.parentElement as HTMLElement | null;
            if (li) li.style.display = match ? "" : "none";
            if (match) anyVisible = true;
          });
          cat.style.display = anyVisible ? "" : "none";
        });
      });
    }
  }
</script>
