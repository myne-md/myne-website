---
---

<section class="cta" id="cta">
  <div class="container">
    <h2>Updates as we ship them.</h2>
    <p>
      We post on the ledger when there's a meaningful change to the threat
      model, protocol, or spec. No cadence promise — read when you want.
    </p>
    <a href="/ledger/" class="btn btn-primary btn-lg">
      Show updates
    </a>
  </div>
</section>

<style>
  .cta {
    text-align: left;
    border-bottom: 0;
  }
  .cta h2 {
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 20px;
    max-width: 720px;
    color: var(--fg-display);
  }
  .cta p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--fg-2);
    max-width: 620px;
    margin: 0 0 32px;
  }

  @media (max-width: 920px) {
    .cta h2 { font-size: 36px; }
  }
</style>
