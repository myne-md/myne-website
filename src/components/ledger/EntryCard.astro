---
import type { CollectionEntry } from "astro:content";
import { ledgerHref } from "../../lib/ledger";
import EntryMeta from "./EntryMeta.astro";
import TagChip from "./TagChip.astro";

interface Props {
  entry: CollectionEntry<"ledger">;
}
const { entry } = Astro.props;
const href = ledgerHref(entry);
---

<article class="entry">
  <EntryMeta entry={entry} />

  <h2 class="title"><a href={href}>{entry.data.title}</a></h2>

  <p class="summary">{entry.data.summary}</p>

  <footer class="bottom">
    <div class="tags" aria-label="Tags">
      {entry.data.tags.map((t) => <TagChip label={t} />)}
    </div>
    <a class="link-accent read-more" href={href}>
      Read more <span aria-hidden="true">→</span>
    </a>
  </footer>
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 0;
    border-top: 1px solid var(--line-1);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--fg-display);
  }
  .title a { color: inherit; transition: color var(--duration-fast) var(--ease-standard); }
  .title a:hover { color: var(--accent); }

  .summary { margin: 0; font-size: 16px; line-height: 1.65; color: var(--fg-1); max-width: 720px; }

  .bottom { display: flex; align-items: center; gap: 16px; padding-top: 4px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; }
  .read-more { font-size: 13px; flex-shrink: 0; }
</style>
