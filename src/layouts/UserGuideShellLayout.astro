---
import LandingLayout from "./LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import GuideNavList from "../components/userguide/GuideNavList.astro";
import StatusBadge from "../components/StatusBadge.astro";
import VersionBadge from "../components/VersionBadge.astro";
import { getManifest } from "../lib/userGuide";
import { absoluteOg } from "../lib/og";
import "../styles/tokens.css";
import "../styles/userguide.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** Current category slug — used to highlight the active sidebar entry. */
  currentCategory?: string;
  /** Current article slug — used to highlight the active sidebar entry. */
  currentSlug?: string;
  /** Article display title — used by the mobile breadcrumb. */
  currentArticleTitle?: string;
  /** Render the L sidebar + mobile toggle + R rail slot. Default true.
   *  Set false on the index page (index has no sidebar). */
  showSidebar?: boolean;
}

const {
  title,
  description,
  canonical,
  currentCategory,
  currentSlug,
  showSidebar = true,
} = Astro.props;

const manifest = getManifest();

/* "myne-in-your-browser" -> "Myne in your browser".
   The rail used to print the slug with `text-transform: capitalize`, which is
   Title Case: every word capitalised, including "in" and "your". The guide's
   own headings are sentence case, so the rail disagreed with the page it
   pointed at. CSS cannot capitalise the first letter only, so it happens here. */
function sentenceCase(slug: string): string {
  const words = slug.replace(/-/g, " ");
  return words.charAt(0).toUpperCase() + words.slice(1);
}
---

<LandingLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={absoluteOg("guide", Astro.site!)}
  clientRouter
>
  <div class="ug-root">
    <!-- TOP BAR — shared with the landing. On mobile its drop-down carries the
         guide nav (full-screen, with a back button to the site nav); there is
         no separate guide sidebar drawer. -->
    {/* Wrapped in a persisted element (Astro won't forward a transition
        directive onto a component whose template isn't a single root node).
        The bar is position:fixed, so this zero-height wrapper adds no layout;
        persisting it keeps the bar and its bound listeners across swaps. */}
    <div transition:persist="gnav">
      <GlassNav active="guide" guide>
        <GuideNavList
          slot="guide"
          currentCategory={currentCategory}
          currentSlug={currentSlug}
        />
      </GlassNav>
    </div>

    <div id="top" class="ug-page">
      <div
        class:list={["ug-shell", { "ug-shell--no-sidebar": !showSidebar }]}
      >
        {showSidebar && (
            <aside
              id="ug-sidebar"
              class="ug-sidebar"
              aria-label="User guide sections"
              transition:persist="ug-sidebar"
            >
              {/* The inner wrapper is what sticks, and the aside itself stays
                  a full-height grid cell. Two things fall out of that split: the
                  hairline on the aside runs from the top of the page to the
                  bottom (a sticky element is only as tall as its own content, so
                  it used to stop where the list did), and the list gets a
                  BOUNDED height to scroll inside. Without the bound the nav was
                  `overflow-y: auto` on an auto-height flex item, which is a
                  scrollbar that never appears: the item grew to its content and
                  the overflow simply spilled past the sticky box. */}
              <div class="ug-sidebar__inner">
              <nav class="ug-sidebar__nav edge-fade-b" data-ug-nav>
                {manifest.map((cat) => {
                  const isActiveCategory = cat.slug === currentCategory;
                  return (
                    <div
                      class:list={[
                        "ug-sidebar__category",
                        { "is-open": isActiveCategory },
                      ]}
                    >
                      <a
                        href={`/user-guide/${cat.slug}/`}
                        class:list={[
                          "mono",
                          "up",
                          "ug-sidebar__cat-link",
                          { active: isActiveCategory },
                        ]}
                      >
                        <span class="ug-sidebar__cat-label">{cat.label}</span>
                        <span class="ug-sidebar__cat-count">
                          {String(cat.articles.length).padStart(2, "0")}
                        </span>
                      </a>
                      {/* Only the active category SHOWS its articles, but all
                          of them stay in the markup.
                          ── Why ─────────────────────────────────────────────
                          Every category used to be expanded, always. The guide
                          has more than a hundred articles, so the rail was a
                          wall of same-weight links from the first screen down,
                          with the one thing a reader needs, where they are
                          now, somewhere inside it. Collapsing to the active
                          category keeps the rail inside the viewport and turns
                          the other categories into signposts with a count,
                          which is what they are until you go there.

                          The lists are all rendered and `is-open` hides the
                          rest, rather than rendering one list server-side: the
                          aside is `transition:persist`, so its DOM survives a
                          client-side navigation. A list that only existed for
                          the page you arrived from would stay behind, and
                          crossing from Getting started to Markdown would land
                          on a rail with no articles in it at all. */}
                      {cat.articles.length > 0 && (
                        <ul class="ug-sidebar__articles">
                          {cat.articles.map((slug) => {
                            const isActive = slug === currentSlug;
                            return (
                              <li>
                                <a
                                  href={`/user-guide/${cat.slug}/${slug}/`}
                                  class:list={[
                                    "ug-sidebar__article",
                                    { active: isActive },
                                  ]}
                                  aria-current={isActive ? "page" : undefined}
                                >
                                  {sentenceCase(slug)}
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      )}
                    </div>
                  );
                })}
              </nav>
              </div>
            </aside>
        )}
        <div class="ug-shell-main">
          <slot />
        </div>
        {showSidebar && Astro.slots.has("rightRail") && (
          <aside class="ug-rightrail" aria-label="On this page">
            <slot name="rightRail" />
          </aside>
        )}
      </div>
    </div>

    <footer class="ug-footer" transition:persist="ug-footer">
      <div class="mono up ug-footer__inner">
        <span>© 2026 Myne · AGPL-3.0 · CC-BY-4.0 docs</span><StatusBadge /><VersionBadge />
      </div>
    </footer>

    <!-- Image lightbox: prose images open here for zoom + pan inspection.
         Dismiss via Esc, backdrop, or the × button. Persisted so its listeners
         and zoom/pan state survive client-router navigations. -->
    <div
      class="ug-lightbox"
      data-ug-lightbox
      aria-hidden="true"
      transition:persist="ug-lightbox"
    >
      <img class="ug-lightbox__img" data-ug-lightbox-img alt="" />
      <button
        type="button"
        class="ug-lightbox__close"
        data-ug-lightbox-close
        aria-label="Close image"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6 L18 18 M18 6 L6 18" />
        </svg>
      </button>
      <span class="mono up ug-lightbox__hint">
        Scroll or pinch to zoom · drag to pan · Esc to close
      </span>
    </div>
  </div>

  <script>
    // User-guide image lightbox — click a prose image to inspect it full-screen
    // with wheel/pinch zoom, drag-to-pan, and click-to-toggle zoom. Closes on
    // Esc, backdrop click, or the × button.
    const lbox = document.querySelector<HTMLElement>("[data-ug-lightbox]");
    const limg = lbox?.querySelector<HTMLImageElement>("[data-ug-lightbox-img]");
    if (lbox && limg) {
      let scale = 1;
      let tx = 0;
      let ty = 0;
      let moved = false;
      let panLast: { x: number; y: number } | null = null;
      let pinchDist = 0;
      let pinchScale = 1;
      const pointers = new Map<number, { x: number; y: number }>();
      const clamp = (v: number, a: number, b: number) =>
        Math.max(a, Math.min(b, v));

      const apply = () => {
        limg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        limg.classList.toggle("is-zoomed", scale > 1.01);
      };
      const reset = () => {
        scale = 1;
        tx = 0;
        ty = 0;
        apply();
      };
      const zoomAt = (cx: number, cy: number, next: number) => {
        next = clamp(next, 1, 6);
        const rect = limg.getBoundingClientRect();
        tx += (cx - rect.left) * (1 - next / scale);
        ty += (cy - rect.top) * (1 - next / scale);
        scale = next;
        if (scale <= 1.001) {
          scale = 1;
          tx = 0;
          ty = 0;
        }
        apply();
      };

      const open = (src: string, alt: string) => {
        limg.src = src;
        limg.alt = alt;
        reset();
        lbox.setAttribute("data-open", "");
        document.documentElement.style.overflow = "hidden";
      };
      const close = () => {
        lbox.removeAttribute("data-open");
        document.documentElement.style.overflow = "";
        limg.removeAttribute("src");
        pointers.clear();
        panLast = null;
      };

      // Delegated so it also covers the article images swapped in by the
      // client router on each navigation — the lightbox node is persisted and
      // this listener is bound once to `document`, which is never torn down.
      document.addEventListener("click", (e) => {
        const im = (e.target as Element | null)?.closest?.(
          ".ledger-prose img",
        ) as HTMLImageElement | null;
        if (im) open(im.currentSrc || im.src, im.alt || "");
      });

      lbox.addEventListener("click", (e) => {
        if (e.target === lbox) close(); // backdrop only
      });
      lbox
        .querySelector("[data-ug-lightbox-close]")
        ?.addEventListener("click", close);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lbox.hasAttribute("data-open")) close();
      });

      lbox.addEventListener(
        "wheel",
        (e) => {
          if (!lbox.hasAttribute("data-open")) return;
          e.preventDefault();
          zoomAt(e.clientX, e.clientY, scale * (e.deltaY < 0 ? 1.18 : 1 / 1.18));
        },
        { passive: false },
      );

      limg.addEventListener("click", (e) => {
        e.stopPropagation();
        if (moved) {
          moved = false;
          return;
        }
        if (scale > 1.01) reset();
        else zoomAt(e.clientX, e.clientY, 2.5);
      });

      limg.addEventListener("pointerdown", (e) => {
        limg.setPointerCapture(e.pointerId);
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
          pinchScale = scale;
        } else if (scale > 1.01) {
          panLast = { x: e.clientX, y: e.clientY };
          limg.classList.add("is-panning");
        }
      });
      limg.addEventListener("pointermove", (e) => {
        if (!pointers.has(e.pointerId)) return;
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (pinchDist > 0)
            zoomAt(
              (a.x + b.x) / 2,
              (a.y + b.y) / 2,
              pinchScale * (dist / pinchDist),
            );
          moved = true;
        } else if (panLast) {
          tx += e.clientX - panLast.x;
          ty += e.clientY - panLast.y;
          panLast = { x: e.clientX, y: e.clientY };
          moved = true;
          apply();
        }
      });
      const endPointer = (e: PointerEvent) => {
        pointers.delete(e.pointerId);
        if (pointers.size < 2) pinchDist = 0;
        if (pointers.size === 0) {
          panLast = null;
          limg.classList.remove("is-panning");
        }
      };
      limg.addEventListener("pointerup", endPointer);
      limg.addEventListener("pointercancel", endPointer);
    }
  </script>

  <script>
    // CLI terminal-cast player — upgrade every `[data-cast]` placeholder an
    // article embeds into a self-hosted asciicast player (../scripts/castPlayer).
    // Bundled once here like the lightbox above; re-scan on each client-router
    // navigation (idempotent — already-mounted hosts are skipped) and pause any
    // playing cast before the page swaps so nothing animates after you leave.
    import { mountCastPlayers, pauseCastPlayers } from "../scripts/castPlayer";
    mountCastPlayers();
    document.addEventListener("astro:page-load", () => mountCastPlayers());
    document.addEventListener("astro:before-swap", pauseCastPlayers);
  </script>

  <script>
    // Sidebar behaviour under the client router. The left sidebar and the
    // mobile guide nav (inside the top bar) are persisted across navigations,
    // so their listeners bind once here (this module runs a single time) and
    // their active state is re-synced from the URL on every navigation rather
    // than re-rendered. sessionStorage restores scroll across full reloads.
    const SCROLL_KEY = "myne-website-userguide-sidebar-scroll";

    const syncActive = () => {
      const path = location.pathname;
      const mark = (el: Element, on: boolean) => {
        el.classList.toggle("active", on);
        if (on) el.setAttribute("aria-current", "page");
        else el.removeAttribute("aria-current");
      };
      // Exact-match article links (desktop sidebar + mobile guide nav).
      document
        .querySelectorAll<HTMLAnchorElement>(
          ".ug-sidebar__article, .gnl-article",
        )
        .forEach((a) => mark(a, a.getAttribute("href") === path));
      // Category links light up when the path sits under them.
      document
        .querySelectorAll<HTMLAnchorElement>(
          ".ug-sidebar__cat-link, .gnl-catlink",
        )
        .forEach((a) => {
          const href = a.getAttribute("href") || "";
          a.classList.toggle("active", href !== "" && path.startsWith(href));
        });
      // Which category is expanded follows the URL, not the page you arrived
      // from. The aside is persisted, so without this a reader crossing from
      // one category to another keeps the old section's list expanded and gets
      // none of the new one's.
      document
        .querySelectorAll<HTMLElement>(".ug-sidebar__category")
        .forEach((cat) => {
          const link = cat.querySelector<HTMLAnchorElement>(
            ":scope > .ug-sidebar__cat-link",
          );
          cat.classList.toggle(
            "is-open",
            link?.classList.contains("active") === true,
          );
        });
    };

    // The scrollable element in the live (.ug-root) layout is the inner nav
    // list, not the sticky aside (which is overflow:visible, scrollTop 0).
    const getScroller = (): HTMLElement | null => {
      const sidebar = document.getElementById("ug-sidebar");
      if (!sidebar) return null;
      return sidebar.querySelector<HTMLElement>("[data-ug-nav]") || sidebar;
    };

    const initScroll = () => {
      const scroller = getScroller();
      if (!scroller) return;
      let lastWritten: number | null = null;
      try {
        const saved = sessionStorage.getItem(SCROLL_KEY);
        if (saved) {
          scroller.scrollTop = parseInt(saved, 10);
          lastWritten = scroller.scrollTop;
        }
      } catch {}
      let pending = false;
      scroller.addEventListener(
        "scroll",
        () => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => {
            const top = scroller.scrollTop;
            if (top !== lastWritten) {
              try {
                sessionStorage.setItem(SCROLL_KEY, String(top));
              } catch {}
              lastWritten = top;
            }
            pending = false;
          });
        },
        { passive: true },
      );
    };

    // `transition:persist` moves the sidebar node on each navigation, and a
    // scroll container that is detached and re-attached loses its scrollTop —
    // so persist alone snaps the list back to the top. Capture the offset just
    // before the swap and reapply it right after (before paint) so the sidebar
    // holds its place from one section to the next.
    let carriedScroll = 0;
    document.addEventListener("astro:before-swap", () => {
      const s = getScroller();
      if (s) carriedScroll = s.scrollTop;
    });
    document.addEventListener("astro:after-swap", () => {
      const s = getScroller();
      if (s) s.scrollTop = carriedScroll;
    });

    initScroll();
    syncActive();
    document.addEventListener("astro:page-load", syncActive);
  </script>
</LandingLayout>
