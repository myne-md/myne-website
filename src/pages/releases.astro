---
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import { absoluteOg } from "../lib/og";

const title = "Releases — Myne";
const description =
  "Myne release notes. Pre-alpha: no installers are published yet. The v0.1 spec and threat model are public (in draft); the desktop client is in progress. Watch GitHub releases.";
const canonical = new URL("/releases/", Astro.site!).toString();
const ogImage = absoluteOg("releases", Astro.site!);

const eyebrow = "font-size:11px;color:#8aa4d0;margin-bottom:14px;";
---

<LandingLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <div
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e6e6e4;background:#0a0a0a;min-height:100vh;"
  >
    <GlassNav active="releases" />

    <section id="top" style="padding:128px 28px 70px;">
      <div style="max-width:820px;margin:0 auto;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
          <span class="mono up" style="font-size:11px;color:#8aa4d0;">Releases</span>
          <span
            class="mono up"
            style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
            >pre-alpha</span
          >
        </div>
        <h1
          style="font-size:clamp(34px,5vw,58px);line-height:1.0;font-weight:700;letter-spacing:-0.035em;"
        >
          Nothing to download yet.
        </h1>
        <p
          style="margin-top:22px;max-width:66ch;font-size:16px;line-height:1.65;color:#8a8a86;"
        >
          No installers are published for general use. The v0.1 protocol spec and
          threat model are public (still in draft); the desktop client is in
          progress. When the first signed build lands it will show up here and on
          GitHub releases — every artifact with its published SHA-256 so you can
          verify it.
        </p>

        <!-- UNRELEASED CARD -->
        <div
          style="margin-top:36px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;background:#0c0c0c;padding:26px;"
        >
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <span class="mono" style="font-size:18px;font-weight:600;color:#e6e6e4;">v0.1.0</span>
            <span
              class="mono up"
              style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
              >unreleased</span
            >
          </div>
          <div class="mono" style="margin-top:6px;font-size:11px;color:#54544f;">
            spec public draft · desktop client in progress
          </div>
          <div style="margin-top:20px;display:flex;flex-direction:column;gap:9px;">
            <div style="display:flex;gap:10px;align-items:baseline;">
              <span style="color:#7fb89a;flex:0 0 auto;">+</span>
              <span style="font-size:13.5px;line-height:1.5;color:#c4c4c0;"
                >Public v0.1 protocol spec &amp; threat model (draft)</span
              >
            </div>
            <div style="display:flex;gap:10px;align-items:baseline;">
              <span style="color:#7fb89a;flex:0 0 auto;">+</span>
              <span style="font-size:13.5px;line-height:1.5;color:#c4c4c0;"
                >Cross-implementation test vectors</span
              >
            </div>
            <div style="display:flex;gap:10px;align-items:baseline;">
              <span style="color:#c2a35e;flex:0 0 auto;">~</span>
              <span style="font-size:13.5px;line-height:1.5;color:#c4c4c0;"
                >Desktop client — editor, encrypted vault, search, backlinks</span
              >
            </div>
          </div>
          <div style="margin-top:24px;display:flex;gap:10px;flex-wrap:wrap;">
            <a
              href="https://github.com/myne-md"
              rel="noopener"
              class="mono up"
              style="display:inline-flex;align-items:center;gap:8px;background:#e6e6e4;color:#0a0a0a;text-decoration:none;border-radius:8px;padding:11px 18px;font-size:10px;font-weight:700;"
              >Watch releases on GitHub</a
            >
            <a
              href="/download/"
              class="mono up"
              style="display:inline-flex;align-items:center;gap:8px;color:#e6e6e4;text-decoration:none;border:1px solid rgba(255,255,255,0.2);border-radius:8px;padding:11px 18px;font-size:10px;"
              >Download details</a
            >
          </div>
        </div>

        <p class="mono" style="margin-top:18px;font-size:11.5px;line-height:1.7;color:#6a6a66;max-width:64ch;">
          No dates and no cadence promise — builds ship when they're ready to
          trust, not on a schedule. Until then, the spec and the source are the
          thing to read.
        </p>
      </div>
    </section>

    <footer style="border-top:1px solid rgba(255,255,255,0.1);padding:36px 28px;">
      <div
        class="mono up"
        style="max-width:820px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:10px;color:#54544f;"
      >
        <span>© 2026 Myne · AGPL-3.0 · CC0 docs</span><span>v0.1 · pre-alpha</span>
      </div>
    </footer>
  </div>
</LandingLayout>
