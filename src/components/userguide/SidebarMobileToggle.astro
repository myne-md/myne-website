---
// Visible at <=920px (site breakpoint convention; Penpot brief said <768
// but the site otherwise uses 920 throughout — site convention wins).
import Icon from "../Icon.astro";

interface Props {
  /** Breadcrumb context labels — kept for API compatibility; the article
   *  header already renders the breadcrumb, so the bar shows a clear
   *  "Guide menu" control instead of duplicating it. */
  categoryLabel?: string;
  articleLabel?: string;
}
---

<div class="ug-mobile-toggle" data-userguide-toggle>
  <button
    type="button"
    class="ug-mobile-toggle__btn"
    aria-label="Toggle guide navigation"
    aria-controls="ug-sidebar"
    aria-expanded="false"
    data-userguide-toggle-btn
  >
    <Icon name="menu" size={16} class="ug-mobile-toggle__icon ug-mobile-toggle__icon--menu" />
    <Icon name="x" size={16} class="ug-mobile-toggle__icon ug-mobile-toggle__icon--close" />
    <span class="ug-mobile-toggle__label">Guide menu</span>
  </button>
</div>

<script>
  const KEY = "myne-website-userguide-sidebar-state";
  const ATTR = "data-userguide-sidebar";

  const setState = (state: "open" | "closed") => {
    document.body.setAttribute(ATTR, state);
    const btn = document.querySelector<HTMLButtonElement>(
      "[data-userguide-toggle-btn]",
    );
    if (btn) btn.setAttribute("aria-expanded", state === "open" ? "true" : "false");
    try {
      localStorage.setItem(KEY, state);
    } catch {
      /* private mode / quota — silent */
    }
  };

  const restore = () => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {
      /* ignore */
    }
    setState(saved === "open" ? "open" : "closed");
  };

  const wire = () => {
    const btn = document.querySelector<HTMLButtonElement>(
      "[data-userguide-toggle-btn]",
    );
    btn?.addEventListener("click", () => {
      const current = document.body.getAttribute(ATTR);
      setState(current === "open" ? "closed" : "open");
    });
    const backdrop = document.querySelector<HTMLElement>(
      "[data-userguide-backdrop]",
    );
    backdrop?.addEventListener("click", () => setState("closed"));
  };

  restore();
  wire();
</script>
