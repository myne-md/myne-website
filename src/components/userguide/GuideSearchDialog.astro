---
/*
 * Full-content search palette for the user guide. A native <dialog> opened from
 * the icon-only trigger in the navbar (GlassNav, guide pages only). It lazily
 * fetches /user-guide/search-index.json the first time it opens and searches
 * every article's title, tags, summary and body — client-side, dependency-free.
 *
 * Design-canon note: this rides — and slightly stretches — the myne-website
 * modal carve-out (design-notes.md 2026-05-03). It is a SOLICITED click on a
 * labelled search affordance, dismiss-default through Esc + backdrop + × — but
 * unlike the subscribe dialog it surfaces a multi-result list rather than a
 * single primary action. If the design canon is updated, log the extension
 * there; the pattern here mirrors the desktop app's own ⌘K command palette.
 */
---

<dialog
  class="gsd"
  data-guide-search
  aria-label="Search the user guide"
>
  <div class="gsd__panel">
    <div class="gsd__head">
      <svg
        class="gsd__head-icon"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.34-4.34"></path>
      </svg>
      <input
        type="text"
        class="gsd__input mono"
        placeholder="Search the guide…"
        aria-label="Search the guide"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        role="combobox"
        aria-expanded="true"
        aria-controls="gsd-results"
        aria-autocomplete="list"
        data-gsd-input
      />
      <button
        type="button"
        class="gsd__close"
        data-gsd-close
        aria-label="Close search"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6 L18 18 M18 6 L6 18"></path>
        </svg>
      </button>
    </div>

    <div
      class="gsd__results"
      id="gsd-results"
      role="listbox"
      aria-label="Search results"
      data-gsd-results
    >
      <p class="gsd__hint">Search the full guide — every article title and its content.</p>
    </div>

    <div class="gsd__foot mono up" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style is:global>
  /* Global (not scoped): the result rows are built in the script with
     document.createElement, so they never carry Astro's scoped-style data
     attribute. Every selector below is namespaced under .gsd, so going global
     styles the dynamic rows without leaking into the rest of the page. */
  .gsd {
    /* Fill the viewport so the surround acts as a click-to-dismiss backdrop;
       the ::backdrop pseudo carries the dim. The card is positioned inside. */
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: var(--ink-1);
  }
  .gsd[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .gsd::backdrop {
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .gsd__panel {
    width: min(640px, calc(100vw - 32px));
    margin-top: 11vh;
    max-height: 72vh;
    display: flex;
    flex-direction: column;
    background: var(--paper-2);
    border: 1px solid rgb(var(--line-rgb) / 0.12);
    border-radius: 12px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    animation: gsd-in 0.16s ease both;
  }
  @keyframes gsd-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .gsd__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    height: 52px;
    border-bottom: 1px solid rgb(var(--line-rgb) / 0.08);
    flex-shrink: 0;
  }
  .gsd__head-icon {
    color: var(--ink-3);
    flex-shrink: 0;
  }
  .gsd__input {
    flex: 1;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: 0;
    /* No focus ring — it's a plain text field (not type=search, which would
       paint its own native ring); the modal + caret already signal focus,
       cmdk-palette convention. */
    outline: none;
    color: var(--ink-1);
    font-size: 15px;
  }
  .gsd__input:focus,
  .gsd__input:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .gsd__input::placeholder {
    color: var(--ink-4);
  }
  .gsd__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 6px;
    color: var(--ink-3);
    cursor: pointer;
    flex-shrink: 0;
  }
  .gsd__close:hover {
    color: var(--ink-1);
    background: rgb(var(--line-rgb) / 0.06);
  }

  .gsd__results {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px;
  }
  .gsd__hint {
    margin: 0;
    padding: 22px 12px;
    color: var(--ink-3);
    font-size: 13px;
    text-align: center;
  }
  .gsd__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .gsd__result {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    scroll-margin: 8px;
  }
  .gsd__result:hover,
  .gsd__result.is-active {
    background: rgb(var(--line-rgb) / 0.06);
  }
  .gsd__result.is-active {
    box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / 0.4);
  }
  .gsd__result-cat {
    font-size: 9.5px;
    color: var(--accent);
    letter-spacing: 0.12em;
  }
  .gsd__result-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-1);
    line-height: 1.3;
  }
  .gsd__result-snippet {
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gsd__result mark {
    background: rgb(var(--accent-rgb) / 0.22);
    color: var(--ink-1);
    border-radius: 2px;
    padding: 0 1px;
  }

  .gsd__foot {
    display: flex;
    gap: 16px;
    padding: 9px 14px;
    border-top: 1px solid rgb(var(--line-rgb) / 0.08);
    font-size: 9px;
    color: var(--ink-4);
    flex-shrink: 0;
  }
  .gsd__foot kbd {
    font: inherit;
    color: var(--ink-3);
  }

  @media (max-width: 620px) {
    .gsd__panel {
      margin-top: 0;
      width: 100%;
      max-height: 100%;
      height: 100%;
      border-radius: 0;
      border: 0;
    }
    .gsd__foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gsd__panel {
      animation: none;
    }
  }
</style>

<script>
  // ── User-guide full-content search palette ──────────────────────────────
  // Bound once (module scripts run a single time). The dialog + trigger buttons
  // live inside the transition:persist="gnav" wrapper, so they survive in-guide
  // client-router navigations and these listeners stay valid across pages.

  interface RawDoc {
    id: string;
    url: string;
    title: string;
    category: string;
    categoryLabel: string;
    summary: string;
    tags: string[];
    text: string;
  }
  interface Doc extends RawDoc {
    _title: string;
    _cat: string;
    _summary: string;
    _tags: string;
    _text: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>("[data-guide-search]");
  const input = document.querySelector<HTMLInputElement>("[data-gsd-input]");
  const results = document.querySelector<HTMLElement>("[data-gsd-results]");

  if (dialog && input && results) {
    let docs: Doc[] | null = null;
    let loadStarted = false;
    let activeIndex = -1;
    let raf = 0;

    const loadIndex = () => {
      if (loadStarted) return;
      loadStarted = true;
      fetch("/user-guide/search-index.json")
        .then((r) => r.json())
        .then((data: { docs: RawDoc[] }) => {
          docs = data.docs.map((d) => ({
            ...d,
            _title: d.title.toLowerCase(),
            _cat: d.categoryLabel.toLowerCase(),
            _summary: d.summary.toLowerCase(),
            _tags: (d.tags || []).join(" ").toLowerCase(),
            _text: d.text.toLowerCase(),
          }));
          if (dialog.open) render();
        })
        .catch(() => {
          loadStarted = false; // let the next open retry
          if (dialog.open) showHint("Search is unavailable right now.");
        });
    };

    const countOcc = (hay: string, needle: string): number => {
      if (!needle) return 0;
      let n = 0;
      let i = 0;
      while ((i = hay.indexOf(needle, i)) !== -1) {
        n++;
        i += needle.length;
        if (n > 50) break;
      }
      return n;
    };

    // Field-weighted score with AND semantics — every query term must appear
    // somewhere in a doc for it to rank at all (mirrors the app's own search).
    const scoreDoc = (d: Doc, terms: string[]): number => {
      let total = 0;
      for (const term of terms) {
        const termScore =
          countOcc(d._title, term) * 8 +
          countOcc(d._tags, term) * 5 +
          countOcc(d._summary, term) * 3 +
          countOcc(d._cat, term) * 2 +
          Math.min(countOcc(d._text, term), 6);
        if (termScore === 0) return 0;
        if (d._title.startsWith(term)) total += 5; // title-prefix bonus
        total += termScore;
      }
      return total;
    };

    const search = (terms: string[]): Doc[] => {
      if (!terms.length || !docs) return [];
      const scored: { d: Doc; score: number }[] = [];
      for (const d of docs) {
        const score = scoreDoc(d, terms);
        if (score > 0) scored.push({ d, score });
      }
      scored.sort(
        (a, b) => b.score - a.score || a.d.title.localeCompare(b.d.title),
      );
      return scored.slice(0, 30).map((x) => x.d);
    };

    const snippetFor = (d: Doc, terms: string[]): string => {
      const hay = d.text || d.summary;
      const low = hay.toLowerCase();
      let pos = -1;
      for (const t of terms) {
        const i = low.indexOf(t);
        if (i !== -1 && (pos === -1 || i < pos)) pos = i;
      }
      if (pos === -1) return d.summary;
      const start = Math.max(0, pos - 70);
      const end = Math.min(hay.length, pos + 140);
      let s = hay.slice(start, end);
      if (start > 0) s = "…" + s;
      if (end < hay.length) s = s + "…";
      return s;
    };

    // Highlight matched terms as <mark> via the DOM (never innerHTML) so the
    // query — user input — can never be interpreted as markup.
    const appendHighlighted = (
      el: HTMLElement,
      text: string,
      terms: string[],
    ) => {
      const low = text.toLowerCase();
      let i = 0;
      while (i < text.length) {
        let best = -1;
        let bestLen = 0;
        for (const t of terms) {
          const idx = low.indexOf(t, i);
          if (idx !== -1 && (best === -1 || idx < best)) {
            best = idx;
            bestLen = t.length;
          }
        }
        if (best === -1) {
          el.appendChild(document.createTextNode(text.slice(i)));
          break;
        }
        if (best > i) {
          el.appendChild(document.createTextNode(text.slice(i, best)));
        }
        const mark = document.createElement("mark");
        mark.textContent = text.slice(best, best + bestLen);
        el.appendChild(mark);
        i = best + bestLen;
      }
    };

    const showHint = (msg: string) => {
      results.innerHTML = "";
      const p = document.createElement("p");
      p.className = "gsd__hint";
      p.textContent = msg;
      results.appendChild(p);
      activeIndex = -1;
    };

    const optionEls = () =>
      Array.from(results.querySelectorAll<HTMLAnchorElement>(".gsd__result"));

    const setActive = (i: number) => {
      const opts = optionEls();
      if (!opts.length) {
        activeIndex = -1;
        input.removeAttribute("aria-activedescendant");
        return;
      }
      activeIndex = ((i % opts.length) + opts.length) % opts.length;
      opts.forEach((el, idx) => {
        const on = idx === activeIndex;
        el.classList.toggle("is-active", on);
        el.setAttribute("aria-selected", on ? "true" : "false");
        if (on) {
          el.scrollIntoView({ block: "nearest" });
          input.setAttribute("aria-activedescendant", el.id);
        }
      });
    };

    const render = () => {
      const q = input.value.trim();
      if (!q) {
        showHint("Search the full guide — every article title and its content.");
        return;
      }
      if (!docs) {
        showHint("Loading…");
        return;
      }
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      const hits = search(terms);
      results.innerHTML = "";
      if (!hits.length) {
        showHint(`No results for “${q}”.`);
        return;
      }
      const list = document.createElement("div");
      list.className = "gsd__list";
      hits.forEach((d, idx) => {
        const a = document.createElement("a");
        a.className = "gsd__result";
        a.href = d.url;
        a.id = `gsd-opt-${idx}`;
        a.setAttribute("role", "option");

        const cat = document.createElement("span");
        cat.className = "gsd__result-cat mono up";
        cat.textContent = d.categoryLabel;
        a.appendChild(cat);

        const title = document.createElement("span");
        title.className = "gsd__result-title";
        appendHighlighted(title, d.title, terms);
        a.appendChild(title);

        const snip = document.createElement("span");
        snip.className = "gsd__result-snippet";
        appendHighlighted(snip, snippetFor(d, terms), terms);
        a.appendChild(snip);

        list.appendChild(a);
      });
      results.appendChild(list);
      setActive(0);
    };

    const open = () => {
      if (dialog.open) return;
      // Deliberately NOT locking document scroll: toggling overflow:hidden
      // removes the page's scrollbar and reflows the layout a few px wider,
      // which reads as a horizontal jitter each time the palette opens/closes.
      // The modal backdrop already covers the page; letting it keep its
      // scrollbar is the calmer trade-off.
      dialog.showModal();
      input.focus();
      input.select();
      render();
      loadIndex();
    };
    const close = () => {
      if (dialog.open) dialog.close();
    };

    // Debounce input to one render per frame.
    input.addEventListener("input", () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        render();
      });
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIndex + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIndex - 1);
      } else if (e.key === "Enter") {
        const opts = optionEls();
        if (activeIndex >= 0 && opts[activeIndex]) {
          e.preventDefault();
          opts[activeIndex].click();
        }
      }
    });

    // Backdrop click (a click that lands on the dialog box itself, outside the
    // card) dismisses.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    dialog
      .querySelector("[data-gsd-close]")
      ?.addEventListener("click", () => close());

    // A result click navigates (the client router intercepts the anchor); close
    // so the palette isn't left open behind the new page.
    results.addEventListener("click", (e) => {
      if ((e.target as Element | null)?.closest?.(".gsd__result")) close();
    });

    // Triggers: every [data-guide-search-open] button in the navbar.
    document.querySelectorAll("[data-guide-search-open]").forEach((btn) =>
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        open();
      }),
    );

    // Global shortcuts: ⌘K / Ctrl+K toggles; "/" opens when not already typing.
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
        e.preventDefault();
        dialog.open ? close() : open();
        return;
      }
      if (e.key === "/" && !dialog.open) {
        const el = document.activeElement as HTMLElement | null;
        const tag = el?.tagName;
        const typing =
          tag === "INPUT" ||
          tag === "TEXTAREA" ||
          tag === "SELECT" ||
          !!el?.isContentEditable;
        if (!typing) {
          e.preventDefault();
          open();
        }
      }
    });
  }
</script>
