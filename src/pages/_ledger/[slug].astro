---
import { render, type CollectionEntry } from "astro:content";
import LandingLayout from "../../layouts/LandingLayout.astro";
import GlassNav from "../../components/GlassNav.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import VersionBadge from "../../components/VersionBadge.astro";
import EntryHeader from "../../components/ledger/EntryHeader.astro";
import ArticleSchema from "../../components/ledger/ArticleSchema.astro";
import { getPublishedLedgerEntries, ledgerHref } from "../../lib/ledger";
import { absoluteLedgerOg } from "../../lib/og";
import "../../styles/tokens.css";
import "../../styles/global.css";
import "../../styles/ledger.css";

export async function getStaticPaths() {
  const entries = await getPublishedLedgerEntries();
  return entries.map((entry: CollectionEntry<"ledger">) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"ledger">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const canonical = new URL(ledgerHref(entry), Astro.site!).toString();
const ogImage = absoluteLedgerOg(entry, Astro.site!);
---

<LandingLayout
  title={`${entry.data.title} — Myne ledger`}
  description={entry.data.summary}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
>
  <ArticleSchema entry={entry} url={canonical} ogImage={ogImage} />

  <div class="ledger-root">
    <div class="ledger-progress" data-ledger-progress aria-hidden="true"></div>
    <GlassNav active="ledger" />
    <section>
      <div class="ledger-reader">
      <a class="ledger-back link-accent" href="/ledger/">
        <span class="arrow" aria-hidden="true">←</span>
        Ledger
      </a>

      <EntryHeader entry={entry} />

      <hr class="ledger-divider" aria-hidden="true" />

      <article class="ledger-prose">
        <Content />
      </article>

      <hr class="ledger-divider" aria-hidden="true" />

      <div class="ledger-link-bar">
        <a class="link-accent" href={canonical}>Permalink</a>
        <span class="dot" aria-hidden="true">·</span>
        <span class="url">myne.md{ledgerHref(entry)}</span>
        <span class="spacer"></span>
        <a class="link-accent" href="/ledger/rss.xml">Subscribe — RSS</a>
      </div>
      </div>
    </section>
    <footer class="ledger-footer">
      <div class="mono up ledger-footer__inner">
        <span>© 2026 Myne · AGPL-3.0 · CC-BY-4.0 docs</span><StatusBadge /><VersionBadge />
      </div>
    </footer>
  </div>

  <style>
    /* Reading-progress bar — a thin accent line pinned to the very top edge,
       above the fixed nav, that fills as the reader moves through the post. */
    .ledger-progress {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      z-index: 90;
      transform: scaleX(0);
      transform-origin: 0 50%;
      background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.55), var(--accent));
      pointer-events: none;
      will-change: transform;
    }
  </style>

  <script is:inline>
    (function () {
      var bar = document.querySelector("[data-ledger-progress]");
      var article = document.querySelector(".ledger-prose");
      if (!bar || !article) return;
      var raf = 0;
      function update() {
        raf = 0;
        var rect = article.getBoundingClientRect();
        var total = rect.height - window.innerHeight;
        var p =
          total > 0
            ? Math.max(0, Math.min(1, -rect.top / total))
            : rect.top <= 0
              ? 1
              : 0;
        bar.style.transform = "scaleX(" + p + ")";
      }
      function onScroll() {
        if (!raf) raf = requestAnimationFrame(update);
      }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    })();
  </script>
</LandingLayout>
