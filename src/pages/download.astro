---
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import { PLATFORM_ICON } from "../data/platformIcons";

const title = "Download — Myne";
const description =
  "Run Myne on your own machine — one desktop app, installed once, running entirely on your device. Code-signed and reproducible so you can verify the binary matches the public source. Pre-alpha.";
const canonical = new URL("/download/", Astro.site!).toString();

const platforms = [
  {
    os: "macOS",
    sub: "Universal · .dmg",
    note: "macOS 11 Big Sur or later · Apple Silicon + Intel",
    d: PLATFORM_ICON.apple,
  },
  {
    os: "Windows",
    sub: "x64 · .msi",
    note: "Windows 10 build 19041+ for screen-capture exclusion",
    d: PLATFORM_ICON.windows,
  },
  {
    os: "Linux",
    sub: "AppImage · .deb",
    note: "No screen-capture exclusion on Linux v0.1",
    d: PLATFORM_ICON.linux,
  },
];

const mobile = [
  {
    os: "iOS",
    note: "The same vault and the same encryption, in your pocket. Native libsodium bindings.",
    d: PLATFORM_ICON.apple,
  },
  {
    os: "Android",
    note: "Argon2id parameters tuned per-device so unlock stays affordable on lower-end phones.",
    d: PLATFORM_ICON.android,
  },
];

const verify = [
  {
    n: "01",
    t: "Code-signed",
    p: "Installers are signed with hardware-backed keys. Your OS confirms the file came from us and was not altered in transit.",
  },
  {
    n: "02",
    t: "Reproducible",
    p: "Rebuild the public source and get byte-for-byte the same binary. Expected hashes are published with every release.",
  },
  {
    n: "03",
    t: "Verified updates",
    p: "Auto-update checks signature and hash before any code runs. A failed check is refused — you are never silently downgraded.",
  },
];

const reqs = [
  ["Disk", "Vault lives in your app-data directory; size scales with your notes."],
  ["Memory", "Argon2id unlock uses 256 MiB transiently — ~1 s on a 2024 laptop."],
  ["Network", "None required. v0.1 runs entirely offline — local-only, not synced."],
  ["Account", "No email, no sign-up. A vault is created locally with a password you choose."],
];
---

<LandingLayout title={title} description={description} canonical={canonical}>
  <div
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e6e6e4;background:#0a0a0a;min-height:100vh;"
  >
    <GlassNav active="download" />

    <!-- HERO -->
    <section id="top" style="padding:128px 28px 52px;">
      <div style="max-width:980px;margin:0 auto;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
          <span class="mono up" style="font-size:11px;color:#8aa4d0;">Download</span>
          <span
            class="mono up"
            style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
            >v0.1 · pre-alpha</span
          >
        </div>
        <h1
          style="font-size:clamp(34px,5vw,62px);line-height:1.0;font-weight:700;letter-spacing:-0.035em;max-width:16ch;"
        >
          Run it on your own machine.
        </h1>
        <p
          style="margin-top:22px;max-width:62ch;font-size:16px;line-height:1.65;color:#8a8a86;"
        >
          One desktop app, installed once, running entirely on your device.
          Code-signed and reproducible — so you can verify the binary you run
          matches the public source.
        </p>

        <div
          style="margin-top:30px;display:flex;gap:16px;align-items:flex-start;border-left:2px solid #c2a35e;background:rgba(194,163,94,0.07);border-radius:0 10px 10px 0;padding:18px 22px;"
        >
          <p style="font-size:14px;line-height:1.6;color:#e6e6e4;max-width:70ch;">
            <strong style="font-weight:600;">Pre-alpha.</strong> The v0.1 spec and
            threat model are public (still in draft); the desktop client is still
            in progress. Builds are not yet published for general use — join the
            GitHub releases to be notified when the first installer lands.
          </p>
        </div>
      </div>
    </section>

    <!-- PLATFORMS -->
    <section style="padding:18px 28px 18px;">
      <div style="max-width:980px;margin:0 auto;">
        <div class="mono up" style="font-size:10px;color:#54544f;margin-bottom:14px;">
          Desktop · available at release
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
          {
            platforms.map((it) => (
              <div
                style="display:flex;flex-direction:column;border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:24px 22px;background:#0c0c0c;"
              >
                <svg width="27" height="27" viewBox="0 0 24 24" fill="#e6e6e4">
                  <path d={it.d} />
                </svg>
                <div style="margin-top:18px;font-size:18px;font-weight:600;color:#e6e6e4;">
                  {it.os}
                </div>
                <div class="mono up" style="margin-top:6px;font-size:9px;color:#8aa4d0;">
                  {it.sub}
                </div>
                <p style="margin-top:14px;flex:1;font-size:11.5px;line-height:1.6;color:#8a8a86;">
                  {it.note}
                </p>
                <div
                  class="mono up"
                  style="margin-top:18px;display:flex;align-items:center;justify-content:space-between;font-size:9px;color:#54544f;border-top:1px solid rgba(255,255,255,0.08);padding-top:14px;"
                >
                  <span>When released</span>
                  <span style="color:#8aa4d0;font-size:13px;">↓</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MOBILE -->
    <section style="padding:14px 28px 30px;">
      <div style="max-width:980px;margin:0 auto;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span class="mono up" style="font-size:10px;color:#54544f;">Mobile</span>
          <span
            class="mono up"
            style="font-size:9px;color:#8aa4d0;border:1px solid rgba(138,164,208,0.4);border-radius:999px;padding:3px 9px;"
            >Phase 3 · planned</span
          >
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px;">
          {
            mobile.map((it) => (
              <div
                style="display:flex;align-items:flex-start;gap:18px;border:1px dashed rgba(255,255,255,0.14);border-radius:14px;padding:22px;background:rgba(255,255,255,0.01);"
              >
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="#6a6a66"
                  style="flex:0 0 auto;margin-top:2px;"
                >
                  <path d={it.d} />
                </svg>
                <div style="min-width:0;">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <span style="font-size:17px;font-weight:600;color:#c4c4c0;">{it.os}</span>
                    <span class="mono up" style="font-size:9px;color:#54544f;">not yet</span>
                  </div>
                  <p style="margin-top:8px;font-size:12px;line-height:1.6;color:#8a8a86;">
                    {it.note}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- VERIFY -->
    <section style="padding:40px 28px;">
      <div style="max-width:980px;margin:0 auto;">
        <div class="mono up" style="font-size:11px;color:#8aa4d0;margin-bottom:14px;">
          Trust chain
        </div>
        <h2
          style="font-size:clamp(22px,2.8vw,34px);font-weight:700;letter-spacing:-0.025em;line-height:1.05;max-width:20ch;"
        >
          Don't trust the download. Verify it.
        </h2>
        <p
          style="margin-top:16px;max-width:62ch;font-size:15px;line-height:1.65;color:#8a8a86;"
        >
          Signed and reproducible builds let you check that the app is exactly
          what we published — one link in the chain, described no more strongly
          than the threat model allows.
        </p>
        <div
          style="margin-top:28px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px;"
        >
          {
            verify.map((c) => (
              <div style="border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px;background:#0c0c0c;">
                <div class="mono" style="font-size:12px;color:#54544f;">
                  {c.n}
                </div>
                <div style="margin-top:10px;font-size:16px;font-weight:600;">{c.t}</div>
                <p style="margin-top:8px;font-size:12.5px;line-height:1.6;color:#8a8a86;">
                  {c.p}
                </p>
              </div>
            ))
          }
        </div>
        <div
          class="mono"
          style="margin-top:18px;border:1px solid rgba(255,255,255,0.1);border-radius:10px;background:#0c0c0c;padding:16px 18px;font-size:12px;color:#8a8a86;display:flex;align-items:center;gap:12px;overflow-x:auto;"
        >
          <span style="color:#54544f;flex:0 0 auto;">$</span>
          <span style="white-space:nowrap;"
            >shasum -a 256 Myne-0.1.0.dmg &nbsp;<span style="color:#54544f;"
              ># compare against the published SHA-256</span
            ></span
          >
        </div>
      </div>
    </section>

    <!-- REQUIREMENTS + LATEST -->
    <section style="padding:30px 28px 70px;">
      <div
        style="max-width:980px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;"
      >
        <div>
          <div class="mono up" style="font-size:11px;color:#8aa4d0;margin-bottom:16px;">
            Requirements
          </div>
          <div style="display:flex;flex-direction:column;">
            {
              reqs.map(([k, v], i) => (
                <div
                  style={`display:grid;grid-template-columns:92px 1fr;gap:16px;padding:15px 0;${i < reqs.length - 1 ? "border-bottom:1px solid rgba(255,255,255,0.08);" : ""}`}
                >
                  <span class="mono up" style="font-size:10px;color:#8a8a86;padding-top:2px;">
                    {k}
                  </span>
                  <span style="font-size:13.5px;line-height:1.6;color:#c4c4c0;">{v}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div>
          <div class="mono up" style="font-size:11px;color:#8aa4d0;margin-bottom:16px;">
            Latest
          </div>
          <div
            style="border:1px solid rgba(255,255,255,0.1);border-radius:12px;background:#0c0c0c;padding:22px;"
          >
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <span class="mono" style="font-size:15px;font-weight:600;color:#e6e6e4;">v0.1.0</span>
              <span
                class="mono up"
                style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
                >pre-alpha</span
              >
            </div>
            <div class="mono" style="margin-top:6px;font-size:11px;color:#54544f;">
              public draft · client in progress
            </div>
            <div style="margin-top:18px;display:flex;flex-direction:column;gap:9px;">
              <div style="display:flex;gap:10px;align-items:baseline;">
                <span style="color:#7fb89a;flex:0 0 auto;">+</span>
                <span style="font-size:13px;line-height:1.5;color:#c4c4c0;"
                  >Public v0.1 protocol spec &amp; threat model</span
                >
              </div>
              <div style="display:flex;gap:10px;align-items:baseline;">
                <span style="color:#7fb89a;flex:0 0 auto;">+</span>
                <span style="font-size:13px;line-height:1.5;color:#c4c4c0;"
                  >Cross-implementation test vectors</span
                >
              </div>
              <div style="display:flex;gap:10px;align-items:baseline;">
                <span style="color:#c2a35e;flex:0 0 auto;">~</span>
                <span style="font-size:13px;line-height:1.5;color:#c4c4c0;"
                  >Desktop client — editor, vault, autosave</span
                >
              </div>
            </div>
            <a
              href="https://github.com/myne-md"
              class="mono up"
              style="margin-top:22px;display:flex;align-items:center;justify-content:center;gap:8px;background:#e6e6e4;color:#0a0a0a;text-decoration:none;border-radius:8px;padding:12px;font-size:10px;font-weight:700;"
              >Watch releases on GitHub</a
            >
          </div>
        </div>
      </div>
    </section>

    <footer style="border-top:1px solid rgba(255,255,255,0.1);padding:36px 28px;">
      <div
        class="mono up"
        style="max-width:980px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:10px;color:#54544f;"
      >
        <span>© 2026 Myne · AGPL-3.0 · CC0 docs</span><span
          >signed · reproducible · open</span
        >
      </div>
    </footer>
  </div>
</LandingLayout>
