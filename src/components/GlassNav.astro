---
/*
 * Shared glassy top bar so the landing and the user guide carry an identical
 * navbar. Anchors are absolute (/#…) so the section links also work from the
 * user-guide routes (they navigate to the landing and scroll). Relies on the
 * .up / .mono helper classes provided by LandingLayout, which wraps both.
 *
 * Responsive: on narrow viewports the centre links collapse behind a hamburger
 * that toggles a drop-down panel. The toggle is a pure-CSS checkbox hack, no
 * island, no JS runtime (AGENTS.md: keep the bundle small).
 */
import GuideSearchDialog from "./userguide/GuideSearchDialog.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Highlighted nav entry. */
  active?:
    | "home"
    | "features"
    | "method"
    | "commit"
    | "guide"
    /* Kept in the union although no link renders them: /roadmap/ and /ledger/
       are parked behind a leading underscore in src/pages (see astro.config.mjs),
       and their sources still pass these keys. Dropping the members would be a
       type error in a file nothing builds any more. */
    | "roadmap"
    | "ledger"
    | "download"
    /** /press is linked from the footer, not the nav: it is for someone who was
     *  told it exists, and a journalist is not browsing the marketing nav. */
    | "press"
    | "spec"
    | "security"
    /** Legal pages live in the footer, not the nav, they pass this so no
     *  unrelated nav entry lights up (the default `"home"` would). */
    | "legal";
  /** Enable scroll-spy: the landing page passes this so the in-page section
   *  links light up as their section scrolls into view. Other pages leave it
   *  off so the server-set `active` stays put. */
  spy?: boolean;
  /** User-guide pages pass this so the mobile drop-down carries the guide nav
   *  (provided via the `guide` slot) as its default pane, with a back button
   *  to the normal site nav. No separate sidebar drawer on mobile. */
  guide?: boolean;
}
const { active = "home", spy = false, guide = false } = Astro.props;

const links = [
  { key: "home", label: "Home", href: "/#top", spy: "top" },
  { key: "method", label: "Compare", href: "/#capab", spy: "capab" },
  /* Between Compare and Guide, where a reader who has just been told what the
     app is unlike now wants to know what it does. It carries no scroll-spy, so
     the landing keeps lighting Home as it scrolls past the grid. */
  { key: "features", label: "Features", href: "/features/" },
  { key: "guide", label: "Guide", href: "/user-guide/getting-started/welcome/" },
  { key: "security", label: "Security", href: "/security/" },
  { key: "download", label: "Download", href: "/download/" },
] as const;
---

<header class="gnav" data-gnav-spy={spy ? "" : undefined}>
  <div class="gnav-inner">
    <a href="/#top" class="gnav-brand">
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none"
        ><path
          d="M8 22 V10 L16 18 L24 10 V22"
          stroke="currentColor"
          stroke-width="2.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
      <span class="gnav-word">Myne</span>
    </a>

    {/* CSS-only toggle: the checkbox state drives the mobile panel. */}
    <input type="checkbox" id="gnav-toggle" class="gnav-toggle" aria-hidden="true" />

    <nav class="gnav-links up" data-gnav-panel data-pane={guide ? "guide" : "site"}>
      {/* Site pane — the links sit inline on desktop (wrapper is display:contents)
         and become the drop-down list on mobile. */}
      <div class="gnav-sitepane">
        {
          links.map((l) => (
            <a
              href={l.href}
              data-spy={"spy" in l ? l.spy : undefined}
              class:list={["gnav-link", { "is-active": active === l.key }]}
            >
              {l.label}
            </a>
          ))
        }
        {guide && (
          <button type="button" class="gnav-paneswitch" data-gnav-to-guide>
            Guide contents →
          </button>
        )}
      </div>

      {/* Guide pane — the full guide nav, the default pane on guide pages, with
         a back button to the site nav. Mobile-only. */}
      {guide && (
        <div class="gnav-guidepane">
          <div class="gnav-guidehead">
            <button type="button" class="gnav-paneback" data-gnav-to-site>
              ← Menu
            </button>
          </div>
          <slot name="guide" />
        </div>
      )}
    </nav>

    <div class="gnav-actions mono">
      {/* Rendered on EVERY route, and only made invisible where it does not
          apply. It used to be conditional, which shifted every centre link left
          by 46px (the button plus its gap) the moment a reader stepped from the
          landing into the guide: the bar's own contents moved, on a page they
          had just navigated to. `visibility: hidden` rather than
          `display: none`, because the space is the whole point, and it also
          takes the button out of the tab order. */}
      <button
        type="button"
        class:list={["gnav-search", { "gnav-search--off": !guide }]}
        data-guide-search-open={guide ? "" : undefined}
        aria-label="Search the guide"
        aria-hidden={guide ? undefined : "true"}
        tabindex={guide ? undefined : -1}
        title={guide ? "Search the guide (⌘K)" : undefined}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.34-4.34"></path>
        </svg>
      </button>
      <ThemeToggle />
    </div>

    {/* The desktop actions cluster is hidden under 920px, so the switch needs
        its own mobile home in the bar. It leads the right cluster and carries
        the auto margin that pushes the search icon / burger to the edge. */}
    <span class="gnav-thememobile">
      <ThemeToggle />
    </span>

    {guide ? (
      <button
        type="button"
        class="gnav-search gnav-search--mobile"
        data-guide-search-open
        aria-label="Search the guide"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.34-4.34"></path>
        </svg>
      </button>
    ) : (
      /* Same reservation as the desktop copy, for the same reason: on a phone
         the search icon appearing in the cluster slides the switch and the
         burger, which is the same movement at a smaller size. */
      <span class="gnav-search gnav-search--mobile gnav-search--reserve" aria-hidden="true"></span>
    )}

    <label for="gnav-toggle" class="gnav-burger" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </label>
  </div>
</header>

{guide && <GuideSearchDialog />}

<style>
  .gnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    /* The gutter lives on the full-width bar (not the inner box) so the inner
       column mirrors the page sections exactly: outer padding + a pure
       max-width token-centred inner. That lands the brand on the same edge as
       the hero/section content at every width. */
    padding: 0 var(--gutter);
    background: rgb(var(--paper-rgb) / 0.18);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  /* ONE height for the bar, on every route. It used to be whatever the
     tallest child happened to be: 55px wherever ThemeToggle's row-height
     margin won and 68px on the guide, where the 32px search button set the
     row outright. The bar is fixed-position, so that difference moved the
     page under it on every navigation. `min-height` rather than `height`
     because this file is also the mobile bar, where the burger and the switch
     have to keep their own hit areas on a small screen without pushing the
     bar past the token. */
  .gnav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: var(--content-max);
    min-height: var(--nav-h);
    margin: 0 auto;
    padding: 0;
  }

  .gnav-brand {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--ink-1);
    flex-shrink: 0;
  }
  .gnav-word {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .gnav-links {
    display: flex;
    gap: 22px;
    font-size: 10.5px;
    color: var(--ink-3);
  }
  .gnav-link {
    color: inherit;
    text-decoration: none;
  }
  .gnav-link.is-active {
    color: var(--ink-1);
  }

  /* Panes: on desktop the site links sit inline (the wrapper is transparent to
     layout via display:contents); the guide pane and the pane-switch controls
     are mobile-only. */
  .gnav-sitepane {
    display: contents;
  }
  .gnav-guidepane {
    display: none;
  }
  .gnav-paneswitch {
    display: none;
  }

  .gnav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10.5px;
    color: var(--ink-3);
    flex-shrink: 0;
  }
  /* Primary CTA, styled identically to the Download pill. Retained after the
     hosted web client closed (2026-10-16): nothing renders it today, and the
     class is kept rather than deleted because the CTA is the shape a future
     "run the browser client" entry point would use. It previously routed to
     app.example.com, which no longer serves anything. */
  .gnav-openapp {
    color: var(--ink-1);
    text-decoration: none;
    border: 1px solid rgb(var(--line-rgb) / 0.2);
    border-radius: 5px;
    padding: 7px 13px;
    font-size: 10px;
  }
  /* Icon-only search trigger, guide pages only (opens the full-content
     search palette). The desktop copy lives inside .gnav-actions; a mobile
     twin sits in the bar next to the burger. */
  .gnav-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 1px solid rgb(var(--line-rgb) / 0.16);
    border-radius: 6px;
    color: var(--ink-2);
    cursor: pointer;
    flex-shrink: 0;
  }
  .gnav-search:hover {
    color: var(--ink-1);
    border-color: rgb(var(--line-rgb) / 0.3);
    background: rgb(var(--line-rgb) / 0.04);
  }
  .gnav-search--mobile {
    display: none;
  }
  /* Reserved on routes with no guide to search. Invisible and out of the tab
     order, but still occupying its own width, which is what keeps the centre
     links from moving between routes. */
  .gnav-search--off {
    visibility: hidden;
    pointer-events: none;
  }
  /* Mobile-only switch slot; the desktop copy lives in .gnav-actions. */
  .gnav-thememobile {
    display: none;
  }
  .gnav-download {
    color: var(--ink-1);
    text-decoration: none;
    border: 1px solid rgb(var(--line-rgb) / 0.2);
    border-radius: 5px;
    padding: 7px 13px;
    font-size: 10px;
  }
  /* Live inside the drop-down panel; only surface on mobile. */
  .gnav-download--panel,
  .gnav-openapp--panel {
    display: none;
  }

  /* The checkbox + hamburger are desktop-hidden; the panel lives inside .gnav-links. */
  .gnav-toggle {
    display: none;
  }
  .gnav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 30px;
    height: 30px;
    padding: 4px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .gnav-burger span {
    display: block;
    height: 1.6px;
    width: 100%;
    background: var(--ink-1);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 920px) {
    /* The mobile bar is fully opaque, no see-through over the page beneath.
       Drop the bar's gutter so the drop-down panel spans edge to edge; the
       inner row carries the inset instead. */
    .gnav {
      padding: 0;
      background: var(--paper);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: 1px solid rgb(var(--line-rgb) / 0.08);
    }
    /* The mobile gutter matches the page sections so the brand/burger line up
       with the mobile content edges. The bar keeps the token's height rather
       than adding padding, so the fixed offset the pages below it reserve is
       the same on a phone as on a desktop. */
    .gnav-inner {
      padding: 0 var(--gutter);
    }

    /* Centre links become a full-height drop-down panel anchored under the bar. */
    .gnav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0 var(--gutter);
      background: var(--paper);
      border-bottom: 1px solid rgb(var(--line-rgb) / 0.08);
      font-size: 12px;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .gnav-link {
      padding: 13px 0;
      border-top: 1px solid rgb(var(--line-rgb) / 0.06);
    }
    .gnav-link:first-child {
      border-top: none;
    }

    /* Two panes (site links ↔ guide nav). Only one shows at a time, switched
       by the pane-switch buttons; on guide pages the panel opens on "guide". */
    .gnav-sitepane,
    .gnav-guidepane {
      flex-direction: column;
    }
    .gnav-links[data-pane="site"] .gnav-sitepane {
      display: flex;
    }
    .gnav-links[data-pane="site"] .gnav-guidepane {
      display: none;
    }
    .gnav-links[data-pane="guide"] .gnav-sitepane {
      display: none;
    }
    .gnav-links[data-pane="guide"] .gnav-guidepane {
      display: flex;
    }
    .gnav-paneswitch {
      display: block;
      width: 100%;
      text-align: left;
      background: transparent;
      border: 0;
      border-top: 1px solid rgb(var(--line-rgb) / 0.06);
      padding: 14px 0;
      margin: 0;
      font: inherit;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      cursor: pointer;
    }
    /* Guide pane head: "← Menu" sits inline next to the search box, no
       separator line. */
    .gnav-guidehead {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0 18px;
    }
    .gnav-paneback {
      flex: 0 0 auto;
      width: auto;
      background: transparent;
      border: 0;
      padding: 0;
      margin: 0;
      font: inherit;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-3);
      cursor: pointer;
      white-space: nowrap;
    }
    /* Guide-pane head: just the "← Menu" back control, search is reached from
       the icon button in the bar, not from inside the drop-down. */
    .gnav-guidepane {
      padding-bottom: 24px;
    }

    /* Download moves out of the bar and into the panel as a real CTA. */
    .gnav-actions {
      display: none;
    }
    .gnav-download--panel {
      display: block;
      margin: 14px 0 12px;
      padding: 12px 16px;
      text-align: center;
      font-size: 11px;
      border-color: rgb(var(--line-rgb) / 0.28);
      background: rgb(var(--line-rgb) / 0.04);
    }
    .gnav-openapp--panel {
      display: block;
      margin: 0 0 18px;
      padding: 12px 16px;
      text-align: center;
      font-size: 11px;
      border-color: rgb(var(--line-rgb) / 0.28);
      background: rgb(var(--line-rgb) / 0.04);
    }

    /* Open state, a near-full-height sheet below the bar. */
    .gnav-toggle:checked ~ .gnav-links {
      max-height: calc(100vh - var(--nav-h));
      max-height: calc(100dvh - var(--nav-h));
      overflow-y: auto;
    }

    /* While that sheet is open it reaches the viewport bottom. The z-index
       raise that used to be here existed only to clear the site-wide strip
       (a sticky, opaque, z-index 100 notice) that has since been removed, so
       the bar keeps its own 80 in both states. */

    /* The mobile switch leads the right cluster and carries the auto margin
       that pushes it (and the search icon / burger behind it) to the edge. */
    .gnav-thememobile {
      display: inline-flex;
      margin-left: auto;
      flex-shrink: 0;
    }
    /* Search icon joins the bar next to the switch and burger. */
    .gnav-search--mobile {
      display: inline-flex;
    }
    .gnav-search--reserve {
      visibility: hidden;
    }
    .gnav-burger {
      display: flex;
    }
    /* Animate the hamburger into an X when open. */
    .gnav-toggle:checked ~ .gnav-burger span:nth-child(1) {
      transform: translateY(5.6px) rotate(45deg);
    }
    .gnav-toggle:checked ~ .gnav-burger span:nth-child(2) {
      opacity: 0;
    }
    .gnav-toggle:checked ~ .gnav-burger span:nth-child(3) {
      transform: translateY(-5.6px) rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gnav-links,
    .gnav-burger span {
      transition: none;
    }
  }

  /* Named so the client router snapshots the bar apart from the page under it.
     An unnamed fixed element inside `root` inherits the page's transition and
     slides with the outgoing article, which reads as the whole site moving
     rather than the content. */
  .gnav {
    view-transition-name: myne-nav;
  }
</style>

<script>
  // Scroll-spy for the landing page, only runs where the bar opted in via
  // [data-gnav-spy] (the landing). Each in-page section link carries a
  // data-spy="<section-id>"; on scroll the link whose section the reader is
  // currently in gets .is-active. Pages without the opt-in keep their
  // server-set active entry untouched. Closing the mobile panel on a link tap
  // is handled here too so a same-page anchor jump doesn't leave it open.
  const bar = document.querySelector(".gnav[data-gnav-spy]");
  if (bar) {
    const spyLinks = Array.from(
      bar.querySelectorAll<HTMLAnchorElement>("[data-spy]"),
    );
    const targets = spyLinks
      .map((a) => ({ a, el: document.getElementById(a.dataset.spy!) }))
      .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => !!t.el);

    if (targets.length) {
      const header = bar as HTMLElement;
      let raf = 0;
      const update = () => {
        raf = 0;
        const y = window.scrollY + header.offsetHeight + 8;
        let active = targets[0];
        for (const t of targets) if (t.el.offsetTop <= y) active = t;
        // Pin the last section to the bottom-most link when the page is
        // scrolled to the very end (short final sections never cross the line).
        if (
          window.innerHeight + window.scrollY >=
          document.body.scrollHeight - 2
        )
          active = targets[targets.length - 1];
        spyLinks.forEach((a) => a.classList.toggle("is-active", a === active.a));
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }

  // Collapse the mobile drop-down after tapping any link inside it.
  const toggle = document.getElementById("gnav-toggle") as HTMLInputElement | null;
  if (toggle) {
    document.querySelectorAll(".gnav-links a").forEach((a) =>
      a.addEventListener("click", () => {
        toggle.checked = false;
      }),
    );
  }

  // Guide drop-down: switch between the guide nav and the site nav. The panel
  // re-opens on its default pane (guide, on guide pages) each time.
  const panel = document.querySelector<HTMLElement>("[data-gnav-panel]");
  if (panel) {
    const defaultPane = panel.dataset.pane || "site";
    const setPane = (p: string) => panel.setAttribute("data-pane", p);
    panel
      .querySelector("[data-gnav-to-guide]")
      ?.addEventListener("click", () => setPane("guide"));
    panel
      .querySelector("[data-gnav-to-site]")
      ?.addEventListener("click", () => setPane("site"));
    toggle?.addEventListener("change", () => {
      if (toggle.checked) setPane(defaultPane);
    });
  }
</script>
