---
const words = [
  "abandon", "ability", "able", "about",
  "above", "absent", "absorb", "abstract",
  "absurd", "abuse", "access", "accident",
  "account", "accuse", "achieve", "acid",
  "acoustic", "acquire", "across", "act",
  "action", "actor", "actress", "actual",
];
---

<section id="recovery">
  <div class="container">
    <div class="feature flip">
      <div>
        <div class="section-eyebrow">Recovery</div>
        <h3>24 words. That's the whole recovery story.</h3>
        <p>
          A BIP-39 24-word phrase is generated once, on-device, when you create
          your vault. Together with your password, it's the only way to derive
          your root key.
        </p>
        <p>
          If you lose both your password and recovery phrase, your notes are
          unrecoverable. We cannot help. We say this in the product, before you
          click "create vault" — and we mean it.
        </p>
        <ul>
          <li>BIP-39 English wordlist, 256-bit entropy</li>
          <li>Generated client-side; never transmitted</li>
          <li>Fed directly to Argon2id (no PBKDF2 step)</li>
          <li>Compatible with paper, password managers, hardware wallets</li>
        </ul>
      </div>
      <div class="visual">
        <div class="grid">
          {words.map((w, i) => (
            <div class="w">
              <span class="i">{i + 1}</span>
              <span class="word">{w}</span>
            </div>
          ))}
        </div>
        <p class="caption">
          Sample words from the BIP-39 English wordlist — not a real phrase.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 0;
    border-bottom: 1px solid var(--line-1);
  }
  .section-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 16px;
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 48px 0;
  }
  .feature.flip > :first-child { order: 2; }
  .feature h3 {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 600;
    margin: 0 0 16px;
    color: var(--fg-display);
  }
  .feature p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg-2);
    margin: 0 0 16px;
  }
  .feature ul {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .feature li {
    padding: 8px 0 8px 24px;
    border-top: 1px solid var(--line-1);
    position: relative;
    font-size: 14px;
    color: var(--fg-1);
  }
  .feature li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 16px;
    width: 12px;
    height: 1px;
    background: var(--fg-3);
  }
  .visual {
    background: var(--paper-2);
    border: 1px solid var(--line-1);
    border-radius: 8px;
    padding: 32px;
    min-height: 320px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .w {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 8px;
    background: var(--bg-1);
    border: 1px solid var(--line-1);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-feature-settings: "ss02", "zero";
  }
  .w .i {
    color: var(--fg-3);
    min-width: 14px;
    text-align: right;
  }
  .w .word { color: var(--fg-1); }
  .caption {
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--fg-3);
    line-height: 1.5;
  }

  @media (max-width: 920px) {
    .feature {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 0;
    }
    .feature.flip > :first-child { order: 0; }
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
