---
import { PLACEHOLDER } from "../scripts/account-number";
---

<section id="identity">
  <div class="container">
    <div class="feature">
      <div>
        <div class="section-eyebrow">Identity</div>
        <h3>Your account is a number you keep.</h3>
        <p>
          No email field, no phone field, no recovery question. Signup gives you
          an account number — yours to write down, store offline, or hand to a
          password manager.
        </p>
        <p>
          The server keeps only its hash. We can't reset it, sell it, or mail you
          about it. There is nothing to mail.
        </p>
        <ul>
          <li>95 bits of entropy across 19 Crockford-base32 characters</li>
          <li>1 Damm-32 check character — single-typo detection</li>
          <li>Non-breaking hyphens — never wraps mid-group</li>
          <li>Single click selects the whole value</li>
          <li>Slashed-zero monospace — no <code>0/O</code> ambiguity</li>
        </ul>
      </div>
      <div class="visual">
        <div class="acct">
          <div class="big-row">
            <span id="big-acct" class="big" aria-label="Live demo account number — click to regenerate">{PLACEHOLDER}</span>
            <button class="reroll" type="button" id="big-acct-reroll" aria-label="Generate a new account number">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 12a9 9 0 0 1 15.5-6.3L21 8" />
                <path d="M21 3v5h-5" />
                <path d="M21 12a9 9 0 0 1-15.5 6.3L3 16" />
                <path d="M3 21v-5h5" />
              </svg>
            </button>
          </div>
          <div class="anno">
            <code>MY</code>
            <span>Fixed prefix — distinguishes Myne account numbers from arbitrary base32.</span>
            <code>1–4</code>
            <span>First entropy group. Non-breaking hyphens (U+2011) — never wraps mid-group.</span>
            <code>20</code>
            <span>Damm-32 check character. Single-typo detection, single-adjacent-transposition detection.</span>
            <code>·</code>
            <span class="demo-note">Demo — fresh CSPRNG draw on every click. Production includes the spec §4 Damm-32 check.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .acct {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .big-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .big {
    font-family: var(--font-mono);
    font-size: 28px;
    letter-spacing: 0.04em;
    font-weight: 500;
    font-feature-settings: "ss02", "zero", "calt";
    white-space: nowrap;
    user-select: all;
    color: var(--fg-1);
    cursor: pointer;
  }
  .reroll {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--line-1);
    background: var(--bg-1);
    color: var(--fg-3);
    cursor: pointer;
    transition:
      color 120ms var(--ease-standard),
      background 120ms var(--ease-standard),
      border-color 120ms var(--ease-standard);
  }
  .reroll:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .reroll :global(.ico) { width: 16px; height: 16px; }
  .demo-note {
    color: var(--fg-3) !important;
    font-style: italic;
  }
  .anno {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px 16px;
    font-size: 12.5px;
    align-items: baseline;
  }
  .anno code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    background: transparent;
    border: 0;
    padding: 0;
    font-feature-settings: "ss02", "zero";
  }
  .anno span {
    color: var(--fg-2);
    line-height: 1.5;
  }

  @media (max-width: 920px) {
    .big { font-size: 22px; }
  }
</style>

<script>
  import { mountAccountNumber } from "../scripts/account-number";
  // Defer the entrance animation until the section enters the viewport, so it
  // doesn't compete with the hero-card animation for paint budget on first load.
  const big = document.getElementById("big-acct");
  const reroll = document.getElementById("big-acct-reroll") ?? undefined;
  if (big) {
    const observer = new IntersectionObserver((entries, self) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          mountAccountNumber(big, reroll);
          self.disconnect();
          break;
        }
      }
    }, { rootMargin: "0px 0px -10% 0px" });
    observer.observe(big);
  }
</script>
