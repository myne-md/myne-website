---
/*
 * Shell for the landing routes (Myne v13 design).
 *
 * The site is DARK by default and a reader may switch to light; the switch
 * itself lives in GlassNav (components/ThemeToggle.astro) and the palette in
 * styles/tokens.css. This layout imports tokens.css so every landing route
 * has the token layer, and it carries the pre-paint snippet below that applies
 * a stored "light" choice before the first paint (no flash).
 *
 * Still does NOT pull in the shared global.css or the unused light-theme
 * SubscribeDialog.
 */
import { ClientRouter } from "astro:transitions";
import DraftNotice from "../components/DraftNotice.astro";
import type { NoticeLang, NoticeVariant } from "../data/notice";
import "../styles/fonts.css";
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL for this page. */
  canonical?: string;
  /** Absolute og:image URL — falls back to nothing if absent. */
  ogImage?: string;
  /** Robots directive (e.g. "noindex,nofollow"). Omit to leave it unset. */
  robots?: string;
  /** og:type — defaults to website; permalink pages pass "article". */
  ogType?: "website" | "article";
  /** Opt in to Astro's client-side router (View Transitions). Only the
   *  user-guide passes this, so guide→guide navigation swaps just the article
   *  content while the persisted chrome (nav, sidebar, footer) stays mounted.
   *  View Transitions engage only between two pages that BOTH ship the router,
   *  so every other route keeps its plain full-load navigation untouched. */
  clientRouter?: boolean;
  /** Which claim the site-wide draft notice makes on this page. Defaults to
   *  the product-status one; the legal texts pass their own, and /impressum/
   *  passes "none", which renders no notice at all. The reasoning per variant
   *  is in DraftNotice.astro; the union is shared from data/notice so this
   *  file and that one cannot drift apart. A legal page that FORGETS the prop
   *  silently gets the product-status wording under a document the reader is
   *  being asked to accept, which every presence check would pass. That is
   *  what scripts/validate-draft-notice.mjs exists to catch. */
  notice?: NoticeVariant;
  /** Language of that notice, matched to the page's prose (the German legal
   *  pages pass "de"). */
  noticeLang?: NoticeLang;
  /** Pin this page to dark and hide the theme switch. The theme builder passes
   *  it: it is a fixed dark workspace with its own `--tb-*` palette and a
   *  live-preview iframe, so a light palette would fight its chrome. The head
   *  snippet below short-circuits on it and ThemeToggle's CSS hides the button. */
  themeLock?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  robots,
  ogType = "website",
  clientRouter = false,
  notice = "status",
  noticeLang = "en",
  themeLock = false,
} = Astro.props;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, Astro.site!).toString();
---

<!--
                    o      o
   888b     d888  o    o    o
   8888b   d8888    o    o
   88888b.d88888  o    o    o
   888 888P 888                     myne-protocol-v0.1
   888  Y8P  888                    encrypted markdown notes
   888   "   888                    no email at signup
   888       888                    your account is a number
                                    you keep, not an email we keep

   Hi. If you're reading this, you're our kind of person.
   Specs, threat model, and source go public when Phase 1 ships.
-->
<html lang="en" data-theme-lock={themeLock ? "dark" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Pre-paint theme application. Inline and non-module because it must run
        during head parsing, before the stylesheet paints, so a reader whose
        stored choice is "light" never sees a dark first frame. Duplicates the
        key/default from lib/theme.mjs, which can not be imported here; the
        token guard (scripts/check-theme-tokens.mjs) asserts the key matches.
        Dark is the CSS default, so a broken script or JS off still lands dark.
        Pages that pin themselves dark (the theme builder) skip it entirely. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (root.dataset.themeLock === "dark") return;
        var stored = null;
        try {
          stored = localStorage.getItem("myne-theme");
        } catch (e) {}
        root.dataset.theme = stored === "light" ? "light" : "dark";
      })();
    </script>
    {clientRouter && <ClientRouter />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {robots && <meta name="robots" content={robots} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Myne ledger"
      href="/ledger/rss.xml"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Myne" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={title} />}

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        scroll-behavior: smooth;
        /* Theme surface all the way down so nothing flashes a mismatched pale
           (or dark) band during the page-in fade or on overscroll. --bg-1 is
           the theme's page colour: #0a0a0a dark, #fbfbfa light. */
        background: var(--bg-1);
        /* Kill the rubber-band overscroll: bouncing past the top let the
           content slide under the fixed, blurred navbar and made its
           backdrop-filter smear. No bounce → the bar's backdrop stays clean. */
        overscroll-behavior: none;
      }
      body {
        background: var(--bg-1);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      /* Smooth, unified page-in: a full-screen curtain in the theme's page
         colour sits over the content and fades away on load, revealing it all
         at once with no per-section stagger. The curtain's z-index is below
         the navbar (80) but above the content/cursor-glow, so the navbar stays
         put on top; it never fades or flashes; only the content behind the
         curtain reveals. Re-runs on every navigation since each is a full
         document load. The colour MUST follow the theme or a light reader
         would get a dark flash on every navigation. */
      .page-curtain {
        position: fixed;
        inset: 0;
        z-index: 75;
        background: var(--bg-1);
        opacity: 0;
        pointer-events: none;
        animation: myne-page-in 0.7s ease both;
      }
      @keyframes myne-page-in {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }
      ::selection {
        background: var(--selection-bg);
        color: var(--selection-fg);
      }
      /* Site-wide custom scrollbar: a muted thumb on the page colour, floated
         off the track by a matching inset border. Firefox uses the thin native
         scrollbar with the same colours. All four values follow the theme. */
      html {
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
      }
      ::-webkit-scrollbar {
        width: 12px;
        height: 12px;
      }
      ::-webkit-scrollbar-track {
        background: var(--scrollbar-track);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--scrollbar-thumb);
        border: 3px solid var(--scrollbar-track);
        border-radius: 8px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--scrollbar-thumb-hover);
      }
      ::-webkit-scrollbar-corner {
        background: var(--scrollbar-track);
      }
      .mono {
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-feature-settings: "zero" 1, "ss02" 1, "calt" 1;
      }
      .up {
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
      /* The draft notice is sticky at the bottom edge on every route, so a
         focused control reached by Tab scrolls flush to the bottom of the
         scrollport, which is under the strip: WCAG 2.2 SC 2.4.11, Focus Not
         Obscured. The mirror problem at the top edge is already solved per
         page (spec.astro carries scroll-margin-top for the fixed nav); this
         is the bottom half, once, for every route. It reserves no layout
         height, so it does not reintroduce the fixed constant the notice's
         own comment measured and rejected.

         This covers the ROOT scroller only, which is every route except the
         two nested scrollports the strip also overlaps: the open mobile nav
         panel and the guide sidebar. Those are handled where they live
         (GlassNav.astro raises the bar above the strip while its panel is
         open; userguide.css reserves inside the sidebar's scroller), because
         a root-level property does not reach into either one.

         The value comes from the notice rather than from here: --draft-notice-
         reserve is declared by DraftNotice.astro, so it is 0px on the two
         pages that render no strip instead of reserving for one that is not
         there. The first version was 7rem, which is 112px against the
         component's own measured 111px worst case, in a unit that scales with
         the root font size while the strip's font-size is a fixed 11px, so a
         reader with a larger default font moved the reserve and the strip
         independently. */
      html {
        scroll-padding-bottom: var(--draft-notice-reserve, 0px);
      }
      .tick {
        position: absolute;
        width: 8px;
        height: 8px;
        color: var(--ink-4);
        font-size: 11px;
        line-height: 8px;
        font-family: "JetBrains Mono", monospace;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          animation: none !important;
          transition: none !important;
        }
        .page-curtain {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    {/* Persist the intro curtain across client-router navigations so it does
        not re-mount and re-run its dark fade-in on every in-guide page swap.
        The directive is applied ONLY when the router is enabled — adding a
        transition directive anywhere on a page pulls in the transitions
        runtime, so the plain variant keeps non-guide routes untouched. */}
    {clientRouter ? (
      <div class="page-curtain" aria-hidden="true" transition:persist></div>
    ) : (
      <div class="page-curtain" aria-hidden="true"></div>
    )}
    <slot />
    {notice !== "none" && <DraftNotice variant={notice} lang={noticeLang} />}
  </body>
</html>
