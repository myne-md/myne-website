---
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import AppShowcase from "../components/AppShowcase.astro";
import FeaturesBento from "../components/FeaturesBento.astro";
import VaultListing from "../components/VaultListing.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteOg } from "../lib/og";

const title = "Myne — Your notes. Sealed.";
const description =
  "Myne is a privacy-first markdown notes app that encrypts every byte before it leaves your device, asks for no email, and stores only ciphertext at rest — quietly, by default.";
const ogImage = absoluteOg("home", Astro.site!);

---

<LandingLayout title={title} description={description} ogImage={ogImage}>
  <div
    data-root
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:var(--ink-1);background:var(--paper);overflow-x:clip;"
  >
    <!-- Cursor glow: a soft light that follows the pointer everywhere except
         the hero, whose own 01 field already carries the glow.

         Turned DOWN deliberately (was 0.06 / 0.022 at 460px). At that strength
         it read as a haze over the comparison table and the FAQ, which are the
         two surfaces on this page a reader has to actually read; `screen` over
         dark lifts black text's surroundings and the table's hairlines washed
         out. The light is now a hint that the page is alive, not a lens. -->
    <div
      data-cursorglow
      style="position:fixed;top:0;left:0;width:340px;height:340px;border-radius:50%;pointer-events:none;z-index:70;opacity:0;transform:translate3d(-9999px,-9999px,0) translate(-50%,-50%);background:radial-gradient(circle closest-side, rgb(var(--particle-c-rgb) / 0.018), rgb(var(--particle-c-rgb) / 0.006) 45%, transparent 70%);mix-blend-mode:var(--blend-glow);transition:opacity .35s ease;"
    ></div>
    <!-- TOP BAR -->
    <GlassNav active="home" spy />

    <!-- ===================== HERO ===================== -->
    <!-- The copy keeps its column and the empty right half now carries the
         product: the desktop app in a window with the phone beside it, both
         frames captured from the running clients (AppShowcase.astro says where).
         The section's own height is left to its content — it used to be a fixed
         100vh on the inner box, which cannot hold the shot once the grid stacks
         on a phone. -->
    <section
      id="top"
      style="position:relative;min-height:100vh;overflow:hidden;padding:0 var(--gutter);"
    >
      <canvas
        data-noise
        style="position:absolute;top:0;left:0;width:100%;height:100%;display:block;opacity:0.9;-webkit-mask-image:linear-gradient(to bottom,#000 52%,transparent 100%);mask-image:linear-gradient(to bottom,#000 52%,transparent 100%);"
      ></canvas>
      <div class="hero-inner">
        <div class="hero-grid">
          <div class="hero-copy" style="position:relative;">
            <h1
              class="up"
              style="font-size:clamp(40px,5.6vw,82px);line-height:0.96;font-weight:800;letter-spacing:-0.01em;"
            >
              Your notes.<br /><span class="mono" data-sealed>Sealed</span>.
            </h1>
            <p
              class="mono"
              style="margin-top:22px;max-width:46ch;font-size:13px;line-height:1.7;color:var(--ink-3);"
            >
              Myne is a privacy-first markdown notes app that encrypts every byte
              before it leaves your device, asks for no email, and stores only
              ciphertext at rest — quietly, by default.
            </p>
            <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:30px;">
              <a
                href="/download/"
                class="up"
                style="background:var(--ink-1);color:var(--paper);text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;"
                >Download</a
              >
              <a
                href="/spec/"
                class="up"
                style="background:transparent;color:var(--ink-1);text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;border:1px solid rgb(var(--line-rgb) / 0.2);"
                >Read the spec</a
              >
            </div>
          </div>

          <AppShowcase
            dark="/app/desktop.webp"
            light="/app/desktop-light.webp"
            eager
            alt="The Myne desktop app with a note open in the editor, the note list and folders beside it on the left, and the note's links and backlinks on the right."
            phone={{
              dark: "/app/phone.webp",
              light: "/app/phone-light.webp",
              alt: "Myne on a phone: a note with tags and a to-do list.",
            }}
          />
        </div>
      </div>
    </section>

    <!-- ===================== MANIFESTO (pinned word reveal) ===================== -->
    <section data-manifesto style="position:relative;height:300vh;background:var(--paper);">
      <div
        style="position:sticky;top:0;height:100vh;display:flex;align-items:center;justify-content:center;padding:0 6vw;"
      >
        <h2
          class="mono"
          style="font-size:clamp(26px,4.6vw,62px);line-height:1.28;font-weight:500;letter-spacing:-0.01em;max-width:20ch;text-align:left;"
          data-words
        >
          We can't read your notes. The server can't. We didn't build a way to.
          That is the entire point.
        </h2>
      </div>
    </section>

    <!-- ===================== FEATURES (bento) ===================== -->
    <!-- Sits directly below the manifesto, so the reader meets what the app
         does before the comparison. It carries its own responsive rules; the
         page's mobile block below leaves it alone.
         The "How it works" section (a wireframe globe plus the four-step
         pipeline) used to sit here and was deleted: all four steps restated
         claims the bento's Encryption and Sync server cards already make in
         the same words, and the page carried three copies of "the server holds
         ciphertext". The concrete KDF parameters it was the only place to
         state live in /spec/, which the hero links. -->
    <FeaturesBento />

    <!-- ===================== COMPARISON ===================== -->
    <section id="capab" style="padding:100px var(--gutter);">
      <div style="max-width:var(--content-max);margin:0 auto;">
        <div data-motion="rise" style="max-width:620px;margin-bottom:40px;">
          <span class="mono up" style="font-size:11px;color:var(--ink-3);"
            >Why not the workarounds</span
          >
          <h2
            style="margin-top:14px;font-size:clamp(28px,3.8vw,50px);font-weight:600;letter-spacing:-0.03em;line-height:1.04;"
          >
            The stack you're duct-taping, in one app.
          </h2>
        </div>
        <div data-motion="clip" class="cmp-scroll" tabindex="0" role="region" aria-label="Feature comparison, scrollable">
        <div
          class="cmp-card"
          style="border:1px solid rgb(var(--line-rgb) / 0.12);border-radius:12px;overflow:hidden;background:var(--paper-2);"
        >
          {/* A real table, not a grid of divs. The cells are ticks, crosses and
              "partial" with no text of their own, so a screen reader can only
              make sense of them through row and column association; the div grid
              this replaced announced 78 cells in one stream. `table-layout:
              fixed` plus the colgroup is what keeps the label column at twice
              the width of each tool column, which the old inline
              grid-template-columns did by hand. */}
          <table class="cmp-table">
            <caption class="cmp-sr">
              Feature comparison: Myne against Obsidian, Standard Notes, Joplin
              and Notesnook, at each tool's default configuration.
            </caption>
            <colgroup>
              <col style="width:33.334%" />
              <col span="5" style="width:13.333%" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col"><span class="cmp-sr">Feature</span></th>
                <th scope="col" class="is-myne">Myne</th>
                <th scope="col">Obsidian</th>
                <th scope="col">Standard Notes</th>
                <th scope="col">Joplin</th>
                <th scope="col">Notesnook</th>
              </tr>
            </thead>
            <tbody data-cmp-rows></tbody>
          </table>
        </div>
        </div>
        <p class="mono" style="margin-top:14px;font-size:11.5px;line-height:1.7;color:var(--ink-4);max-width:90ch;">
          Each tool is judged at its <strong>default configuration</strong>, from
          its own documentation, in October 2026.
          <span style="color:var(--warning);">Partial</span> means a claim that
          holds with a condition, or one Myne still owes: on the Myne column those
          are zero-knowledge sync (in hardening, on a server you run yourself,
          since Myne offers no hosted instance), self-hosted sync (the same
          server, published as a container image), meeting recording (behind
          Developer mode while its capture path is verified) and signed builds
          (macOS notarized, Android OS-verified, Windows and Linux unsigned). No
          vendor here publishes a reproducible build, so that is not scored.
        </p>
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    <section id="commit" style="padding:96px var(--gutter);">
      <div
        class="faq-grid"
        style="max-width:var(--content-max);margin:0 auto;display:grid;grid-template-columns:1.4fr 1fr;gap:50px;align-items:start;"
      >
        <div data-motion="rise">
          <h2
            style="font-size:clamp(30px,4vw,56px);font-weight:700;letter-spacing:-0.03em;line-height:1.02;"
          >
            Frequently asked<br /><span style="color:var(--ink-4);"
              >questions</span
            >
          </h2>
          <p
            style="margin-top:20px;font-size:14px;line-height:1.7;color:var(--ink-3);"
          >
            No vault is worth much if you can't understand it. Straight answers,
            including the uncomfortable ones.
          </p>
          <!-- The column is a whole half of the row now, so it carries more than
               a heading and a line of copy. This is the one exit: a reader who
               is here has a question, and the guide is where the answer is
               written out with screenshots rather than in one paragraph. -->
          <div class="faq-guide">
            <p>
              The user guide takes the same ground step by step: your first
              unlock, a note from nothing, turning sync on, and getting the whole
              vault back out as plain files.
            </p>
            <a class="faq-guide__go" href="/user-guide/getting-started/welcome/">
              <span>Open the user guide</span>
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                ><path
                  d="M5 12h13M12 5l7 7-7 7"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
          <p
            class="mono"
            style="margin-top:22px;font-size:12px;line-height:1.6;color:var(--ink-4);"
          >
            Still have a question?<br />
            <a
              href="mailto:info@myne.md"
              style="color:var(--accent);text-decoration:none;"
              >info@myne.md</a
            >
          </p>
        </div>
        <div data-faq></div>
      </div>
    </section>

    <!-- ===================== CTA ===================== -->
    <section id="contact" style="padding:90px var(--gutter) 60px;">
      <div
        data-motion="rise"
        class="cta-grid"
        style="max-width:var(--content-max);margin:0 auto;border:1px dashed rgb(var(--line-rgb) / 0.2);padding:56px 48px;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;"
      >
        <div>
          <h2
            class="up"
            style="font-size:clamp(26px,3.4vw,46px);line-height:1.02;font-weight:700;"
          >
            Write like no one's watching.<br />Because no one else can read a word.
          </h2>
          <p
            style="margin-top:16px;max-width:46ch;font-size:12.5px;line-height:1.7;color:var(--ink-3);"
          >
            Your notes deserve more than a privacy policy. In Myne the
            encryption is always on, and it never asks you to do anything.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:28px;">
            <a
              href="/spec/"
              class="up"
              style="background:var(--ink-1);color:var(--paper);text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;"
              >Read the spec</a
            >
            <a
              href="https://github.com/myne-md"
              class="up"
              style="background:transparent;color:var(--ink-1);text-decoration:none;padding:13px 22px;font-size:11px;font-weight:700;letter-spacing:0.08em;border:1px solid rgb(var(--line-rgb) / 0.2);"
              >View source</a
            >
          </div>
        </div>
        <VaultListing />
      </div>
    </section>

    <!-- ===================== FOOTER ===================== -->
    <SiteFooter />
  </div>

  <!-- Mobile layout overrides. Inline styles win over classes, so the grid
       collapses use !important — scoped to ≤760px, desktop is untouched. -->
  <style is:global>
    /* The "Sealed" wordmark renders in the mono face: its fixed-width glyphs
       keep the encrypt/decrypt scramble from reflowing the line. */
    [data-sealed] {
      letter-spacing: 0.01em;
    }

    /* Hero shell: the copy column keeps its measure and the product shot takes
       the space beside it. `min-height` with its own padding rather than a fixed
       `height: 100vh`, the fixed height cannot hold the shot once the grid
       stacks on a phone, and it clipped rather than scrolling. */
    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: var(--content-max);
      margin: 0 auto;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--page-top) 0 64px;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 600px) minmax(0, 1fr);
      gap: 48px;
      align-items: center;
    }


    /* ---- feature comparison table ---------------------------------------
       A real <table> (see the markup comment): the cell contents are a tick, a
       cross or "partial", so row/column association is the only thing that
       makes them readable, and `table-layout: fixed` is what holds the label
       column at twice the tool width. The surfaces are the pages' existing
       tokens, unchanged from the grid this replaced. */
    .cmp-table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
    }
    .cmp-table thead th {
      padding: 16px 14px;
      border-bottom: 1px solid rgb(var(--line-rgb) / 0.1);
      border-left: 1px solid rgb(var(--line-rgb) / 0.1);
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ink-2);
      text-align: center;
    }
    .cmp-table thead th:first-child {
      padding: 16px 18px;
      border-left: 0;
    }
    .cmp-table thead th.is-myne {
      background: rgb(var(--accent-rgb) / 0.14);
      color: var(--accent);
      font-weight: 700;
    }
    .cmp-table tbody th,
    .cmp-table tbody td {
      padding: 14px;
      border-left: 1px solid rgb(var(--line-rgb) / 0.1);
      text-align: center;
    }
    .cmp-table tbody th {
      padding: 14px 18px;
      border-left: 0;
      font-size: 13.5px;
      font-weight: 400;
      color: var(--ink-1);
      text-align: left;
    }
    .cmp-table tbody td.is-myne {
      background: rgb(var(--accent-rgb) / 0.08);
    }
    .cmp-table tbody tr:not(:last-child) > * {
      border-bottom: 1px solid rgb(var(--line-rgb) / 0.1);
    }
    /* The table's own header cell and caption, said once to a screen reader and
       never drawn: the column header row is the tool names, so the corner cell
       needs the word the columns are a list of. */
    .cmp-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    /* A diffuse dark cloud behind the hero copy: it locally suppresses the 01
       field so the text stays legible, then dissolves smoothly back into the
       binary on every side, soft radial falloff, no box edge. Same colour as
       the page (#0a0a0a), so it never reads as a visible blob, only as the
       binary fading out behind the words. */
    .hero-copy::before {
      content: "";
      position: absolute;
      z-index: -1;
      pointer-events: none;
      inset: -48% -58% -46% -42%;
      /* Fully opaque core so the cursor-driven 01 glow can't light up behind
         the text; then a soft falloff that dissolves into the binary. */
      background: radial-gradient(
        62% 58% at 34% 50%,
        rgb(var(--paper-rgb) / 1) 0%,
        rgb(var(--paper-rgb) / 1) 28%,
        rgb(var(--paper-rgb) / 0.55) 52%,
        rgb(var(--paper-rgb) / 0) 74%
      );
    }
    @media (max-width: 760px) {
      .hero-copy::before {
        inset: -32% -30% -34% -26%;
        background: radial-gradient(
          78% 60% at 42% 46%,
          rgb(var(--paper-rgb) / 1) 0%,
          rgb(var(--paper-rgb) / 1) 34%,
          rgb(var(--paper-rgb) / 0.5) 60%,
          rgb(var(--paper-rgb) / 0) 82%
        );
      }
    }

    @media (max-width: 1079px) {
      /* The hero stacks: copy first, then the shot full width beneath it. The
         shot needs about 300px of column to stay legible, and at this width a
         side-by-side split would leave it less than that. */
      .hero-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 40px;
      }
      .hero-inner {
        padding: 92px 0 48px;
      }
    }

    @media (max-width: 760px) {

      /* Wide comparison table scrolls horizontally instead of crushing
         its six columns. */
      .cmp-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .cmp-scroll .cmp-card {
        min-width: 640px;
      }

      /* FAQ + CTA two-column splits stack. */
      .faq-grid {
        grid-template-columns: 1fr !important;
        gap: 28px !important;
      }
      .cta-grid {
        grid-template-columns: 1fr !important;
        gap: 28px !important;
        padding: 32px 22px !important;
      }
    }
  /* The FAQ intro's exit: a hairline on the left, no box, so it reads as part of
     the paragraph above it rather than as a second card. Only the link is
     accent, and only the arrow moves on hover, because the sentence beside it
     is the reason to follow it. */
  .faq-guide {
    margin-top: 26px;
    padding-left: 16px;
    border-left: 1px solid rgb(var(--line-rgb) / 0.22);
  }
  .faq-guide p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .faq-guide__go {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .faq-guide__go svg {
    transition: transform var(--duration-exit) var(--ease-out-quint);
  }
  .faq-guide__go:hover svg,
  .faq-guide__go:focus-visible svg {
    transform: translateX(3px);
  }
  </style>
</LandingLayout>

<script>
  // Ported from the Claude Design v13 prototype (DCLogic.componentDidMount).
  // Plain DOM + canvas, no framework. Module scope keeps locals off window.
  const $ = (s: string) => document.querySelector(s);
  const $$ = (s: string) => Array.from(document.querySelectorAll(s));
  const reduce =
    window.matchMedia &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Canvas colours cannot use var() because the 2D context does not resolve
  // custom properties, so the palette's RGB triples are read from the document
  // runtime and re-read when the theme switch fires myne:themechange. The
  // values are published by styles/tokens.css as space-separated triples;
  // comma form is what rgba() wants.
  const tri = (v: string) => v.trim().replace(/\s+/g, ",");
  const readTokens = () => {
    const cs = getComputedStyle(document.documentElement);
    return {
      accent: tri(cs.getPropertyValue("--accent-rgb")),
      particleA: tri(cs.getPropertyValue("--particle-a-rgb")),
      particleB: tri(cs.getPropertyValue("--particle-b-rgb")),
      particleC: tri(cs.getPropertyValue("--particle-c-rgb")),
    };
  };
  let T = readTokens();
  window.addEventListener("myne:themechange", () => {
    T = readTokens();
  });
  // Markup colours (inline styles in generated HTML) DO take var(), so they
  // are written as the token itself and re-resolve on every theme change.
  const accent = "var(--accent)";

  let manCheck: (() => void) | null = null;
  let nRaf = 0;

  // ---------- reveals ----------
  // Owned by scripts/motion.ts together with the rest of the site's motion, so
  // this page cannot drift out of step with the other routes. What it still
  // needs locally is the hook into the manifesto's scroll progress: that check
  // used to ride on the reveal pass, which no longer exists here.
  const revealCheck = () => {
    if (manCheck) manCheck();
  };
  window.addEventListener("scroll", revealCheck, { passive: true });
  window.addEventListener("resize", revealCheck, { passive: true });
  revealCheck();
  requestAnimationFrame(revealCheck);
  [0, 150, 500, 1000].forEach((d) => setTimeout(revealCheck, d));

  // ---------- manifesto word reveal ----------
  const mclamp = (v: number, a: number, b: number) =>
    Math.max(a, Math.min(b, v));
  const man = $("[data-manifesto]") as HTMLElement | null;
  const wordsEl = $("[data-words]") as HTMLElement | null;
  if (wordsEl && man) {
    const text = wordsEl.textContent!.trim();
    const parts = text.split(/\s+/);
    wordsEl.textContent = "";
    const spans = parts.map((w) => {
      const s = document.createElement("span");
      s.textContent = w + " ";
      s.style.opacity = "0.16";
      // The highlight is scroll-driven (user-controlled), not an autonomous
      // animation, so it stays under reduce-motion, but drop the easing so
      // opacity snaps instead of animating.
      s.style.transition = reduce ? "none" : "opacity .3s ease";
      wordsEl.appendChild(s);
      return s;
    });
    manCheck = () => {
      const total = man.offsetHeight - window.innerHeight;
      const r = man.getBoundingClientRect();
      const p = total > 0 ? mclamp(-r.top / total, 0, 1) : 0;
      const lit = mclamp((p - 0.06) / 0.82, 0, 1) * spans.length;
      spans.forEach((s, i) => {
        s.style.opacity = i < lit ? "1" : i < lit + 1.6 ? "0.5" : "0.16";
      });
    };
    // revealCheck is a no-op under reduce-motion, so drive manCheck from its
    // own listeners too, otherwise the highlight never updates on the many
    // phones that ship with Reduce Motion enabled.
    window.addEventListener("scroll", manCheck, { passive: true });
    window.addEventListener("resize", manCheck, { passive: true });
    manCheck();
  }

  // ---------- comparison rows ----------
  const cmp = $("[data-cmp-rows]") as HTMLElement | null;
  if (cmp) {
    const Y = '<span style="color:var(--success);font-weight:600;">✓</span>';
    const N = '<span style="color:var(--ink-4);">—</span>';
    // "partial" is deliberately a WORD, not a symbol: paired with the footnote
    // it is the one cell a reader has to look up, and a half-glyph would make
    // it a puzzle. Its definition lives in the footnote, which is also where
    // the Myne column's three partials are named.
    const P = '<span style="color:var(--warning);font-size:12px;">partial</span>';
    // Columns: label, Myne, Obsidian, Standard Notes, Joplin, Notesnook.
    //
    // Every competitor cell was re-checked against that tool's own docs and
    // pricing in October 2026, and three of them moved LEFT after that check:
    // Joplin does end-to-end encrypt the sync target (opt-in, off by default),
    // Standard Notes does encrypt titles and tags, Notesnook does require an
    // email (it is the salt in their key derivation), and Joplin's backlinks
    // and graph are plugins rather than built-ins. A table that flatters us by
    // misdescribing a competitor is a legal risk for this project, not a
    // marketing win, and the footnote says what baseline each cell assumes:
    // DEFAULT configuration, with Obsidian's add-ons stated rather than scored.
    //
    // "Signed builds" is one row rather than "reproducible, signed" because
    // those are two different claims with three different answers, and the old
    // single cell scored Notesnook "partial" for a reproducible-build check
    // F-Droid records as FAILED. No vendor publishes a reproducible desktop
    // build; every vendor signs something. See the footnote.
    const rows = [
      ["Encrypted by default", Y, N, Y, N, Y],
      ["Encrypts titles & structure too", Y, N, Y, P, Y],
      ["Plain markdown files", Y, Y, N, N, N],
      ["Backlinks & graph, built-in", Y, Y, P, N, P],
      // Two rows that only Myne answers YES/PARTIAL. Both were verified against
      // the four vendors' own help pages rather than their marketing (October
      // 2026): Obsidian's Sync markets real-time updating while its help page
      // says it "does not yet support collaborative live editing on the same
      // file"; its shared-vault team editing merges on sync, so the "live"
      // qualifier is what makes the cell a NO rather than a YES. Obsidian and
      // Joplin both record audio and neither transcribes it, so the row tests
      // the pair rather than the recorder alone.
      ["Live co-editing, built-in", Y, N, N, N, N],
      ["Audio recording with transcription", P, N, N, N, N],
      ["No email at signup", Y, Y, P, Y, N],
      ["User-held recovery, no reset", Y, P, P, P, P],
      ["Zero-knowledge sync", P, P, Y, P, Y],
      ["Self-hostable sync", P, N, Y, Y, P],
      ["Open-source full stack", Y, N, Y, Y, Y],
      ["One integrated app", Y, Y, Y, Y, Y],
      ["No plaintext mode for notes", Y, N, Y, N, Y],
      ["Signed builds", P, P, P, P, P],
      ["No feature paywall", Y, Y, P, Y, P],
    ];
    rows.forEach((r) => {
      const tr = document.createElement("tr");
      const th = document.createElement("th");
      th.scope = "row";
      th.textContent = r[0];
      tr.append(th);
      for (let i = 1; i <= 5; i++) {
        const td = document.createElement("td");
        if (i === 1) td.className = "is-myne";
        td.innerHTML = r[i];
        tr.append(td);
      }
      cmp.append(tr);
    });
  }

  // ---------- hero noise canvas (char map) ----------
  const clamp = (v: number, a: number, b: number) =>
    Math.max(a, Math.min(b, v));
  const noise = $("[data-noise]") as HTMLCanvasElement | null;
  if (noise) {
    const ctx = noise.getContext("2d")!;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    // Touch devices never get the cursor glow that reveals the field on
    // desktop, so the faint base alpha reads as blank on a phone. Lift the
    // base contrast on no-hover (coarse-pointer) devices so the 01s show.
    const noHover =
      !!window.matchMedia && window.matchMedia("(hover: none)").matches;
    const fieldBoost = noHover ? 2.1 : 1;
    const GL = "01";
    let W = 0,
      H = 0,
      cols = 0,
      rows = 0,
      grid: { c: string; on: boolean }[] = [];
    const CELL = 15;
    const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999, active: false };
    const resize = () => {
      const b = noise.getBoundingClientRect();
      W = b.width;
      H = b.height;
      noise.width = W * dpr;
      noise.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(W / CELL);
      rows = Math.ceil(H / CELL);
      grid = new Array(cols * rows);
      for (let i = 0; i < grid.length; i++)
        grid[i] = { c: GL[(Math.random() * 2) | 0], on: Math.random() < 0.5 };
      ctx.font = "11px 'JetBrains Mono', monospace";
      ctx.textBaseline = "top";
    };
    resize();
    window.addEventListener("resize", resize);
    const moveTarget = noise.parentElement || noise;
    moveTarget.addEventListener("mousemove", (e) => {
      const b = noise.getBoundingClientRect();
      mouse.tx = (e as MouseEvent).clientX - b.left;
      mouse.ty = (e as MouseEvent).clientY - b.top;
      // Snap on first entry so the glow doesn't glide in from off-canvas.
      if (!mouse.active) {
        mouse.x = mouse.tx;
        mouse.y = mouse.ty;
        mouse.active = true;
      }
    });
    moveTarget.addEventListener("mouseleave", () => {
      mouse.active = false;
      mouse.x = mouse.y = mouse.tx = mouse.ty = -9999;
    });
    // Glyphs re-randomize on a calm ~70ms cadence; the cursor glow eases
    // toward the pointer and is redrawn every frame while hovering so it
    // visibly tracks the mouse instead of jumping in 70ms steps.
    const R = 200;
    let flickerLast = 0;
    const draw = (t: number) => {
      const flick = t - flickerLast > 70;
      if (flick) {
        flickerLast = t;
        for (let i = 0; i < grid.length; i++)
          if (Math.random() < 0.06) grid[i].c = GL[(Math.random() * 2) | 0];
      }
      if (mouse.active) {
        mouse.x += (mouse.tx - mouse.x) * 0.25;
        mouse.y += (mouse.ty - mouse.y) * 0.25;
      }
      // Full redraw every frame while hovering (smooth tracking); otherwise
      // only on the flicker tick to keep the idle cost low.
      if (mouse.active || flick) {
        ctx.clearRect(0, 0, W, H);
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const cell = grid[y * cols + x];
            const px = x * CELL,
              py = y * CELL;
            // Cover the whole hero and fade the field downward.
            const dens = clamp((1 - y / rows) * 0.8 + 0.2, 0, 1);
            const a =
              (cell.on ? 0.04 + dens * 0.18 : 0.02 + dens * 0.05) * fieldBoost;
            const d = Math.hypot(px - mouse.x, py - mouse.y);
            if (d < R) {
              const a2 = clamp(a + (1 - d / R) * 0.62, 0, 0.82);
              ctx.fillStyle = "rgba(" + T.particleC + "," + a2.toFixed(3) + ")";
            } else {
              ctx.fillStyle = "rgba(" + T.particleA + "," + a.toFixed(3) + ")";
            }
            ctx.fillText(cell.c, px, py);
          }
        }
      }
      nRaf = requestAnimationFrame(draw);
    };
    if (reduce) {
      // Force one full paint: draw() only renders on a flicker tick, and
      // t=0 with flickerLast=0 would skip it, leaving the field blank.
      flickerLast = -1000;
      draw(0);
      cancelAnimationFrame(nRaf);
    } else nRaf = requestAnimationFrame(draw);
  }

  // ---------- page-wide cursor glow ----------
  // A soft light that eases toward the pointer across the whole page. The
  // hero is excluded, its 01 field already carries the cursor glow, so the
  // binary characters stay hero-only while the glow follows everywhere else.
  const glow = $("[data-cursorglow]") as HTMLElement | null;
  if (glow && !reduce) {
    let gx = -9999,
      gy = -9999,
      tx = -9999,
      ty = -9999,
      started = false,
      inWindow = false;
    let heroBottom = 0;
    const measureHero = () => {
      const h = document.getElementById("top");
      heroBottom = h ? h.offsetHeight : window.innerHeight;
    };
    measureHero();
    window.addEventListener("resize", measureHero);
    window.addEventListener(
      "mousemove",
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
        if (!started) {
          gx = tx;
          gy = ty;
          started = true;
        }
        inWindow = true;
      },
      { passive: true },
    );
    window.addEventListener("mouseout", (e) => {
      if (!(e as MouseEvent).relatedTarget) inWindow = false;
    });
    const tick = () => {
      gx += (tx - gx) * 0.16;
      gy += (ty - gy) * 0.16;
      glow.style.transform =
        "translate3d(" + gx + "px," + gy + "px,0) translate(-50%,-50%)";
      // Hide over the hero (its 01 field already glows) and when the pointer
      // has left the window.
      const overHero = window.scrollY + ty < heroBottom;
      glow.style.opacity = inWindow && started && !overHero ? "1" : "0";
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // ---------- FAQ ----------
  const faq = $("[data-faq]") as HTMLElement | null;
  if (faq) {
    const items: [string, string][] = [
      [
        "What if I lose my password?",
        "With your 24-word recovery phrase you re-derive your key and you’re back in. Lose both and the data is gone — there is no reset link, because a reset link is a backdoor.",
      ],
      [
        "Can you read my notes?",
        "No. Encryption happens on your device with a key we never receive. The sync server stores and routes ciphertext only.",
      ],
      [
        "Is it actually open source?",
        "Client, server, and protocol spec are all open — AGPL-3.0 for code, CC-BY-4.0 for docs. No open core, no proprietary build.",
      ],
      [
        "What if Myne shuts down?",
        "Your notes are plain markdown after decryption, so they open in any editor. And the server is open source — keep syncing by self-hosting.",
      ],
      [
        "Is it ready to use?",
        "It works, and it is not ready for you. Myne is in alpha: the spec and the threat model are public and still in draft, the installers are on the download page with a signed checksum list so you can verify the bytes you run, and the thing to expect is breakage rather than polish.",
      ],
    ];
    // Accordion: only one panel stays open at a time. Each entry registers a
    // close() that the others call when one is expanded.
    const panels: { open: boolean; expand: (v: boolean) => void }[] = [];
    items.forEach(([q, a], i) => {
      const row = document.createElement("div");
      row.style.cssText =
        "border-bottom:1px solid rgb(var(--line-rgb) / 0.1);" +
        (i === 0 ? "border-top:1px solid rgb(var(--line-rgb) / 0.1);" : "");
      const head = document.createElement("button");
      head.style.cssText =
        "width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 16px;background:rgb(var(--line-rgb) / 0.02);border:0;cursor:pointer;text-align:left;font-family:inherit;margin:8px 0;border-radius:8px;";
      head.innerHTML =
        '<span style="font-size:15px;font-weight:500;color:var(--ink-1);">' +
        q +
        '</span><span class="mono" data-plus style="font-size:18px;color:' +
        accent +
        ';transition:transform .3s ease;">+</span>';
      const body = document.createElement("div");
      body.style.cssText =
        "overflow:hidden;max-height:0;transition:max-height .35s ease;";
      body.innerHTML =
        '<p style="padding:0 16px 18px;max-width:60ch;font-size:13.5px;line-height:1.65;color:var(--ink-3);">' +
        a +
        "</p>";
      const plus = head.querySelector("[data-plus]") as HTMLElement;
      const panel = {
        open: false,
        expand(v: boolean) {
          this.open = v;
          body.style.maxHeight = v ? body.scrollHeight + 30 + "px" : "0px";
          plus.style.transform = v ? "rotate(45deg)" : "rotate(0deg)";
        },
      };
      panels.push(panel);
      head.addEventListener("click", () => {
        const next = !panel.open;
        panels.forEach((p) => p !== panel && p.open && p.expand(false));
        panel.expand(next);
      });
      row.appendChild(head);
      row.appendChild(body);
      faq.appendChild(row);
    });
  }

  // ---------- hero "Sealed" wordmark: decrypt reveal ----------
  // Plays once on load (scrambled -> resolved, left to right) and replays on
  // hover. Deliberately one-shot, no idle loop, so it never nags the reader.
  // Mono glyphs (set in CSS) keep the line from reflowing as chars churn.
  const sealed = $("[data-sealed]") as HTMLElement | null;
  if (sealed && !reduce) {
    const target = (sealed.textContent || "Sealed").trim();
    const cs = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%@&$/?";
    let running = false;
    const play = () => {
      if (running) return;
      running = true;
      const L = target.length;
      const per = 78; // ms before each successive char locks in
      const lead = 200; // initial all-scrambled beat
      let start = -1;
      const tick = (now: number) => {
        if (start < 0) start = now;
        const t = now - start;
        let out = "";
        let done = true;
        for (let i = 0; i < L; i++) {
          if (t >= lead + i * per) {
            out += target[i];
          } else {
            done = false;
            out += cs[(Math.random() * cs.length) | 0];
          }
        }
        sealed.textContent = out;
        if (done) {
          sealed.textContent = target;
          running = false;
          return;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    play();
    sealed.addEventListener("mouseenter", play);
  }

</script>
