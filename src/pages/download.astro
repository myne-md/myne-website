---
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { PLATFORM_ICON } from "../data/platformIcons";
import { absoluteOg } from "../lib/og";
import {
  RELEASE_TAG,
  RELEASE_VERSION,
  RELEASE_CHANNEL,
  RELEASE_BASE,
  RELEASE_DATE,
  MINISIGN_PUBKEY,
  assetUrl,
  assetByName,
  humanSize,
} from "../data/release";

const title = "Download — Myne";
const description =
  "Run Myne on your own machine — one desktop app, installed once, running entirely on your device. Early access: the installers are unsigned, and every release ships a signed checksum list you can verify. Pre-alpha.";
const canonical = new URL("/download/", Astro.site!).toString();
const ogImage = absoluteOg("download", Astro.site!);

/**
 * Every download is a plain link to downloads.myne.md. No OS sniffing, no
 * runtime fetch — see src/data/release.ts for why the hashes live in this repo
 * rather than being read off the origin they verify.
 *
 * `.msi` and `.rpm` used to be advertised here and neither has ever been
 * produced: Windows is blocked on myne#178 (the local-IPC layer is coupled to
 * Unix sockets) and Tauri's rpm bundler hangs, reproduced three times.
 */
const platforms = [
  {
    os: "macOS",
    sub: "Apple Silicon · .dmg",
    note: "macOS 11 Big Sur or later · Apple Silicon",
    d: PLATFORM_ICON.apple,
    downloads: [{ label: "Apple Silicon .dmg", name: `Myne_${RELEASE_VERSION}_aarch64.dmg` }],
  },
  {
    os: "Windows",
    sub: "not yet built",
    note: "No Windows build exists. The local-IPC layer is still coupled to Unix sockets — tracked as myne#178, deferred to v1.",
    d: PLATFORM_ICON.windows,
    downloads: [],
  },
  {
    os: "Linux",
    sub: "not built for this release",
    note: "This release is macOS and iOS only. Linux desktop packages (.deb, AppImage, Arch) are not built for it; use the previous release or wait for the next full release.",
    d: PLATFORM_ICON.linux,
    downloads: [],
  },
];

const extensions = [
  {
    os: "Firefox",
    sub: "MV3 · Add-ons",
    note: "One cross-browser codebase, reconciled to the Firefox event-page model.",
    d: PLATFORM_ICON.firefox,
  },
  {
    os: "Chrome",
    sub: "MV3 · Web Store",
    note: "Also covers Helium, Brave, Arc and other Chromium browsers from the same build.",
    d: PLATFORM_ICON.chrome,
  },
  {
    os: "Edge",
    sub: "MV3 · Edge Add-ons",
    note: "The identical extension, listed on the Microsoft Edge Add-ons store.",
    d: PLATFORM_ICON.edge,
  },
];

/**
 * iOS never ships an installable file: an `.ipa` needs a developer certificate
 * to install, so publishing one hands almost every reader a file they cannot
 * open. Android ships a universal `.apk` for sideloading this release.
 *
 * The annotation is load-bearing: with iOS's `download` null, inference would
 * otherwise narrow the whole array to `null` once one entry is null and every
 * `it.download.name` in the markup becomes an error on `never`. Typing the
 * array keeps the branch that renders a download compiling.
 */
type MobileRow = {
  os: string;
  status: string;
  note: string;
  d: string;
  download: { label: string; name: string } | null;
};

const mobile: MobileRow[] = [
  {
    os: "iOS",
    status: "not yet",
    note: "The same vault and the same encryption, in your pocket. Reuses the exact Rust core and protocol crate the desktop app runs. No installable build is published — an iOS build needs a developer certificate on your side to sideload, so there is nothing here you could use yet.",
    d: PLATFORM_ICON.apple,
    download: null,
  },
  {
    os: "Android",
    status: "not built for this release",
    note: "The Android build is skipped for this interim release. It is not on the Play Store; when it ships you install it yourself, which Android will ask you to allow.",
    d: PLATFORM_ICON.android,
    download: null,
  },
];

/**
 * These three said "Code-signed", "Reproducible" and "Verified updates" for
 * months, and all three were false: no signing certificate exists, desktop
 * builds are not reproducible and the source is private, and there is no
 * updater at all. The user guide had been saying the opposite the whole time.
 * threat-model.md TB7/A9 were corrected in the same change (decisions 0496).
 * Copy may not exceed the threat model — do not walk these back.
 */
const verify = [
  {
    n: "01",
    t: "Signed checksums",
    p: "Every release ships a SHA256SUMS file signed with an offline minisign key. The key is on neither of our servers, so whoever holds the download host cannot forge a hash to match a swapped file. The installers themselves are not signed — see below.",
  },
  {
    n: "02",
    t: "Two places, one answer",
    p: "The same hashes appear on this page and on the download host. Different machine, different repository, different deploy pipeline — so one of them being tampered with shows up as a disagreement rather than as nothing at all.",
  },
  {
    n: "03",
    t: "No auto-updater",
    p: "Myne never checks whether a newer version exists and never downloads one. Updating is you downloading the next release and installing over the old one — which also means there is no update channel for anyone else to hijack.",
  },
];

const reqs = [
  ["Disk", "Vault lives in your app-data directory; size scales with your notes."],
  ["Memory", "Argon2id unlock uses 256 MiB transiently — ~1 s on a 2024 laptop."],
  ["Network", "None required. Myne runs fully offline and local-first; optional zero-knowledge sync (self-hostable, open source) is there when you want more than one device."],
  ["Account", "No email, no sign-up. A vault is created locally with a password you choose."],
];
---

<LandingLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <div
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e6e6e4;background:#0a0a0a;min-height:100vh;"
  >
    <GlassNav active="download" />

    <!-- HERO -->
    <section id="top" style="padding:128px 28px 52px;">
      <div style="max-width:980px;margin:0 auto;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
          <span class="mono up" style="font-size:11px;color:#8aa4d0;">Download</span>
          <span
            class="mono up"
            style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
            >{RELEASE_TAG} · {RELEASE_CHANNEL}</span
          >
        </div>
        <h1
          style="font-size:clamp(34px,5vw,62px);line-height:1.0;font-weight:700;letter-spacing:-0.035em;max-width:16ch;"
        >
          Run it on your own machine.
        </h1>
        <p
          style="margin-top:22px;max-width:62ch;font-size:16px;line-height:1.65;color:#8a8a86;"
        >
          One desktop app, installed once, running entirely on your device. Every
          release ships a signed checksum list, so you can check that the file
          you got is the file we published.
        </p>

        <div
          style="margin-top:30px;display:flex;gap:16px;align-items:flex-start;border-left:2px solid #c2a35e;background:rgba(194,163,94,0.07);border-radius:0 10px 10px 0;padding:18px 22px;"
        >
          <p style="font-size:14px;line-height:1.6;color:#e6e6e4;max-width:70ch;">
            <strong style="font-weight:600;">Early access, and we mean it.</strong>
            {RELEASE_TAG} is a pre-alpha build. The desktop installers are not
            code-signed, so macOS and Windows will warn you. There is no
            auto-updater, no Windows build, and no iOS build you can install.
            Expect rough edges, and keep backups of anything you would be upset
            to lose.
          </p>
        </div>
      </div>
    </section>

    <!-- PLATFORMS -->
    <section style="padding:18px 28px 18px;">
      <div style="max-width:980px;margin:0 auto;">
        <div class="mono up" style="font-size:10px;color:#54544f;margin-bottom:14px;">
          Desktop
        </div>
        <div class="dl-cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
          {
            platforms.map((it) => (
              <div
                style="display:flex;flex-direction:column;border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:24px 22px;background:#0c0c0c;"
              >
                <svg width="27" height="27" viewBox="0 0 24 24" fill="#e6e6e4">
                  <path d={it.d} />
                </svg>
                <div style="margin-top:18px;font-size:18px;font-weight:600;color:#e6e6e4;">
                  {it.os}
                </div>
                <div class="mono up" style="margin-top:6px;font-size:9px;color:#8aa4d0;">
                  {it.sub}
                </div>
                <p style="margin-top:14px;flex:1;font-size:11.5px;line-height:1.6;color:#8a8a86;">
                  {it.note}
                </p>
                <div
                  style="margin-top:18px;display:flex;flex-direction:column;gap:7px;border-top:1px solid rgba(255,255,255,0.08);padding-top:14px;"
                >
                  {it.downloads.length === 0 && (
                    <span class="mono up" style="font-size:9px;color:#54544f;">
                      Not available
                    </span>
                  )}
                  {it.downloads.map((dl) => (
                    <a
                      class="mono up"
                      href={assetUrl(dl.name)}
                      style="display:flex;align-items:baseline;justify-content:space-between;gap:8px;font-size:9px;color:#8aa4d0;text-decoration:none;"
                    >
                      <span>{dl.label}</span>
                      <span style="color:#54544f;">
                        {humanSize(assetByName(dl.name).bytes)} ↓
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <p class="mono" style="margin-top:14px;font-size:10px;line-height:1.7;color:#54544f;">
          {RELEASE_TAG} · unsigned · no auto-updater. Your OS will warn on first
          launch — that is expected, and <a
            href="#verify"
            style="color:#8aa4d0;text-decoration:none;">Verify it</a
          > below covers both the warning and the checksum.
        </p>
      </div>
    </section>

    <!-- BROWSER EXTENSION -->
    <section style="padding:14px 28px 18px;">
      <div style="max-width:980px;margin:0 auto;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
          <span class="mono up" style="font-size:10px;color:#54544f;">Browser extension</span>
          <span
            class="mono up"
            style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
            >available at release</span
          >
        </div>
        <p style="margin:0 0 16px;max-width:64ch;font-size:12.5px;line-height:1.6;color:#8a8a86;">
          <strong style="color:#c4c4c0;font-weight:600;">Myne Clipper</strong> saves
          the page you're reading straight into your vault. Keyless by design — the
          extension hands the clip to your unlocked desktop app, which does all the
          encryption. It never receives your keys.
        </p>
        <div class="dl-cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
          {
            extensions.map((it) => (
              <div
                style="display:flex;flex-direction:column;border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:24px 22px;background:#0c0c0c;"
              >
                <svg width="27" height="27" viewBox="0 0 24 24" fill="#e6e6e4">
                  <path d={it.d} />
                </svg>
                <div style="margin-top:18px;font-size:18px;font-weight:600;color:#e6e6e4;">
                  {it.os}
                </div>
                <div class="mono up" style="margin-top:6px;font-size:9px;color:#8aa4d0;">
                  {it.sub}
                </div>
                <p style="margin-top:14px;flex:1;font-size:11.5px;line-height:1.6;color:#8a8a86;">
                  {it.note}
                </p>
                <div
                  class="mono up"
                  style="margin-top:18px;display:flex;align-items:center;justify-content:space-between;font-size:9px;color:#54544f;border-top:1px solid rgba(255,255,255,0.08);padding-top:14px;"
                >
                  <span>When released</span>
                  <span style="color:#8aa4d0;font-size:13px;">↓</span>
                </div>
              </div>
            ))
          }
        </div>
        <p class="mono" style="margin-top:12px;font-size:10px;line-height:1.6;color:#54544f;">
          Safari isn't supported in v1 — its extensions can't use the native
          clip channel the desktop app relies on.
        </p>
      </div>
    </section>

    <!-- MOBILE -->
    <section style="padding:14px 28px 30px;">
      <div style="max-width:980px;margin:0 auto;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span class="mono up" style="font-size:10px;color:#54544f;">Mobile</span>
          <span
            class="mono up"
            style="font-size:9px;color:#8aa4d0;border:1px solid rgba(138,164,208,0.4);border-radius:999px;padding:3px 9px;"
            >Phase 3 · in development</span
          >
        </div>
        <div class="dl-cols-2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px;">
          {
            mobile.map((it) => (
              <div
                style="display:flex;align-items:flex-start;gap:18px;border:1px dashed rgba(255,255,255,0.14);border-radius:14px;padding:22px;background:rgba(255,255,255,0.01);"
              >
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="#6a6a66"
                  style="flex:0 0 auto;margin-top:2px;"
                >
                  <path d={it.d} />
                </svg>
                <div style="min-width:0;">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <span style="font-size:17px;font-weight:600;color:#c4c4c0;">{it.os}</span>
                    <span class="mono up" style="font-size:9px;color:#54544f;">{it.status}</span>
                  </div>
                  <p style="margin-top:8px;font-size:12px;line-height:1.6;color:#8a8a86;">
                    {it.note}
                  </p>
                  {it.download && (
                    <a
                      class="mono up"
                      href={assetUrl(it.download.name)}
                      style="margin-top:12px;display:inline-flex;align-items:baseline;gap:8px;font-size:9px;color:#8aa4d0;text-decoration:none;"
                    >
                      <span>{it.download.label}</span>
                      <span style="color:#54544f;">
                        {humanSize(assetByName(it.download.name).bytes)} ↓
                      </span>
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- VERIFY -->
    <section id="verify" style="padding:40px 28px;">
      <div style="max-width:980px;margin:0 auto;">
        <div class="mono up" style="font-size:11px;color:#8aa4d0;margin-bottom:14px;">
          Trust chain
        </div>
        <h2
          style="font-size:clamp(22px,2.8vw,34px);font-weight:700;letter-spacing:-0.025em;line-height:1.05;max-width:20ch;"
        >
          Don't trust the download. Verify it.
        </h2>
        <p
          style="margin-top:16px;max-width:62ch;font-size:15px;line-height:1.65;color:#8a8a86;"
        >
          Checking a download costs you two commands, and it is the only thing
          standing between you and a swapped installer. Here is exactly what we
          give you to check against, and exactly what we do not — described no
          more strongly than the threat model allows.
        </p>
        <div
          class="dl-cols-3"
          style="margin-top:28px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px;"
        >
          {
            verify.map((c) => (
              <div style="border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px;background:#0c0c0c;">
                <div class="mono" style="font-size:12px;color:#54544f;">
                  {c.n}
                </div>
                <div style="margin-top:10px;font-size:16px;font-weight:600;">{c.t}</div>
                <p style="margin-top:8px;font-size:12.5px;line-height:1.6;color:#8a8a86;">
                  {c.p}
                </p>
              </div>
            ))
          }
        </div>
        <pre
          class="mono"
          style="margin-top:18px;border:1px solid rgba(255,255,255,0.1);border-radius:10px;background:#0c0c0c;padding:16px 18px;font-size:12px;line-height:1.75;color:#8a8a86;overflow-x:auto;white-space:pre;"
        >{`# 1. the signature over the hash list — do this FIRST. Checking hashes
#    against a list you haven't authenticated verifies a file against itself.
curl -fsSLO ${RELEASE_BASE}/SHA256SUMS
curl -fsSLO ${RELEASE_BASE}/SHA256SUMS.minisig
minisign -Vm SHA256SUMS -P ${MINISIGN_PUBKEY}

# 2. then the download itself
sha256sum -c SHA256SUMS --ignore-missing     # macOS: shasum -a 256 -c`}</pre>
        <div
          style="margin-top:18px;border:1px solid rgba(194,163,94,0.35);border-radius:12px;background:rgba(194,163,94,0.05);padding:20px 22px;"
        >
          <div class="mono up" style="font-size:10px;color:#c2a35e;">
            What we do not give you
          </div>
          <p style="margin-top:10px;max-width:66ch;font-size:12.5px;line-height:1.7;color:#8a8a86;">
            <strong style="color:#c4c4c0;font-weight:600;">The desktop installers are not code-signed.</strong>
            We hold no Apple Developer ID and no Windows certificate, so macOS
            will say the app is from an unidentified developer. On macOS:
            right-click the app in Applications and choose <em>Open</em>, then
            confirm — that is the supported way past it, and Touch&nbsp;ID for
            unlock does not work on an unsigned build (myne#214). The Android
            APK is the exception: Android will not install an unsigned package,
            so it carries our own release-key signature and the OS checks it at
            install and on every update. It still warns, because that key is not
            Google's — that warning is about where the file came from, not about
            a missing signature.
          </p>
          <p style="margin-top:10px;max-width:66ch;font-size:12.5px;line-height:1.7;color:#8a8a86;">
            <strong style="color:#c4c4c0;font-weight:600;">Desktop builds are not reproducible, and the source is not public yet.</strong>
            The web client at app.example.com is reproducible and its every released
            hash goes to an append-only public record; the desktop app is built
            on one machine and cannot yet be independently rebuilt and compared.
            Until it can, a signed hash list is what you get, and it proves the
            file was not swapped — not that it was built from source you can read.
          </p>
        </div>
      </div>
    </section>

    <!-- REQUIREMENTS + LATEST -->
    <section style="padding:30px 28px 70px;">
      <div
        class="dl-split"
        style="max-width:980px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;"
      >
        <div>
          <div class="mono up" style="font-size:11px;color:#8aa4d0;margin-bottom:16px;">
            Requirements
          </div>
          <div style="display:flex;flex-direction:column;">
            {
              reqs.map(([k, v], i) => (
                <div
                  style={`display:grid;grid-template-columns:92px 1fr;gap:16px;padding:15px 0;${i < reqs.length - 1 ? "border-bottom:1px solid rgba(255,255,255,0.08);" : ""}`}
                >
                  <span class="mono up" style="font-size:10px;color:#8a8a86;padding-top:2px;">
                    {k}
                  </span>
                  <span style="font-size:13.5px;line-height:1.6;color:#c4c4c0;">{v}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div>
          <div class="mono up" style="font-size:11px;color:#8aa4d0;margin-bottom:16px;">
            Latest
          </div>
          <div
            style="border:1px solid rgba(255,255,255,0.1);border-radius:12px;background:#0c0c0c;padding:22px;"
          >
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <span class="mono" style="font-size:15px;font-weight:600;color:#e6e6e4;"
                >{RELEASE_TAG}</span
              >
              <span
                class="mono up"
                style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
                >pre-alpha</span
              >
            </div>
            <div class="mono" style="margin-top:6px;font-size:11px;color:#54544f;">
              released {RELEASE_DATE} · early access
            </div>
            <div style="margin-top:18px;display:flex;flex-direction:column;gap:9px;">
              <div style="display:flex;gap:10px;align-items:baseline;">
                <span style="color:#7fb89a;flex:0 0 auto;">+</span>
                <span style="font-size:13px;line-height:1.5;color:#c4c4c0;"
                  >Desktop — editor, vault, search, backlinks, graph, attachments, optional sync</span
                >
              </div>
              <div style="display:flex;gap:10px;align-items:baseline;">
                <span style="color:#7fb89a;flex:0 0 auto;">+</span>
                <span style="font-size:13px;line-height:1.5;color:#c4c4c0;"
                  >Android, sideloaded · v0.1 protocol spec, threat model &amp; test vectors</span
                >
              </div>
              <div style="display:flex;gap:10px;align-items:baseline;">
                <span style="color:#c2a35e;flex:0 0 auto;">~</span>
                <span style="font-size:13px;line-height:1.5;color:#c4c4c0;"
                  >Pre-alpha: unsigned installers, no Windows build, no iOS build you can install,
                  and no auto-updater. Keep backups.</span
                >
              </div>
            </div>
            <a
              href="/releases/"
              class="mono up"
              style="margin-top:22px;display:flex;align-items:center;justify-content:center;gap:8px;background:#e6e6e4;color:#0a0a0a;text-decoration:none;border-radius:8px;padding:12px;font-size:10px;font-weight:700;"
              >Release notes &amp; checksums</a
            >
          </div>
        </div>
      </div>
    </section>

    <footer style="border-top:1px solid rgba(255,255,255,0.1);padding:36px 28px;">
      <div
        class="mono up"
        style="max-width:980px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:10px;color:#54544f;"
      >
        <span>© 2026 Myne · AGPL-3.0 · CC-BY-4.0 docs</span><StatusBadge /><span
          >checksums signed · open</span
        >
      </div>
    </footer>
  </div>

  <!-- Mobile layout overrides. Inline grids win over classes, so the column
       collapses use !important. Three-up card rows step 3→2→1; the split
       requirements/latest row stacks; mobile two-up stacks on phones. -->
  <style is:global>
    @media (max-width: 820px) {
      .dl-cols-3 {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }
    @media (max-width: 760px) {
      .dl-split {
        grid-template-columns: 1fr !important;
        gap: 36px !important;
      }
    }
    @media (max-width: 560px) {
      .dl-cols-3,
      .dl-cols-2 {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</LandingLayout>
