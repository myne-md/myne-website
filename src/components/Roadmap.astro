---
const phases = [
  {
    label: "PHASE 1 — NOW",
    title: "Desktop client",
    body: "Tauri 2 app with single-vault editor, wikilinks, backlinks, and a minimal graph view. Local-only until Phase 2 lands.",
    active: true,
  },
  {
    label: "PHASE 2",
    title: "Sync server + hosted sync",
    body: "Same protocol, same trust boundary for self-hosted and hosted. Hosted sync is the only paid tier; the local app stays free.",
    active: false,
  },
  {
    label: "PHASE 3",
    title: "Mobile",
    body: "iOS and Android clients sharing the protocol library. Same crypto, same account number, same vault format.",
    active: false,
  },
  {
    label: "PHASE 4",
    title: "Real-time collaboration",
    body: "Multi-cursor co-editing via CRDT (Yjs). Lands only after the rest of the product is solid — earliest, not soonest.",
    active: false,
  },
];
---

<section id="roadmap">
  <div class="container">
    <div class="section-eyebrow">Roadmap</div>
    <h2 class="section-title">Phased, in public.</h2>

    <div class="grid">
      {phases.map((p) => (
        <article class={`card ${p.active ? "active" : ""}`}>
          <div class="num">{p.label}</div>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 0;
    border-bottom: 1px solid var(--line-1);
  }
  .section-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 16px;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 56px;
    color: var(--fg-display);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .card {
    padding: 28px;
    background: var(--paper-2);
    border: 1px solid var(--line-1);
    border-radius: 8px;
  }
  .card.active {
    background: var(--bg-1);
    border-color: var(--accent);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-3);
    margin-bottom: 16px;
    font-feature-settings: "ss02", "zero";
  }
  .card.active .num { color: var(--accent); }
  .card h3 {
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--fg-1);
  }
  .card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
    margin: 0;
  }

  @media (max-width: 920px) {
    .grid { grid-template-columns: 1fr; }
    .section-title { font-size: 32px; }
  }
</style>
