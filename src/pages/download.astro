---
/*
 * /download — the releases, in the shape this page has always had: a card per
 * platform, then the browser extension, then the phone, then how to verify.
 *
 * ── What this page is for ──────────────────────────────────────────────────
 *
 * It is the SECOND WITNESS for release integrity (`docs/threat-model.md` §3):
 * the installers are served from downloads.myne.md, the hashes are published
 * here, and the two ship through different chains so one compromised host
 * cannot make its lie agree with the other. Every link below is a plain
 * <a href> with nothing fetched behind it, and the hashes are a committed
 * snapshot (`src/data/releases.json`, generated by scripts/sync-releases.mjs
 * after verifying the origin's signed index) rather than a runtime read of the
 * origin they exist to check.
 *
 * ── Why the cards are data-driven and not hand-written ────────────────────
 *
 * The page this replaces hard-coded three platform cards and filled the empty
 * ones with "not built for this release", so every release without a Windows
 * build looked broken, and the version lived in twenty places. Each card below
 * is filled from THAT release's own asset list, and a card with nothing in it
 * says so in one sentence rather than listing an apology.
 *
 * ── What the page refuses to do ───────────────────────────────────────────
 *
 * Three claims the old copy carried are now false and are not restored: "the
 * installers are not code-signed" (macOS has been signed and notarized since
 * 2026-10-07, the Android APK is OS-verified), "there is no auto-updater" (a
 * signature-gated update channel ships in TB7), and "nothing is reproducible"
 * is stated rather than glossed. The remaining gap is real and says so: no
 * desktop build is reproducible yet, so nobody outside the project can rebuild
 * a release and compare it byte for byte.
 *
 * ── The archive, and why it is two shapes at once ─────────────────────────
 *
 * Every release ships in the HTML and the page hides the tail on load (the
 * script at the bottom, `src/lib/archive.mjs` for the arithmetic). The newest
 * seven read as the short list they are useful as, and "Load more" appends a
 * page at a time. Hiding is the enhancement rather than the markup because the
 * archive is the one list here whose job is being complete: a reader without
 * JavaScript gets all of it.
 *
 * A row that went out on the beta channel alone carries a `beta` chip, which is
 * a LABEL and nothing more. `src/data/releases.json` learns it from GitHub at
 * sync time (`scripts/sync-releases.mjs`), because the origin's signed index
 * carries no channel and `latest-beta.json` names only the current build. The
 * hashes still come from that signed index alone, so a mislabelled row cannot
 * change a byte a reader verifies — it can only tell them the wrong kind of
 * build, which `scripts/validate-release.mjs` also refuses.
 */
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteOg } from "../lib/og";
import { PLATFORM_ICON } from "../data/platformIcons";
import {
  BETA,
  CHANNELS_MATCH,
  DOWNLOADS_ORIGIN,
  MINISIGN_PUBKEY,
  RELEASES,
  STABLE,
  checksumsUrl,
  humanDate,
  humanSize,
  isBeta,
  releaseDirUrl,
  signatureUrl,
} from "../data/release";
import { downloadGroups, releaseSummary, type DownloadItem } from "../lib/downloads";

const title = "Download — Myne";
const description =
  "Installers for Myne, platform by platform, with a signed checksum list you can verify, the beta channel the updater follows, and the full release archive. Alpha.";
const canonical = new URL("/download/", Astro.site!).toString();
const ogImage = absoluteOg("download", Astro.site!);

const groups = downloadGroups(STABLE);
const items = (key: string): DownloadItem[] =>
  groups.find((g) => g.key === key)?.items ?? [];

const macos = items("macos");
const linux = items("linux");
const android = items("android");
const ios = items("ios");
const windows = items("windows");
const clipper = items("clipper");
const cli = items("cli");

/** One card's download list. The hash is a tooltip rather than a column: the
 *  full value belongs in SHA256SUMS, and a page of 64-character strings is
 *  unreadable at this density. */
const nothing = "Nothing published for this platform in this release.";

/* A card can be empty because the CURRENT release does not build that
   platform, not because the platform was never supported. v0.10.0 is a macOS
   build only, so a Linux reader landing here would otherwise meet five cards
   that all say "nothing" and conclude the project dropped Linux. Point at the
   newest release that does carry it, and let the archive do the rest. */
const newestWith = (key: string) =>
  RELEASES.find(
    (r) => (downloadGroups(r).find((g) => g.key === key)?.items.length ?? 0) > 0,
  );
---

<LandingLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <div class="dl-root">
    <GlassNav active="download" />

    <!-- ===================== HERO ===================== -->
    <section class="dl-hero" id="top">
      <div class="dl-inner">
        <div class="dl-eyebrow-row">
          <span class="mono up dl-eyebrow">Download</span>
          <span class="mono up dl-chip">alpha</span>
        </div>
        <h1 class="dl-h1">Run it on your own machine.</h1>
        <p class="dl-lede">
          One desktop app, installed once, running entirely on your device. Every
          release ships a signed checksum list, so you can check that the file you
          got is the file we published.
        </p>

        <div class="dl-warn">
          <p>
            <strong>Alpha, and we mean it.</strong> macOS builds are signed and
            notarized and the Android APK is verified by the OS; the Linux packages
            carry no signature, so your system will warn you. Expect rough edges,
            keep backups of anything you would be upset to lose, and read the
            verify block before you run an installer.
          </p>
        </div>

        {/* Which build each channel points at. Two channels, because the app's
            own updater reads exactly these two manifests; when they name one
            build, so does this line. */}
        <div class="dl-channels mono">
          <span>
            <i class="up">Release</i> {STABLE.tag} · {humanDate(STABLE.date)}
          </span>
          <span class="dl-channels__sep" aria-hidden="true">/</span>
          <span>
            <i class="up">Beta</i> {BETA.tag}
            {CHANNELS_MATCH ? (
              " · same build"
            ) : (
              <>
                {" · "}
                <a class="dl-channels__jump" href="#beta">{humanDate(BETA.date)} ↓</a>
              </>
            )}
          </span>
          <a class="dl-channels__link" href="#archive">archive ↓</a>
        </div>
      </div>
    </section>

    {/* ===================== BETA =====================
        Shown ONLY while the two channels name different builds, which is the
        state during a beta cycle: a beta is cut on the beta channel alone and
        carries the beta artefact set (macOS Apple Silicon and iOS), so the
        cards below belong to the release channel and this block is the beta's
        own door. When the channels agree — the normal state between releases —
        the line above says "same build" and this block would be a second copy
        of the cards, which is why it is absent rather than collapsed. */}
    {!CHANNELS_MATCH && (
      <section class="dl-section dl-section--beta" id="beta">
        <div class="dl-inner">
          <div class="dl-label-row">
            <span class="mono up dl-label">Beta channel</span>
            <span class="dl-label-note">{humanDate(BETA.date)} · {BETA.tag}</span>
          </div>
          <p class="dl-body">
            The build the app's own updater collects when it is set to the beta
            channel, published ahead of the release channel. Betas ship the
            Apple Silicon macOS and iOS builds, so a platform without a row here
            has no beta build for this cycle. Hashes verify against the same
            signed <code class="mono">SHA256SUMS</code> as every other release.
          </p>
          <ul class="dl-items dl-items--flat">
            {downloadGroups(BETA)
              .flatMap((g) => g.items)
              .map((item) => (
                <li class="dl-item">
                  <a class="dl-item__link" href={item.url}>
                    <span class="dl-item__name">{item.name}</span>
                    <span class="dl-item__size mono">{item.size} ↓</span>
                  </a>
                  <code class="dl-item__hash" title={item.sha256}>
                    {item.sha256.slice(0, 16)}…
                  </code>
                </li>
              ))}
            <li class="dl-item dl-item--more">
              <a class="mono up" href={checksumsUrl(BETA.tag)}>
                {BETA.tag} SHA256SUMS and its signature ↓
              </a>
              <span class="dl-item__size mono">
                {humanSize(BETA.assets.reduce((n, a) => n + a.bytes, 0))} total
              </span>
            </li>
          </ul>
        </div>
      </section>
    )}

    <!-- ===================== DESKTOP ===================== -->
    <section class="dl-section">
      <div class="dl-inner">
        <div class="dl-label-row">
          <span class="mono up dl-label">Desktop</span>
          <span class="dl-label-note">{humanDate(STABLE.date)} · {STABLE.tag}</span>
        </div>

        <div class="dl-cards dl-cards--3">
          <div class="dl-card">
            <svg class="dl-card__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={PLATFORM_ICON.apple} />
            </svg>
            <div class="dl-card__os">macOS</div>
            <div class="mono up dl-card__sub">Apple Silicon</div>
            <p class="dl-card__note">
              macOS 11 Big Sur or later. Signed with a Developer ID and notarized,
              so Gatekeeper opens it without the unidentified-developer dance.
            </p>
            <div class="dl-card__list">
              {macos.length === 0 && <span class="mono up dl-none">{nothing}</span>}
              {macos.map((item) => (
                <a class="dl-link mono" href={item.url}>
                  <span>{item.label}</span>
                  <span class="dl-link__size">{item.size} ↓</span>
                </a>
              ))}
            </div>
          </div>

          <div class={windows.length === 0 ? "dl-card dl-card--empty" : "dl-card"}>
            <svg class="dl-card__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={PLATFORM_ICON.windows} />
            </svg>
            <div class="dl-card__os">Windows</div>
            <div class="mono up dl-card__sub">x86_64</div>
            <p class="dl-card__note">
              Windows 10 or later, x86_64. The installer is <strong>unsigned</strong>,
              because no Authenticode certificate exists yet, so SmartScreen asks
              before it runs. Nothing on this release has been executed on Windows.
            </p>
            <div class="dl-card__list">
              {windows.length === 0 && <span class="mono up dl-none">{nothing}</span>}
              {windows.map((item) => (
                <a class="dl-link mono" href={item.url}>
                  <span>{item.label}</span>
                  <span class="dl-link__size">{item.size} ↓</span>
                </a>
              ))}
            </div>
          </div>

          <div class="dl-card">
            <svg class="dl-card__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={PLATFORM_ICON.linux} />
            </svg>
            <div class="dl-card__os">Linux</div>
            <div class="mono up dl-card__sub">AppImage · deb · rpm · Flatpak · snap · Arch</div>
            <p class="dl-card__note">
              Any modern x86_64 or arm64 distribution. The AppImage needs no
              install, just the executable bit. The .rpm needs glibc 2.39, which
              means Fedora 40 or newer and openSUSE Tumbleweed, not Leap 15 or
              RHEL 9. Packages carry no signature, so your package manager will
              not vouch for them.
            </p>
            <div class="dl-card__list">
              {linux.length === 0 &&
                (newestWith("linux") ? (
                  <a class="dl-fallback mono up" href={releaseDirUrl(newestWith("linux")!.tag)}>not in {STABLE.tag} · newest Linux build is {newestWith("linux")!.tag} ↓</a>
                ) : (
                  <span class="mono up dl-none">{nothing}</span>
                ))}
              {linux.map((item) => (
                <a class="dl-link mono" href={item.url}>
                  <span>{item.label}</span>
                  <span class="dl-link__size">{item.size} ↓</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== CLIPPER + CLI ===================== -->
    <section class="dl-section">
      <div class="dl-inner">
        <div class="dl-label-row">
          <span class="mono up dl-label">Also published</span>
        </div>

        <div class="dl-cards dl-cards--2">
          <div class="dl-card">
            <svg class="dl-card__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={PLATFORM_ICON.chrome} />
            </svg>
            <div class="dl-card__os">Browser clipper</div>
            <div class="mono up dl-card__sub">Firefox · Chrome · Edge</div>
            <p class="dl-card__note">
              Saves the page you are reading into your vault. Keyless by design:
              it hands the clip to your unlocked desktop app, which does the
              encryption, and it never receives your keys. Safari is out, because
              its extensions cannot use the native clip channel.
            </p>
            <div class="dl-card__list">
              {clipper.length === 0 &&
                (newestWith("clipper") ? (
                  <a class="dl-fallback mono up" href={releaseDirUrl(newestWith("clipper")!.tag)}>not in {STABLE.tag} · newest clipper build is {newestWith("clipper")!.tag} ↓</a>
                ) : (
                  <span class="mono up dl-none">{nothing}</span>
                ))}
              {clipper.map((item) => (
                <a class="dl-link mono" href={item.url}>
                  <span>{item.label}</span>
                  <span class="dl-link__size">{item.size} ↓</span>
                </a>
              ))}
            </div>
          </div>

          <div class="dl-card">
            <svg class="dl-card__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={PLATFORM_ICON.linux} />
            </svg>
            <div class="dl-card__os">Command line</div>
            <div class="mono up dl-card__sub">myne-decrypt</div>
            <p class="dl-card__note">
              Opens a vault without the app installed: point it at the folder and
              give it the password or the recovery phrase. It holds no keys of its
              own and needs no network.
            </p>
            <div class="dl-card__list">
              {cli.length === 0 &&
                (newestWith("cli") ? (
                  <a class="dl-fallback mono up" href={releaseDirUrl(newestWith("cli")!.tag)}>not in {STABLE.tag} · newest myne-decrypt build is {newestWith("cli")!.tag} ↓</a>
                ) : (
                  <span class="mono up dl-none">{nothing}</span>
                ))}
              {cli.map((item) => (
                <a class="dl-link mono" href={item.url}>
                  <span>{item.label}</span>
                  <span class="dl-link__size">{item.size} ↓</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== MOBILE ===================== -->
    <section class="dl-section">
      <div class="dl-inner">
        <div class="dl-label-row">
          <span class="mono up dl-label">Mobile</span>
        </div>

        <div class="dl-cards dl-cards--2">
          <div class="dl-card">
            <svg class="dl-card__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={PLATFORM_ICON.android} />
            </svg>
            <div class="dl-card__os">Android</div>
            <div class="mono up dl-card__sub">sideload · per ABI</div>
            <p class="dl-card__note">
              Not on the Play Store. Install the APK for your phone's ABI and
              Android will ask you to allow the source. The store bundle is
              published with the release and is not a file you can install.
            </p>
            <div class="dl-card__list">
              {android.length === 0 &&
                (newestWith("android") ? (
                  <a class="dl-fallback mono up" href={releaseDirUrl(newestWith("android")!.tag)}>not in {STABLE.tag} · newest Android build is {newestWith("android")!.tag} ↓</a>
                ) : (
                  <span class="mono up dl-none">{nothing}</span>
                ))}
              {android.map((item) => (
                <a class="dl-link mono" href={item.url}>
                  <span>{item.label}</span>
                  <span class="dl-link__size">{item.size} ↓</span>
                </a>
              ))}
            </div>
          </div>

          <div class="dl-card">
            <svg class="dl-card__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={PLATFORM_ICON.apple} />
            </svg>
            <div class="dl-card__os">iOS</div>
            <div class="mono up dl-card__sub">development certificate only</div>
            <p class="dl-card__note">
              An .ipa installs only on a device with a development certificate, so
              for almost everyone this is not a file you can use. It is published
              because it is what the project builds and signs, not because it is
              installable.
            </p>
            <div class="dl-card__list">
              {ios.length === 0 &&
                (newestWith("ios") ? (
                  <a class="dl-fallback mono up" href={releaseDirUrl(newestWith("ios")!.tag)}>not in {STABLE.tag} · newest iOS build is {newestWith("ios")!.tag} ↓</a>
                ) : (
                  <span class="mono up dl-none">{nothing}</span>
                ))}
              {ios.map((item) => (
                <a class="dl-link mono" href={item.url}>
                  <span>{item.label}</span>
                  <span class="dl-link__size">{item.size} ↓</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== VERIFY ===================== -->
    <section class="dl-section dl-section--verify" id="verify">
      <div class="dl-inner">
        <span class="mono up dl-label">Verify</span>
        <h2 class="dl-h2">Every hash, in public.</h2>
        <p class="dl-body">
          This page exists to be a second opinion. The artefacts are served from{" "}
          <code class="mono">downloads.myne.md</code>; the SHA-256 of each one is
          published here, from a different machine and a different deploy
          pipeline. If those two ever disagree, something is wrong, and that
          disagreement is the point.
        </p>

        <div class="dl-verify-grid">
          <div class="dl-verify-item">
            <span class="mono up dl-verify-n">01</span>
            <b>Signed checksums</b>
            <p>
              Every release ships a SHA256SUMS file signed with an offline minisign
              key, and the key is on neither of our servers, so whoever holds the
              download host cannot forge a hash list to match a swapped installer.
            </p>
          </div>
          <div class="dl-verify-item">
            <span class="mono up dl-verify-n">02</span>
            <b>Two places, one answer</b>
            <p>
              The same hashes appear here and on the download host: different
              machine, different repository, different deploy pipeline, so one of
              them being tampered with shows up as a disagreement rather than as
              nothing at all.
            </p>
          </div>
          <div class="dl-verify-item">
            <span class="mono up dl-verify-n">03</span>
            <b>A signed update channel</b>
            <p>
              The app now updates itself, and an update installs only if its
              signature verifies against the same offline key and its version is
              strictly newer. A substituted file is refused rather than installed,
              and so is a downgrade.
            </p>
          </div>
        </div>

        <pre class="dl-code mono"><code>minisign -Vm SHA256SUMS -P {MINISIGN_PUBKEY}
sha256sum -c SHA256SUMS <span class="dl-code__dim"># macOS: shasum -a 256 -c SHA256SUMS</span></code></pre>

        <p class="dl-body">
          What that does not cover is stated plainly: the signature authenticates
          the hash list, not the installer, and no desktop build is reproducible
          yet, so you cannot rebuild one and compare it byte for byte. Your OS
          checks the macOS and Android artefacts; on Linux it checks nothing.
        </p>

        <ul class="dl-links">
          <li>
            <a class="mono up" href={checksumsUrl(STABLE.tag)}
              >{STABLE.tag} SHA256SUMS ↓</a
            >
          </li>
          <li>
            <a class="mono up" href={signatureUrl(STABLE.tag)}
              >{STABLE.tag} signature ↓</a
            >
          </li>
          <li>
            <a class="mono up" href={`${DOWNLOADS_ORIGIN}/releases/`}
              >the origin's own index ↓</a
            >
          </li>
        </ul>
      </div>
    </section>

    <!-- ===================== ARCHIVE ===================== -->
    <section class="dl-section" id="archive">
      <div class="dl-inner">
        <span class="mono up dl-label">Archive</span>
        <h2 class="dl-h2">Every release, including the ones to avoid.</h2>
        <p class="dl-body">
          Newest first, and the beta channel is the same manifest the updater
          follows. An old release is not a safer one: it carries the bugs and the
          protocol quirks of its date. They are here because a release you cannot
          go back to is a release you cannot audit, and because a hash is only
          useful next to the file it belongs to.
        </p>

        <div class="dl-archive" data-archive>
          {
            RELEASES.map((release) => (
              <details
                class={isBeta(release) ? "dl-release dl-release--beta" : "dl-release"}
                data-channel={release.channel ?? "unknown"}
              >
                <summary>
                  <span class="dl-release__tag mono">{release.tag}</span>
                  {/* Its own column rather than glued to the tag: the tag
                      column is a fixed 8ch so rows line up, and a chip inside
                      it would shorten the tag or push the column wide for
                      every row to fit the five that need it. An empty cell
                      keeps the grid aligned and says nothing, which is right:
                      a stable release is the default and needs no badge. */}
                  <span class="dl-release__channel mono up">
                    {isBeta(release) ? <span class="dl-beta">beta</span> : null}
                  </span>
                  <span class="dl-release__date mono">{release.date}</span>
                  <span class="dl-release__what">{releaseSummary(release)}</span>
                  <span class="dl-release__count mono">
                    {release.assets.length}{" "}
                    {release.assets.length === 1 ? "file" : "files"}
                  </span>
                </summary>
                <ul class="dl-items">
                  {downloadGroups(release)
                    .flatMap((g) => g.items)
                    .map((item) => (
                      <li class="dl-item">
                        <a class="dl-item__link" href={item.url}>
                          <span class="dl-item__name">{item.name}</span>
                          <span class="dl-item__size mono">{item.size} ↓</span>
                        </a>
                        <code class="dl-item__hash" title={item.sha256}>
                          {item.sha256.slice(0, 16)}…
                        </code>
                      </li>
                    ))}
                  <li class="dl-item dl-item--more">
                    <a class="mono up" href={releaseDirUrl(release.tag)}>
                      everything in {release.tag}, including checksums ↑
                    </a>
                    <span class="dl-item__size mono">
                      {humanSize(release.assets.reduce((n, a) => n + a.bytes, 0))} total
                    </span>
                  </li>
                </ul>
              </details>
            ))
          }
        </div>

        {/* Rendered hidden and un-hidden by the script below, so a reader with
            no JavaScript keeps every release instead of losing the tail. The
            count is the fact that answers "is it worth pressing". */}
        <div class="dl-archive__foot">
          <p class="mono up dl-archive__progress" data-archive-progress hidden></p>
          <button type="button" class="mono up dl-archive__more" data-archive-more hidden>
            Load more
          </button>
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>
</LandingLayout>

{/* Progressive enhancement, and the ORDER matters: the rows ship visible and
    this hides the tail, so a reader without JavaScript has the complete archive
    rather than the first seven. The 12 KB of markup this costs is the price of
    that, and it is the right trade for the one list on the site whose job is
    being complete. */}
<script>
  import { archiveProgress } from "../lib/archive.mjs";

  const root = document.querySelector<HTMLElement>("[data-archive]");
  const more = document.querySelector<HTMLButtonElement>("[data-archive-more]");
  const counter = document.querySelector<HTMLElement>("[data-archive-progress]");

  if (root && more && counter) {
    const rows = [...root.querySelectorAll<HTMLElement>(":scope > details")];
    const total = rows.length;
    // The row a reader has expanded is a choice about THIS page, not about how
    // much history to reveal, so revealing more rows never collapses one.
    let presses = 0;
    let shown = 0;

    const apply = () => {
      const progress = archiveProgress({ total, presses, label: "releases" });
      rows.forEach((row, index) => {
        row.hidden = index >= progress.shown;
      });
      shown = progress.shown;
      counter.textContent = progress.text;
      counter.hidden = false;
      more.hidden = !progress.hasMore;
      return progress;
    };

    more.addEventListener("click", () => {
      const before = shown;
      presses += 1;
      const progress = apply();
      // The button disappears on the last press, so focus moves to the first row
      // that press revealed rather than falling back to the top of the document.
      if (!progress.hasMore) {
        rows[before]?.querySelector<HTMLElement>("summary")?.focus();
      } else {
        more.focus();
      }
    });

    apply();
  }
</script>

