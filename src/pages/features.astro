---
/*
 * /features, the page the landing page's feature grid is the signpost for.
 *
 * ── Why this page exists ───────────────────────────────────────────────────
 *
 * The landing page answers "should I care?" and the user guide answers "how do
 * I do this?". Neither answered "what is actually in it?", which is the question
 * a reader arrives with. The seven sections here are the seven cells of the
 * landing grid, in the same order and under the same anchors.
 *
 * ── The shape of the page ─────────────────────────────────────────────────
 *
 * It is a landing page rather than a document. The hero is split: the claim and
 * the section chips on the left, one frame of the app on the right, and the
 * chips switch what that frame shows (it also advances on its own until a reader
 * takes over, an unmoving screenshot beside a row of controls reads as
 * decoration). Below it, each section is a two-column block that alternates
 * side, with the app showing the surface the section is about. The first version
 * of this page was seven text sections in one column, which is a manual's shape
 * and made the reader scroll past everything to learn anything.
 *
 * ── The house rule this page is written under ──────────────────────────────
 *
 * AGENTS.md: marketing copy may not exceed `docs/threat-model.md`, and the same
 * rule governs every user-guide article. So this page is a restatement of the
 * guide, and where the guide states a boundary this page states it in the same
 * words: presence is ephemeral, a name label is not proof of authorship, the
 * in-process model is not sandboxed, a remote provider receives the request,
 * losing both secrets loses the data, sync is not a backup.
 *
 * The LIMITS row carries the boundaries that change what a reader can safely
 * assume, and nothing else. An earlier pass listed every ordinary capability
 * gap in it (which client shows cursors yet, that a locked vault has nothing to
 * search, that the saved graph layout is only a convenience), which buried the
 * security and data-loss sentences among trivia and made the page read as a
 * list of apologies. The trivia is still in the guide; this page keeps the rows
 * that matter and two sections (Meeting notes, Sync server) carry their
 * consequential limits only.
 *
 * ── What is photographed and what is drawn ────────────────────────────────
 *
 * Five of the seven sections carry a capture of the running desktop app, taken
 * through the e2e capture harness: a note with an inline comment, the links
 * panel, the find bar, the render, the assistant's chat panel. Two carry no
 * picture at all, and that is deliberate rather than pending: Meeting notes and
 * Sync server replaced Markdown and Portability, and nothing on disk photographs
 * either subject in BOTH themes, while the deck draws a light and a dark file
 * side by side. A single-theme capture is exactly the defect the landing hero
 * shipped with, so the section states its claim and the deck draws a text slide
 * instead. `shot` on the Section type records this, and adding a pair later is
 * one FRAMES row plus two capture runs.
 *
 * Every capture here comes from a single-tab session. The app's split-view
 * frames were deliberately passed over: at the width a block gives a frame, two
 * editor panes read as a cramped application rather than as a capable one.
 *
 * ── Dark and light ────────────────────────────────────────────────────────
 *
 * Each capture ships in both palettes and the theme picks one (tokens.css), so a
 * light-theme reader gets the app in light. The two drawn panels follow the
 * theme the ordinary way, because they are built from tokens.
 */
import LandingLayout from "../layouts/LandingLayout.astro";
import AppShowcase from "../components/AppShowcase.astro";
import GlassNav from "../components/GlassNav.astro";
import Icon from "../components/Icon.astro";
import ShotFrame from "../components/ShotFrame.astro";
import FeaturesDrawn from "../components/FeaturesDrawn.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteOg } from "../lib/og";

const title = "Features — Myne";
const description =
  "What is actually in Myne: live collaboration on a shared vault, an agent that runs where you point it, meeting notes transcribed on the device, the graph of your own links, a sync server you can run yourself, and encryption under all of it. The limits that matter are stated in the sections that have them.";
const canonical = new URL("/features/", Astro.site!).toString();
const ogImage = absoluteOg("features", Astro.site!);

type IconName =
  | "users"
  | "bot"
  | "file-text"
  | "shield-check"
  | "search"
  | "graph"
  | "hard-drive"
  | "mic"
  | "server";

interface Point {
  /** The lead-in, read as a label rather than as a sentence. */
  t: string;
  d: string;
}

interface Section {
  id: string;
  index: string;
  kicker: string;
  title: string;
  lede: string;
  points: Point[];
  /** The guide's own boundary statements, kept in the guide's words. */
  limits: string;
  /** Where this is explained in full. */
  guide: { href: string; label: string };
  icon: IconName;
  /** A DRAWN panel, for the sections with no capture pair.
   *
   *  Two of the seven carry one of these instead of a photograph, and the
   *  reason is in `FeaturesDrawn.astro`'s header: drawing follows the theme, a
   *  single-theme capture does not, and the alternative that was actually
   *  shipped for a while (no visual at all) left half of the row empty. */
  drawn?: "meeting" | "server";
  /** The capture that illustrates this section, and what it shows.
   *
   *  Optional, and two sections have none: Meeting notes and Sync server
   *  replaced Markdown and Portability, and no capture of either new subject
   *  exists in the pair the deck needs. A light capture alone would recreate
   *  the exact defect the hero shipped with (a "light" file that was really a
   *  dark one), because the guide artifacts on disk are a light run only, and a
   *  dark one needs the Linux capture. So the section states its claim without
   *  a picture, the deck draws a text slide for it, and the blocks lay the copy
   *  out full width. Adding the pair later is `prep-marketing-shots.mjs` plus a
   *  FRAMES row per theme. */
  shot?: { alt: string };
}

/* The order is the landing grid's order, and the anchors are the grid's hrefs. */
const sections: Section[] = [
  {
    id: "collaboration",
    index: "01",
    kicker: "Collaboration",
    title: "Two people, one note, two cursors",
    lede: "A vault can be shared with the people you work with. Each member joins with their own identity and sets their own password, and your recovery phrase is never part of it.",
    points: [
      {
        t: "Cursors with names",
        d: "You see their cursor, their selection and their name while you both write. The label always sits beside the colour, so a colour is never the only thing telling you who is where.",
      },
      {
        t: "One owner, many members",
        d: "The vault's content key is wrapped to each member separately, so adding or removing someone does not touch anyone else's password.",
      },
      {
        t: "Comments where the text is",
        d: "An inline comment stays attached to the sentence it is about. It renders in the editor, not in print, and a byte-verbatim markdown export keeps it exactly as you typed it.",
      },
    ],
    limits:
      "A colour is a recognition aid rather than a security identity, and a name label resolves a device to the member it is claimed by: a well-founded hint about who is here, not evidence of who typed a change.",
    guide: {
      href: "/user-guide/sync-and-devices/live-collaboration/",
      label: "Live collaboration",
    },
    icon: "users",
    shot: {
      alt: "A note open in the Myne editor with an inline comment dimmed beside the sentence it sits in, and the note list down the left side.",
    },
  },
  {
    id: "agents",
    index: "02",
    kicker: "Agents",
    title: "A model that works where you point it",
    lede: "Myne's AI is a set of features you turn on, not a service that is already reading. Out of the box you have named nothing, so no AI request leaves your device.",
    points: [
      {
        t: "A question over the whole vault",
        d: "Ask once and the answer is written from your notes, by a model running where you chose to run it. The transcript keeps the question and the answer.",
      },
      {
        t: "Changes you approve",
        d: "The composer proposes edits. They arrive as changes to review; nothing is written until you accept them.",
      },
      {
        t: "Three places to run it",
        d: "A model file on your own computer, a runtime you already run on the same machine, or a remote provider you name.",
      },
    ],
    limits:
      "An answer can be wrong, and the surfaces are built so a wrong one is easy to check. The in-process model is not sandboxed. Naming a remote provider sends the text of each request to that provider. This is Beta, and it is off until you turn it on.",
    guide: { href: "/user-guide/ai/overview/", label: "AI (Beta)" },
    icon: "bot",
    shot: {
      alt: "The assistant working inside a vault: a question about sync, its answer, then a request to move two notes answered with a proposed change waiting for approval.",
    },
  },
  {
    id: "meeting-notes",
    index: "03",
    kicker: "Meeting notes",
    title: "Record the room, transcribe it here",
    lede: "A meeting can be recorded as one session and comes back as a note: the audio attached, and a transcript written on your device rather than somewhere else.",
    points: [
      {
        t: "One session, two sources",
        d: "Your microphone on every platform, plus a system-audio tap on macOS 14.2 and later, resampled to a common rate and mixed into one mono recording.",
      },
      {
        t: "The transcript is written here",
        d: "A small model on this device turns the recording into text. The note says it is a machine reading, and the audio stays beside it to check against.",
      },
      {
        t: "Behind Developer mode",
        d: "The recording path is still being verified on real hardware, so the command sits behind Developer mode until it is.",
      },
    ],
    limits:
      "Windows system audio is not captured yet, so a session there records the microphone alone, and a system-audio permission that was refused delivers silence rather than an error. Recording captures other people's speech: make sure you are allowed to before you start.",
    guide: {
      href: "/user-guide/attachments-and-import/meeting-notes/",
      label: "Meeting notes",
    },
    icon: "mic",
    drawn: "meeting",
  },
  {
    id: "encryption",
    index: "04",
    kicker: "Encryption",
    title: "Sealed on the device, with no way to turn it off",
    lede: "Encryption is not a setting here. There is one mode, it is on before the first note exists, and no part of the app exists to switch it off.",
    points: [
      {
        t: "Argon2id, bound to the file",
        d: "Your password is stretched at m=256 MiB, t=3, p=2 into a key that never leaves your device.",
      },
      {
        t: "XChaCha20-Poly1305",
        d: "Every note is sealed with a key commitment before it touches disk: content, titles, folders and tags alike.",
      },
      {
        t: "No off switch",
        d: "Auto-lock is always on and quick unlock reverses it rather than disabling it. There is no reset link, because a reset link is a backdoor.",
      },
    ],
    limits:
      "This does not defend a machine that is already compromised or a vault someone is using while it is unlocked, and it has not had an independent audit. Losing both your password and your recovery phrase means the data is gone. Quick unlock is opt-in, and its PIN form stores a third encrypted copy of the key on this device, where a copied disk can be attacked offline at PIN strength.",
    guide: {
      href: "/user-guide/settings-and-privacy/privacy-model/",
      label: "The privacy model",
    },
    icon: "shield-check",
    shot: {
      alt: "The Myne unlock screen: a sealed vault on the device, asking for the password that derives its key, in front of the app's own window.",
    },
  },
  {
    id: "graph",
    index: "05",
    kicker: "Graph",
    title: "Your notes, and the shape they make",
    lede: "A note is a node, not a page. Myne shows what points at it, what it points at, and the shape all of it makes in the graph.",
    points: [
      {
        t: "Backlinks, in place",
        d: "Every note that points at this one, listed with the sentence it does it in, plus the mentions you never turned into links.",
      },
      {
        t: "The whole vault as a map",
        d: "Every note a dot, every resolved wikilink a line: filter to what is isolated, to one tag, or to the neighbourhood of the note you have open.",
      },
      {
        t: "Readable without a mouse",
        d: "The same view is available as a list: one row per note, most connected first, with what it links to and what links back.",
      },
    ],
    limits:
      "Folders and attachments are not nodes, and a note outside the vault is not part of either surface.",
    guide: {
      href: "/user-guide/find-and-connect/overview/",
      label: "Find and connect",
    },
    icon: "graph",
    shot: {
      alt: "The graph view open as its own tab in the Myne desktop app, drawing the notes of a vault as labelled nodes joined by their links.",
    },
  },
  {
    id: "search",
    index: "06",
    kicker: "Search",
    title: "Search that never leaves the machine",
    lede: "The index that answers you is built and read on your own device. Nothing about a search is sent anywhere, because there is nowhere for it to go.",
    points: [
      {
        t: "Find, and replace",
        d: "The find bar works on the note in front of you, with case and whole-word options and a replace that can be stepped through.",
      },
      {
        t: "Across the whole vault",
        d: "The command palette searches every note in the open vault as you type, and by tag or property as well as by word.",
      },
      {
        t: "Saved views",
        d: "A query kept as a place you can come back to, instead of something you retype.",
      },
    ],
    limits:
      "Attachments are searched only where Myne can extract their text on this device, and only for the attachment types it can read.",
    guide: { href: "/user-guide/find-and-connect/search/", label: "Search" },
    icon: "search",
    shot: {
      alt: "The find bar open over a note in the Myne editor, with the match counted and the find and replace fields side by side.",
    },
  },
  {
    id: "sync-server",
    index: "07",
    kicker: "Sync server",
    title: "The server is a program you run",
    lede: "Sync moves ciphertext the server holds no key for. That server is open source and built from the same tree, so you can run it on a machine you control.",
    points: [
      {
        t: "The same server, from the same source",
        d: "Build the pinned tag with the documented toolchain, or compile the server crate directly; the source is the distribution.",
      },
      {
        t: "Running it changes the operator, not the trust",
        d: "It holds encrypted blobs and no keys either way. What changes is who operates it, and what becomes yours: the TLS edge, retention, and your own backups.",
      },
      {
        t: "What the operator can see",
        d: "That an account synced, when, and roughly how much. Never a note: to the server a note is ciphertext.",
      },
    ],
    limits:
      "Sync is not a backup, on your own server or anyone else's: it propagates a deletion to your other devices. A self-hosted server needs a public domain and a certificate a public authority issued, because the clients refuse a self-signed one.",
    guide: {
      href: "/user-guide/sync-and-devices/run-your-own-sync-server/",
      label: "Run your own server",
    },
    icon: "server",
    drawn: "server",
  },
];

---

<LandingLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <div class="feat-root">
    <GlassNav active="features" />

    <!-- ===================== HERO ===================== -->
    <section class="feat-hero">
      <div class="feat-inner feat-hero__grid">
        <div class="feat-hero__copy">
          <span class="mono up feat-eyebrow">Features</span>
          <h1 class="feat-h1">What is actually in it.</h1>
          <p class="feat-lede">
            Myne is a markdown notebook with encryption underneath it, not a
            note-taking app with a privacy badge added later. Seven surfaces,
            and the limits that matter are stated where they apply.
          </p>

          <div class="feat-chips" role="group" aria-label="Feature sections">
            {
              sections.map((s, i) => (
                <button
                  type="button"
                  class:list={["feat-chip", { "is-on": i === 0 }]}
                  aria-current={i === 0 ? "true" : undefined}
                  data-feat-chip={s.id}
                >
                  <span class="feat-chip__icon">
                    <Icon name={s.icon} size={16} />
                  </span>
                  <span class="feat-chip__label">{s.kicker}</span>
                  <span class="mono feat-chip__index">{s.index}</span>
                </button>
              ))
            }
            {/* The eighth cell. Seven sections over two columns leaves a gap,
                and a gap reads as something missing; this closes the grid with
                the one thing the grid itself cannot do, which is scroll. */}
            <a class="feat-chip feat-chip--link" href="#collaboration">
              <span class="feat-chip__icon">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14" />
                  <path d="m19 12-7 7-7-7" />
                </svg>
              </span>
              <span class="feat-chip__label">Read on</span>
              <span class="mono feat-chip__index">↓</span>
            </a>
          </div>
        </div>

        <div class="feat-hero__window" data-feat-deck>
          <ShotFrame ratio="1400 / 885">            <div class="feat-stage">
              {
                sections.map((s, i) => (
                  <div
                    class:list={["feat-slide", { "is-on": i === 0 }]}
                    data-shot-slide={s.id}
                  >
                    {/* The unlock screen is the one slide with no pair: the
                        theme is a vault preference, and a locked vault has
                        none, so the app draws it in its own default palette in
                        both themes. Shipping it as two files would have been
                        two copies of the same bytes pretending to be a light
                        and a dark capture. */}
                    {s.shot &&
                      (s.id === "encryption" ? (
                        <img
                          class="shot__img"
                          src="/app/p-encryption.webp"
                          width="1400"
                          height="885"
                          loading="lazy"
                          decoding="async"
                          alt={s.shot.alt}
                        />
                      ) : (
                        <>
                          <img
                            class="shot__img"
                            src={`/app/p-${s.id}.webp`}
                            data-shot="dark"
                            width="1400"
                            height="885"
                            loading={i === 0 ? "eager" : "lazy"}
                            fetchpriority={i === 0 ? "high" : undefined}
                            decoding="async"
                            alt={s.shot.alt}
                          />
                          <img
                            class="shot__img"
                            src={`/app/p-${s.id}-light.webp`}
                            data-shot="light"
                            width="1400"
                            height="885"
                            loading={i === 0 ? "eager" : "lazy"}
                            fetchpriority={i === 0 ? "high" : undefined}
                            decoding="async"
                            alt={s.shot.alt}
                          />
                        </>
                      ))}
                    {/* A section with no capture shows its DRAWN panel, sized
                        to the frame like the other slides so switching between
                        them does not re-lay-out the page. A text card is the
                        last resort and nothing uses it now. */}
                    {s.drawn && <FeaturesDrawn variant={s.drawn} bleed />}
                    {!s.shot && !s.drawn && (
                      <span class="feat-slide__card">
                        <span class="mono up feat-slide__kicker">
                          {s.index} · {s.kicker}
                        </span>
                        <span class="feat-slide__title">{s.title}</span>
                      </span>
                    )}
                  </div>
                ))
              }
            </div>
          </ShotFrame>
          {/* The deck's own clock. One bar rather than one per section: the
              chips already say which slide is showing, so what a reader cannot
              tell from them is WHEN it will move on. Hidden while the deck is
              in the reader's hands, because then nothing is coming. */}
          <div class="feat-progress" data-feat-progress aria-hidden="true">
            <span class="feat-progress__fill" data-feat-progress-fill></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== THE SECTIONS ===================== -->
    <div class="feat-blocks">
      {
        sections.map((s, i) => (
          <article
            id={s.id}
            class:list={["feat-block", { "feat-block--flip": i % 2 === 0 }]}
          >
            <div class="feat-inner feat-block__grid">
              <div class="feat-block__copy">
                <span class="feat-block__head">
                  <span class="feat-block__icon">
                    <Icon name={s.icon} size={18} />
                  </span>
                  <span class="mono up feat-block__index">{s.index}</span>
                  <span class="mono up feat-block__kicker">{s.kicker}</span>
                </span>
                <h2 class="feat-block__title">{s.title}</h2>
                <p class="feat-block__lede">{s.lede}</p>

                <ul class="feat-points">
                  {s.points.map((p) => (
                    <li>
                      <span class="feat-points__mark" aria-hidden="true" />
                      <b>{p.t}.</b> <span>{p.d}</span>
                    </li>
                  ))}
                </ul>

                <p class="feat-limits">
                  <span class="mono up">Limits</span>
                  <span>{s.limits}</span>
                </p>
                <a class="feat-guide" href={s.guide.href}>
                  {s.guide.label}
                  <i aria-hidden="true">→</i>
                </a>
              </div>

              <div
                class:list={[
                  "feat-block__visual",
                  { "is-empty": !s.shot && !s.drawn },
                ]}
              >
                {s.shot && (
                  <AppShowcase
                    dark={`/app/p-${s.id}.webp`}
                    light={s.id === "encryption" ? undefined : `/app/p-${s.id}-light.webp`}
                    alt={s.shot.alt}
                    w={1400}
                    h={885}
                  />
                )}
                {!s.shot && s.drawn && <FeaturesDrawn variant={s.drawn} />}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- ===================== CLOSING ===================== -->
    <section class="feat-close">
      <div class="feat-inner feat-close__inner">
        <h2>The claims are checkable. Start there.</h2>
        <p>
          The protocol, the key derivation and the account-number scheme are
          public, and the app is open source under AGPL-3.0-only-only. If a sentence on
          this page is not something you can verify, that is a bug, not a
          footnote.
        </p>
        <div class="feat-close__cta">
          <a href="/spec/" class="up feat-btn feat-btn--solid">Read the spec</a>
          <a
            href="/user-guide/getting-started/welcome/"
            class="up feat-btn feat-btn--ghost">Open the guide</a
          >
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>
</LandingLayout>

<style>
  .feat-root {
    font-family: var(--font-sans);
    color: var(--ink-1);
    background: var(--paper);
    overflow-x: clip;
  }
  .feat-inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ---- hero ------------------------------------------------------------ */
  .feat-hero {
    padding: var(--page-top) var(--gutter) 0;
  }
  /* The hero is two columns from the start, and it is the frame on the right
     that decides the height: the copy column stretches to meet it so the chips
     land at the bottom of that column rather than floating mid-air. */
  .feat-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  /* Both halves are the same width, and neither is capped.
     ── What changed ────────────────────────────────────────────────────────
     The frame used to be capped at 600px and pushed to the right edge of its
     column, on the theory that a full-width capture made the app's own sidebar
     legible enough to compete with the headline. In place the effect was the
     opposite of a claim: the two columns are 1fr/1fr, so the right half LOOKED
     narrower than the left by exactly the capped remainder, and the hero read
     as an off-centre layout rather than as a split. The grid is the thing that
     decides the width now; the capture keeps its own 1400×885 ratio and simply
     fills what it is given. */
  .feat-hero__window {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
  }
  .feat-hero__copy {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }
  .feat-eyebrow {
    display: block;
    font-size: 11px;
    color: var(--accent);
  }
  .feat-h1 {
    margin-top: 18px;
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .feat-lede {
    margin-top: 20px;
    max-width: 46ch;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--ink-3);
  }

  /* ---- the chips ------------------------------------------------------
     A control that swaps the frame beside it, so it is a KEY rather than a
     tag: a tile with its own icon plate, its own numeral and a rail that lights
     when it is the one on screen.

     ── What this replaced, and why ─────────────────────────────────────────
     Two versions ago these were 10px uppercase labels on transparent stock
     with a 26px grey outline icon. Measured in place: on a 1440 window each
     label was smaller than the body copy beneath the hero and the same weight
     as the section numbers, so the grid read as a legend for the picture
     rather than as the page's navigation, and the only colour on the whole
     left half was the one-line accent of the active tile. The picker is the
     first thing a reader's eye lands on after the headline, so it now carries
     the accent: an icon plate in the theme colour on every tile, a numeral in
     the same colour, and a lit rail on the active one. */
  .feat-chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    /* Not the full column: at the hero's own width the eight tiles stretched
       to 297px each and the picker outweighed the headline it sits under. */
    max-width: 496px;
    margin-top: auto;
    padding-top: 32px;
  }
  /* A flat tile whose BORDER is the only thing that moves. No fill, no glass,
     no glow, no lit rail: three earlier versions each added one of those and
     the grid read as eight lit buttons competing with the frame they control.
     The picker is a key, and a key's state is its edge. */
  .feat-chip {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid rgb(var(--line-rgb) / 0.13);
    border-radius: 8px;
    background: transparent;
    color: var(--ink-2);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .feat-chip:hover {
    border-color: rgb(var(--line-rgb) / 0.3);
  }
  .feat-chip:focus-visible {
    outline: none;
    box-shadow: var(--ring);
  }
  .feat-chip.is-on {
    border-color: rgb(var(--accent-rgb) / 0.7);
  }
  .feat-chip__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    color: var(--ink-3);
  }
  .feat-chip__icon svg {
    width: 15px;
    height: 15px;
  }
  .feat-chip__label {
    min-width: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feat-chip__index {
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }
  /* The eighth cell is a link, not a section, and it must not read as an
     eighth feature: dashed edge, and it keeps the same flat stock. */
  .feat-chip--link {
    border-style: dashed;
    border-color: rgb(var(--line-rgb) / 0.16);
    color: var(--ink-3);
  }
  .feat-chip--link:hover {
    border-color: rgb(var(--line-rgb) / 0.34);
  }

  /* ---- the deck --------------------------------------------------------
     Only the selected slide is a box at all, so the other seven are neither
     painted nor fetched, and every slide occupies the SAME box: an image pair
     fills it with `cover`, a drawn panel is laid out to fill it. A slide that
     sized itself would re-lay-out the page on every switch. */
  .feat-stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }
  .feat-slide {
    position: absolute;
    inset: 0;
    display: none;
  }
  .feat-slide.is-on {
    display: block;
    animation: feat-slide-in 380ms var(--ease-out) both;
  }
  /* The deck's own images carry this, because `AppShowcase`'s scoped
     `.shot__img` rule does NOT reach into this page: a scoped style is only
     applied inside its own component. Without it the image kept its natural
     1400px width inside a 598px frame and `overflow: hidden` cropped the right
     half of the app away, measured as a rendered box of 1400×885 against a
     598×378 surface, with `object-fit` still at its default `fill`. */
  .feat-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The text slide: what the deck draws in a section with no capture (see the
     `shot` note on the Section type). Anchored to the bottom of the frame, on
     the panel ground, so it reads as a title card in the same window rather
     than as a missing image. */
  .feat-slide__card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 12px;
    padding: 30px;
    background: var(--paper-2);
  }
  .feat-slide__kicker {
    font-size: 10px;
    color: var(--accent);
  }
  .feat-slide__title {
    font-size: clamp(19px, 2.1vw, 27px);
    line-height: 1.14;
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 24ch;
    color: var(--ink-1);
  }
  @keyframes feat-slide-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- the deck's progress bar -----------------------------------------
     2px of accent on a hairline track, filling linearly over one interval so
     the reader can see the switch coming instead of being surprised by it. It
     is a single bar: one segmented bar per section was the thing that made the
     reference's row read as a pagination control rather than a clock. */
  .feat-progress {
    height: 2px;
    margin-top: 16px;
    border-radius: var(--radius-pill);
    background: rgb(var(--line-rgb) / 0.1);
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-standard);
  }
  .feat-progress[data-on] {
    opacity: 1;
  }
  .feat-progress__fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* ---- blocks ---------------------------------------------------------- */
  .feat-blocks {
    padding: 0 var(--gutter);
  }
  .feat-block {
    /* The fixed bar is 60px; a link that lands a heading under it is a link that
       appears to have done nothing. */
    scroll-margin-top: calc(var(--nav-h) + 24px);
    padding: 88px 0 0;
  }
  .feat-block__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    /* `start`, not `center`: the visual is sticky from the top of its own
       column, and a centred item never has room to stick (the client rect it
       would stick within is the centring gap). */
    align-items: start;
    padding-top: 34px;
    border-top: 1px solid rgb(var(--line-rgb) / 0.12);
  }
  /* The evidence stays with the claim.
     ── What changed and why ────────────────────────────────────────────────
     The capture used to be vertically centred in the row. That is fine while
     the copy is shorter than the picture and wrong the moment it is not: the
     row grows to the taller column, the picture sits in the middle of a hole,
     and by the time a reader has reached the third bullet the screenshot beside
     it has scrolled out of view, so the section ends in text with an empty
     half. Sticking it costs nothing when the copy is short (a sticky element
     only moves once the row is taller than the viewport allows) and keeps the
     picture beside the sentence it illustrates however long the copy gets.
     `top` clears the fixed bar plus one line of breathing room. */
  .feat-block__visual {
    position: sticky;
    top: calc(var(--nav-h) + 28px);
    align-self: start;
  }
  /* A section with no capture (Meeting notes, Sync server) runs its copy
     across the full measure instead of leaving half the row empty. */
  .feat-block__grid:has(.feat-block__visual.is-empty) {
    grid-template-columns: minmax(0, 1fr);
  }
  .feat-block__grid:has(.feat-block__visual.is-empty) .feat-block__copy {
    max-width: 74ch;
  }
  /* The FIRST block puts its frame on the left, and every other block swaps
     sides from there. Starting copy-left would repeat the hero above it, which
     is also copy-left, and a zig-zag whose first move is the same direction as
     the section it follows is not a zig-zag: the reader sees one long column of
     text with pictures on the right, then a single break. The order is set on
     the children rather than by the source order, so the reading order of the
     DOM stays claim-then-evidence on every block. */
  .feat-block--flip .feat-block__copy {
    order: 2;
  }
  .feat-block--flip .feat-block__visual {
    order: 1;
  }

  .feat-block__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .feat-block__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgb(var(--line-rgb) / 0.14);
    border-radius: var(--radius-2);
    color: var(--accent);
  }
  .feat-block__index {
    font-size: 11px;
    color: var(--ink-4);
  }
  .feat-block__kicker {
    font-size: 11px;
    color: var(--ink-2);
  }
  .feat-block__title {
    margin-top: 18px;
    max-width: 24ch;
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .feat-block__lede {
    margin-top: 16px;
    max-width: 56ch;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .feat-points {
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 58ch;
  }
  .feat-points li {
    position: relative;
    padding-left: 24px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .feat-points b {
    color: var(--ink-1);
    font-weight: 600;
  }
  .feat-points__mark {
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 10px;
    height: 1px;
    background: var(--accent);
  }
  /* The limits row is deliberately not a smaller grey line at the bottom of a
     wall of text. It carries a mono label and its own surface, because it is the
     half of the page the copy discipline is about.

     The label sits ABOVE the sentence and the sentence starts on the box's own
     left edge. It began as a two-column row, which indented the paragraph to the
     right of a nine-pixel label, the reader's eye had to step over the label to
     find the first word, and every wrapped line started seven characters in from
     the box that contains it. */
  .feat-limits {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 26px;
    max-width: 58ch;
    padding: 16px 18px;
    border: 1px solid rgb(var(--line-rgb) / 0.1);
    border-left: 2px solid rgb(var(--warning-rgb) / 0.5);
    border-radius: var(--radius-2);
    background: rgb(var(--line-rgb) / 0.02);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .feat-limits span:first-child {
    font-size: 9.5px;
    color: var(--warning);
  }
  .feat-guide {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--accent-rgb) / 0.3);
    padding-bottom: 3px;
    align-self: flex-start;
  }
  .feat-guide i {
    font-style: normal;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .feat-guide:hover {
    border-bottom-color: var(--accent);
  }
  .feat-guide:hover i {
    transform: translateX(3px);
  }

  /* ---- closing --------------------------------------------------------- */
  .feat-close {
    padding: var(--page-top) var(--gutter) 40px;
  }
  .feat-close__inner {
    padding: 48px;
    border: 1px dashed rgb(var(--line-rgb) / 0.2);
  }
  .feat-close__inner h2 {
    max-width: 26ch;
    font-size: clamp(24px, 3.2vw, 40px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .feat-close__inner p {
    margin-top: 16px;
    max-width: 58ch;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .feat-close__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .feat-btn {
    padding: 13px 22px;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }
  .feat-btn--solid {
    background: var(--ink-1);
    color: var(--paper);
  }
  .feat-btn--ghost {
    color: var(--ink-1);
    border: 1px solid rgb(var(--line-rgb) / 0.2);
  }

  /* ---- narrow ----------------------------------------------------------
     The hero stacks at 1080 (where the frame stops being a column and starts
     being a picture), and the blocks stack at 940, which is where a claim and
     its evidence stop fitting side by side. */
  @media (max-width: 1079px) {
    .feat-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .feat-hero__copy {
      min-height: 0;
    }
    .feat-chips {
      margin-top: 0;
    }
    .feat-hero__window {
      max-width: 720px;
      margin: 0 auto;
    }
  }
  @media (max-width: 940px) {
    .feat-block__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .feat-block--flip .feat-block__copy,
    .feat-block--flip .feat-block__visual {
      order: 0;
    }
    /* One column: the picture now sits BELOW the copy, so there is no sentence
       beside it to stay with. Sticky would pin it to a row it already fills. */
    .feat-block__visual {
      position: static;
    }
    .feat-block {
      padding-top: 64px;
    }
    .feat-close__inner {
      padding: 28px 22px;
    }
  }
  @media (max-width: 560px) {
    /* Two columns, not one. One column of eight chips is 640px of navigation
       before the reader meets the frame those chips control; two columns of four
       still reads as a grid of controls. The index line goes, because at this
       size it is the part nothing depends on. */
    .feat-chip {
      grid-template-columns: 26px minmax(0, 1fr);
      padding: 9px 10px;
      gap: 8px;
    }
    .feat-chip__icon {
      width: 26px;
      height: 26px;
    }
    .feat-chip__index {
      display: none;
    }
    .feat-chip__label {
      font-size: 11.5px;
    }
    .feat-lede,
    .feat-block__lede {
      font-size: 14px;
    }
    .feat-points li {
      font-size: 13px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feat-slide.is-on {
      animation: none;
    }
  }
</style>

<script>
  import { voicePoints } from "../scripts/voice";

  // ---------- the hero deck ----------
  //
  // Eight chips, eight slides in one frame. Clicking a chip selects its slide
  // (and keeps the chip's own state in step); left alone, the deck advances
  // every few seconds, because a still frame beside a row of controls reads as
  // decoration rather than as something the controls do. The first click stops
  // the timer for good: a reader who has taken over should not have it taken
  // back from them mid-read.
  const INTERVAL = 5200;

  const chips = Array.from(
    document.querySelectorAll<HTMLElement>("[data-feat-chip]"),
  );
  const deck = document.querySelector("[data-feat-deck]");
  const progress = document.querySelector<HTMLElement>("[data-feat-progress]");
  const fill = document.querySelector<HTMLElement>("[data-feat-progress-fill]");

  if (chips.length && deck) {
    const slides = Array.from(
      deck.querySelectorAll<HTMLElement>("[data-shot-slide]"),
    );
    let auto: number | undefined;
    let bar: Animation | undefined;

    const select = (id: string) => {
      slides.forEach((s) =>
        s.classList.toggle("is-on", s.dataset.shotSlide === id),
      );
      chips.forEach((c) => {
        const on = c.dataset.featChip === id;
        c.classList.toggle("is-on", on);
        if (on) c.setAttribute("aria-current", "true");
        else c.removeAttribute("aria-current");
      });
    };

    // Restarting a WAAPI animation is what makes the bar honest: `cancel` then
    // `play` on a fresh one restarts from zero on every switch, where a CSS
    // animation would need a forced reflow to do the same thing.
    const armBar = () => {
      if (!progress || !fill || typeof fill.animate !== "function") return;
      progress.dataset.on = "";
      bar?.cancel();
      bar = fill.animate(
        [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
        { duration: INTERVAL, easing: "linear", fill: "forwards" },
      );
    };

    // The reader has the deck: no more advancing, so no more clock.
    const disarmBar = () => {
      bar?.cancel();
      if (progress) delete progress.dataset.on;
      if (fill) fill.style.transform = "scaleX(0)";
    };

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const id = chip.dataset.featChip;
        if (!id) return;
        window.clearInterval(auto);
        auto = undefined;
        select(id);
        disarmBar();
      });
    });

    if (!reduce) {
      armBar();
      auto = window.setInterval(() => {
        const current = chips.findIndex((c) => c.classList.contains("is-on"));
        const next = chips[(current + 1) % chips.length];
        if (next?.dataset.featChip) select(next.dataset.featChip);
        armBar();
      }, INTERVAL);
    } else {
      disarmBar();
    }
  }

  // ---------- the voice line ----------
  //
  // The meeting panel's stroke is a voice going into a microphone, and a
  // recording that does not move reads as a chart of something that already
  // ended. So the line is REDRAWN, about thirty times a second, from the same
  // amplitude field the build-time frame uses: one bell-shaped group of peaks in
  // the middle of the panel, its lobes each moving at their own speed so nothing
  // repeats, and a single level over the group so it swells and drops the way a
  // person talking does.
  const voiceLines = Array.from(
    document.querySelectorAll<SVGPolylineElement>("[data-voice]"),
  );
  const stillVoice = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (voiceLines.length && !stillVoice) {
    /* The same drawing the component builds, from the same module: one
       function of time, so a frame drawn here can never disagree with the frame
       the server rendered. */
    const shapes = voiceLines.map(() => (time: number) => voicePoints(time, 6));

    const visible = new Set<SVGPolylineElement>();
    let raf = 0;
    let started = 0;
    let last = 0;
    const tick = (now: number) => {
      raf = window.requestAnimationFrame(tick);
      if (now - last < 33) return;
      last = now;
      if (!started) started = now;
      const time = (now - started) / 1000;
      voiceLines.forEach((el, i) => {
        if (visible.has(el)) el.setAttribute("points", shapes[i]!(time));
      });
    };

    // Only the panel on screen is redrawn: the same drawing appears in the deck
    // AND in the meeting section, and the one that is scrolled away or sitting
    // in a hidden slide costs nothing.
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const el = entry.target as SVGPolylineElement;
        if (entry.isIntersecting) visible.add(el);
        else visible.delete(el);
      }
      if (visible.size && !raf) raf = window.requestAnimationFrame(tick);
      else if (!visible.size && raf) {
        window.cancelAnimationFrame(raf);
        raf = 0;
      }
    });
    voiceLines.forEach((el) => io.observe(el));
  }
</script>
