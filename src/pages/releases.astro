---
import LandingLayout from "../layouts/LandingLayout.astro";
import GlassNav from "../components/GlassNav.astro";
import StatusBadge from "../components/StatusBadge.astro";
import VersionBadge from "../components/VersionBadge.astro";
import { absoluteOg } from "../lib/og";
import {
  RELEASE_TAG,
  RELEASE_DATE,
  MINISIGN_PUBKEY,
  ASSETS,
  humanSize,
} from "../data/release";

const title = "Releases — Myne";
const description =
  "Myne releases, with the SHA-256 of every published artefact and the minisign public key that signs the checksum list. Early access, pre-alpha.";
const canonical = new URL("/releases/", Astro.site!).toString();
const ogImage = absoluteOg("releases", Astro.site!);

const eyebrow = "font-size:11px;color:#8aa4d0;margin-bottom:14px;";
---

<LandingLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <div
    style="font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e6e6e4;background:#0a0a0a;min-height:100vh;"
  >
    <GlassNav active="releases" />

    <section id="top" style="padding:128px 28px 70px;">
      <div style="max-width:820px;margin:0 auto;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
          <span class="mono up" style="font-size:11px;color:#8aa4d0;">Releases</span>
          <span
            class="mono up"
            style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
            >pre-alpha</span
          >
        </div>
        <h1
          style="font-size:clamp(34px,5vw,58px);line-height:1.0;font-weight:700;letter-spacing:-0.035em;"
        >
          Every hash, in public.
        </h1>
        <p
          style="margin-top:22px;max-width:66ch;font-size:16px;line-height:1.65;color:#8a8a86;"
        >
          This page exists to be a second opinion. The artefacts are served from
          <span class="mono" style="color:#c4c4c0;">downloads.myne.md</span>; the
          SHA-256 of each one is published here, from a different machine and a
          different deploy pipeline. If those two ever disagree, something is
          wrong — and that disagreement is the point.
        </p>

        <!-- HOW TO VERIFY -->
        <div
          style="margin-top:36px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;background:#0c0c0c;padding:26px;"
        >
          <div class="mono up" style="font-size:10px;color:#8aa4d0;">Verify a download</div>
          <p style="margin-top:12px;max-width:66ch;font-size:13.5px;line-height:1.7;color:#8a8a86;">
            Check the signature <em>before</em> the hashes. Verifying a file
            against a checksum list you have not authenticated only proves the
            list and the file came from the same place — which is exactly what an
            attacker who controls that place would arrange.
          </p>
          <div style="margin-top:18px;border-top:1px solid rgba(255,255,255,0.08);padding-top:16px;">
            <div class="mono up" style="font-size:10px;color:#54544f;">
              minisign public key
            </div>
            <p
              class="mono"
              style="margin-top:8px;font-size:11.5px;line-height:1.6;color:#c4c4c0;word-break:break-all;"
            >
              {MINISIGN_PUBKEY}
            </p>
            <p style="margin-top:10px;max-width:66ch;font-size:12px;line-height:1.7;color:#6a6a66;">
              Also published in <a
                href="/.well-known/security.txt"
                style="color:#8aa4d0;text-decoration:none;">security.txt</a
              > and in the download host's own <span class="mono">index.json</span>.
              Three places, so that a reader who distrusts one can compare. It signs
              the checksum list — <strong style="color:#8a8a86;font-weight:600;">not</strong> the
              installers, which are unsigned and will make your OS warn you.
            </p>
          </div>
        </div>

        <!-- RELEASE -->
        <div
          style="margin-top:22px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;background:#0c0c0c;padding:26px;"
        >
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <span class="mono" style="font-size:18px;font-weight:600;color:#e6e6e4;"
              >{RELEASE_TAG}</span
            >
            <span
              class="mono up"
              style="font-size:9px;color:#c2a35e;border:1px solid rgba(194,163,94,0.4);border-radius:999px;padding:3px 9px;"
              >early access</span
            >
          </div>
          <div class="mono" style="margin-top:6px;font-size:11px;color:#54544f;">
            released {RELEASE_DATE} · unsigned installers · no auto-updater
          </div>

          <div style="margin-top:20px;overflow-x:auto;">
            <table
              class="mono"
              style="width:100%;border-collapse:collapse;font-size:11px;text-align:left;"
            >
              <thead>
                <tr style="color:#54544f;">
                  <th style="padding:8px 10px 8px 0;font-weight:400;">Artefact</th>
                  <th style="padding:8px 10px;font-weight:400;white-space:nowrap;">Size</th>
                  <th style="padding:8px 0 8px 10px;font-weight:400;">SHA-256</th>
                </tr>
              </thead>
              <tbody>
                {ASSETS.map((a) => (
                  <tr style="border-top:1px solid rgba(255,255,255,0.08);">
                    <td style="padding:9px 10px 9px 0;vertical-align:top;color:#8a8a86;word-break:break-all;">
                      {a.name}
                    </td>
                    <td style="padding:9px 10px;vertical-align:top;color:#6a6a66;white-space:nowrap;">
                      {humanSize(a.bytes)}
                    </td>
                    <td style="padding:9px 0 9px 10px;vertical-align:top;color:#8a8a86;word-break:break-all;">
                      {a.sha256}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          </div>
        </div>

        <p class="mono" style="margin-top:18px;font-size:11.5px;line-height:1.7;color:#6a6a66;max-width:64ch;">
          No dates and no cadence promise — builds ship when they're ready to
          trust, not on a schedule. Older versions are not published here: they
          are superseded pre-1.0 builds, and listing them next to the current one
          invites installing the wrong one.
        </p>
      </div>
    </section>

    <footer style="border-top:1px solid rgba(255,255,255,0.1);padding:36px 28px;">
      <div
        class="mono up"
        style="max-width:820px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:10px;color:#54544f;"
      >
        <span>© 2026 Myne · AGPL-3.0 · CC-BY-4.0 docs</span><StatusBadge /><VersionBadge />
      </div>
    </footer>
  </div>
</LandingLayout>
